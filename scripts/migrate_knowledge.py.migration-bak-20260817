RULE_SOURCES = {
    "Capability_System.md": ("能力系统规则", "capability-system"),
    "Completion_Protocol.md": ("完成协议", "completion-protocol"),
    "Context_Loading_System.md": ("上下文加载系统", "context-loading-system"),
