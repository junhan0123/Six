# Xiao6 Environment Configuration
# Copy this file to .env and set actual values

# Application
APP_VERSION=1.0.0          # 应用版本号，需与 VERSION 文件一致
APP_NAME=小6               # 应用名称

# TTS Backend
TTS_BACKEND=none           # TTS 后端: none / gpt_sovits / edge_tts
GPT_SOVITS_URL=http://localhost:9880  # GPT-SoVITS 服务地址（TTS_BACKEND=gpt_sovits 时必填）

# Database
DATABASE_PATH=./xiao6-ui/data/xiao6.db  # SQLite 数据库路径

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Logging
LOG_LEVEL=INFO

# QQ Bot (optional)
QQ_BOT_APP_ID=
QQ_BOT_SECRET=
