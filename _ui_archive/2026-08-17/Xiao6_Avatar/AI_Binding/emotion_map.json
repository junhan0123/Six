    "speaking":  { "eye": "soft",    "mouth": "talk",   "emotion": "warm" },
    "curious":   { "eye": "bright",  "mouth": "small",  "emotion": "interest" },
    "concerned": { "eye": "slanted", "mouth": "flat",   "emotion": "worry" },
    "alarmed":   { "eye": "sharp",   "mouth": "open",   "emotion": "alert" }
