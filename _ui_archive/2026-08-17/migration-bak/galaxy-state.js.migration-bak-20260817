/*
 * galaxy-state.js — 庄周 Phase 6 · 银河节点数据消费层（非视觉）
 * ----------------------------------------------------------------------------
 * 职责：把 AppState 的领域事件投影为银河节点数据 {id, type, state, relation, metadata}，
 *       供未来 solar-system.js 作为“状态渲染器”消费（readiness §3.3 / §6）。
 * 纪律：
 *   - 本文件绝不触碰 Three.js / WebGL；只维护数据。银河节点是领域对象的“投影”，不是新实体。
 *   - 数据单向派生自 AppState（readiness §5.2：银河是订阅者而非生产者）。
 *   - state 字段 = 运行维（来自领域事件）；interaction 字段 = 交互维（来自用户交互，
 *     本阶段恒 'idle'，Order 6 焦点同步时再填充 Focused/Hover 等）。
 * 设计依据：readiness 银河 §4（正交状态机 交互×运行）/ §5（AI 运行映射）。
 * 可在 Node 中单测（不依赖 window）。
 */
(function (global) {
  'use strict';
  var AppState = global.AppState;

  // 领域态 → 银河运行态（正交模型“运行维”，readiness 银河 §4/§5 投影）
  var RUNTIME_MAP = {
    Created: 'Created', Started: 'Started', Dormant: 'Dormant', Running: 'Running',
    Thinking: 'Thinking', Working: 'Working', Waiting: 'Waiting',
    Paused: 'Paused', Completed: 'Completed', Failed: 'Error', Error: 'Error',
    Stored: 'Stored', Linked: 'Linked',
    Archived: 'Dormant', Sleeping: 'Sleeping',
    updated: 'updated', idle: 'idle',
    // —— Order 5：Intent Gateway 运行态（非视觉，仅供渲染器未来消费）——
    Received: 'Received', Analyzing: 'Analyzing', Classified: 'Classified',
    Accepted: 'Accepted', Rejected: 'Rejected', Converted: 'Converted'
  };
  function deriveRuntime(domainStatus) {
    return RUNTIME_MAP[domainStatus] || 'Unknown';
  }

  var nodes = {};
  var subs = [];

  // 从 AppState 单向拉取节点数据（投影，非复制写入逻辑）
  function pull() {
    var src = AppState.getGalaxyNodes();
    for (var id in src) {
      if (!Object.prototype.hasOwnProperty.call(src, id)) continue;
      var s = src[id];
      nodes[id] = {
        id: s.id,
        type: s.type,
        state: deriveRuntime(s.state),     // 运行维
        interaction: s.interaction || 'idle', // 交互维（本阶段恒 idle）
        relation: s.relation || {},
        metadata: s.metadata || {}
      };
    }
  }

  function notify(evt) {
    for (var i = 0; i < subs.length; i++) subs[i](nodes, evt);
  }

  // 订阅 AppState 全事件，保持节点数据同步
  var unsub = AppState.subscribe('*', function (e) { pull(); notify(e); });
  pull();

  var API = {
    getNodes: function () {
      return Object.keys(nodes).map(function (k) { return nodes[k]; });
    },
    getNode: function (id) { return nodes[id] || null; },
    // Order 2：Goal → Galaxy Node 的显式数据投影（仅供渲染器未来消费，非视觉）
    getGoalNodes: function () {
      return Object.keys(nodes)
        .filter(function (k) { return nodes[k].type === 'goal'; })
        .map(function (k) { return nodes[k]; });
    },
    // Order 3：Agent → Satellite 数据投影（仅供渲染器未来消费，非视觉）
    getAgentNodes: function () {
      return Object.keys(nodes)
        .filter(function (k) { return nodes[k].type === 'agent'; })
        .map(function (k) { return nodes[k]; });
    },
    // Order 3：Task → Orbit Node 数据投影（仅供渲染器未来消费，非视觉）
    getTaskNodes: function () {
      return Object.keys(nodes)
        .filter(function (k) { return nodes[k].type === 'task'; })
        .map(function (k) { return nodes[k]; });
    },
    // Order 4：Memory → Memory Node 纯数据投影（仅供渲染器未来消费，非视觉）
    getMemoryNodes: function () {
      return Object.keys(nodes)
        .filter(function (k) { return nodes[k].type === 'memory'; })
        .map(function (k) { return nodes[k]; });
    },
    // Order 4：Knowledge → Knowledge Link 纯数据投影（仅供渲染器未来消费，非视觉）
    getKnowledgeLinks: function () {
      return Object.keys(nodes)
        .filter(function (k) { return nodes[k].type === 'knowledge'; })
        .map(function (k) { return nodes[k]; });
    },
    // Order 5：Intent → Intent Node 纯数据投影（仅供渲染器未来消费，非视觉）
    getIntentNodes: function () {
      return Object.keys(nodes)
        .filter(function (k) { return nodes[k].type === 'intent'; })
        .map(function (k) { return nodes[k]; });
    },
    onNodeChange: function (cb) {
      subs.push(cb);
      return function () { var i = subs.indexOf(cb); if (i >= 0) subs.splice(i, 1); };
    },
    deriveRuntime: deriveRuntime,
    _unsub: unsub
  };

  global.GalaxyState = API;
  if (typeof module !== 'undefined' && module.exports) module.exports = API;
})(typeof window !== 'undefined' ? window : globalThis);
