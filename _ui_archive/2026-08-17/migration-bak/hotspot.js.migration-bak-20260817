function latLonToVec3(lat, lon, radius) {
  const phi = (90 - lat) * (Math.PI / 180);
  const theta = (lon + 180) * (Math.PI / 180);
  return new THREE.Vector3(
    -radius * Math.sin(phi) * Math.cos(theta),
     radius * Math.cos(phi),
     radius * Math.sin(phi) * Math.sin(theta),
  );
}

export class HotspotEarth {
  constructor(canvas) {
    this.canvas = canvas;
    this.renderer = null; this.scene = null; this.camera = null;
    this.earth = null; this.clouds = null; this.atmo = null; this.atmo2 = null;
    this.stars = null;
    this.ambient = null; this.dynamic = null; this.regionMeshes = {};
    this.highlight = ''; this._regions = []; this.hoverRegion = '';
    this.isDragging = false; this.prevMouse = { x: 0, y: 0 };
    this.rotX = 0.1; this.rotY = 0;
    this.velX = 0; this.velY = 0.0008;
    this.camDist = 3.25; this.camDistMin = 2.35; this.camDistMax = 4.5;
    this.appearing = false; this.appearScale = 0;
    this.animFrame = null; this._bound = {}; this.raycaster = null; this.onRegionPick = null;
    this.disposed = false; this._appearTimer = null; this._onContextLost = null;
    // 城市/热点标记风格：'pulse'（脉冲环，默认）| 'beam'（光柱）| 'ring'（环点旧版）
    this.markerStyle = 'ring';
  }

  async init() {
    setEarthStatus('正在加载 3D 引擎...', 'info');
    try {
    const T = await loadThree();
    if (!T || !T.Scene) throw new Error('Three.js 加载失败');
    setEarthStatus('Three.js 已加载，正在创建 WebGL 上下文...', 'info');
    this.scene = new T.Scene();
    const w = this.canvas.clientWidth || 400;
    const h = this.canvas.clientHeight || 400;
    this.camera = new T.PerspectiveCamera(45, w / h, 0.1, 100);
    this.camera.position.set(0, 0, this.camDist);
    this.renderer = new T.WebGLRenderer({ canvas: this.canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
    setEarthStatus('WebGL 上下文创建成功，正在加载地球纹理...', 'info');
    this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    this.renderer.setSize(w, h, false);
    if (T.SRGBColorSpace) this.renderer.outputColorSpace = T.SRGBColorSpace;
    if (T.ACESFilmicToneMapping) { this.renderer.toneMapping = T.ACESFilmicToneMapping; this.renderer.toneMappingExposure = 1.15; }

    // —— 参考实现同款光照：纯白太阳光 + 冷青半球光 + 较弱环境光 ——
    const sun = new T.DirectionalLight(0xffffff, 2.35);
    sun.position.set(5, 2.2, 4.5);
    this.scene.add(sun);
    this.scene.add(new T.HemisphereLight(0xdcecff, 0x111827, 0.72));
    this.scene.add(new T.AmbientLight(0xffffff, 0.16));

    const loader = new T.TextureLoader();
    const loadTex = (url) => new Promise((res) => loader.load(url, res, undefined, () => res(null)));

    // 同步加载四张 NASA 纹理（地球/法线/高光/云层）
    setEarthStatus('正在加载基础地球纹理...', 'info');
    const [earthTex, normalTex, specTex, cloudTex] = await Promise.all([
      loadTex(TEX.earth), loadTex(TEX.normal), loadTex(TEX.specular), loadTex(TEX.clouds),
    ]);
    [earthTex, cloudTex].forEach((tex) => { if (tex && T.SRGBColorSpace) tex.colorSpace = T.SRGBColorSpace; });

    // —— 参考实现同款地球材质：真实 NASA 纹理，不调蓝、无自发光 ——
    const usedEarthTex = earthTex || createProceduralEarthTexture(T);
    const geo = new T.SphereGeometry(1, 64, 64);
    const mat = new T.MeshPhongMaterial({
      map: usedEarthTex,
      normalMap: normalTex || undefined,
      specularMap: specTex || undefined,
      specular: new T.Color(0x1d3557),
      shininess: 28,
    });
    this.earth = new T.Mesh(geo, mat);
    this.scene.add(this.earth);
    setEarthStatus('地球网格已创建，正在添加大气与星空...', 'info');

    // —— 参考实现同款云层 ——
    if (cloudTex) {
      const cloudGeo = new T.SphereGeometry(1.012, 48, 48);
      const cloudMat = new T.MeshPhongMaterial({ map: cloudTex, transparent: true, opacity: 0.75, depthWrite: false });
      this.clouds = new T.Mesh(cloudGeo, cloudMat);
      this.scene.add(this.clouds);
    }

    // —— 参考实现同款大气层（0x4488ff 外晕 + 0x88ccff 内缘） ——
    const atmoGeo = new T.SphereGeometry(1.06, 32, 32);
    const atmoMat = new T.MeshBasicMaterial({ color: 0x4488ff, transparent: true, opacity: 0.06, side: T.BackSide, depthWrite: false });
    this.atmo = new T.Mesh(atmoGeo, atmoMat);
    this.scene.add(this.atmo);

    const atmo2Geo = new T.SphereGeometry(1.035, 32, 32);
    const atmo2Mat = new T.MeshBasicMaterial({ color: 0x88ccff, transparent: true, opacity: 0.035, side: T.FrontSide, depthWrite: false });
    this.atmo2 = new T.Mesh(atmo2Geo, atmo2Mat);
    this.scene.add(this.atmo2);

    // —— 参考实现同款星空（2000 points） ——
    const starVerts = [];
    for (let i = 0; i < 2000; i++) {
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);
      const r = 18 + Math.random() * 12;
      starVerts.push(
        r * Math.sin(phi) * Math.cos(theta),
        r * Math.cos(phi),
        r * Math.sin(phi) * Math.sin(theta),
      );
    }
    const starGeo = new T.BufferGeometry();
    starGeo.setAttribute('position', new T.Float32BufferAttribute(starVerts, 3));
    const starMat = new T.PointsMaterial({ color: 0xffffff, size: 0.06, sizeAttenuation: true, transparent: true });
    this.stars = new T.Points(starGeo, starMat);
    this.scene.add(this.stars);
    setEarthStatus('星空已添加，正在初始化热点环...', 'info');

    // —— 城市骨架红点（参考实现同款） ——
    this._buildAmbient(T);
    // —— 庄周动态地域热点（保留热搜功能） ——
    this.dynamic = new T.Group();
    this.earth.add(this.dynamic);
    this.earth.scale.setScalar(0);
    if (this.clouds) this.clouds.scale.setScalar(0);
    this.atmo.scale.setScalar(0); this.atmo2.scale.setScalar(0);
    this.stars.material.opacity = 0;
    this.raycaster = new T.Raycaster();
    this._bindEvents();
    this._setupContextLoss();
    setEarthStatus('初始化完成，等待出场动画...', 'success');
    this._animate();
    // 自动出场兜底：如果外部 500ms 内没有触发 triggerAppear，自动显示地球
    // 避免 setHotspotMode 的 promise 链因 hotspotActive 状态变化而漏掉出场
    setTimeout(() => {
      if (this.disposed) return;
      if (!this.appearing && this.earth && this.earth.scale.x < 0.01) {
        console.warn('[HotspotEarth] auto-triggering appear from init safety net');
        setEarthStatus('自动触发出场动画...', 'info');
        this.triggerAppear();
      }
    }, 500);
    } catch (err) {
      console.error('[HotspotEarth] init failed:', err);
      setEarthStatus(`初始化失败：${err?.message || '未知错误'}<br>请刷新页面或检查浏览器 WebGL 设置`, 'error');
      throw err;
    }
  }

  _setupContextLoss() {
    this._onContextLost = (e) => {
      e.preventDefault();
      console.warn('[HotspotEarth] WebGL context lost');
      this.dispose();
      earth = null;
      earthInitPromise = null;
    };
    this.canvas.addEventListener('webglcontextlost', this._onContextLost);
  }

  // 脉冲点 / 脉冲环的 billboard 贴图（CanvasTexture，始终面向相机）
  _makePulseDotSprite(color, scale, opacity) {
    if (!THREE) return null;
    const cvs = document.createElement('canvas');
    cvs.width = 64; cvs.height = 64;
    const ctx = cvs.getContext('2d');
    const g = ctx.createRadialGradient(32, 32, 0, 32, 32, 28);
    g.addColorStop(0, 'rgba(255,255,255,0.95)');
    g.addColorStop(0.45, 'rgba(255,255,255,0.5)');
    g.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, 64, 64);
    const tex = new THREE.CanvasTexture(cvs);
    const mat = new THREE.SpriteMaterial({
      map: tex, color, transparent: true, opacity,
      blending: THREE.AdditiveBlending, depthWrite: false,
    });
    const s = new THREE.Sprite(mat);
    s.scale.setScalar(scale);
    return { sprite: s, mat };
  }

  _makePulseRingSprite(color, scale, opacity) {
    if (!THREE) return null;
    const cvs = document.createElement('canvas');
    cvs.width = 128; cvs.height = 128;
    const ctx = cvs.getContext('2d');
    ctx.beginPath(); ctx.arc(64, 64, 56, 0, Math.PI * 2);
    ctx.lineWidth = 9; ctx.strokeStyle = 'rgba(255,255,255,0.9)'; ctx.stroke();
    ctx.globalCompositeOperation = 'destination-out';
    ctx.beginPath(); ctx.arc(64, 64, 46, 0, Math.PI * 2); ctx.fill();
    ctx.globalCompositeOperation = 'source-over';
    const tex = new THREE.CanvasTexture(cvs);
    const mat = new THREE.SpriteMaterial({
      map: tex, color, transparent: true, opacity,
      blending: THREE.AdditiveBlending, depthWrite: false,
    });
    const s = new THREE.Sprite(mat);
    s.scale.setScalar(scale);
    return { sprite: s, mat };
  }

  // 脉冲环风格：中心光点 + 固定内环 + 2 个向外扩散的 billboard 脉冲环
  _makePulse(group, pos, colorHex, size, intensity, region = '') {
    if (!THREE) return null;
    const color = new THREE.Color(colorHex);

    // 命中球：比视觉范围大，确保每个亮点都能点开
    const hitGeo = new THREE.SphereGeometry(Math.max(size * 7.0, 0.14), 14, 14);
    const hitMat = new THREE.MeshBasicMaterial({
      transparent: true, opacity: 0, depthWrite: false, side: THREE.DoubleSide,
    });
    const hit = new THREE.Mesh(hitGeo, hitMat);
    hit.position.copy(pos);

    // 中心光点（始终面向相机）
    const dotBase = size * 1.1;
    const dotObj = this._makePulseDotSprite(color, dotBase, 0.85 + 0.15 * intensity);
    const dot = dotObj ? dotObj.sprite : new THREE.Object3D();
    dot.position.copy(pos);

    // 内环固定
    const ringBase = size * 1.7;
    const ringObj = this._makePulseRingSprite(color, ringBase, 0.55 + 0.25 * intensity);
    const ring = ringObj ? ringObj.sprite : new THREE.Object3D();
    ring.position.copy(pos);

    // 2 个外脉冲环，相位错开
    const waveBase = size * 1.5;
    const waves = [];
    for (let i = 0; i < 2; i++) {
      const wObj = this._makePulseRingSprite(color, waveBase, 0.45 + 0.15 * intensity);
      if (!wObj) continue;
      wObj.sprite.position.copy(pos);
      waves.push({ sprite: wObj.sprite, mat: wObj.mat, phaseOffset: i * Math.PI });
    }

    [hit, dot, ring, ...waves.map(w => w.sprite)].forEach((o) => { o.userData.region = region; });
    group.add(hit, dot, ring, ...waves.map(w => w.sprite));

    return {
      ring, ringMat: ringObj ? ringObj.mat : null,
      dot, dotMat: dotObj ? dotObj.mat : null,
      core: null, coreMat: null,
      hit, phase: Math.random() * 6.28, baseSize: size, intensity,
      isPulse: true, waves, dotBase, ringBase, waveBase,
    };
  }

  // 光柱风格：从地表沿法线向外射出的发光柱 + 底部光环 + 顶部光球
  _makeBeam(group, pos, colorHex, size, intensity, region = '') {
    if (!THREE) return null;
    const color = new THREE.Color(colorHex);
    const normal = pos.clone().normalize();
    const quat = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 1, 0), normal);

    // 光柱高度随热度/强度略增，骨架点（低强度）更短，避免拥挤
    const H = 0.10 + intensity * 0.07;
    const rTop = size * 0.05;
    const rBase = size * 0.16;

    // 光柱本体（顶端略细，营造光束收束感）
    const pillarGeo = new THREE.CylinderGeometry(rTop, rBase, H, 12, 1, true);
    const pillarMat = new THREE.MeshBasicMaterial({
      color, transparent: true, opacity: 0.35 + 0.35 * intensity,
      blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide,
    });
    const pillar = new THREE.Mesh(pillarGeo, pillarMat);
    pillar.position.copy(pos.clone().add(normal.clone().multiplyScalar(H / 2)));
    pillar.quaternion.copy(quat);

    // 底部光环（贴地，呼吸脉冲）
    const baseRingGeo = new THREE.RingGeometry(size * 0.42, size * 0.78, 24);
    const baseRingMat = new THREE.MeshBasicMaterial({
      color, transparent: true, opacity: 0.45 + 0.3 * intensity,
      side: THREE.DoubleSide, blending: THREE.AdditiveBlending, depthWrite: false,
    });
    const baseRing = new THREE.Mesh(baseRingGeo, baseRingMat);
    baseRing.position.copy(pos);
    baseRing.lookAt(pos.clone().multiplyScalar(2));

    // 顶部光球（高亮时放大变亮）
    const topGeo = new THREE.SphereGeometry(size * 0.42, 12, 12);
    const topMat = new THREE.MeshBasicMaterial({
      color: 0xffffff, transparent: true, opacity: 0.7 + 0.3 * intensity,
      blending: THREE.AdditiveBlending, depthWrite: false,
    });
    const top = new THREE.Mesh(topGeo, topMat);
    top.position.copy(pos.clone().add(normal.clone().multiplyScalar(H)));

    // 命中体：不可见球体，确保点击容错
    const hitGeo = new THREE.SphereGeometry(Math.max(size * 5.0, 0.095), 14, 14);
    const hitMat = new THREE.MeshBasicMaterial({
      transparent: true, opacity: 0, depthWrite: false, side: THREE.DoubleSide,
    });
    const hit = new THREE.Mesh(hitGeo, hitMat);
    hit.position.copy(pos);

    [pillar, baseRing, top, hit].forEach((o) => { o.userData.region = region; });
    group.add(pillar, baseRing, top, hit);

    // 字段命名与 ring 风格对齐，便于 _animate 统一驱动
    return {
      ring: baseRing, ringMat: baseRingMat,
      dot: top, dotMat: topMat,
      core: pillar, coreMat: pillarMat,
      hit, phase: 0, baseSize: size, isBeam: true,
    };
  }

  _createBeacon(group, pos, colorHex, size, intensity, region = '') {
    if (this.markerStyle === 'ring') {
      // —— 纯色静态小球：无环、无光晕、不闪烁 ——
      if (!THREE) return null;
      const color = new THREE.Color(colorHex);

      // 可见点：实心小球
      const dotGeo = new THREE.SphereGeometry(size, 12, 12);
      const dotMat = new THREE.MeshBasicMaterial({ color, depthWrite: false });
      const dot = new THREE.Mesh(dotGeo, dotMat);
      dot.position.copy(pos);

      // 命中体：不可见球体，确保点击容错
      const hitGeo = new THREE.SphereGeometry(Math.max(size * 4.0, 0.08), 14, 14);
      const hitMat = new THREE.MeshBasicMaterial({
        transparent: true, opacity: 0, depthWrite: false, side: THREE.DoubleSide,
      });
      const hit = new THREE.Mesh(hitGeo, hitMat);
      hit.position.copy(pos);

      dot.userData.region = region;
      hit.userData.region = region;
      group.add(dot, hit);

      return { ring: null, ringMat: null, dot, dotMat, core: null, coreMat: null, hit, baseSize: size };
    }
    if (this.markerStyle === 'beam') {
      // 光柱风格
      return this._makeBeam(group, pos, colorHex, size, intensity, region);
    }
    // 默认脉冲环风格
    return this._makePulse(group, pos, colorHex, size, intensity, region);
  }

  _buildAmbient(T) {
    // 12 个主要城市作骨架点：纯色小球，无环、无光晕、不闪烁
    // 真实热点另由 updateHotspots 叠加（平台色小球）；骨架点本身也可点击
    const group = new T.Group();
    HOTSPOT_COORDS.forEach(({ lat, lon, label }) => {
      const pos = latLonToVec3(lat, lon, 1.02);
      // 可见点：实心小红球
      const dotGeo = new T.SphereGeometry(0.007, 12, 12);
      const dotMat = new T.MeshBasicMaterial({ color: 0xff4444, depthWrite: false });
      const dot = new T.Mesh(dotGeo, dotMat);
      dot.position.copy(pos);
      dot.userData = { region: label, isAmbient: true };

      // 不可见命中球：确保 360° 可点
      const hitGeo = new T.SphereGeometry(0.045, 12, 12);
      const hitMat = new T.MeshBasicMaterial({
        transparent: true, opacity: 0, depthWrite: false, side: T.DoubleSide,
      });
      const hit = new T.Mesh(hitGeo, hitMat);
      hit.position.copy(pos);
      hit.userData = { region: label, isAmbient: true };

      group.add(dot, hit);
    });
    this.ambient = group;
    this.earth.add(group);
  }

  // 平台主色，用于真实地域环着色
  _regionColor(r) {
    const pkey = (r.platforms && r.platforms[0] && r.platforms[0][0]) || 'weibo';
    return PLATFORM_COLOR[pkey] || '#22D3EE';
  }

  _disposeGroup(g) {
    if (!g) return;
    g.traverse((o) => {
      if (o.geometry) o.geometry.dispose();
      if (o.material) o.material.dispose();
    });
  }

  // 用后端实时聚合的地域数据重建地球热点信标：地图上只显示标注点，文字移入点击弹窗
  updateHotspots(regions) {
    if (!this.earth || !THREE) return;
    if (this.dynamic) { this.earth.remove(this.dynamic); this._disposeGroup(this.dynamic); }
    const group = new THREE.Group();
    this.regionMeshes = {};

    // 按热度排序并限制总数，从源头减少视觉拥挤
    this._regions = (regions || [])
      .filter((r) => r && r.lat != null && r.lon != null)
      .sort((a, b) => (b.count || 0) - (a.count || 0))
      .slice(0, 12);
    const max = Math.max(1, ...this._regions.map((r) => r.count));

    this._regions.forEach((r) => {
      const pos = latLonToVec3(r.lat, r.lon, 1.02);
      const intensity = Math.min(1, r.count / max);
      // 静态纯色小球半径：无环、无光晕，只做极轻微大小区分
      const size = 0.006 + intensity * 0.003;
      const colorHex = this._regionColor(r);
      const beacon = this._createBeacon(group, pos, colorHex, size, 0.55 + intensity * 0.45, r.region);
      if (beacon) {
        beacon.phase = Math.random() * 6.28;
        beacon.data = r;
        this.regionMeshes[r.region] = beacon;
      }
    });
    this.dynamic = group;
    this.earth.add(group);
    if (this.highlight) this.highlightRegion(this.highlight);
  }

  highlightRegion(region) {
    this.highlight = region || '';
  }

  // 取最近的「正面可见」地域命中：过滤掉被地球本体遮挡的背面标记（防穿透地球误点）
  _firstVisibleRegionHit(hits) {
    if (!this.camera) return null;
    const camPos = this.camera.position;
    for (const h of hits) {
      if (!h.object.userData || !h.object.userData.region) continue;
      // 命中点法向（地球位于原点，从球心指向命中点即朝外的法向）
      const normal = h.point.clone().normalize();
      // 视线方向：从命中点指向相机
      const viewDir = camPos.clone().sub(h.point).normalize();
      // 法向与视线同向（都朝外）即正面可见；允许接近 limb 的微小夹角
      if (normal.dot(viewDir) > -0.08) return h;
    }
    return null;
  }

  // 兜底拾取：若没直接命中标记命中体，则取射线在地球表面的落点，找最近的地域标记
  _pickNearestRegionFromSurface(ray) {
    if (!this.earth || !this._regions) return '';
    const earthHits = ray.intersectObject(this.earth, false);
    if (!earthHits.length) return '';
    const p = earthHits[0].point.clone().normalize();
    let best = null, bestDot = -1;
    for (const r of this._regions) {
      if (r.lat == null || r.lon == null) continue;
      const rp = latLonToVec3(r.lat, r.lon, 1).normalize();
      const d = p.dot(rp);
      if (d > bestDot) { bestDot = d; best = r; }
    }
    // 只有在 10° 以内（cos 10°≈0.985）才认为点中了附近的热点，避免空白处误触
    if (best && bestDot > 0.985) return best.region;
    return '';
  }

  // 射线拾取：优先命中标记命中体；未命中时兜底到地球表面最近地域
  _pickRegion(e) {
    if (!this.dynamic || !this.raycaster || !THREE) return;
    const rect = this.canvas.getBoundingClientRect();
    const ndc = new THREE.Vector2(
      ((e.clientX - rect.left) / rect.width) * 2 - 1,
      -((e.clientY - rect.top) / rect.height) * 2 + 1,
    );
    this.raycaster.setFromCamera(ndc, this.camera);
    const pickTargets = [
      ...(this.dynamic ? this.dynamic.children : []),
      ...(this.ambient ? this.ambient.children : []),
    ];
    const hits = this.raycaster.intersectObjects(pickTargets, false);
    const hit = this._firstVisibleRegionHit(hits);
    const region = hit ? hit.object.userData.region : this._pickNearestRegionFromSurface(this.raycaster);
    if (region) this._flashBeacon(region);
    if (this.onRegionPick) this.onRegionPick(region);
  }

  _flashBeacon(region) {
    const m = this.regionMeshes[region];
    if (!m) return;
    const t0 = performance.now();
    const animate = () => {
      const p = Math.min(1, (performance.now() - t0) / 320);
      const boost = 1 + 0.7 * Math.sin(p * Math.PI);
      if (m.isPulse) {
        if (m.dot) m.dot.scale.setScalar((m.dotBase || 0.02) * boost);
        if (m.ring) m.ring.scale.setScalar((m.ringBase || 0.04) * boost);
        (m.waves || []).forEach((w) => { w.sprite.scale.setScalar((m.waveBase || 0.04) * boost); });
      } else {
        if (m.ring) m.ring.scale.setScalar(boost);
        if (m.dot) m.dot.scale.setScalar(boost);
        if (m.core) m.core.scale.setScalar(boost);
      }
      if (p < 1) requestAnimationFrame(animate);
    };
    animate();
  }

  // hover 检测：命中地域环时显示 tooltip
  _updateHover(p) {
    if (!this.dynamic || !this.raycaster || !THREE || this.isDragging) { hideEarthTooltip(); this.canvas.style.cursor = 'grab'; return; }
    // hover 射线检测节流：每 40ms 最多一次，降低高刷新率下的 GPU/CPU 开销
    const now = performance.now();
    if (now - (this._lastHover || 0) < 40) return;
    this._lastHover = now;
    const rect = this.canvas.getBoundingClientRect();
    const x = p.clientX - rect.left, y = p.clientY - rect.top;
    if (x < 0 || y < 0 || x > rect.width || y > rect.height) { hideEarthTooltip(); this.canvas.style.cursor = 'grab'; return; }
    const ndc = new THREE.Vector2((x / rect.width) * 2 - 1, -(y / rect.height) * 2 + 1);
    this.raycaster.setFromCamera(ndc, this.camera);
    const hoverTargets = [
      ...(this.dynamic ? this.dynamic.children : []),
      ...(this.ambient ? this.ambient.children : []),
    ];
    const hits = this.raycaster.intersectObjects(hoverTargets, false);
    const hit = this._firstVisibleRegionHit(hits);
    const region = hit ? hit.object.userData.region : this._pickNearestRegionFromSurface(this.raycaster);
    if (!region) { hideEarthTooltip(); this.hoverRegion = ''; this.canvas.style.cursor = 'crosshair'; return; }
    const r = (this._regions || []).find((x) => x.region === region);
    showEarthTooltip(p.clientX, p.clientY, region, r?.count || 0);
    this.hoverRegion = region;            // 光标悬停的地域 → 该标记随光标放大变亮
    this.canvas.style.cursor = 'crosshair';
  }

  _bindEvents() {
    const c = this.canvas;
    const onDown = (e) => { this.isDragging = true; const p = e.touches ? e.touches[0] : e; this.prevMouse = { x: p.clientX, y: p.clientY }; this._downPos = { x: p.clientX, y: p.clientY }; this.velX = 0; this.velY = 0; hideEarthTooltip(); };
    const onMove = (e) => {
      const p = e.touches ? e.touches[0] : e;
      if (!this.isDragging) { this._updateHover(p); return; }
      e.preventDefault();
      const dx = p.clientX - this.prevMouse.x, dy = p.clientY - this.prevMouse.y;
      this.velY = dx * 0.003; this.velX = dy * 0.003;
      this.rotY += this.velY; this.rotX += this.velX;
      this.rotX = Math.max(-Math.PI / 2.2, Math.min(Math.PI / 2.2, this.rotX));
      this.prevMouse = { x: p.clientX, y: p.clientY };
    };
    const onUp = () => { this.isDragging = false; this.canvas.style.cursor = 'crosshair'; };
    const onLeave = () => { this.isDragging = false; hideEarthTooltip(); this.hoverRegion = ''; this.canvas.style.cursor = 'crosshair'; };
    const onClick = (e) => {
      if (!this._downPos) return;
      const moved = Math.hypot(e.clientX - this._downPos.x, e.clientY - this._downPos.y);
      this._downPos = null;
      if (moved > 6) return;            // 拖拽距离过大 → 视为旋转，不触发点击
      this._pickRegion(e);
    };
    const onWheel = (e) => { e.preventDefault(); this.camDist += e.deltaY * 0.002; this.camDist = Math.max(this.camDistMin, Math.min(this.camDistMax, this.camDist)); };
    c.style.cursor = 'crosshair';
    c.addEventListener('mousedown', onDown);
    c.addEventListener('mousemove', onMove);
    c.addEventListener('mouseup', onUp);
    c.addEventListener('mouseleave', onLeave);
    c.addEventListener('click', onClick);
    c.addEventListener('touchstart', onDown, { passive: true });
    c.addEventListener('touchmove', onMove, { passive: false });
    c.addEventListener('touchend', onUp);
    c.addEventListener('wheel', onWheel, { passive: false });
    this._bound = { onDown, onMove, onUp, onLeave, onWheel, onClick };
  }

  triggerAppear() {
    console.log('[HotspotEarth] triggerAppear called. appearing=', this.appearing, 'scale=', this.earth?.scale.x);
    if (this.appearing) {
      setEarthStatus('出场动画已在进行中...', 'info');
      return;
    }
    // 如果已经显示完成，不再重置
    if (this.earth && this.earth.scale.x > 0.99) {
      setEarthStatus('地球已显示', 'success');
      setTimeout(hideEarthStatus, 400);
      return;
    }
    this.appearing = true; this.appearScale = 0;
    if (this.earth) this.earth.scale.setScalar(0);
    if (this.clouds) this.clouds.scale.setScalar(0);
    if (this.atmo) this.atmo.scale.setScalar(0);
    if (this.atmo2) this.atmo2.scale.setScalar(0);
    if (this.stars) this.stars.material.opacity = 0;
    setEarthStatus('正在显示地球...', 'info');
    // 安全兜底：3 秒后若出场动画仍未完成，强制归位，防止渲染卡死时白屏
    if (this._appearTimer) clearTimeout(this._appearTimer);
    this._appearTimer = setTimeout(() => {
      if (!this.appearing) return;
      console.warn('[HotspotEarth] appear animation safety timeout');
      setEarthStatus('出场动画超时，已强制显示地球', 'warn');
      this.appearing = false; this.appearScale = 1;
      if (this.earth) this.earth.scale.setScalar(1);
      if (this.clouds) this.clouds.scale.setScalar(1);
      if (this.atmo) this.atmo.scale.setScalar(1);
      if (this.atmo2) this.atmo2.scale.setScalar(1);
      if (this.stars) this.stars.material.opacity = 1;
    }, 3000);
  }

  _animate() {
    this.animFrame = requestAnimationFrame(() => this._animate());
    if (this.appearing) {
      this.appearScale += (1 - this.appearScale) * 0.07;
      const s = this.appearScale;
      if (this.earth) this.earth.scale.setScalar(s);
      if (this.clouds) this.clouds.scale.setScalar(s);
      if (this.atmo) this.atmo.scale.setScalar(s);
      if (this.atmo2) this.atmo2.scale.setScalar(s);
      if (this.stars) this.stars.material.opacity = Math.min(1, s * 1.5);
      // 每 10 帧刷新一次状态面板，避免 DOM 操作过频
      if (Math.round(s * 100) % 10 === 0) {
        setEarthStatus(`地球出场中... scale=${s.toFixed(2)}`, 'info');
      }
      if (s > 0.999) {
        this.appearing = false;
        if (this._appearTimer) { clearTimeout(this._appearTimer); this._appearTimer = null; }
        if (this.earth) this.earth.scale.setScalar(1);
        if (this.clouds) this.clouds.scale.setScalar(1);
        if (this.atmo) this.atmo.scale.setScalar(1);
        if (this.atmo2) this.atmo2.scale.setScalar(1);
        if (this.stars) this.stars.material.opacity = 1;
        setTimeout(hideEarthStatus, 400);
      }
    }
    if (!this.isDragging) {
      this.velX *= 0.92; this.velY *= 0.92;
      this.rotX += this.velX; this.rotY += this.velY + 0.0018;
      this.rotX = Math.max(-Math.PI / 2.2, Math.min(Math.PI / 2.2, this.rotX));
    }
    if (this.earth) { this.earth.rotation.x = this.rotX; this.earth.rotation.y = this.rotY; }
    if (this.clouds) { this.clouds.rotation.x = this.rotX; this.clouds.rotation.y = this.rotY + performance.now() * 0.000008; }
    const curr = this.camera.position.length();
    const next = curr + (this.camDist - curr) * 0.1;
    this.camera.position.setLength(next);
    // 真实地域信标：柔和脉冲 + 高亮放大
    if (this.dynamic) {
      const t = performance.now() * 0.0025;
      for (const region in this.regionMeshes) {
        const m = this.regionMeshes[region];
        const isHi = region === this.highlight;
        const isHover = region === this.hoverRegion;
        const pulse = 0.65 + 0.35 * Math.sin(t + m.phase);
        const boost = isHi ? 1.35 : (isHover ? 1.55 : 1);
        if (m.isPulse) {
          // 脉冲环风格：中心点 + 内环呼吸 + 外环持续向外扩散
          if (m.dotMat) m.dotMat.opacity = isHover || isHi ? 1 : 0.9;
          if (m.dot) m.dot.scale.setScalar(boost * m.baseSize * 1.1);
          if (m.ringMat) m.ringMat.opacity = ((isHi || isHover ? 0.85 : 0.55) * pulse) + (isHi || isHover ? 0.1 : 0);
          if (m.ring) m.ring.scale.setScalar(boost * m.baseSize * 1.7 * (0.95 + 0.05 * pulse));
          const waveBase = m.baseSize * 1.5;
          const cycle = Math.PI * 2;
          (m.waves || []).forEach((w) => {
            const localT = (t + m.phase + w.phaseOffset) % cycle;
            const p = localT / cycle;
            w.sprite.scale.setScalar(waveBase * (1 + p * 2.0));
            w.mat.opacity = (0.55 * (1 - p) + 0.05) * m.intensity * (isHi || isHover ? 1.3 : 1);
          });
        } else if (m.isBeam) {
          // 光柱风格：柱体呼吸 + 底部光环脉冲 + 顶部光球随高亮放大
          m.pillarMat.opacity = ((isHi || isHover ? 0.8 : 0.5) * pulse) + (isHi || isHover ? 0.15 : 0);
          m.ringMat.opacity = ((isHi || isHover ? 0.95 : 0.55) * pulse) + (isHi || isHover ? 0.15 : 0);
          const s = boost * (1 + 0.12 * Math.sin(t * 1.2 + m.phase));
          m.ring.scale.setScalar(s);
          m.dot.scale.setScalar(boost);
          m.dotMat.opacity = isHover || isHi ? 1 : 0.9;
        } else {
          // 静态小圆点：无光晕、无呼吸、无持续动画
        }
      }
    }
    this._checkResize();
    this.renderer.render(this.scene, this.camera);
  }

  _checkResize() {
    const c = this.canvas, w = c.clientWidth, h = c.clientHeight;
    if (!w || !h) return;
    const dpr = this.renderer.getPixelRatio();
    if (c.width !== Math.round(w * dpr) || c.height !== Math.round(h * dpr)) {
      this.renderer.setSize(w, h, false);
      this.camera.aspect = w / h;
      this.camera.updateProjectionMatrix();
    }
  }

  pause() {
    if (this.animFrame) { cancelAnimationFrame(this.animFrame); this.animFrame = null; }
    if (this._appearTimer) { clearTimeout(this._appearTimer); this._appearTimer = null; }
  }
  resume() {
    if (pendingRegions && this.updateHotspots) { this.updateHotspots(pendingRegions); pendingRegions = null; }
    if (!this.animFrame && this.renderer) this._animate();
  }
  dispose() {
    this.disposed = true;
    if (this._appearTimer) clearTimeout(this._appearTimer);
    if (this._onContextLost) this.canvas?.removeEventListener('webglcontextlost', this._onContextLost);
    if (this.animFrame) cancelAnimationFrame(this.animFrame);
    const c = this.canvas, b = this._bound;
    if (b.onDown) c.removeEventListener('mousedown', b.onDown);
    if (b.onMove) c.removeEventListener('mousemove', b.onMove);
    if (b.onUp) c.removeEventListener('mouseup', b.onUp);
    if (b.onLeave) c.removeEventListener('mouseleave', b.onLeave);
    if (b.onDown) c.removeEventListener('touchstart', b.onDown);
    if (b.onMove) c.removeEventListener('touchmove', b.onMove);
    if (b.onUp) c.removeEventListener('touchend', b.onUp);
    if (b.onWheel) c.removeEventListener('wheel', b.onWheel);
    if (b.onClick) c.removeEventListener('click', b.onClick);
    this._disposeGroup(this.dynamic);
    this._disposeGroup(this.ambient);
    [this.stars, this.atmo, this.atmo2].forEach((o) => {
      if (!o) return;
      if (o.geometry) o.geometry.dispose();
      if (o.material) o.material.dispose();
    });
    this.dynamic = null; this.ambient = null; this.regionMeshes = {};
    this.stars = null; this.atmo = null; this.atmo2 = null;
    this.renderer?.dispose();
    this.renderer = null;
  }
}

// ── 暴露热点面板桥：供 app.js 通过 zhuangzhou_event 打开全屏热点模式 ──
window.ZZHotspot = {
  open: () => setHotspotMode(true),
  close: () => setHotspotMode(false),
  toggle: toggleHotspot,
};

// 自启动（module 在 DOM 解析完成后执行）
initHotspot();
