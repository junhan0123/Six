const TREND_ICONS = { up:'↑', down:'↓', same:'—' };
const TREND_CLASSES = { up:'hs-trend-up', down:'hs-trend-dn', same:'hs-trend-same' };

function renderList(listId, items, style = 'heat', platform = '', config = {}) {
  const ul = $(listId);
  if (!ul) return;
  if (!items.length) {
    ul.innerHTML = `<li class="hs-item hs-item-empty">
      <span class="hs-rank">--</span>
      <span class="hs-item-text">实时源未配置或暂不可用</span>
      <span class="hs-heat">--</span>
      <span class="hs-trend hs-trend-same">—</span>
    </li>`;
    return;
  }
  ul.innerHTML = items.map(({ rank, text, heat, trend, isNew, url }) => {
    const rankCls = rank <= 3 ? `hs-rank-top${rank}` : '';
    const trendIcon = TREND_ICONS[trend] || '';
    const trendCls = TREND_CLASSES[trend] || '';
    const newBadge = isNew ? '<span class="hs-new-badge">新</span>' : '';
    const heatLabel = style === 'heat'
      ? `<span class="hs-heat">${heat}</span>`
      : `<span class="hs-label-badge">${heat}</span>`;
    const clickable = url ? ' hs-item-clickable' : '';
    return `<li class="hs-item${clickable}" data-url="${url ? encodeURI(url) : ''}">
      <span class="hs-rank ${rankCls}">${rank}</span>
      <span class="hs-item-text">${text}${newBadge}</span>
      ${heatLabel}
      <span class="hs-trend ${trendCls}">${trendIcon}</span>
    </li>`;
  }).join('');
  // 点击条目 -> 弹出详情卡片（有外链则在卡片内「查看原文」）
  ul.querySelectorAll('.hs-item').forEach((li, i) => {
    const item = items[i];
    if (!item) return;
    li.style.cursor = 'pointer';
    li.addEventListener('click', () => {
      const statusSrc = (hotspotMeta.status && hotspotMeta.status[platform] && hotspotMeta.status[platform].source) || '';
      const data = {
        platform,
        platformLabel: config.label,
        color: CAT_COLORS[config.label] || '#8fb6d8',
        rank: item.rank,
        text: item.text,
        heat: item.heat,
        trend: item.trend,
        url: item.url || '',
        source: statusSrc,
      };
      if (window.ZZModal && window.ZZModal.openHotspot) {
        window.ZZModal.openHotspot(data);
      } else if (item.url) {
        window.open(item.url, '_blank', 'noopener');
      }
    });
  });
}

function renderAllLists() {
  for (const [platform, config] of Object.entries(PLATFORM_CONFIG)) {
    renderList(config.listId, hotspotLists[platform] || [], config.style, platform, config);
  }
}

function formatFetchedAt(value) {
  if (!value) return '未知';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '未知';
  const pad = (n) => String(n).padStart(2, '0');
  return `${pad(date.getHours())}:${pad(date.getMinutes())}`;
}

function normalizeHotspotItem(item, idx) {
  return {
    rank: Number(item?.rank || idx + 1),
    text: item?.text || '',
    heat: item?.heat || '',
    trend: item?.trend || 'same',
    isNew: !!item?.isNew,
    url: item?.url || '',
    region: item?.region || '',
    lat: item?.lat ?? null,
    lon: item?.lon ?? null,
  };
}

function setText(id, text) {
  const el = $(id);
  if (el) el.textContent = text;
}

function updateHotspotMeta() {
  let total = 0, hot = 0, alert = 0;
  const RISK = ['地震', '台风', '火灾', '爆炸', '事故', '疫情', '制裁', '冲突', '暴跌', '预警', '坍塌', '暴雨', '洪水', '通报'];
  for (const [platform, config] of Object.entries(PLATFORM_CONFIG)) {
    const items = hotspotLists[platform] || [];
    const status = hotspotMeta.status?.[platform] || {};
    total += items.length;
    items.forEach((it, i) => {
      if (i < 3) hot++;
      if (RISK.some(k => (it.text || '').includes(k))) alert++;
    });
    const source = status.ok
      ? `${status.source || '实时'}${hotspotMeta.stale ? '缓存' : '数据'}`
      : '未配置';
    setText(config.updateId, `${source} · ${formatFetchedAt(hotspotMeta.fetchedAt)}`);
  }
  setText('hs-stat-data', String(total));
  setText('hs-stat-data-delta', `四平台热榜 / ${REFRESH_INTERVAL_MINUTES} 分钟刷新`);
  setText('hs-stat-hot', String(hot));
  setText('hs-stat-hot-delta', `各平台 Top3 高热条目`);
  setText('hs-stat-alert', String(alert));
  setText('hs-stat-alert-delta', alert ? `含风险关键词事件` : `暂未发现风险事件`);
  const ai = Math.min(99, 82 + Math.round(total / 20));
  setText('hs-stat-ai', ai + '%');
  const isStale = isDataStale();
  setText('hs-stat-ai-delta', isStale ? '数据已陈旧，请手动刷新' : '模型状态：稳定');
  // 顶部陈旧提示条
  const staleBar = $('hs-stale-bar');
  if (staleBar) staleBar.style.display = isStale ? 'flex' : 'none';
}

function isDataStale() {
  if (!hotspotMeta.fetchedAt) return true;
  const fetched = new Date(hotspotMeta.fetchedAt).getTime();
  if (Number.isNaN(fetched)) return true;
  return (Date.now() - fetched) > STALE_WARNING_MINUTES * 60 * 1000;
}

async function refreshHotspots({ force = false } = {}) {
  try {
    const params = new URLSearchParams();
    if (force) params.set('refresh', '1');
    if (hotspotActive) params.set('viewed', '1');
    const query = params.toString();
    const res = await fetch('/api/hotspots' + (query ? `?${query}` : ''));
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();
    for (const platform of Object.keys(PLATFORM_CONFIG)) {
      const list = data?.platforms?.[platform] || [];
      hotspotLists[platform] = Array.isArray(list)
        ? list.slice(0, 14).map(normalizeHotspotItem).filter(item => item.text).slice(0, 10)
        : [];
    }
    hotspotMeta = {
      source: 'hotspot-api',
      fetchedAt: data.fetchedAt,
      stale: !!data.stale,
      refreshMinutes: REFRESH_INTERVAL_MINUTES,
      status: data.status || {},
    };
    renderAllLists();
    renderFeed();
    renderTicker();
    updateHotspotMeta();
    // 地域联动：把后端实时聚合的地域分布渲染成可点击列表，并驱动 3D 地球热点环
    geoRegions = data?.geo?.regions || [];
    renderRegionList();
    if (earth && earth.updateHotspots) earth.updateHotspots(geoRegions);
    else pendingRegions = geoRegions;   // 地球还在初始化，先缓存，ensure 完成后 flush
  } catch (err) {
    hotspotMeta = { ...hotspotMeta, stale: true };
    updateHotspotMeta();
    console.warn('[Hotspot] 热榜刷新失败:', err.message);
  }
}

function startHotspotRefresh() {
  if (hotspotRefreshTimer) clearInterval(hotspotRefreshTimer);
  hotspotRefreshTimer = setInterval(() => { refreshHotspots().catch(() => {}); },
    REFRESH_INTERVAL_MINUTES * 60 * 1000);
}
function stopHotspotRefresh() {
  if (hotspotRefreshTimer) clearInterval(hotspotRefreshTimer);
  hotspotRefreshTimer = null;
}

// ── 实时事件流（用真实热榜 Top 条目生成，避免硬编码旧数据）──
const CAT_COLORS = {
  '抖音':'#ff0050', '小红书':'#ff2442', '微信':'#07c160', '微博':'#e6162d',
  '自然灾害':'#e05c5c', '科技':'#5c9ee0', '财经':'#c97d30',
  '体育':'#4eaa6e', '社会':'#9b6bc4', '政策':'#6bbfbf', '旅游':'#c4a030',
};

// 平台主色（用于 3D 地球真实地域环着色）
const PLATFORM_COLOR = {
  douyin: '#ff0050', xiaohongshu: '#ff2442', wechat: '#07c160', weibo: '#e6162d',
};

function buildFeedFromHotspots() {
  // 未筛选：各平台取前 2 条混合（原行为）
  if (!regionFilter) {
    const top = [];
    for (const [key, cfg] of Object.entries(PLATFORM_CONFIG)) {
      (hotspotLists[key] || []).slice(0, 2).forEach((it) => {
        top.push({ ...it, platform: key, platformLabel: cfg.label });
      });
    }
    top.sort((a, b) => (a.rank || 99) - (b.rank || 99));
    return top.slice(0, 8);
  }
  // 已筛选某地域：跨平台聚合该地域全部条目，按 rank 排序
  const all = [];
  for (const [key, cfg] of Object.entries(PLATFORM_CONFIG)) {
    (hotspotLists[key] || []).forEach((it) => {
      if (it.region === regionFilter) all.push({ ...it, platform: key, platformLabel: cfg.label });
    });
  }
  all.sort((a, b) => (a.rank || 99) - (b.rank || 99));
  return all.slice(0, 10);
}

// ── 区域关注度（真实地域，可点击筛选事件流 + 高亮地球环）──
function renderRegionList() {
  const el = $('hs-region-list');
  if (!el) return;
  if (!geoRegions.length) {
    el.innerHTML = `<div class="hs-region-row hs-region-empty">暂无地域分布数据</div>`;
    return;
  }
  const max = Math.max(1, ...geoRegions.map((r) => r.count));
  el.innerHTML = geoRegions.slice(0, 8).map((r) => {
    const pct = Math.round((100 * r.count) / max);
    const active = regionFilter === r.region ? ' active' : '';
    const plats = (r.platforms || []).map(([p]) => PLATFORM_CONFIG[p]?.label || p).join(' · ');
    return `<div class="hs-region-row${active}" data-region="${r.region}" role="button" tabindex="0" title="点击筛选「${r.region}」相关热点">
      <span class="hs-region-name">${r.region}<span class="hs-region-plats">${plats}</span></span>
      <div class="hs-bar-track"><div class="hs-bar-fill" style="width:${pct}%"></div></div>
      <span class="hs-region-pct">${r.count}</span>
    </div>`;
  }).join('');
  el.querySelectorAll('.hs-region-row[data-region]').forEach((row) => {
    const toggle = () => {
      const reg = row.getAttribute('data-region');
      regionFilter = regionFilter === reg ? '' : reg;
      renderRegionList();
      renderFeed();
      renderTicker();
      earth?.highlightRegion(regionFilter);
      hsChatRenderContext();
    };
    row.addEventListener('click', toggle);
    row.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
    });
  });
}

// 为地球骨架点（城市名）构建虚拟地域对象：从各平台热榜中匹配含该城市的条目
function buildVirtualRegion(city) {
  const all = [];
  for (const [key, cfg] of Object.entries(PLATFORM_CONFIG)) {
    (hotspotLists[key] || []).forEach((it) => {
      if ((it.region || '').includes(city) || (it.text || '').includes(city)) {
        all.push({ ...it, platform: key });
      }
    });
  }
  all.sort((a, b) => (a.rank || 99) - (b.rank || 99));
  return {
    region: city,
    count: all.length,
    platforms: [],
    top: all.slice(0, 5).map((it) => ({
      platform: it.platform,
      text: it.text,
      url: it.url || '',
    })),
  };
}

// ── 地球红点点击 → 选中地域（与列表同语义）+ 弹该地域 Top 热搜浮层 ──
function handleEarthRegionPick(region) {
  if (!region) { closeRegionPopup(); return; }
  regionFilter = regionFilter === region ? '' : region;   // 再点同一点 = 取消
  renderRegionList();
  renderFeed();
  renderTicker();
  earth?.highlightRegion(regionFilter);
  hsChatRenderContext();
  if (regionFilter) {
    const r = geoRegions.find((x) => x.region === region) || buildVirtualRegion(region);
    showRegionPopup(regionFilter, r);
  } else {
    closeRegionPopup();
  }
}

function showRegionPopup(region, r = null) {
  const popup = $('hs-region-popup');
  if (!popup) return;
  if (!r) r = geoRegions.find((x) => x.region === region);
  if (!r) { closeRegionPopup(); return; }
  $('hs-rp-title').textContent = `${r.region} · 共 ${r.count} 条`;
  const top = (r.top || []).slice(0, 5);
  $('hs-rp-body').innerHTML = top.length
    ? top.map((it, i) => {
        const cfg = PLATFORM_CONFIG[it.platform] || {};
        const label = cfg.label || it.platform;
        const color = PLATFORM_COLOR[it.platform] || '#22D3EE';
        const hasUrl = !!it.url;
        const clickable = hasUrl ? `<a class="hs-rp-item" href="${it.url}" target="_blank" rel="noopener" title="${it.text}">` : `<div class="hs-rp-item hs-rp-item-disabled" title="暂无原文链接">`;
        const closer = hasUrl ? '</a>' : '</div>';
        return `${clickable}
          <span class="hs-rp-rank">${i + 1}</span>
          <span class="hs-rp-plat" style="color:${color}">${label}</span>
          <span class="hs-rp-text">${it.text}</span>
        ${closer}`;
      }).join('')
    : '<div class="hs-rp-empty">该地域暂无 Top 热搜条目</div>';
  popup.hidden = false;
  if (window.OverlayManager) window.OverlayManager.track('hotspot-region', {
    el: popup, onClose: closeRegionPopup, type: window.OverlayManager.OverlayType.DIALOG,
    trap: false, autofocus: false
  });
}

function closeRegionPopup() {
  if (window.OverlayManager) window.OverlayManager.untrack('hotspot-region');
  const popup = $('hs-region-popup');
  if (popup) popup.hidden = true;
}

function renderFeed() {
  const track = $('hs-feed-track');
  if (!track) return;
  const items = buildFeedFromHotspots();
  if (!items.length) {
    track.innerHTML = `<div class="hs-feed-card"><div class="hs-feed-title">暂无实时数据</div><div class="hs-feed-desc">进入热点模式后将自动刷新。</div></div>`;
    return;
  }
  track.innerHTML = items.map((item) => {
    const color = CAT_COLORS[item.platformLabel] || '#8fb6d8';
    const time = formatFetchedAt(hotspotMeta.fetchedAt);
    return `<div class="hs-feed-card">
      <div class="hs-feed-card-top">
        <span class="hs-feed-time">${time}</span>
        <span class="hs-feed-cat" style="background:${color}22;color:${color};border-color:${color}44">${item.platformLabel}</span>
      </div>
      <div class="hs-feed-title">${item.text}</div>
      <div class="hs-feed-desc">热度 ${item.heat || '—'} · 排名 ${item.rank}</div>
      <div class="hs-feed-loc"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-flame"/></svg> ${item.platformLabel}热搜${item.region ? ` · ${item.region}` : ''}</div>
    </div>`;
  }).join('');
}

function scrollFeedTo(idx) {
  const track = $('hs-feed-track');
  const viewport = $('hs-feed-viewport');
  if (!track || !viewport) return;
  const cards = track.querySelectorAll('.hs-feed-card');
  if (!cards.length) return;
  feedIndex = ((idx % cards.length) + cards.length) % cards.length;
  const cardW = cards[0].offsetWidth + 12;
  const maxScroll = track.scrollWidth - viewport.offsetWidth;
  const target = Math.min(feedIndex * cardW, maxScroll);
  viewport.scrollTo({ left: target, behavior: 'smooth' });
}

function startFeedAuto() {
  if (feedAutoTimer) clearInterval(feedAutoTimer);
  feedAutoTimer = setInterval(() => { scrollFeedTo(feedIndex + 1); }, 4000);
}
function stopFeedAuto() {
  if (feedAutoTimer) clearInterval(feedAutoTimer);
  feedAutoTimer = null;
}

// ── 底部跑马灯（用真实热榜条目生成）──
function buildTickerFromHotspots() {
  // 每个平台取 Top1 作为跑马灯内容
  const all = [];
  for (const [key, cfg] of Object.entries(PLATFORM_CONFIG)) {
    const it = (hotspotLists[key] || [])[0];
    if (it) all.push({ time: cfg.label, text: it.text });
  }
  return all.length ? all : [{ time: '实时', text: '热点数据加载中…' }];
}

function renderTicker() {
  const el = $('hs-ticker-inner');
  if (!el) return;
  const items = buildTickerFromHotspots();
  const html = items.map(({ time, text }) =>
    `<span class="hs-ticker-item"><span class="hs-ticker-time">${time}</span>${text}</span>`
  ).join('<span class="hs-ticker-sep">●</span>');
  el.innerHTML = html + '<span class="hs-ticker-sep">●</span>' + html;
}

// ── 朗读摘要：把当前各平台 Top3 拼成一段口语化文本 ──
function buildTtsSummary() {
  const parts = [];
  for (const [key, cfg] of Object.entries(PLATFORM_CONFIG)) {
    const items = (hotspotLists[key] || []).slice(0, 3);
    if (!items.length) continue;
    const list = items.map((it, i) => `第${i + 1}，${it.text || ''}`).join('；');
    parts.push(`${cfg.label}热榜：${list}`);
  }
  return parts.length ? ('以下是当前实时热点。' + parts.join('。') + '。') : '当前暂无热点数据。';
}

// ── 实时时钟 ──
function updateClock() {
  const el = $('hs-clock');
  if (!el) return;
  const now = new Date();
  const pad = (n) => String(n).padStart(2, '0');
  el.textContent = `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
}
function startClock() { updateClock(); if (clockTimer) clearInterval(clockTimer); clockTimer = setInterval(updateClock, 1000); }
function stopClock() { if (clockTimer) clearInterval(clockTimer); clockTimer = null; }

function _onScanDone(e) {
  if (e && e.animationName !== 'hs-scan') return;
  const panel = $('hotspot-panel');
  if (panel) panel.classList.remove('hs-booting');
  if (bootTimer) { clearTimeout(bootTimer); bootTimer = null; }
}

function replayHotspotBoot() {
  const panel = $('hotspot-panel');
  if (!panel) return;
  if (bootTimer) { clearTimeout(bootTimer); bootTimer = null; }
  panel.classList.remove('hs-booting');
  const scanline = panel.querySelector('.hs-scanline');
  if (scanline) {
    scanline.removeEventListener('animationend', _onScanDone);
    scanline.addEventListener('animationend', _onScanDone, { once: true });
  }
  void panel.offsetWidth;
  panel.classList.add('hs-booting');
  // 兜底：即使 animationend 未触发，2.6s 后强制移除开场类，防止扫描线残留
  bootTimer = setTimeout(() => {
    bootTimer = null;
    _onScanDone(null);
  }, 2600);
}

// ── 模式切换 ──
function setPanelVisible(visible) {
  hotspotActive = visible;
  document.body.classList.toggle('hotspot-mode', visible);
  if (!visible) {
    $('hotspot-panel')?.classList.remove('hs-booting');
    if (bootTimer) { clearTimeout(bootTimer); bootTimer = null; }
  }
  const btn = document.getElementById('hsOpenBtn');
  if (btn) btn.classList.toggle('active', visible);
  window.dispatchEvent(new CustomEvent('zhuangzhou:hotspot-mode', { detail: { active: visible } }));
}

export function setHotspotMode(visible) {
  const next = !!visible;
  if (hotspotActive === next) return;
  if (!next) {
    if (window.OverlayManager) { window.OverlayManager.untrack('hotspot'); window.OverlayManager.untrack('hotspot-region'); }
    setPanelVisible(false);
    stopClock(); stopFeedAuto(); stopHotspotRefresh();
    earth?.pause();
  } else {
    setPanelVisible(true);
    if (window.OverlayManager) {
      var hsOverlayEl = $('hs-overlay');
      if (hsOverlayEl) window.OverlayManager.track('hotspot', {
        el: hsOverlayEl,
        onClose: function () { setHotspotMode(false); },
        type: window.OverlayManager.OverlayType.PANEL,
        trap: false,
        autofocus: false
      });
    }
    replayHotspotBoot();
    startClock(); startFeedAuto(); startHotspotRefresh();
    refreshHotspots({ force: true }).catch(() => {});  // 进入热点模式强制刷新
    ensureEarth().then((e) => {
      console.log('[HotspotEarth] ensureEarth resolved, e=', !!e, 'hotspotActive=', hotspotActive);
      if (!e) { setEarthStatus('地球实例未创建', 'error'); return; }
      if (!hotspotActive) { console.log('[HotspotEarth] paused because hotspotActive=false'); e.pause(); return; }
      e.resume();
      e.updateHotspots(pendingRegions || geoRegions);
      pendingRegions = null;
      console.log('[HotspotEarth] calling triggerAppear');
      setEarthStatus('正在请求出场动画...', 'info');
      requestAnimationFrame(() => e.triggerAppear());
    }).catch((err) => {
      console.error('[HotspotEarth] ensureEarth rejected:', err);
      setEarthStatus('地球初始化异常：' + (err.message || String(err)), 'error');
    });
  }
}

export function toggleHotspot() { setHotspotMode(!hotspotActive); }

// ── 初始化 ──
function ensurePanel() {
  if ($('hs-overlay')) return;
  document.body.insertAdjacentHTML('beforeend',
    `<div class="hs-overlay" id="hs-overlay"><div class="hs-scale-stage" id="hs-scale-stage">${PANEL_HTML}</div></div>`);
}

// 数据大屏等比缩放：以 1920×1080 为设计稿，按窗口短边比例整体缩放
function updateHotspotScale() {
  const stage = $('hs-scale-stage');
  if (!stage) return;
  const designW = 1920;
  const designH = 1080;
  // 适配带留白的弹窗框：在 overlay 可视区内留出边距，使大屏像居中的弹窗而非全屏接管
  const ov = $('hs-overlay');
  const availW = (ov ? ov.clientWidth : window.innerWidth) - 56;
  const availH = (ov ? ov.clientHeight : window.innerHeight) - 56;
  const scale = Math.min(availW / designW, availH / designH);
  stage.style.transform = `scale(${scale})`;
}
window.addEventListener('resize', updateHotspotScale);

export async function initHotspot() {
  ensurePanel();
  updateHotspotScale();
  // 点击半透明遮罩层关闭热点弹窗（点击内容区不关闭）
  $('hs-overlay')?.addEventListener('click', (e) => {
    if (e.target === $('hs-overlay')) toggleHotspot();
  });
  renderAllLists();
  renderFeed();
  renderTicker();
  updateHotspotMeta();
  refreshHotspots({ force: true }).catch(() => {});  // 页面初始化即强制刷新一次

  $('hs-exit-btn')?.addEventListener('click', () => toggleHotspot());
  $('hs-refresh-btn')?.addEventListener('click', () => {
    const btn = $('hs-refresh-btn');
    btn?.classList.add('spin');
    setTimeout(() => btn?.classList.remove('spin'), 500);
    refreshHotspots({ force: true }).catch(() => {});
  });
  $('hs-tts-btn')?.addEventListener('click', () => {
    const summary = buildTtsSummary();
    if (window.ZZModal && window.ZZModal.speak) window.ZZModal.speak(summary);
  });
  $('hs-selfcheck-btn')?.addEventListener('click', () => window.open('selfcheck.html', '_blank', 'noopener'));
  $('hs-feed-prev')?.addEventListener('click', () => { stopFeedAuto(); scrollFeedTo(feedIndex - 1); });
  $('hs-feed-next')?.addEventListener('click', () => { stopFeedAuto(); scrollFeedTo(feedIndex + 1); });
  $('hsOpenBtn')?.addEventListener('click', () => toggleHotspot());
  // 右侧聊天框已移除，不再初始化热点聊天视图
  // initHotspotChat();
  // 地域弹窗关闭：显式按钮 + Esc
  $('hs-rp-close')?.addEventListener('click', () => { regionFilter = ''; renderRegionList(); renderFeed(); renderTicker(); earth?.highlightRegion(''); closeRegionPopup(); });

  document.addEventListener('visibilitychange', () => {
    if (!earth) return;
    if (document.hidden) earth.pause();
    else if (hotspotActive) earth.resume();
  });
}

/* ============================================================
   右侧聊天框：作为主页当前会话的延伸视图
   不再维护独立 HS_SESSION / hsChatMessages，全部走 window.ZZChat
   ============================================================ */
const hsMic = { rec: null, stream: null, chunks: [], recording: false, mime: '' };

function hsIsProactiveNoise(text) {
  const t = String(text || '');
  return /^\s*🌐\s*舆情扫描更新/.test(t) || /^\s*⚠️/.test(t) || /^\s*🚨/.test(t);
}
function hsChatScroll() {
  const log = $('hs-chat-log');
  if (log) log.scrollTop = log.scrollHeight;
}
function hsChatAddBubble(role, text = '') {
  const log = $('hs-chat-log');
  if (!log) return null;
  const el = document.createElement('div');
  // 主页 role 为 'zhuangzhou'，右侧样式类为 'bot'
  const clsRole = role === 'user' ? 'user' : 'bot';
  el.className = 'hs-chat-bubble hs-chat-' + clsRole;
  el.textContent = text;
  log.appendChild(el);
  return el;
}
function hsChatRender() {
  const log = $('hs-chat-log');
  const zz = window.ZZChat;
  if (!log || !zz) return;
  const msgs = (zz.getMessages() || []).filter(m => m && m.role && m.content && !hsIsProactiveNoise(m.content));
  const streaming = zz.isStreaming();
  const sendBtn = $('hs-chat-send');
  const clearBtn = $('hs-chat-clear');
  if (sendBtn) sendBtn.disabled = streaming;
  if (clearBtn) clearBtn.disabled = streaming;
  if (!msgs.length && !streaming) {
    log.innerHTML = `
      <div class="hs-chat-empty">
        <div class="hs-chat-empty-icon"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-globe"/></svg></div>
        <div class="hs-chat-empty-title">热点 + 对话</div>
        <div class="hs-chat-empty-sub">一边看全球脉搏，一边问庄周</div>
      </div>`;
    return;
  }
  log.innerHTML = '';
  for (const m of msgs) hsChatAddBubble(m.role, m.content);
  if (streaming) {
    const bubble = document.createElement('div');
    bubble.className = 'hs-chat-bubble hs-chat-bot hs-streaming';
    bubble.textContent = '';
    log.appendChild(bubble);
  }
  hsChatScroll();
}

// 渲染右侧聊天框顶部的「热点上下文」：把当前选中的地域/热点和主对话链接起来
function hsChatRenderContext() {
  const el = $('hs-chat-context');
  if (!el) return;
  if (!regionFilter) { el.innerHTML = ''; el.hidden = true; return; }
  const r = (geoRegions || []).find((x) => x.region === regionFilter);
  const count = r?.count || 0;
  const plats = (r?.platforms || []).map(([p]) => PLATFORM_CONFIG[p]?.label || p).join(' · ') || '多平台';
  el.hidden = false;
  el.innerHTML = `
    <div class="hs-ctx-chip" data-region="${escapeHtml(regionFilter)}">
      <span class="hs-ctx-dot"></span>
      <span class="hs-ctx-main">
        <span class="hs-ctx-region">${escapeHtml(regionFilter)}</span>
        <span class="hs-ctx-meta">${escapeHtml(plats)} · ${count} 条相关</span>
      </span>
      <button class="hs-ctx-ask" type="button" title="让庄周分析该地区热点">分析</button>
      <button class="hs-ctx-close" type="button" title="取消聚焦">×</button>
    </div>`;
  el.querySelector('.hs-ctx-ask')?.addEventListener('click', () => {
    const zz = window.ZZChat;
    if (zz && !zz.isStreaming()) zz.send(`帮我分析一下「${regionFilter}」最近有什么热点？`);
  });
  el.querySelector('.hs-ctx-close')?.addEventListener('click', () => {
    regionFilter = '';
    renderRegionList();
    renderFeed();
    renderTicker();
    earth?.highlightRegion('');
    closeRegionPopup();
    hsChatRenderContext();
  });
}
function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
}
function hsChatAppendStream(delta) {
  const log = $('hs-chat-log');
  if (!log) return;
  log.querySelector('.hs-chat-empty')?.remove();
  let bubble = log.querySelector('.hs-chat-bubble.hs-streaming');
  if (!bubble) {
    bubble = document.createElement('div');
    bubble.className = 'hs-chat-bubble hs-chat-bot hs-streaming';
    bubble.textContent = '';
    log.appendChild(bubble);
  }
  bubble.textContent += delta;
  hsChatScroll();
}
async function hsChatSend() {
  const ta = $('hs-chat-text');
  const sendBtn = $('hs-chat-send');
  const zz = window.ZZChat;
  if (!ta || !zz || zz.isStreaming()) return;
  const text = ta.value.trim();
  if (!text) return;
  ta.value = ''; ta.style.height = 'auto';
  if (sendBtn) sendBtn.disabled = true;
  try {
    await zz.send(text);
  } finally {
    if (sendBtn) sendBtn.disabled = !!zz && zz.isStreaming();
  }
}
function initHotspotChat() {
  const zz = window.ZZChat;
  if (!zz) {
    // app.js 作为普通 script 在 module 之后加载，稍后才能拿到 ZZChat
    setTimeout(initHotspotChat, 50);
    return;
  }
  zz.offUpdate(hsChatRender);
  zz.offStreamDelta(hsChatAppendStream);
  zz.onUpdate(hsChatRender);
  zz.onStreamDelta(hsChatAppendStream);
  zz.triggerUpdate();

  const ta = $('hs-chat-text');
  const sendBtn = $('hs-chat-send');
  sendBtn?.addEventListener('click', hsChatSend);
  ta?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); hsChatSend(); }
  });
  ta?.addEventListener('input', () => {
    ta.style.height = 'auto';
    ta.style.height = Math.min(ta.scrollHeight, 120) + 'px';
  });
  $('hs-chat-clear')?.addEventListener('click', () => {
    if (zz.isStreaming()) return;
    zz.clearMessages();
  });
  $('hs-chat-mic')?.addEventListener('click', hsChatToggleMic);
}

// ── 右侧聊天框：语音输入（复用主界面本地 FunASR /api/asr）──
function hsChatToggleMic() {
  if (hsMic.recording) { hsChatStopMic(); return; }
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    hsChatMicHint('当前环境不支持麦克风录音'); return;
  }
  navigator.mediaDevices.getUserMedia({ audio: true }).then((stream) => {
    hsMic.chunks = [];
    hsMic.mime = MediaRecorder.isTypeSupported('audio/webm;codecs=opus')
      ? 'audio/webm;codecs=opus'
      : (MediaRecorder.isTypeSupported('audio/webm') ? 'audio/webm' : '');
    hsMic.stream = stream;
    hsMic.rec = hsMic.mime
      ? new MediaRecorder(stream, { mimeType: hsMic.mime })
      : new MediaRecorder(stream);
    hsMic.rec.ondataavailable = (e) => { if (e.data && e.data.size) hsMic.chunks.push(e.data); };
    hsMic.rec.onstop = hsChatOnMicStop;
    hsMic.rec.start();
    hsMic.recording = true;
    const btn = $('hs-chat-mic');
    if (btn) { btn.classList.add('recording'); btn.title = '聆听中…再点一次结束'; }
  }).catch((e) => {
    hsChatMicHint(e && e.name === 'NotAllowedError' ? '麦克风权限被拒绝' : '无法访问麦克风');
  });
}
function hsChatStopMic() {
  if (hsMic.rec && hsMic.rec.state !== 'inactive') hsMic.rec.stop();
  if (hsMic.stream) hsMic.stream.getTracks().forEach((t) => t.stop());
  hsMic.recording = false;
  const btn = $('hs-chat-mic');
  if (btn) { btn.classList.remove('recording'); btn.title = '点击说话（本地 FunASR 语音识别）'; }
}
async function hsChatOnMicStop() {
  const btn = $('hs-chat-mic');
  const blob = new Blob(hsMic.chunks, { type: hsMic.mime || 'audio/webm' });
  hsMic.chunks = [];
  if (!blob.size) { hsChatMicHint('未捕获到音频'); return; }
  try {
    const buf = await blob.arrayBuffer();
    const r = await fetch('/api/asr?ext=.webm', { method: 'POST', body: buf });
    const d = await r.json();
    if (d.ok && d.text) {
      const ta = $('hs-chat-text');
      if (ta) {
        ta.value = (ta.value ? ta.value + ' ' : '') + d.text;
        ta.focus();
        ta.style.height = 'auto';
        ta.style.height = Math.min(ta.scrollHeight, 120) + 'px';
      }
      hsChatMicHint('识别成功');
    } else {
      hsChatMicHint(d.error || '未识别到语音内容');
    }
  } catch (e) {
    hsChatMicHint('语音识别请求失败');
  }
}
function hsChatMicHint(msg) {
  const btn = $('hs-chat-mic');
  const prev = btn?.title;
  if (btn) btn.title = msg;
  console.log('[hs-chat-mic]', msg);
  setTimeout(() => { if (btn && prev) btn.title = prev; }, 2200);
}

