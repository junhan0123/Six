function createProceduralEarthTexture(T) {
  const W = 1024, H = 512;
  const canvas = document.createElement('canvas');
  canvas.width = W; canvas.height = H;
  const ctx = canvas.getContext('2d');
  // 备用纹理：蓝色海洋 + 蓝调大陆 + 蓝色网格（兜底用，与「蓝色地球」基调一致）
  const oceanGrad = ctx.createLinearGradient(0, 0, 0, H);
  oceanGrad.addColorStop(0, '#06203f');
  oceanGrad.addColorStop(0.3, '#0a3a6b');
  oceanGrad.addColorStop(0.5, '#0e4a85');
  oceanGrad.addColorStop(0.7, '#0a3a6b');
  oceanGrad.addColorStop(1, '#06203f');
  ctx.fillStyle = oceanGrad;
  ctx.fillRect(0, 0, W, H);
  // 经纬网格（增加科技感，也帮助判断是否渲染）
  ctx.strokeStyle = 'rgba(120, 180, 255, 0.14)';
  ctx.lineWidth = 1;
  for (let i = 0; i <= 12; i++) {
    const x = (i / 12) * W;
    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
  }
  for (let i = 0; i <= 6; i++) {
    const y = (i / 6) * H;
    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
  }
  // 大陆（蓝调，与蓝色地球基调一致）
  ctx.fillStyle = '#6fa8dc';
  const p = (x, y) => [x / 360 * W, (90 - y) / 180 * H];
  function poly(coords) {
    ctx.beginPath();
    coords.forEach(([x, y], i) => { const [cx, cy] = p(x, y); i === 0 ? ctx.moveTo(cx, cy) : ctx.lineTo(cx, cy); });
    ctx.closePath(); ctx.fill();
  }
  poly([[-170,72],[-60,72],[-55,45],[-65,25],[-85,15],[-115,20],[-130,30],[-140,55],[-165,62]]);
  poly([[-73,76],[-20,83],[-17,76],[-30,70],[-55,68],[-66,72]]);
  poly([[-82,12],[-60,12],[-35,5],[-35,-25],[-55,-55],[-68,-55],[-75,-40],[-80,-10]]);
  poly([[0,72],[30,72],[35,60],[30,45],[15,38],[0,38],[-10,45],[-10,60]]);
  poly([[-18,38],[52,38],[52,10],[45,-10],[35,-35],[20,-55],[10,-35],[0,0],[-18,15]]);
  poly([[30,72],[180,72],[180,40],[140,20],[120,10],[100,5],[80,12],[60,20],[40,38],[28,60]]);
  poly([[95,25],[110,10],[105,0],[95,5],[90,15]]);
  poly([[114,-22],[154,-22],[154,-39],[140,-38],[125,-33],[113,-28]]);
  ctx.fillStyle = 'rgba(220, 245, 255, 0.75)';
  ctx.beginPath(); ctx.rect(0, H * 0.89, W, H * 0.11); ctx.fill();
  ctx.beginPath(); ctx.rect(0, 0, W, H * 0.04); ctx.fill();
  // 在赤道加一条高亮带，帮助判断纹理是否加载
  ctx.strokeStyle = 'rgba(34, 211, 238, 0.25)';
  ctx.lineWidth = 2;
  ctx.beginPath(); ctx.moveTo(0, H * 0.5); ctx.lineTo(W, H * 0.5); ctx.stroke();
  const tex = new T.CanvasTexture(canvas);
  if (T.SRGBColorSpace) tex.colorSpace = T.SRGBColorSpace;
  return tex;
}

