// voice-orb-simple.js — 庄周 · 语音球（完整移植自参考实现 voice-core.js 渲染引擎）
//
// 设计目标：让庄周语音球的「形状 / 配色 / 动画」与参考实现球一模一样。
// 移植范围 = 参考实现 voice-core.js 的「点阵球渲染」部分（斐波那契采样 + 正弦噪声位移 +
// 8 态语义配色 + 深度着色 + 帧节流 + 自转/俯仰），逻辑逐行对齐参考实现。
//
// 刻意不移植的部分（不属于"球"）：麦克风采集 / 云端 ASR WebSocket / AudioWorklet /
// Electron IPC / 打断预缓冲 / 看门狗。这些依赖参考实现专属后端（ws://127.0.0.1:3721）
// 与 Electron 环境，庄周已有自己的语音管线（asr.py + edge-tts + app.js），不应引入。
//
// 对外接口保持与 main-orb.js 兼容：createVoiceOrb({canvas,statusEl,transcriptEl,onState})
// → { start, stop, setStatus, setVolume, setTranscript }。

// ─── 球面采样（Fibonacci，与参考实现一致） ───
function fibSphere(n, radius) {
  const pts = [];
  const golden = Math.PI * (3 - Math.sqrt(5));
  for (let i = 0; i < n; i++) {
    const y = 1 - (i / (n - 1)) * 2;
    const r = Math.sqrt(Math.max(0, 1 - y * y));
    const theta = golden * i;
    pts.push({ x: Math.cos(theta) * r * radius, y: y * radius, z: Math.sin(theta) * r * radius });
  }
  return pts;
}

const BASE_PTS  = fibSphere(3200, 1.0);   // 外层 3200 点
const BASE_PTS2 = fibSphere(1200, 0.88);  // 内层 1200 点（更小半径）

// 小尺寸抽稀：球被缩成小坞时按 stride 隔点取，成本随点数线性降（参考实现同策略）。
const PTS_BY_STRIDE = new Map();
function ptsForStride(stride) {
  let pts = PTS_BY_STRIDE.get(stride);
  if (!pts) {
    pts = stride === 1
      ? { outer: BASE_PTS, inner: BASE_PTS2 }
      : {
          outer: BASE_PTS.filter((_, i) => i % stride === 0),
          inner: BASE_PTS2.filter((_, i) => i % stride === 0),
        };
    PTS_BY_STRIDE.set(stride, pts);
  }
  return pts;
}

// ─── 正弦噪声（与参考实现完全一致） ───
function sn(x, y, z, t) {
  return (
    Math.sin(x * 2.3 + t * 1.1) * Math.cos(y * 1.9 + t * 0.8) * 0.38 +
    Math.sin(y * 3.1 + t * 1.4) * Math.cos(z * 2.7 + t * 0.6) * 0.30 +
    Math.sin(z * 1.7 + t * 0.9) * Math.cos(x * 3.3 + t * 1.2) * 0.30 +
    Math.sin(x * 5.1 + y * 4.3 + t * 2.1) * 0.14
  );
}

function lerp(a, b, t) { return a + (b - a) * t; }
function lerpArr(a, b, t) { return a.map((v, i) => lerp(v, b[i], t)); }

// ─── 状态配置（参考实现 STATE_CFG 原样，8 态语义配色） ───
// idle = 麦克风关闭（灰）  listening = 麦克风开启待命（白）
// recognizing = 正在识别（蓝）  done = 识别完成（绿，2s 后回 listening）
// processing = 处理中（紫）  thinking = 思考中（青绿）
// error = 错误（红/暗）  event = 事件（琥珀）
// speaking = AI 正在说话（青，可打断，随音量不规则跳动）
// r/g/b 为 [近, 中, 远] 三档色，渲染时只用 [0]→[2] 做深度渐变（参考实现同语义）。
const STATE_CFG = {
  idle:        { amp: 0.003, spd: 0.10, r: [50, 68, 80],    g: [50, 68, 80],    b: [55, 73, 85]   },
  listening:   { amp: 0.055, spd: 0.75, r: [185, 215, 245], g: [185, 215, 245], b: [195, 225, 255] },
  recognizing: { amp: 0.55,  spd: 4.50, r: [25, 75, 165],   g: [95, 155, 230],  b: [195, 230, 255] },
  done:        { amp: 0.10,  spd: 1.20, r: [30, 105, 65],   g: [145, 200, 135], b: [45, 90, 60]   },
  processing:  { amp: 0.15,  spd: 1.10, r: [100, 60, 200],  g: [80, 60, 180],   b: [220, 190, 255] },
  thinking:    { amp: 0.16,  spd: 1.15, r: [35, 90, 75],    g: [160, 210, 120], b: [120, 180, 150] },
  error:       { amp: 0.10,  spd: 0.70, r: [200, 240, 255], g: [20, 30, 40],    b: [20, 30, 40]   },
  event:       { amp: 0.60,  spd: 4.00, r: [255, 200, 50],  g: [200, 160, 30],  b: [50, 80, 150]   },
  speaking:    { amp: 0.09,  spd: 1.00, r: [40, 90, 140],   g: [185, 225, 245], b: [190, 220, 255] },
};

// 兼容别名：无。thinking 独立为青绿色，processing 保持紫色。

export function createVoiceOrb({ canvas, statusEl, transcriptEl, onState }) {
  const ctx = canvas.getContext('2d');
  let W = 0, H = 0, cx = 0, cy = 0, scale = 0;
  // canvas 的 CSS 短边，绘制帧的 resize 顺手写入（抽稀档位按它判）。
  let cssMinSize = Infinity;

  // ─── 渲染状态 ───
  let sk = 'idle';
  let animState = {
    amp: STATE_CFG.idle.amp, spd: STATE_CFG.idle.spd,
    col: [STATE_CFG.idle.r, STATE_CFG.idle.g, STATE_CFG.idle.b],
    t: 0, rotY: 0, rotX: 0.25,
  };
  let rafId = null;
  let eventFlashCount = 0;
  let doneTimer = null;
  // 外部音量注入：由 main-orb.js 每帧把真实音量（麦克风/TTS）推过来，驱动球体跳动。
  let externalVol = null;   // null = 未注入；数值 = 用它当本帧的视觉音量

  // ── 画面节流（与参考实现一致）──
  const IDLE_FPS = 18;
  const SMALL_FPS_CAP = 30;
  const QUIET_AFTER_MS = 2500;
  const QUIET_VOL = 0.02;
  let lastDrawTs = 0;
  let lastVoiceTs = 0;      // 最近一次 vol 超过 QUIET_VOL 的时刻
  let lastVol = 0;          // 备用（无麦时为 0）

  function resizeCanvasToDisplay() {
    const rect = canvas.getBoundingClientRect();
    cssMinSize = Math.min(rect.width, rect.height);
    const dpr = Math.max(1, Math.min(window.devicePixelRatio || 1, 3));
    const nextW = Math.max(1, Math.round(rect.width * dpr));
    const nextH = Math.max(1, Math.round(rect.height * dpr));
    if (canvas.width !== nextW || canvas.height !== nextH) {
      canvas.width = nextW;
      canvas.height = nextH;
    }
    W = nextW; H = nextH; cx = W / 2; cy = H / 2;
    scale = Math.min(W, H) * 0.34;   // 参考实现同系数
  }

  // 画面节流档位：返回 0 = 不限（跟随显示器刷新率）
  function targetDrawFps(ts) {
    let fps = 0;
    const calm = sk === 'idle' || sk === 'listening';
    if (sk === 'idle' && !micData) fps = IDLE_FPS;                                   // ① 灰待机
    else if (calm && micData && ts - lastVoiceTs > QUIET_AFTER_MS) fps = IDLE_FPS;   // ② 麦开但静音
    if (cssMinSize <= 100) fps = fps ? Math.min(fps, SMALL_FPS_CAP) : SMALL_FPS_CAP; // ③ 小坞
    return fps;
  }

  // 小坞抽稀档位：≤100px 取 1/4，≤160px 取 1/2，大尺寸全量（与参考实现一致）
  function strideForSize() {
    return cssMinSize <= 100 ? 4 : cssMinSize <= 160 ? 2 : 1;
  }

  // ─── 状态切换 ───
  function setStatus(newSk, text) {
    const renderSk = STATE_CFG[newSk] ? newSk : (STATE_ALIAS[newSk] || 'idle');
    sk = renderSk;
    if (onState) onState(newSk);   // DOM 状态类用原始名，保持 main-orb.js 映射
    if (text != null && statusEl) statusEl.textContent = text;

    if (newSk === 'done') {
      if (doneTimer) clearTimeout(doneTimer);
      doneTimer = setTimeout(() => {
        doneTimer = null;
        if (sk === 'done') setStatus('idle');
      }, 2000);
    }
    if (newSk === 'event') {
      // 参考实现事件是短暂高亮；给一个可见的闪烁预算（≈0.6s）后自动回落。
      eventFlashCount = 36;
    }
  }

  function setExternalVol(v) { externalVol = (v == null ? null : Number(v) || 0); }
  function setVolume(v) { setExternalVol(v); }
  function setTranscript(text) {
    const t = text || '';
    if (transcriptEl) {
      transcriptEl.textContent = t;
      transcriptEl.classList.toggle('show', !!t);
    }
  }
  function triggerDone() { setStatus('done'); }

  function drawFrame(now) {
    const ts = now ?? performance.now();

    // ── 画面节流 ──
    const fps = targetDrawFps(ts);
    if (fps && ts - lastDrawTs < 1000 / fps) {
      rafId = requestAnimationFrame(drawFrame);
      return;
    }
    lastDrawTs = ts;
    resizeCanvasToDisplay();
    const cfg = STATE_CFG[sk];
    const s = animState;
    const ls = 0.025;

    s.amp = lerp(s.amp, cfg.amp, ls * 8);
    s.spd = lerp(s.spd, cfg.spd, ls * 6);
    s.col = [
      lerpArr(s.col[0], cfg.r, ls * 1.5),
      lerpArr(s.col[1], cfg.g, ls * 1.5),
      lerpArr(s.col[2], cfg.b, ls * 1.5),
    ];

    // 有声时放大振幅/转速（音量来自外部注入）。
    const visualVol = externalVol != null ? externalVol : lastVol;
    if (visualVol > QUIET_VOL) {
      s.amp = lerp(s.amp, 0.08 + visualVol * 1.2, 0.4);
      s.spd = lerp(s.spd, 1.0 + visualVol * 5.0, 0.2);
    }

    // 声音事件闪烁效果自动恢复
    if (sk === 'event') {
      eventFlashCount--;
      if (eventFlashCount <= 0) {
        eventFlashCount = 0;
        setStatus('idle');
      }
    }

    s.t    += 0.016 * s.spd;
    s.rotY += 0.008;
    s.rotX  = 0.22 + Math.sin(s.t * 0.15) * 0.06;

    ctx.clearRect(0, 0, W, H);

    const cY = Math.cos(s.rotY), sY = Math.sin(s.rotY);
    const cX = Math.cos(s.rotX), sX = Math.sin(s.rotX);

    // 为 speaking 状态提供基于真实音量、随时间不规则跳动的额外位移。
    const isSpeaking = sk === 'speaking';
    const voiceBump = isSpeaking ? Math.max(0, (visualVol - QUIET_VOL) * 1.8) : 0;
    const jitterT = s.t * 18.0;
    function voiceJitter(idx) {
      if (!isSpeaking || voiceBump <= 0) return 0;
      // 伪随机 hash：把 idx 和时间搅在一起，产生高频不规则脉冲
      const h = Math.sin(idx * 12.9898 + jitterT) * 43758.5453;
      const n = h - Math.floor(h);
      return (n * 2 - 1) * voiceBump * 0.18;
    }

    const project = (orig, idx) => {
      let d = 1.0 + sn(orig.x, orig.y, orig.z, s.t) * s.amp;
      if (isSpeaking && voiceBump > 0) {
        // 音量越大，局部点阵起伏越不规则；低频包络 + 高频抖动
        const envelope = 1.0 + Math.sin(orig.y * 4.0 + s.t * 6.0) * voiceBump * 0.35;
        d = d * envelope + voiceJitter(idx);
      }
      const px = orig.x * d, py = orig.y * d, pz = orig.z * d;
      const rx  =  px * cY + pz * sY;
      const ry0 = py;
      const rz  = -px * sY + pz * cY;
      const ry  = ry0 * cX - rz * sX;
      const rz2 = ry0 * sX + rz * cX;
      return { sx: cx + rx * scale, sy: cy - ry * scale, z: rz2 };
    };

    const { outer, inner } = ptsForStride(strideForSize());
    const allPts = [
      ...outer.map((p, i) => ({ ...project(p, i * 2), inner: false })),
      ...inner.map((p, i) => ({ ...project(p, i * 2 + 1), inner: true  })),
    ];
    allPts.sort((a, b) => a.z - b.z);

    for (const pt of allPts) {
      const depth = (pt.z + 1.5) / 3.0;
      const r = Math.round(lerp(s.col[0][0], s.col[0][2], depth));
      const g = Math.round(lerp(s.col[1][0], s.col[1][2], depth));
      const b = Math.round(lerp(s.col[2][0], s.col[2][2], depth));
      const alpha = 0.25 + depth * 0.75;
      const dotR = pt.inner ? (0.4 + depth * 0.5) : (0.6 + depth * 0.8 + s.amp * 2);
      ctx.beginPath();
      ctx.arc(pt.sx, pt.sy, dotR, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${r},${g},${b},${alpha.toFixed(2)})`;
      ctx.fill();
    }

    rafId = requestAnimationFrame(drawFrame);
  }

  function start() {
    if (!rafId) drawFrame();
  }

  function stop() {
    if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
    if (doneTimer) { clearTimeout(doneTimer); doneTimer = null; }
  }

  // micData 仅在参考实现原版用于音量分析；庄周无麦，恒为 null（targetDrawFps 据此判定待机降帧）。
  const micData = null;

  return { start, stop, setStatus, setVolume, setTranscript, triggerDone };
}
