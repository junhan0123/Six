/* ============================================================
 * UI-4D-1 · AI OS Home Experience v1.0
 * 身份：Senior Product Designer / AI OS Experience Architect
 * 性质：纯表现层 ADDITIVE 最高覆盖（必须位于 ui4c-unified-home.css 之后）
 * ------------------------------------------------------------
 * 纪律（严格遵守 brief 红线）：
 *  - 不修改 Backend / Agent / AppState / EventBus / Galaxy 逻辑 / 新增功能 / 新增事件契约。
 *  - 不触碰 fixed 定位、不修改三面板外层、零逻辑改动、不新增/重定义令牌体系。
 *  - 仅消费既有令牌（--accent / --presence-color / --surface / --surface-2 / --border /
 *    --text / --text-dim / --muted / --glow / --ok / --sp-* / --radius-* / --glass-*）。
 *  - 保护 Phase 8 AI Presence 三唯一：只消费 body[data-presence] 与 --presence-color，不重定义。
 *  - 复用唯一呼吸动效 vitPulse（ui2.css:740）：THINKING/PLANNING/EXECUTING 脉动，
 *    IDLE/WAITING/COMPLETED/OFFLINE 静止，ERROR 静止（错误不制造焦虑脉动）。
 * 目标映射（核心四问：①AI 在哪 ②AI 现在状态 ③我可以让 AI 做什么 ④当前有没有任务）：
 *  - D1 · AI Presence 成为首页核心身份（HUD 状态药丸 + 意识核心状态徽章 + 核心光环随态反应）。
 *  - D2 · Command Dock 升级「AI Intent Console」（标题文案 CSS 替换 + 意图控制台视觉 + 意图提示）。
 *  - D3 · 首启体验强化「本地 AI OS」身份（首启卡片 presence 辉光 + 英雄名 presence 光晕）。
 *  - D4 · 当前态势表面串联（时间线标题加 presence 点 + 面板 presence 描边，把 AI 状态/任务/活动归一）。
 * 作用域：首页态限定 body:not(.chat-mode):not(.universe-mode)，工作台/宇宙态视觉零变化。
 * 严禁：把 AI 状态呈现为「聊天气泡」——所有表达均落在状态徽章 / 状态点 / 光环 / 描边，而非对话气泡。
 * ============================================================ */

/* ═══════════════ D1 · AI Presence 成为首页核心身份 ═══════════════ */

/* D1-a · 意识核心状态药丸 = 首页最明确的「AI 身份徽章」
 * 把左上角裸状态文字升级为 glass + presence 描边的状态芯片，回答「AI 在哪 + AI 现在状态」。 */
body:not(.chat-mode):not(.universe-mode) .os-core .os-core-state {
  top: 18px;
  left: 18px;
  padding: var(--sp-6) var(--sp-12);
  border-radius: var(--radius-pill);
  background: color-mix(in srgb, var(--surface-2) 78%, transparent);
  border: 1px solid color-mix(in srgb, var(--presence-color) 42%, var(--border));
  box-shadow: 0 0 18px -6px color-mix(in srgb, var(--presence-color) 45%, transparent);
  font-weight: 600;
  backdrop-filter: var(--glass-3);
  transition: border-color var(--dur-base) var(--ease-soft),
              box-shadow var(--dur-base) var(--ease-soft);
}

/* D1-b · 强化意识核心光环（presence 反应），叠加于 ui4c 微光环，让 AI「在场感」可被感知 */
body:not(.chat-mode):not(.universe-mode) .os-core::after {
  content: "";
  position: absolute;
  inset: -10px;
  border-radius: inherit;
  pointer-events: none;
  box-shadow:
    0 0 0 1px color-mix(in srgb, var(--presence-color, var(--accent)) 40%, transparent),
    0 0 72px -8px color-mix(in srgb, var(--presence-color, var(--accent)) 38%, transparent);
}

/* D1-c · AI 工作中：核心边框与光晕随态点亮（复用既有 transition，无新 keyframe） */
body[data-presence="THINKING"]:not(.chat-mode):not(.universe-mode) .os-core,
body[data-presence="PLANNING"]:not(.chat-mode):not(.universe-mode) .os-core,
body[data-presence="EXECUTING"]:not(.chat-mode):not(.universe-mode) .os-core {
  border-color: color-mix(in srgb, var(--presence-color) 55%, var(--border));
  box-shadow: 0 0 64px -16px color-mix(in srgb, var(--presence-color) 48%, transparent);
}

/* D1-d · ERROR 静态红色描边（不脉动，不制造焦虑，遵守 vitPulse 纪律） */
body[data-presence="ERROR"]:not(.chat-mode):not(.universe-mode) .os-core {
  border-color: color-mix(in srgb, var(--presence-error) 52%, var(--border));
}

/* D1-e · 顶部 HUD 状态药丸 presence 玻璃化，强化「这是 AI 的当前态」 */
body:not(.chat-mode):not(.universe-mode) .os-hud .os-state {
  background: color-mix(in srgb, var(--surface-2) 70%, transparent);
  border-color: color-mix(in srgb, var(--presence-color) 40%, var(--border));
  box-shadow: 0 0 14px -6px color-mix(in srgb, var(--presence-color) 42%, transparent);
  color: var(--text);
}
body:not(.chat-mode):not(.universe-mode) .os-hud .os-state .dot {
  box-shadow: 0 0 12px color-mix(in srgb, var(--presence-color) 70%, transparent);
}

/* ═══════════════ D2 · Command Dock 升级为「AI Intent Console」═════════════ */

/* D2-a · 标题重命名（纯 CSS 文案替换：隐藏原文本节点 + 注入新标签，不碰 JS / DOM 文本） */
body:not(.chat-mode):not(.universe-mode) .os-dock > h3 {
  font-size: 0;            /* 隐藏原 "Command Dock" 文本节点 */
}
body:not(.chat-mode):not(.universe-mode) .os-dock > h3::after {
  content: "AI Intent Console · 意图控制台";
  font-size: 13px;
  letter-spacing: .18em;
  color: var(--text);
}

/* D2-b · 意图控制台视觉：输入条随 presence 反应的内描边 + 软光
 * （低 alpha，避免 ERROR 红色产生告警感；仍保留 accent 基底身份） */
body:not(.chat-mode):not(.universe-mode) .os-dock .os-dock-bar {
  position: relative;
  border-color: color-mix(in srgb, var(--presence-color) 32%, var(--border));
  box-shadow:
    0 0 30px -10px color-mix(in srgb, var(--presence-color) 28%, transparent),
    inset 0 1px 0 color-mix(in srgb, var(--accent) 12%, transparent);
}

/* D2-c · 输入即「意图」：在既有 hint 下追加一行，框定输入为意图表达（不覆盖 JS 文案） */
body:not(.chat-mode):not(.universe-mode) .os-dock .os-dock-hint::after {
  content: "用自然语言下达意图 · 庄周会自行规划与执行";
  display: block;
  margin-top: 4px;
  color: color-mix(in srgb, var(--text-dim) 92%, transparent);
  letter-spacing: .04em;
}

/* ═══════════════ D3 · 首启体验强化「本地 AI OS」身份 ══════════════ */

/* D3-a · 首启卡片 presence 边框 + 品牌辉光（不碰 JS 文案，纯 CSS 强化身份） */
body:not(.chat-mode):not(.universe-mode) #onbOverlay .onb-card {
  border-color: color-mix(in srgb, var(--presence-color) 38%, var(--border));
  box-shadow:
    0 0 0 1px color-mix(in srgb, var(--presence-color) 30%, transparent),
    0 30px 90px -40px color-mix(in srgb, var(--presence-color) 50%, var(--glow));
}

/* D3-b · 英雄名「庄周」presence 光晕：把名字锚定为「AI 在此」的视觉中心 */
body:not(.chat-mode):not(.universe-mode) .os-hero-title {
  text-shadow: 0 0 40px color-mix(in srgb, var(--presence-color) 28%, transparent);
}

/* ═══════════════ D4 · 当前态势表面（AI状态/当前任务/最近活动 空间串联）═════════════ */

/* D4-a · 时间线标题加 presence 点，串联「AI 正在处理当前任务 / 最近活动」 */
body:not(.chat-mode):not(.universe-mode) .os-panel.os-timeline > h3 {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
}
body:not(.chat-mode):not(.universe-mode) .os-panel.os-timeline > h3::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--presence-color);
  box-shadow: 0 0 10px color-mix(in srgb, var(--presence-color) 60%, transparent);
}

/* D4-b · 时间线面板 presence 描边：当前态势 = AI 实时活动的投影表面 */
body:not(.chat-mode):not(.universe-mode) .os-panel.os-timeline {
  border-color: color-mix(in srgb, var(--presence-color) 22%, var(--border));
}

/* ═══════════════ 响应式 · Narrow（≤980）═════════════
 * 沿用 ui2 既有「导航横排」职责；仅确保 D1/D2/D4 的 presence 表达在窄屏同样成立。 */
@media (max-width: 980px) {
  body:not(.chat-mode):not(.universe-mode) .os-core .os-core-state {
    top: 14px;
    left: 14px;
    padding: var(--sp-4) var(--sp-10);
  }
  body:not(.chat-mode):not(.universe-mode) .os-dock > h3::after {
    font-size: 12px;
    letter-spacing: .14em;
  }
}
