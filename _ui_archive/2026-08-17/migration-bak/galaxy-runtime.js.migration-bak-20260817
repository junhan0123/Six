/*
 * galaxy-runtime.js — 庄周 Phase 6 Order 6 · Galaxy Runtime Layer（纯数据转换，非视觉）
 * ----------------------------------------------------------------------------
 * 职责：接收 GalaxyState（由 AppState 投影），转换为 Renderer(solar-system.js) 可消费的数据模型。
 * 纪律（Order 6 严格 Implementation Only / Architecture Frozen）：
 *   - 本文件绝不触碰 Three.js / WebGL / DOM；只产出纯数据模型（供 Renderer 消费）。
 *   - 禁止直接读后端、禁止直接调 API、禁止任何业务判断（仅做“状态投影→渲染模型”的映射）。
 *   - 数据单向派生自 GalaxyState（readiness §5.2：银河是订阅者而非生产者）。
 *   - 生命周期态仅暴露枚举（Dormant/Created/Running/Thinking/Waiting/Completed/Failed/Archived），
 *     不在此文件写颜色/Glow/Shader/动画参数（属 Order 8）。
 * 结构：AppState → GalaxyState → GalaxyRuntime → Renderer。
 * 可在 Node 中单测（不依赖 window）。
 */
(function (global) {
  'use strict';

  // —— 生命周期态枚举（仅状态接口，无视觉；Order 8 才映射颜色/Glow/动画）——
  var RUNTIME_STATES = {
    Dormant:   'Dormant',
    Created:   'Created',
    Running:   'Running',
    Thinking:  'Thinking',
    Waiting:   'Waiting',
    Completed: 'Completed',
    Failed:    'Failed',
    Archived:  'Archived'
  };

  // GalaxyState 运行态 → 规范生命周期态（收敛到 8 词表，绝不出界）
  function mapState(s) {
    switch (s) {
      case 'Created':                       return 'Created';
      case 'Started':
      case 'Running':
      case 'Working':                      return 'Running';
      case 'Thinking':                     return 'Thinking';
      case 'Waiting':
      case 'Paused':                       return 'Waiting';
      case 'Completed':                    return 'Completed';
      case 'Stored':
      case 'Linked':                       return 'Completed';  // 已落库/已关联的知识 = 完成态
      case 'Failed':
      case 'Error':                        return 'Failed';
      case 'Archived':
      case 'Dormant':                      return 'Archived';   // 归档/parked = Archived
      case 'Sleeping':                     return 'Dormant';
      default:                             return 'Dormant';
    }
  }

  function _goalIdOf(rel) {
    return (rel && rel.goalId != null) ? ('goal:' + rel.goalId) : null;
  }

  // 把一批 GalaxyState 节点投影为渲染模型条目（统一 shape）
  function _proj(nodes, type, parentFromRel) {
    return (nodes || []).map(function (n) {
      return {
        id: n.id,
        type: type,
        state: mapState(n.state),
        label: (n.metadata && (n.metadata.title || n.metadata.name)) || n.id,
        parentId: parentFromRel ? parentFromRel(n.relation) : null,
        meta: n.metadata || {}
      };
    });
  }

  function _getGalaxyState() {
    if (global.GalaxyState) return global.GalaxyState;
    if (typeof window !== 'undefined' && window.GalaxyState) return window.GalaxyState;
    return null;
  }

  // —— 核心 API：把 GalaxyState 转换为 Renderer 可消费模型 ——
  // 不读后端 / 不调 API / 不做业务判断，只做投影。
  var API = {
    RUNTIME_STATES: RUNTIME_STATES,

    getRenderModel: function () {
      var gs = _getGalaxyState();
      if (!gs || typeof gs.getGoalNodes !== 'function') {
        // 未接入状态层时的空模型（品牌核心仍在，但无动态节点）
        return {
          core:     { id: 'sun', type: 'core', state: 'Active', label: '庄周核心' },
          planets:  [], satellites: [], orbits: [], archives: [], links: []
        };
      }
      return {
        // 太阳 = 庄周核心（品牌静态身份，非业务状态节点）
        core:     { id: 'sun', type: 'core', state: 'Active', label: '庄周核心' },
        // Goal   → Planet
        planets:  _proj(gs.getGoalNodes(),     'goal',     null),
        // Agent  → Satellite（挂载到所属 Goal 轨道）
        satellites: _proj(gs.getAgentNodes(), 'agent',    function (r) { return _goalIdOf(r); }),
        // Task   → Orbit Node（挂载到所属 Goal 轨道）
        orbits:   _proj(gs.getTaskNodes(),    'task',     function (r) { return _goalIdOf(r); }),
        // Memory → Archive Node（挂载到所属 Goal）
        archives: _proj(gs.getMemoryNodes(),  'memory',   function (r) { return _goalIdOf(r); }),
        // Knowledge → Link Node（挂载到所属 Memory）
        links:    _proj(gs.getKnowledgeLinks(), 'knowledge', function (r) {
                    return (r && r.memoryId != null) ? ('memory:' + r.memoryId) : null;
                  })
      };
    },

    mapState: mapState
  };

  global.GalaxyRuntime = API;
  if (typeof module !== 'undefined' && module.exports) module.exports = API;
})(typeof window !== 'undefined' ? window : globalThis);
