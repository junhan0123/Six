// memory-query.js —— 长期记忆查询面板（Phase 12 · P12-4）
// 由 app.js / 指令中心触发 window.ZZMemoryQuery.open() 打开。
// 行为：
//   POST /api/memory/query { query, limit } → { ok, query, results:[{source,type,title,content,tags?,sentiment?,date}] }
//   输入即搜（防抖），支持相对时间词（上周/昨天/本月…由后端解析）。

const MQ = { panel: null, open: false, _timer: null };

// 本地转义：避免依赖其它模块作用域内的 escapeHtml
function mqEsc(str) {
  return String(str == null ? '' : str).replace(/[&<>"']/g, (c) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  }[c]));
}

function mqBuild() {
  if (MQ.panel) return;
  const html = `
  <div class="memq-panel" id="memq-panel" role="dialog" aria-label="记忆查询">
    <div class="memq-backdrop" data-close="1"></div>
    <div class="memq-stage glass">
      <div class="memq-bar">
        <div class="memq-title"><span class="memq-dot"></span>记忆查询</div>
        <button class="memq-close" id="memq-close" title="关闭（Esc）" aria-label="关闭"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-close"/></svg></button>
      </div>
      <div class="memq-search">
        <span class="memq-caret"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-search"/></svg></span>
        <input class="memq-input" id="memq-input" placeholder="问庄周记得什么… 例如「上周聊了什么」「妈妈的生日」「我不喜欢吃香菜」" autocomplete="off" />
        <button class="memq-go" id="memq-go" title="搜索">查询</button>
      </div>
      <div class="memq-body" id="memq-body">
        <div class="memq-hint">输入关键词，庄周会在长期记忆与历史对话摘要中检索。<br>试试：「上周」「上个月」「生日」「喜好」「项目」等。</div>
      </div>
    </div>
  </div>`;
  document.body.insertAdjacentHTML('beforeend', html);
  MQ.panel = document.getElementById('memq-panel');
  document.getElementById('memq-close').addEventListener('click', mqClose);
  MQ.panel.querySelector('[data-close]').addEventListener('click', mqClose);
  const input = document.getElementById('memq-input');
  input.addEventListener('input', mqOnType);
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); mqSearch(input.value); } });
  document.getElementById('memq-go').addEventListener('click', () => mqSearch(input.value));
}

function mqTypeLabel(t) {
  return ({
    habit: '习惯', preference: '偏好', important_event: '重要事件',
    relationship: '关系', conversation: '对话', note: '笔记', distill: '经验',
    feedback: '偏好', correction: '纠错',
  }[t] || (t || '记忆'));
}

function mqResultCard(r) {
  const source = r && r.source ? String(r.source) : 'memory';
  const type = r && r.type ? String(r.type) : 'note';
  const title = r && r.title ? String(r.title) : '记忆';
  const content = r && r.content ? String(r.content) : '';
  const date = r && r.date ? String(r.date) : '';
  const tags = r && r.tags ? String(r.tags) : '';
  const sentiment = r && r.sentiment ? String(r.sentiment) : '';
  const srcLabel = source === 'conversation' ? '对话摘要' : '长期记忆';
  const sentiTag = sentiment ? `<span class="memq-tag memq-senti">${mqEsc(sentiment)}</span>` : '';
  const tagStr = tags ? String(tags).split(',').filter(Boolean).map((t) => `<span class="memq-tag">#${mqEsc(t.trim())}</span>`).join('') : '';
  const ctype = content.includes('\n') || content.length > 200 ? 'memq-content multi' : 'memq-content';
  return `
    <div class="memq-card">
      <div class="memq-card-head">
        <span class="memq-tag memq-type">${mqTypeLabel(type)}</span>
        <span class="memq-tag memq-src">${srcLabel}</span>
        ${sentiTag}
        ${date ? `<span class="memq-date">${mqEsc(date)}</span>` : ''}
      </div>
      <div class="memq-card-title">${mqEsc(title)}</div>
      <div class="${ctype}">${mqEsc(content)}</div>
      ${tagStr ? `<div class="memq-tags">${tagStr}</div>` : ''}
    </div>`;
}

function mqRender(results, q) {
  const body = document.getElementById('memq-body');
  if (!Array.isArray(results) || !results.length) {
    body.innerHTML = `<div class="memq-empty">没有找到与「${mqEsc(q)}」相关的记忆。<br>多用一段时间，庄周会自动沉淀你的习惯、偏好和重要日期。</div>`;
    return;
  }
  const head = `<div class="memq-summary">找到 <b>${results.length}</b> 条相关记忆${q ? ` · 「${mqEsc(q)}」` : ''}</div>`;
  body.innerHTML = head + `<div class="memq-grid">${results.map(mqResultCard).join('')}</div>`;
}

async function mqSearch(query, limit = 8) {
  const body = document.getElementById('memq-body');
  const q = (query || '').trim();
  if (!q) { mqBuild(); document.getElementById('memq-body').innerHTML = `<div class="memq-hint">输入关键词开始检索…</div>`; return; }
  body.innerHTML = `<div class="memq-loading">正在检索长期记忆…</div>`;
  try {
    const r = await fetch('/api/memory/query', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query: q, limit }),
    });
    const d = await r.json();
    if (d && d.ok) mqRender(d.results || [], q);
    else body.innerHTML = `<div class="memq-empty">检索失败：${mqEsc((d && d.error) ? String(d.error) : '未知错误')}</div>`;
  } catch (e) {
    body.innerHTML = `<div class="memq-empty">检索请求失败：${mqEsc(String(e && e.message || e))}</div>`;
  }
}

function mqOnType() {
  const v = document.getElementById('memq-input').value.trim();
  if (MQ._timer) clearTimeout(MQ._timer);
  if (!v) { document.getElementById('memq-body').innerHTML = `<div class="memq-hint">输入关键词开始检索…</div>`; return; }
  MQ._timer = setTimeout(() => mqSearch(v), 350);
}

function mqOpen() {
  mqBuild();
  requestAnimationFrame(() => document.body.classList.add('memq-mode'));
  MQ.open = true;
  const input = document.getElementById('memq-input');
  if (input) setTimeout(() => input.focus(), 40);
  // Sprint 1/2：登记到 OverlayManager（统一 ESC / 焦点 / 栈）
  if (window.OverlayManager) window.OverlayManager.track('memory-query', { el: MQ.panel, onClose: mqCloseImpl, type: window.OverlayManager.OverlayType.PANEL, trap: false });
}

function mqCloseImpl() {
  document.body.classList.remove('memq-mode');
  MQ.open = false;
}

function mqClose() {
  if (window.OverlayManager && window.OverlayManager.isOpen('memory-query')) window.OverlayManager.close('memory-query');
  else mqCloseImpl();
}

window.ZZMemoryQuery = { open: mqOpen, close: mqClose, search: mqSearch };
