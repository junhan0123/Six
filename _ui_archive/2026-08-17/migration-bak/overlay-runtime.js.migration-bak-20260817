/*
 * overlay-runtime.js — 庄周 Phase 6 Order 7 · Overlay Runtime Layer（纯数据转换，非视觉）
 * ----------------------------------------------------------------------------
 * 职责：接收 AppState（统一状态核心）+ GalaxyState（银河节点投影），转换为
 *       Overlay Model（供 Existing Overlay Renderer 消费的真实状态信息层）。
 * 纪律（Order 7 严格 Implementation Only / Architecture Frozen）：
 *   - 本文件绝不触碰 DOM / CSS / Three.js / WebGL；只产出纯数据模型（供 Renderer 消费）。
 *   - 禁止直接读后端、禁止调 API、禁止任何业务判断（仅做“领域状态→Overlay 模型”的映射）。
 *   - 数据单向派生自 AppState + GalaxyState（readiness §5.2：Overlay 是订阅者而非生产者）。
 *   - 六类 Overlay（Phase 3 定义）仅暴露类型枚举与映射；五态生命周期仅暴露枚举（非视觉）。
 *   - 禁止在此文件写颜色/Glow/Shader/动画/布局参数（属 Order 8 / Design Token 阶段）。
 * 结构：AppState ─┐
 *                 ├─→ Overlay Runtime ─→ Overlay Model ─→ Overlay Renderer
 *        GalaxyState ─┘
 * 可在 Node 中单测（不依赖 window）。
 */
(function (global) {
  'use strict';

  // —— 六类 Overlay 类型（Phase 3 定义；Order 7 实现真实对象映射）——
  var OVERLAY_TYPES = {
    Info:      'Info',
    Detail:    'Detail',
    Action:    'Action',
    Execution: 'Execution',
    Memory:    'Memory',
    Warning:   'Warning'
  };

  // —— 五态生命周期（Order 7；非视觉，仅供 Renderer 未来消费）——
  var OVERLAY_LIFECYCLE = {
    OPEN:      'OPEN',       // overlay 首次出现 / 被聚焦打开
    UPDATING:  'UPDATING',   // 源对象状态发生变化（单次闪光，下一帧转稳态）
    ACTIVE:    'ACTIVE',     // 源对象正在运行（Running/Thinking/Working/Waiting）
    COMPLETED: 'COMPLETED',  // 源对象到达终态（Completed/Stored/Linked/Failed/Error/Rejected）
    CLOSED:    'CLOSED'      // 源对象归档/休眠（archived/dormant/sleeping）→ 不进入信息层
  };

  // 领域节点类型 → Overlay 类型映射（scope ③）
  //   Goal   → Detail      Agent → Execution    Task → Execution
  //   Memory → Memory      Error → Warning
  //   Intent → Info（needsConfirm 时为 Action）；knowledge 不在六类映射内（保留，不生成 overlay）
  function mapType(sourceType, node) {
    switch (sourceType) {
      case 'goal':   return OVERLAY_TYPES.Detail;
      case 'agent':  return OVERLAY_TYPES.Execution;
      case 'task':   return OVERLAY_TYPES.Execution;
      case 'memory': return OVERLAY_TYPES.Memory;
      case 'error':  return OVERLAY_TYPES.Warning;
      case 'intent':
        return (node && node.metadata && node.metadata.needsConfirm)
          ? OVERLAY_TYPES.Action
          : OVERLAY_TYPES.Info;
      default:
        return null; // knowledge 等未映射类型 → 不生成 overlay
    }
  }

  // 领域运行态 → Overlay 稳态生命周期（scope ④）
  function steadyLifecycle(s) {
    switch (s) {
      case 'Created':
      case 'Received':
      case 'Analyzing':
      case 'Classified':
      case 'Accepted':
      case 'Converted':
        return OVERLAY_LIFECYCLE.OPEN;
      case 'Started':
      case 'Running':
      case 'Thinking':
      case 'Working':
      case 'Waiting':
        return OVERLAY_LIFECYCLE.ACTIVE;
      case 'Completed':
      case 'Stored':
      case 'Linked':
      case 'Failed':
      case 'Error':
      case 'Rejected':
        return OVERLAY_LIFECYCLE.COMPLETED;
      case 'Dormant':
      case 'Archived':
      case 'Sleeping':
        return OVERLAY_LIFECYCLE.CLOSED;
      default:
        return OVERLAY_LIFECYCLE.OPEN;
    }
  }

  function _title(node) {
    var m = node.metadata || {};
    return m.title || m.name || m.text || node.id;
  }

  function _body(node) {
    var m = node.metadata || {};
    if (node.type === 'error')  return '错误 · ' + (m.message || m.severity || '');
    if (node.type === 'intent') return '意图 · ' + node.state + (m.needsConfirm ? '（待确认）' : '');
    return (node.type || 'node') + ' · ' + node.state;
  }

  function _getAppState() {
    if (global.AppState) return global.AppState;
    if (typeof window !== 'undefined' && window.AppState) return window.AppState;
    return null;
  }

  function _getGalaxyState() {
    if (global.GalaxyState) return global.GalaxyState;
    if (typeof window !== 'undefined' && window.GalaxyState) return window.GalaxyState;
    return null;
  }

  // 把单个银河节点投影为 Overlay 条目（统一 shape）
  function buildOverlay(node) {
    if (!node || !node.type) return null;
    var type = mapType(node.type, node);
    if (!type) return null;
    var steady = steadyLifecycle(node.state);
    return {
      id:         'overlay:' + node.id,
      sourceId:   node.id,
      sourceType: node.type,
      type:       type,
      lifecycle:  steady,
      title:      _title(node),
      body:       _body(node),
      meta:       node.metadata || {},
      sourceState: node.state,   // 内部：用于 UPDATING 变更检测
      _steady:      steady         // 内部：稳态回退
    };
  }

  // 变更检测（在事件回调 _onChange 中推进，不放在 getModel 内，避免内部 notify 吞掉 UPDATING 闪光）：
  //   - 首现（_prev 无该 id）→ 标记 _firstSeen（首帧 OPEN；若稳态为终态 COMPLETED/CLOSED 则直接收敛）
  //   - 状态变化（_prev != 当前）→ 标记 _updating（单次闪光 UPDATING）
  //   - 否则 → 稳态
  // getModel 仅消费 _firstSeen / _updating（读一次即清除），不推进 _prev。
  var _prev = {};
  var _updating = {};
  var _firstSeen = {};

  function _recomputePrev() {
    var gs = _getGalaxyState();
    var nodes = (gs && typeof gs.getNodes === 'function') ? gs.getNodes() : [];
    var seen = {};
    for (var i = 0; i < nodes.length; i++) {
      var n = nodes[i];
      if (!n || !n.id) continue;
      seen[n.id] = true;
      if (_prev[n.id] === undefined) {
        _firstSeen[n.id] = true;            // 首现
      } else if (_prev[n.id] !== n.state) {
        _updating[n.id] = true;             // 状态变化 → 闪光
      }
      _prev[n.id] = n.state;
    }
    // 清理已消失节点
    for (var k in _prev) if (!seen[k]) delete _prev[k];
  }

  function applyLifecycle(ov) {
    if (!ov || ov.sourceState === undefined) return ov;
    var steady = ov._steady;
    if (_firstSeen[ov.sourceId]) {
      // 首现：若稳态为终态（COMPLETED/CLOSED），直接收敛（如单次 Error 事件 → Warning COMPLETED）；
      //       过渡态（OPEN/ACTIVE）保持 OPEN，等待后续推进。
      ov.lifecycle = (steady === OVERLAY_LIFECYCLE.COMPLETED || steady === OVERLAY_LIFECYCLE.CLOSED)
        ? steady : OVERLAY_LIFECYCLE.OPEN;
      delete _firstSeen[ov.sourceId];
    } else if (_updating[ov.sourceId]) {
      ov.lifecycle = OVERLAY_LIFECYCLE.UPDATING;   // 单次闪光，读后即清除
      delete _updating[ov.sourceId];
    } else {
      ov.lifecycle = steady;
    }
    return ov;
  }

  function _strip(ov) {
    if (!ov) return ov;
    delete ov.sourceState;
    delete ov._steady;
    return ov;
  }

  // —— 核心 API：把 AppState + GalaxyState 转换为 Overlay Model ——
  // 不读后端 / 不调 API / 不做业务判断，只做投影。
  // 返回 { focus: <overlay|null>, items: [<overlay>, ...] }
  function getModel() {
    var as = _getAppState();
    if (!as || typeof as.getState !== 'function') {
      return { focus: null, items: [] };
    }
    var gs = _getGalaxyState();
    var state = as.getState();
    var focus = (state && state.focus) || { capability: null, id: null };

    var nodes = (gs && typeof gs.getNodes === 'function') ? gs.getNodes() : [];
    var items = [];
    for (var i = 0; i < nodes.length; i++) {
      var ov = buildOverlay(nodes[i]);
      if (ov) items.push(ov);
    }

    // 聚焦 overlay（scope ⑤）：仅读 AppState.focus，绝不读 Three.js / GalaxyRuntime 几何。
    var focused = null;
    if (focus && focus.id) {
      var fnode = as.getNode(focus.id)
               || (gs && typeof gs.getNode === 'function' ? gs.getNode(focus.id) : null);
      if (fnode) focused = buildOverlay(fnode);
    }

    // 生命周期态收敛（含 UPDATING 单次闪光）
    for (var j = 0; j < items.length; j++) applyLifecycle(items[j]);
    if (focused) applyLifecycle(focused);

    // 信息层只暴露非 CLOSED（archived/dormant 不应再作为活动信息）
    var visible = [];
    for (var k = 0; k < items.length; k++) {
      if (items[k].lifecycle !== OVERLAY_LIFECYCLE.CLOSED) visible.push(_strip(items[k]));
    }
    return { focus: _strip(focused), items: visible };
  }

  // —— 订阅（供 Existing Overlay Renderer 消费；非视觉）——
  var subs = [];
  function _notify() {
    _recomputePrev();              // 事件时间推进指纹（首现/变化），先于 getModel
    var model = getModel();
    for (var i = 0; i < subs.length; i++) {
      try { subs[i](model); } catch (e) { /* 隔离订阅者异常 */ }
    }
  }
  var _unsubApp = null, _unsubGs = null;
  (function _wire() {
    var as = _getAppState();
    var gs = _getGalaxyState();
    if (as && typeof as.subscribe === 'function') {
      _unsubApp = as.subscribe('*', function () { _notify(); });
    }
    if (gs && typeof gs.onNodeChange === 'function') {
      _unsubGs = gs.onNodeChange(function () { _notify(); });
    }
  })();

  var API = {
    OVERLAY_TYPES:     OVERLAY_TYPES,
    OVERLAY_LIFECYCLE: OVERLAY_LIFECYCLE,
    mapType:           mapType,
    steadyLifecycle:   steadyLifecycle,
    getModel:          getModel,
    subscribe: function (cb) {
      subs.push(cb);
      return function () { var i = subs.indexOf(cb); if (i >= 0) subs.splice(i, 1); };
    }
  };
  // 清理句柄：非枚举，不污染纯数据 API 表面（Object.keys 仅含数据方法）
  Object.defineProperty(API, '_unsub', {
    value: function () {
      if (_unsubApp) _unsubApp();
      if (_unsubGs)  _unsubGs();
    },
    enumerable: false, writable: false, configurable: false
  });

  global.OverlayRuntime = API;
  if (typeof module !== 'undefined' && module.exports) module.exports = API;
})(typeof window !== 'undefined' ? window : globalThis);
