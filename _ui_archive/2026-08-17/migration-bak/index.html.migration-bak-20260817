    <!-- ============ 右侧遥测面板 ============ -->
    <aside class="tele" id="tele">
      <div class="tele-head">
        <span>工作日志</span>
        <button class="tele-close" id="btnTeleClose" title="收起">
          <svg viewBox="0 0 24 24" class="ic"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
        </button>
      </div>

      <div class="meter">
        <div class="meter-label">核心状态</div>
        <div class="meter-val" id="mState">IDLE</div>
        <div class="meter-bar"><i id="mBar" style="width:8%"></i></div>
      </div>

      <div class="tele-grid">
        <div class="tcell"><span class="tk">模型</span><span class="tv" id="mModel">agnes-2.5-flash</span></div>
        <div class="tcell"><span class="tk">延迟</span><span class="tv" id="mLatency">— ms</span></div>
        <div class="tcell"><span class="tk">本轮 Tokens</span><span class="tv" id="mTokens">0</span></div>
        <div class="tcell"><span class="tk">会话</span><span class="tv" id="mTurns">0</span></div>
      </div>

      <!-- AI 活动状态（由聊天流程桥接更新） -->
      <div class="tele-ai" id="actAi" data-state="idle">
        <span class="tele-ai-dot"></span>
        <span class="tele-ai-label" id="actAi-label">空闲</span>
        <span class="tele-ai-detail" id="actAi-detail"></span>
      </div>

      <!-- Agent Runtime 编排状态（Phase 8：后台闭环授权内核） -->
      <div class="tele-ai" id="agentState" data-state="disabled">
        <span class="tele-ai-dot"></span>
        <span class="tele-ai-label">Agent 编排</span>
        <span class="tele-ai-detail" id="agentState-detail">未启用</span>
      </div>

