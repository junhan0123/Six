  <!-- Galaxy Experience Layer · 纯表现 + 受控交互包装层（Phase 3；不修改 solar-system.js 本体 / Galaxy 数据结构 / 节点模型 / 事件协议 / 导航协议 / 不新增 Capability） -->
  <script src="galaxy-experience.js?v=20260807gx1"></script>
