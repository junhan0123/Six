          <span class="loc-pin">◉</span>
          <span class="loc-txt" id="locTxt">定位中…</span>
        </div>
      </div>

      <div class="rail-section quick-actions">
        <div class="rail-label">快捷能力</div>
        <div class="chip-row quick-chips">
          <button class="quick-chip" data-q="现在几点了？"><span class="qc-ico"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-clock"/></svg></span><span class="qc-lbl">时钟</span></button>
          <button class="quick-chip" data-q="帮我记一下：明天 10 点复盘"><span class="qc-ico"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-edit"/></svg></span><span class="qc-lbl">记笔记</span></button>
          <button class="quick-chip" data-q="用一句话介绍你自己"><span class="qc-ico"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-person"/></svg></span><span class="qc-lbl">关于你</span></button>
          <button class="quick-chip" data-q="给我一个今天的工作建议"><span class="qc-ico"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-idea"/></svg></span><span class="qc-lbl">建议</span></button>
          <button class="quick-chip" id="btnUserProfile"><span class="qc-ico"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-brain"/></svg></span><span class="qc-lbl">画像</span></button>
          <button class="quick-chip" id="btnBriefing"><span class="qc-ico"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-calendar"/></svg></span><span class="qc-lbl">简报</span></button>
        </div>
      </div>

      <button class="btn-new" id="btnNew">
        <svg viewBox="0 0 24 24" class="ic"><path d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6V5Z"/></svg>
        <span>新建会话</span>
      </button>

      <div class="rail-section">
        <div class="rail-label">会话</div>
        <div class="conv-list" id="convList">
          <div class="conv-item active">
            <span class="conv-dot"></span>主会话 · 在线
          </div>
        </div>
      </div>

      <div class="rail-foot">
        <div class="status-pill" id="corePill">
          <span class="dot"></span><span id="corePillTxt">核心离线</span>
        </div>
        <div class="status-pill" id="fePill" title="前端启动自检">
          <span class="dot"></span><span id="fePillTxt">前端自检…</span>
        </div>
      </div>
    </aside>

    <!-- ============ 主区 ============ -->
    <main class="main" id="mainArea">
      <!-- 顶部 HUD 条 -->
      <header class="hud-bar">
        <div class="hud-left">
          <span class="hud-tag">SYSTEM</span>
