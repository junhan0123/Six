          </button>
          <button class="mic-btn" id="btnMedia" title="上传音视频，提取字幕（本地 FunASR）">
            <svg viewBox="0 0 24 24" class="ic"><path d="M4 4h16v16H4zM4 9h16M4 15h16M8 4v5M16 4v5M8 15v5M16 15v5"/></svg>
          </button>
          <button class="mic-btn" id="btnScreen" title="捕获屏幕，让小6看图理解（多模态）">
            <svg viewBox="0 0 24 24" class="ic"><path d="M3 4h18v12H3zM8 20h8M12 16v4"/></svg>
