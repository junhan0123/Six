          <span class="hud-line" id="clock">--:--:--</span>
        </div>
        <div class="hud-right">
          <button class="mem-toggle" id="btnMem" title="长期记忆">
            <svg viewBox="0 0 24 24" class="ic"><path d="M12 3c4.4 0 8 1.3 8 3s-3.6 3-8 3-8-1.3-8-3 3.6-3 8-3Zm0 4.5c4.4 0 8 1.3 8 3v3c0 1.7-3.6 3-8 3s-8-1.3-8-3v-3c0-1.7 3.6-3 8-3Zm0 5.5c4.4 0 8 1.3 8 3v3c0 1.7-3.6 3-8 3s-8-1.3-8-3v-3c0-1.7 3.6-3 8-3Z"/></svg>
