  <!-- 主题无闪烁引导：在首帧绘制前同步设置 data-theme / reduced-motion，杜绝 FOUC -->
  <script>
    (function () {
      try {
        var raw = localStorage.getItem('zhuangzhou_settings_v1');
        var s = raw ? JSON.parse(raw) : {};
        var t = (s && s.theme) || 'dark-cyan';
        // 兼容旧强调色主题；OS 三主题目：dark / quantum / midnight
        var KNOWN = ['dark-cyan','dark-green','dark-purple','dark-amber','dark-rose','light','dark','quantum','midnight'];
        if (!t || KNOWN.indexOf(t) < 0) t = 'dark-cyan';
        document.body.setAttribute('data-theme', t);
        if (s && s.animation === 'reduced') document.body.classList.add('reduced-motion');
      } catch (e) {
        document.body.setAttribute('data-theme', 'dark-cyan');
      }
    })();
  </script>
