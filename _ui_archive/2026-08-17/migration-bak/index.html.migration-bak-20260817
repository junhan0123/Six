      <div class="tele-block tele-act">
        <div class="act-head">
          <div>
            <div class="act-title">自主行动机制 · Tick</div>
            <div class="act-sub">心跳 · 思考 · 工具</div>
          </div>
          <span class="act-pill" id="actConn"><span class="live-dot"></span>流式传输</span>
        </div>
        <div class="act-stats">
          <div class="act-stat"><span class="act-stat-label">状态</span><span class="act-stat-val live" id="actState"><span class="live-dot"></span>SSE</span></div>
          <div class="act-stat"><span class="act-stat-label">节点</span><span class="act-stat-val" id="actNodes">0</span></div>
          <div class="act-stat"><span class="act-stat-label">连线</span><span class="act-stat-val" id="actLinks">0</span></div>
          <div class="act-stat"><span class="act-stat-label">tok/s</span><span class="act-stat-val" id="actTok">—</span></div>
          <div class="act-stat"><span class="act-stat-label">召回/h</span><span class="act-stat-val" id="actRecall">—</span></div>
          <div class="act-stat"><span class="act-stat-label">抽取/h</span><span class="act-stat-val" id="actExtract">—</span></div>
        </div>
        <div class="stream act-stream" id="actStream"></div>
      </div>

      <!-- 认知指标 -->
      <div class="tele-block tele-cog">
        <div class="tele-title">认知指标</div>
