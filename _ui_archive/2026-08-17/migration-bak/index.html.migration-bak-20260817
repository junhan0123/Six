  <script>
  (function () {
    function bootOS() {
      if (window.ConsciousnessCore) ConsciousnessCore.init(document.getElementById('osCoreCanvas'));
      if (window.ExecutionTimeline) ExecutionTimeline.init(document.getElementById('osTimeline'));
      if (window.CapabilityMatrix) CapabilityMatrix.init(document.getElementById('osMatrix'));
      if (window.CommandDock) CommandDock.init(document.getElementById('osDock'));
      if (window.InsightPanel) InsightPanel.init(document.getElementById('osInsight'));
      // Unified Workspace：统一面板生命周期 / 工作区状态收口（Sprint 3/4）
      if (window.PanelManager) PanelManager.init();

      var stText = document.getElementById('osStateText');
      var coreText = document.getElementById('osCoreStateText');
      var clock = document.getElementById('osClock');
      function refreshHud() {
        var st = (window.AvatarState && window.AvatarState.deriveFromGlobals)
          ? window.AvatarState.deriveFromGlobals() : { state: 'IDLE', label: '待命' };
        if (stText) stText.textContent = st.label || '待命';
        if (coreText) coreText.textContent = st.label || '待命';
        // Phase 8 · AI Presence Adapter（唯一写入点）：把 AvatarState 真实态投影为全局存在信号。
        // 只写状态名，不写任何颜色——颜色映射 100% 归 ui2.css（body[data-presence] → --presence-color）。
        // 不新增状态机、不缓存状态、不改变任何业务语义；纯表现层。
        try { document.body.setAttribute('data-presence', st.state || 'IDLE'); } catch (e) {}
      }
      if (window.AppState) window.AppState.subscribe('*', refreshHud);
      if (window.ExecutionChannel) window.ExecutionChannel.subscribe(refreshHud);
      if (window.ZZSSE) window.ZZSSE.onMessage(refreshHud);
      refreshHud();
      setInterval(function () {
        if (clock) clock.textContent = new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
      }, 1000);

      // P9 主题选择器
      var picker = document.getElementById('osThemePicker');
      function applyTheme(t) {
        document.body.setAttribute('data-theme', t);
        try {
          var raw = localStorage.getItem('zhuangzhou_settings_v1');
          var s = raw ? JSON.parse(raw) : {}; s.theme = t;
          localStorage.setItem('zhuangzhou_settings_v1', JSON.stringify(s));
        } catch (e) {}
        if (picker) picker.querySelectorAll('button').forEach(function (b) {
          b.classList.toggle('active', b.getAttribute('data-theme') === t);
        });
      }
      if (picker) picker.querySelectorAll('button').forEach(function (b) {
        b.addEventListener('click', function () { applyTheme(b.getAttribute('data-theme')); });
      });
      applyTheme(document.body.getAttribute('data-theme') || 'dark-cyan');

      // P9 主题统一：任一来源（设置面板 / 指令中心 / Companion）变更主题后，同步 HUD 选择器高亮（Presentation-only）
      try {
        var _hudThemeObs = new MutationObserver(function () {
          var ct = document.body.getAttribute('data-theme');
          if (picker) picker.querySelectorAll('button').forEach(function (b) {
            b.classList.toggle('active', b.getAttribute('data-theme') === ct);
          });
        });
        _hudThemeObs.observe(document.body, { attributes: true, attributeFilter: ['data-theme'] });
      } catch (e) {}

      // Phase 10.2 任务一：任何主题变更（HUD 或 Settings 选择器）→ 推送 Companion 同步（Presentation-only）
      try {
        function pushThemeToCompanion() {
          var t = document.body.getAttribute('data-theme') || 'dark-cyan';
          if (window.zhuangzhou && window.zhuangzhou.setTheme) window.zhuangzhou.setTheme(t);
        }
        pushThemeToCompanion();
        var _themeObs = new MutationObserver(function (muts) {
          for (var i = 0; i < muts.length; i++) {
            if (muts[i].attributeName === 'data-theme') { pushThemeToCompanion(); break; }
          }
        });
        _themeObs.observe(document.body, { attributes: true, attributeFilter: ['data-theme'] });
      } catch (e) {}

      // ═══ UI Consolidation · Layer 3 上下文抽屉开关 ═══
      // 纪律：仅切换 body 类（纯表现）。不新建状态机 / 事件总线 / 业务能力；
      //       Capability Matrix 与 Insight 的数据与生命周期完全不变，只改「何时占据视觉」。
      var ctxBtn = document.getElementById('osContextToggle');
      function setContext(open) {
        document.body.classList.toggle('os-context-open', !!open);
        if (ctxBtn) ctxBtn.setAttribute('aria-pressed', open ? 'true' : 'false');
      }
      if (ctxBtn) ctxBtn.addEventListener('click', function () {
        setContext(!document.body.classList.contains('os-context-open'));
      });
      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        if (!document.body.classList.contains('os-context-open')) return;
        // 浮层优先：仅当 OverlayManager 栈内无浮层时才收起上下文抽屉
        if (window.OverlayManager && window.OverlayManager.getStack().length) return;
        setContext(false);
      });

      // 聊天开关（既有 .app 降级为可唤出抽屉）
      var fab = document.getElementById('osChatFab');
      function openChat() { document.body.classList.add('chat-mode'); document.body.classList.remove('universe-mode'); }
      function closeChat() { document.body.classList.remove('chat-mode'); }
      if (fab) fab.addEventListener('click', openChat);

      // P1 Universe 独立视图（Ctrl/Cmd+U）
      var uv = document.getElementById('universeView');
      var uvClose = document.getElementById('uvClose');
      function openUniverse() { document.body.classList.add('universe-mode'); if (uv) uv.classList.add('open'); }
      function closeUniverse() { document.body.classList.remove('universe-mode'); if (uv) uv.classList.remove('open'); }
      if (uvClose) uvClose.addEventListener('click', closeUniverse);
      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'u' || e.key === 'U')) {
          e.preventDefault();
          document.body.classList.contains('universe-mode') ? closeUniverse() : openUniverse();
        }
        if (e.key === 'Escape' && document.body.classList.contains('universe-mode')) {
          // 浮层优先：仅当 OverlayManager 栈内无浮层时才退出宇宙视图
          if (!(window.OverlayManager && window.OverlayManager.getStack().length)) closeUniverse();
        }
      });

      // ═══ [B] 统一 AI OS 导航脊柱 ═══
      // 纪律：仅切换既有 body 类 / 调用既有入口（ZZSettings · ZZCommandPalette）；
      // 不新建状态、不写运行时、不新增业务功能。active 态由 body 类 + 面板 open 类单一推导。
      var navVoice = false;
      var navBtns = Array.prototype.slice.call(document.querySelectorAll('[data-nav]'));
      function settingsOpen() {
        var p = document.getElementById('settingsPanel');
        return !!p && p.classList.contains('open');
      }
      function syncNav() {
        var b = document.body.classList, cur = 'home';
        if (b.contains('universe-mode')) cur = 'galaxy';
        else if (b.contains('cp-mode')) cur = 'command';
        else if (b.contains('chat-mode')) cur = navVoice ? 'assistant' : 'workspace';
        else if (settingsOpen()) cur = 'settings';
        navBtns.forEach(function (btn) {
          btn.classList.toggle('active', btn.getAttribute('data-nav') === cur);
        });
      }
      navBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var key = btn.getAttribute('data-nav');
          if (key === 'home') {
            closeChat(); closeUniverse(); navVoice = false;
            if (window.ZZSettings && ZZSettings.close) ZZSettings.close();
            if (window.ZZCommandPalette && ZZCommandPalette.close) ZZCommandPalette.close();
          } else if (key === 'workspace') {
            closeUniverse(); openChat(); navVoice = false;
          } else if (key === 'assistant') {
            closeUniverse(); openChat(); navVoice = true;
            window.dispatchEvent(new CustomEvent('zz:voice-toggle', { detail: { listening: true } }));
          } else if (key === 'command') {
            if (window.ZZCommandPalette && ZZCommandPalette.open) ZZCommandPalette.open();
          } else if (key === 'galaxy') {
            closeChat(); openUniverse(); navVoice = false;
          } else if (key === 'settings') {
            if (window.ZZSettings && ZZSettings.open) ZZSettings.open();
          }
          syncNav();
        });
      });
      // 单一真相：body 类 / 设置面板 open 类变更 → 同步导航高亮
      var navObs = new MutationObserver(syncNav);
      navObs.observe(document.body, { attributes: true, attributeFilter: ['class'] });
      var sp = document.getElementById('settingsPanel');
      if (sp) navObs.observe(sp, { attributes: true, attributeFilter: ['class'] });
      syncNav();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bootOS);
    else bootOS();
  })();
  </script>
