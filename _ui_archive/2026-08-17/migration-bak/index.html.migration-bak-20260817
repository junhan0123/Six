          <button class="tts-stop-btn" id="btnTtsStop" title="停止播报" aria-label="停止播报">
            <svg viewBox="0 0 24 24" class="ic"><path d="M6 6h12v12H6z"/></svg>
            <span>停止</span>
          </button>
          <button class="wx-open-btn" id="wxOpenBtn" title="天气观测"><span class="ico"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-weather"/></svg></span><span class="lbl">天气</span></button>
          <button class="hs-open-btn" id="hsOpenBtn" title="实时热点"><span class="ico"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-signal"/></svg></span><span class="lbl">热点</span></button>
          <div class="more-menu-wrap" id="moreMenuWrap">
            <button class="more-open-btn" id="moreOpenBtn" title="更多功能"><span class="ico"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-kebab"/></svg></span><span class="lbl">更多</span></button>
            <div class="more-dropdown" id="moreDropdown" aria-hidden="true">
              <button class="more-item" data-task="sysmon"><span><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-monitor"/></svg></span><b>系统监控</b></button>
              <button class="more-item" data-task="terminal"><span><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-scroll"/></svg></span><b>终端日志</b></button>
              <button class="more-item" data-task="sysprompt"><span><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-receipt"/></svg></span><b>系统提示词</b></button>
              <button class="more-item" data-task="capabilities"><span><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-puzzle"/></svg></span><b>能力清单</b></button>
              <button class="more-item" data-panel="memory-center"><span><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-brain"/></svg></span><b>记忆中心</b></button>
              <button class="more-item" data-panel="aboutme"><span><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-id"/></svg></span><b>关于我</b></button>
              <button class="more-item" data-panel="capability-center"><span><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-puzzle"/></svg></span><b>能力中心</b></button>
              <button class="more-item" data-panel="self-awareness"><span><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-pulse"/></svg></span><b>自我认知</b></button>
              <button class="more-item" data-panel="execution"><span><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-play"/></svg></span><b>执行状态</b></button>
            </div>
          </div>
          <button class="profile-open-btn" id="profileOpenBtn" title="Agent 档案"><span class="ico"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-id"/></svg></span><span class="lbl">档案</span></button>
          <button class="settings-open-btn" id="settingsOpenBtn" title="设置"><span class="ico"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-gear"/></svg></span><span class="lbl">设置</span></button>
          <span class="proactive-chip" id="proactiveChip" data-count="0" title="小6主动发现"><i></i>小6主动发现</span>
          <span class="hud-state" id="stateBadge">待命</span>
        </div>
      </header>

