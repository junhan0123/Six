[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "zhuangzhou"
version = "0.1.0"
description = "庄周 · 本地个人 AI 副驾"
requires-python = ">=3.10"

# ---- Lint / Format / Type 门禁（CI 与 pre-commit 共用）----
[tool.ruff]
line-length = 120
target-version = "py310"
# 当前为单文件 god-file 过渡期，先放开部分规则，随模块化逐步收紧
lint.select = ["E", "F", "W", "I", "UP", "B", "C4", "SIM"]
lint.ignore = ["E501", "B008", "C401", "SIM105", "UP031", "C408", "SIM112", "SIM102"]
# UP031(百分号格式化) 属纯风格偏好，代码库统一使用 % 格式化，故忽略以免大规模无意义改动
# C408(dict() 字面量)/SIM112(环境变量大写)/SIM102(嵌套if) 均为风格类，按团队既有写法忽略

[tool.ruff.lint.per-file-ignores]
# e2e 脚本在文件末尾追加测试用 import，非模块顶部导入属有意为之
"e2e_*.py" = ["E402"]

[tool.black]
line-length = 120
target-version = ["py310"]

[tool.mypy]
python_version = "3.10"
ignore_missing_imports = true
warn_unused_ignores = false

# ---------------------------------------------------------------------------
# P0-A · 测试收集修复
# 历史测试文件命名为 *.test.py（如 phase40-capability-foundation.test.py）。
# 标准 pytest 的 python_files 仅认 test_*.py / *_test.py，导致约 17 个 *.test.py
# 在默认运行器下被静默跳过（"存在但未执行"）。此处统一收口：
#   1) python_files 显式纳入 *.test.py；
#   2) --import-mode=importlib 支持含连字符的文件名（phase40-capability-foundation.test）。
# 不重命名任何历史测试文件、不改动测试语义。
# ---------------------------------------------------------------------------
[tool.pytest.ini_options]
python_files = ["*.test.py", "test_*.py", "*_test.py"]
addopts = ["--import-mode=importlib"]
testpaths = ["tests"]
