<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>小6 · DeepSeek Harness</title>
<link rel="icon" href="./xiao6-icon.png" />
<style>
  /* ═════════════ DSH 真实浅色主题 ═════════════ */
  :root{
    --bg:#eef2f7;
    --sidebar:rgba(255,255,255,.82);
    --sidebar-border:rgba(0,0,0,.06);
    --card:rgba(255,255,255,.92);
    --card-solid:#fff;
    --text-primary:#111827;
    --text-secondary:#4b5563;
    --text-tertiary:#9ca3af;
    --accent:#4f46e5;
    --accent-hover:#4338ca;
    --accent-light:#e0e7ff;
    --border:rgba(0,0,0,.08);
    --hover:rgba(0,0,0,.04);
    --shadow:0 10px 40px rgba(0,0,0,.08);
    --radius:16px;
    --radius-sm:10px;
    --font:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei","Segoe UI",Roboto,sans-serif;
    --mono:"SFMono-Regular",ui-monospace,Menlo,Consolas,monospace;
  }
  *{box-sizing:border-box}
  html,body{height:100%;margin:0}
  body{
    background:var(--bg);
    color:var(--text-primary);font-family:var(--font);font-size:14px;
    display:flex;overflow:hidden;-webkit-font-smoothing:antialiased;
  }
  button,input,textarea,select{font-family:inherit;color:inherit}
  button{cursor:pointer;border:none;background:none}
  ::-webkit-scrollbar{width:8px;height:8px}
  ::-webkit-scrollbar-thumb{background:rgba(0,0,0,.12);border-radius:8px}
  ::-webkit-scrollbar-thumb:hover{background:rgba(0,0,0,.22)}
  ::-webkit-scrollbar-track{background:transparent}

  .app{display:flex;width:100%;height:100%}

  /* ───────── 左侧边栏 ───────── */
  .sidebar{
    width:268px;min-width:268px;height:100%;
    background:var(--sidebar);backdrop-filter:blur(14px);
    border-right:1px solid var(--sidebar-border);
    display:flex;flex-direction:column;position:relative;
    -webkit-app-region:drag;
  }
  .win-controls{
    position:absolute;top:10px;right:12px;display:flex;gap:8px;
    -webkit-app-region:no-drag;z-index:10;
  }
  .win-controls button{
    width:22px;height:22px;border-radius:50%;display:grid;place-items:center;
    font-size:12px;color:var(--text-secondary);transition:.15s;
  }
  .win-controls button:hover{background:var(--hover);color:var(--text-primary)}
  .brand{
    display:flex;align-items:center;gap:10px;padding:18px 18px 14px;
    -webkit-app-region:drag;
  }
  .logo-6{
    width:34px;height:34px;border-radius:9px;object-fit:cover;
    background:linear-gradient(135deg,#4f46e5,#7c3aed);
    display:block;
  }
  .brand-text{font-weight:700;font-size:16px;letter-spacing:-.3px}
  .brand-text .tag{
    font-size:10px;font-weight:700;color:#fff;background:#111827;
    padding:2px 5px;border-radius:4px;vertical-align:middle;margin-left:6px;
  }
  .new-chat{
    margin:0 16px 12px;padding:10px 14px;border-radius:var(--radius-sm);
    background:#fff;border:1px solid var(--border);font-weight:600;
    box-shadow:0 1px 2px rgba(0,0,0,.03);transition:.15s;
    -webkit-app-region:no-drag;
  }
  .new-chat:hover{background:var(--hover)}
  .plugin-center{
    display:flex;align-items:center;gap:8px;margin:0 16px 8px;
    padding:8px 10px;border-radius:var(--radius-sm);color:var(--text-secondary);
    font-size:13px;cursor:pointer;transition:.15s;
    -webkit-app-region:no-drag;
  }
  .plugin-center:hover{background:var(--hover);color:var(--text-primary)}
  .section-header{
    display:flex;align-items:center;justify-content:space-between;
    padding:10px 18px 6px;font-size:12px;font-weight:600;color:var(--text-tertiary);
    text-transform:uppercase;letter-spacing:.4px;
  }
  .section-actions{display:flex;gap:6px;-webkit-app-region:no-drag}
  .section-actions button{
    width:22px;height:22px;border-radius:5px;display:grid;place-items:center;
    color:var(--text-tertiary);font-size:12px;
  }
  .section-actions button:hover{background:var(--hover);color:var(--text-primary)}
  .tree{flex:1;overflow-y:auto;padding:0 12px 12px;-webkit-app-region:no-drag}
  .tree-item{
    display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:8px;
    cursor:pointer;color:var(--text-secondary);font-size:13px;transition:.12s;
    margin-bottom:2px;
  }
  .tree-item:hover{background:var(--hover);color:var(--text-primary)}
  .tree-item.active{background:var(--accent-light);color:var(--accent)}
  .tree-item .icon{font-size:14px;opacity:.75}
  .tree-item .time{margin-left:auto;font-size:11px;color:var(--text-tertiary)}
  .tree-folder{font-weight:600;color:var(--text-primary)}
  .tree-empty{padding:16px;text-align:center;color:var(--text-tertiary);font-size:12px}
  .bottom-actions{
    border-top:1px solid var(--sidebar-border);padding:10px 14px;
    display:flex;gap:8px;-webkit-app-region:no-drag;
  }
  .bottom-actions button{
    flex:1;display:flex;align-items:center;justify-content:center;gap:6px;
    padding:8px;border-radius:var(--radius-sm);font-size:13px;
    color:var(--text-secondary);transition:.15s;
  }
  .bottom-actions button:hover{background:var(--hover);color:var(--text-primary)}
  .bottom-actions button.active{background:var(--accent-light);color:var(--accent)}

  /* ───────── 主区域 ───────── */
  .main{flex:1;position:relative;overflow:hidden;display:flex;flex-direction:column}
  /* 顶部拖拽条：让整个 GUI 窗口可拖动（无边框时也能拖） */
  .dragbar{
    position:absolute;top:0;left:0;right:0;height:38px;z-index:6;
    -webkit-app-region:drag;background:transparent;
  }
  .dragbar .wc{
    position:absolute;right:10px;top:7px;display:flex;gap:8px;-webkit-app-region:no-drag;
  }
  .dragbar .wc button{
    width:22px;height:22px;border-radius:50%;display:grid;place-items:center;
    font-size:12px;color:var(--text-secondary);transition:.15s;
  }
  .dragbar .wc button:hover{background:var(--hover);color:var(--text-primary)}
  .view{display:none;flex:1;flex-direction:column;position:relative}
  .view.active{display:flex}

  /* 欢迎页 */
  .landing{align-items:center;justify-content:center;padding:40px}
  .landing-inner{
    width:100%;max-width:720px;text-align:center;
    display:flex;flex-direction:column;align-items:center;gap:18px;
  }
  .big-logo{
    width:72px;height:72px;border-radius:50%;
    background:#fff;display:grid;place-items:center;font-size:36px;
    box-shadow:var(--shadow);margin-bottom:4px;
  }
  .landing h1{
    font-size:32px;font-weight:700;margin:0;display:flex;align-items:center;gap:10px;
    color:var(--text-primary);
  }
  .badge{
    font-size:11px;font-weight:600;color:var(--accent);background:var(--accent-light);
    padding:3px 8px;border-radius:20px;border:1px solid rgba(79,70,229,.15);
  }
  .context-bar{
    display:flex;align-items:center;gap:12px;margin-bottom:6px;
    font-size:13px;color:var(--text-secondary);
  }
  .context-bar span{
    background:var(--card);border:1px solid var(--border);padding:5px 12px;border-radius:20px;
    display:flex;align-items:center;gap:6px;
  }

  /* 输入卡片 */
  .input-card{
    width:100%;max-width:720px;background:var(--card-solid);
    border:1px solid var(--border);border-radius:var(--radius);
    box-shadow:var(--shadow);display:flex;flex-direction:column;
    overflow:hidden;margin-top:6px;
  }
  .input-card textarea{
    width:100%;min-height:88px;max-height:220px;resize:none;
    border:none;outline:none;padding:18px 20px 10px;font-size:15px;
    background:transparent;line-height:1.55;
  }
  .input-card textarea::placeholder{color:var(--text-tertiary)}
  .input-toolbar{
    display:flex;align-items:center;gap:8px;padding:0 14px 8px;
  }
  .input-toolbar button{
    display:flex;align-items:center;gap:5px;padding:6px 10px;border-radius:8px;
    font-size:12px;color:var(--text-secondary);border:1px solid transparent;transition:.12s;
  }
  .input-toolbar button:hover{background:var(--hover)}
  .input-toolbar button.record.recording{background:#fee2e2;color:#dc2626;border-color:#fecaca;animation:pulse 1.2s infinite}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
  .input-footer{
    display:flex;align-items:center;justify-content:space-between;
    padding:10px 14px 14px;border-top:1px solid var(--border);
  }
  .model-select{
    padding:6px 10px;border-radius:8px;border:1px solid var(--border);
    background:#fff;font-size:13px;color:var(--text-secondary);outline:none;
  }
  .send{
    width:38px;height:38px;border-radius:50%;background:var(--accent);color:#fff;
    display:grid;place-items:center;font-size:16px;transition:.15s;
  }
  .send:hover{background:var(--accent-hover)}
  .send:disabled{opacity:.5;cursor:not-allowed}

  /* 聊天页 */
  .chat .messages{flex:1;overflow-y:auto;padding:52px 32px 24px}
  .msg{max-width:760px;margin:0 auto 18px;display:flex;gap:14px}
  .msg.user{flex-direction:row-reverse}
  .msg-avatar{
    width:32px;height:32px;border-radius:50%;display:grid;place-items:center;
    font-size:14px;flex-shrink:0;background:#fff;border:1px solid var(--border);
  }
  .msg.user .msg-avatar{background:var(--accent);color:#fff;border:none}
  .msg-body{max-width:calc(100% - 60px)}
  .msg-bubble{
    padding:12px 16px;border-radius:var(--radius-sm);background:#fff;
    border:1px solid var(--border);line-height:1.6;font-size:14px;
    box-shadow:0 1px 3px rgba(0,0,0,.03);
  }
  .msg.user .msg-bubble{background:var(--accent-light);border-color:rgba(79,70,229,.12)}
  .msg-bubble p{margin:0 0 8px}
  .msg-bubble p:last-child{margin-bottom:0}
  .msg-time{font-size:11px;color:var(--text-tertiary);margin-top:4px}
  .tool-card{
    max-width:760px;margin:0 auto 14px;padding:12px 14px;border-radius:var(--radius-sm);
    background:#fff;border:1px solid var(--border);font-size:13px;
  }
  .tool-card .tool-title{font-weight:600;color:var(--accent);margin-bottom:6px;display:flex;align-items:center;gap:6px}
  .tool-card pre{white-space:pre-wrap;font-family:var(--mono);font-size:12px;background:#f8fafc;padding:10px;border-radius:6px;margin:0;max-height:260px;overflow:auto}
  .typing{font-style:italic;color:var(--text-tertiary)}
  .chat .input-wrap{padding:16px 24px 24px;background:linear-gradient(to top,rgba(255,255,255,.95),transparent)}
  .chat .input-card{margin:0 auto;max-width:760px}

  /* 控制台页 */
  .console{flex-direction:row}
  .console-tabs{
    width:180px;min-width:180px;background:var(--sidebar);
    border-right:1px solid var(--sidebar-border);padding:18px 12px;
    display:flex;flex-direction:column;gap:4px;
  }
  .console-tabs button{
    text-align:left;padding:10px 12px;border-radius:10px;font-size:13px;
    color:var(--text-secondary);display:flex;align-items:center;gap:8px;transition:.12s;
  }
  .console-tabs button:hover{background:var(--hover);color:var(--text-primary)}
  .console-tabs button.active{background:var(--accent-light);color:var(--accent);font-weight:600}
  .console-body{flex:1;overflow-y:auto;padding:24px}
  .console-panel{max-width:980px;margin:0 auto}
  .console-panel h2{margin:0 0 16px;font-size:18px}
  .card-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;margin-bottom:18px}
  .console-card{
    background:var(--card-solid);border:1px solid var(--border);border-radius:var(--radius-sm);
    padding:14px;box-shadow:0 1px 3px rgba(0,0,0,.03);
  }
  .console-card h3{margin:0 0 10px;font-size:14px;color:var(--text-secondary);font-weight:600}
  .kv{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px dashed var(--border);font-size:13px}
  .kv:last-child{border-bottom:none}
  .kv .k{color:var(--text-secondary)}
  .kv .v{color:var(--text-primary);font-weight:500}
  .list-item{padding:10px 12px;border-radius:8px;background:#fff;border:1px solid var(--border);margin-bottom:8px;font-size:13px}
  .list-item .title{font-weight:600;margin-bottom:3px}
  .list-item .meta{font-size:11px;color:var(--text-tertiary)}
  .btn-sm{padding:5px 10px;border-radius:6px;background:var(--accent);color:#fff;font-size:12px}
  .btn-sm:hover{background:var(--accent-hover)}
  .btn-ghost{padding:5px 10px;border-radius:6px;border:1px solid var(--border);font-size:12px;color:var(--text-secondary);background:#fff}
  .btn-ghost:hover{background:var(--hover)}
  .toolbar{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap}
  .status-badge{display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:20px;font-size:12px;background:#fff;border:1px solid var(--border)}
  .dot{width:7px;height:7px;border-radius:50%;background:var(--text-tertiary)}
  .dot.ok{background:#22c55e}
  .dot.warn{background:#f59e0b}
  .dot.err{background:#ef4444}

  /* 响应 */
  @media(max-width:900px){.console{flex-direction:column}.console-tabs{width:100%;flex-direction:row;overflow-x:auto}}
</style>
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="win-controls">
      <button id="winMin" title="隐藏">−</button>
      <button id="winClose" title="关闭">×</button>
    </div>
    <div class="brand">
      <img class="logo-6" src="./xiao6-icon.png" alt="小6" />
      <div class="brand-text">小6 <span class="tag">HARNESS</span></div>
    </div>
    <button class="new-chat" id="btnNewChat">+ 新会话</button>
    <div class="plugin-center" id="btnPluginCenter">🧩 插件中心</div>
    <div class="section-header">
      <span>工作区</span>
      <div class="section-actions">
        <button id="btnSearchSession" title="搜索">🔍</button>
        <button id="btnListSession" title="列表">☰</button>
        <button id="btnAddFolder" title="新建">＋</button>
      </div>
    </div>
    <div class="tree" id="sessionTree">
      <div class="tree-empty">加载中…</div>
    </div>
    <div class="bottom-actions">
      <button id="btnConsole">🎛 控制台</button>
      <button id="btnSettings">⚙ 设置</button>
    </div>
  </aside>

  <main class="main">
    <div class="dragbar">
      <div class="wc">
        <button id="winMin2" title="隐藏">−</button>
        <button id="winClose2" title="关闭">×</button>
      </div>
    </div>
    <!-- 欢迎/输入页 -->
    <div class="view landing active" id="viewLanding">
      <div class="landing-inner">
        <div class="big-logo">🐋</div>
        <h1>探索未至之境 <span class="badge">预览版</span></h1>
        <div class="context-bar">
          <span>📁 <span id="ctxWorkspace">小6 Workspace</span></span>
          <span>⚡ <span id="ctxMode">标准模式</span></span>
        </div>
        <div class="input-card">
          <textarea id="inputLanding" placeholder="描述你想要构建的内容" rows="3"></textarea>
          <div class="input-toolbar">
            <button id="btnAttach" title="附件">＋ 附件</button>
            <button id="btnWorkspaceWrite">🛠 Workspace Write</button>
            <button id="btnVision">👁 视觉增强</button>
            <button id="btnMicLanding" class="record" title="语音对话">🎙 语音</button>
          </div>
          <div class="input-footer">
            <select class="model-select" id="modelLanding"><option>小6 · Qwen3</option></select>
            <button class="send" id="btnSendLanding" title="发送">➤</button>
          </div>
        </div>
      </div>
    </div>

    <!-- 对话页 -->
    <div class="view chat" id="viewChat">
      <div class="messages" id="messages"></div>
      <div class="input-wrap">
        <div class="input-card">
          <textarea id="inputChat" placeholder="描述你想要构建的内容…" rows="2"></textarea>
          <div class="input-toolbar">
            <button id="btnAttachChat">＋ 附件</button>
            <button id="btnWorkspaceWriteChat">🛠 Workspace Write</button>
            <button id="btnVisionChat">👁 视觉增强</button>
            <button id="btnMicChat" class="record" title="语音对话">🎙 语音</button>
          </div>
          <div class="input-footer">
            <select class="model-select" id="modelChat"><option>小6 · Qwen3</option></select>
            <button class="send" id="btnSendChat">➤</button>
          </div>
        </div>
      </div>
    </div>

    <!-- 控制台页 -->
    <div class="view console" id="viewConsole">
      <div class="console-tabs">
        <button data-tab="status" class="active">📊 状态</button>
        <button data-tab="memory">🧠 记忆库</button>
        <button data-tab="tasks">📋 任务</button>
        <button data-tab="caps">🛠 能力</button>
        <button data-tab="perception">👁 感知</button>
        <button data-tab="system">⚙ 系统</button>
      </div>
      <div class="console-body">
        <div class="console-panel" id="consolePanel"></div>
      </div>
    </div>
  </main>
</div>

<script>
(function(){
  'use strict';
  var API='http://127.0.0.1:8010';
  var $=function(s){return document.querySelector(s)};
  var $$=function(s){return document.querySelectorAll(s)};

  var state={
    sessions:[], currentSession:null, messages:[],
    consoleTab:'status', hud:{}, voice:false
  };
  var $panel=null;

  /* 路由 */
  function showView(name){
    $$('.view').forEach(function(v){v.classList.remove('active')});
    $('#view'+(name.charAt(0).toUpperCase()+name.slice(1))).classList.add('active');
    if(name==='console') renderConsole();
    if(name==='chat' && state.messages.length===0) appendWelcome();
  }

  /* 窗口控制 */
  function electron(name){ if(window.electronAPI && window.electronAPI[name]) window.electronAPI[name](); }
  $('#winMin').onclick=function(){electron('hide')};
  $('#winClose').onclick=function(){electron('close')};
  $('#winMin2').onclick=function(){electron('hide')};
  $('#winClose2').onclick=function(){electron('close')};

  /* 新建会话 */
  function newChat(){ state.currentSession=null; state.messages=[]; $('#messages').innerHTML=''; showView('landing'); $('#inputLanding').focus(); }
  $('#btnNewChat').onclick=newChat;

  /* 加载会话列表 */
  function loadSessions(){
    fetch(API+'/api/chat/history').then(function(r){return r.json()}).then(function(d){
      var list=(d&&d.history)||(d&&d.sessions)||(Array.isArray(d)?d:[]);
      state.sessions=list;
      renderTree();
    }).catch(function(){ state.sessions=[]; renderTree(); });
  }
  function renderTree(){
    var el=$('#sessionTree');
    if(!state.sessions.length){ el.innerHTML='<div class="tree-empty">暂无会话</div>'; return; }
    var html='<div class="tree-item tree-folder"><span class="icon">📁</span>workspace</div>';
    state.sessions.forEach(function(s,i){
      var id=s.id||s.session_id||i;
      var title=(s.title||s.summary||s.first_message||'新会话').toString().slice(0,26);
      var time=s.updated_at||s.created_at||'';
      if(time) time=time.slice(5,10);
      html+='<div class="tree-item '+(state.currentSession===id?'active':'')+'" data-id="'+id+'"><span class="icon">💬</span><span>'+escapeHtml(title)+'</span><span class="time">'+time+'</span></div>';
    });
    el.innerHTML=html;
    el.querySelectorAll('.tree-item[data-id]').forEach(function(it){
      it.onclick=function(){ openSession(it.dataset.id); };
    });
  }
  function openSession(id){
    state.currentSession=id;
    renderTree();
    showView('chat');
    fetch(API+'/api/chat/history').then(function(r){return r.json()}).then(function(d){
      var list=(d&&d.history)||(d&&d.sessions)||(Array.isArray(d)?d:[]);
      var sess=list.find(function(x){return (x.id||x.session_id)===id})||{};
      var msgs=(sess.messages)||[];
      state.messages=[]; $('#messages').innerHTML='';
      msgs.forEach(function(m){ addMessage(m.role||m.sender, m.content||m.text||''); });
    });
  }

  /* 欢迎语 */
  function appendWelcome(){
    addMessage('assistant','你好，我是小6。告诉我你想构建什么，我可以帮你写代码、查资料、管理任务或感知桌面。');
  }

  /* 消息渲染 */
  function escapeHtml(t){ return (t||'').replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]}) }
  function mdToHtml(t){ return escapeHtml(t).replace(/\n/g,'<br>'); }
  function addMessage(role,text){
    var isUser=role==='user';
    var div=document.createElement('div'); div.className='msg '+(isUser?'user':'assistant');
    div.innerHTML='<div class="msg-avatar">'+(isUser?'👤':'🐋')+'</div><div class="msg-body"><div class="msg-bubble"><p>'+mdToHtml(text)+'</p></div><div class="msg-time">'+new Date().toLocaleTimeString()+'</div></div>';
    $('#messages').appendChild(div);
    $('#messages').scrollTop=$('#messages').scrollHeight;
    state.messages.push({role:role,content:text});
  }
  function appendTool(name,args){
    var div=document.createElement('div'); div.className='tool-card';
    div.innerHTML='<div class="tool-title">🛠 '+escapeHtml(name)+'</div><pre>'+escapeHtml(JSON.stringify(args,null,2))+'</pre>';
    $('#messages').appendChild(div);
    $('#messages').scrollTop=$('#messages').scrollHeight;
  }
  function setTyping(show){
    var old=$('#typing'); if(old) old.remove();
    if(show){
      var div=document.createElement('div'); div.id='typing'; div.className='msg assistant';
      div.innerHTML='<div class="msg-avatar">🐋</div><div class="msg-body"><div class="msg-bubble"><span class="typing">思考中…</span></div></div>';
      $('#messages').appendChild(div);
      $('#messages').scrollTop=$('#messages').scrollHeight;
    }
  }

  /* 发送 */
  var busy=false;
  function send(text){
    if(busy||!text.trim()) return; busy=true;
    addMessage('user',text);
    showView('chat');
    setTyping(true);
    var body={message:text,stream:true};
    if(state.currentSession) body.session_id=state.currentSession;
    fetch(API+'/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
    .then(function(r){ return r.body; })
    .then(function(stream){
      var reader=stream.getReader(); var dec=new TextDecoder(); var buf=''; var assistantMsg='';
      var msgDiv=null;
      function push(){
        reader.read().then(function(res){
          if(res.done){ busy=false; setTyping(false); loadSessions(); return; }
          buf+=dec.decode(res.value,{stream:true});
          var lines=buf.split('\n'); buf=lines.pop();
          lines.forEach(function(line){
            if(!line.startsWith('data:')) return;
            var data=line.slice(5).trim(); if(!data||data==='[DONE]') return;
            try{
              var ev=JSON.parse(data);
              if(ev.zhuangzhou_event && ev.zhuangzhou_event.type){
                var t=ev.zhuangzhou_event;
                if(t.type==='tool_start') appendTool(t.tool||t.name,t.arguments||{});
                return;
              }
              var delta=(ev.choices&&ev.choices[0]&&ev.choices[0].delta&&ev.choices[0].delta.content)||'';
              if(delta){
                if(!msgDiv){
                  setTyping(false);
                  msgDiv=document.createElement('div'); msgDiv.className='msg assistant';
                  msgDiv.innerHTML='<div class="msg-avatar">🐋</div><div class="msg-body"><div class="msg-bubble"><p></p></div><div class="msg-time">'+new Date().toLocaleTimeString()+'</div></div>';
                  $('#messages').appendChild(msgDiv);
                }
                assistantMsg+=delta;
                msgDiv.querySelector('p').innerHTML=mdToHtml(assistantMsg);
                $('#messages').scrollTop=$('#messages').scrollHeight;
              }
            }catch(e){}
          });
          push();
        });
      }
      push();
    }).catch(function(err){ busy=false; setTyping(false); addMessage('assistant','请求出错：'+err.message); });
  }
  $('#btnSendLanding').onclick=function(){ send($('#inputLanding').value); $('#inputLanding').value=''; };
  $('#btnSendChat').onclick=function(){ send($('#inputChat').value); $('#inputChat').value=''; };
  $('#inputLanding').addEventListener('keydown',function(e){ if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();$('#btnSendLanding').click();} });
  $('#inputChat').addEventListener('keydown',function(e){ if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();$('#btnSendChat').click();} });

  /* 语音对话（连续 VAD） */
  var voice={active:false,ctx:null,analyser:null,src:null,stream:null,rec:null,silence:0,chunks:[],threshold:0.012};
  function toggleVoice(btn){
    if(voice.active){ stopVoice(btn); return; }
    navigator.mediaDevices.getUserMedia({audio:true}).then(function(s){
      voice.active=true; voice.stream=s; btn.classList.add('recording'); btn.textContent='🎙 录音中';
      voice.ctx=new (window.AudioContext||window.webkitAudioContext)();
      voice.src=voice.ctx.createMediaStreamSource(s);
      voice.analyser=voice.ctx.createAnalyser(); voice.analyser.fftSize=512;
      voice.src.connect(voice.analyser);
      voice.rec=new MediaRecorder(s,{mimeType:'audio/webm'});
      voice.chunks=[]; voice.silence=0;
      voice.rec.ondataavailable=function(e){ voice.chunks.push(e.data); };
      voice.rec.onstop=function(){ processVoiceBlob(new Blob(voice.chunks,{type:'audio/webm'})); };
      voice.rec.start(200);
      monitorVoice(btn);
    }).catch(function(err){ alert('麦克风不可用：'+err.message); });
  }
  function monitorVoice(btn){
    if(!voice.active) return;
    var data=new Uint8Array(voice.analyser.frequencyBinCount);
    voice.analyser.getByteTimeDomainData(data);
    var sum=0; for(var i=0;i<data.length;i++){ var v=(data[i]-128)/128; sum+=v*v; }
    var rms=Math.sqrt(sum/data.length);
    if(rms<voice.threshold){
      voice.silence+=200;
      if(voice.silence>1600 && voice.rec && voice.rec.state==='recording'){ voice.rec.stop(); }
    }else{ voice.silence=0; }
    setTimeout(function(){monitorVoice(btn);},200);
  }
  function stopVoice(btn){ voice.active=false; if(voice.rec&&voice.rec.state!=='inactive') voice.rec.stop(); if(voice.stream) voice.stream.getTracks().forEach(function(t){t.stop()}); if(voice.ctx) voice.ctx.close(); btn.classList.remove('recording'); btn.textContent='🎙 语音'; }
  function processVoiceBlob(blob){
    if(!blob.size){ stopVoice($('.record.recording')); return; }
    var fr=new FileReader();
    fr.onloadend=function(){
      var buf=fr.result;
      var wav=encodeWAV(buf,1,16000);
      fetch(API+'/api/asr',{method:'POST',headers:{'Content-Type':'audio/wav'},body:wav})
      .then(function(r){return r.json()}).then(function(d){
        var text=(d.text||d.transcript||d.content||'');
        if(text){ addMessage('user',text); send(text); }
      }).catch(function(){});
    };
    fr.readAsArrayBuffer(blob);
    // 重新开始下一段监听
    if(voice.active){
      voice.chunks=[]; voice.silence=0;
      voice.rec=new MediaRecorder(voice.stream,{mimeType:'audio/webm'});
      voice.rec.ondataavailable=function(e){ voice.chunks.push(e.data); };
      voice.rec.onstop=function(){ processVoiceBlob(new Blob(voice.chunks,{type:'audio/webm'})); };
      voice.rec.start(200);
    }
  }
  function encodeWAV(ab,channels,rate){
    // 简化：假设输入已是 16kHz mono pcm（webm 解码后由后端处理即可；这里转 blob 为 wav 头占位）
    // 后端 /api/asr 实际接受 wav，但 webm 若被后端支持也可直接传。为安全这里保留简化 wav 包装：
    var view=new DataView(ab);
    var buffer=new ArrayBuffer(44+ab.byteLength);
    var out=new DataView(buffer);
    function writeString(off,str){ for(var i=0;i<str.length;i++) out.setUint8(off+i,str.charCodeAt(i)); }
    writeString(0,'RIFF'); out.setUint32(4,36+ab.byteLength,true); writeString(8,'WAVE');
    writeString(12,'fmt '); out.setUint32(16,16,true); out.setUint16(20,1,true); out.setUint16(22,channels,true);
    out.setUint32(24,rate,true); out.setUint32(28,rate*channels*2,true); out.setUint16(32,channels*2,true); out.setUint16(34,16,true);
    writeString(36,'data'); out.setUint32(40,ab.byteLength,true);
    for(var i=0;i<ab.byteLength;i++) out.setUint8(44+i,view.getUint8(i));
    return new Blob([out],{type:'audio/wav'});
  }
  $$('.record').forEach(function(btn){ btn.onclick=function(){ toggleVoice(btn); }; });

  /* 控制台 */
  $('#btnConsole').onclick=function(){
    state.consoleTab='status'; showView('console');
    $$('.bottom-actions button').forEach(function(b){b.classList.remove('active')});
    $('#btnConsole').classList.add('active');
  };
  $('#btnSettings').onclick=function(){
    // 设置暂跳控制台 system 页
    state.consoleTab='system'; showView('console');
    $$('.bottom-actions button').forEach(function(b){b.classList.remove('active')});
  };
  $$('.console-tabs button').forEach(function(btn){
    btn.onclick=function(){
      state.consoleTab=btn.dataset.tab;
      $$('.console-tabs button').forEach(function(b){b.classList.remove('active')});
      btn.classList.add('active'); renderConsole();
    };
  });
  function renderConsole(){
    $panel=$('#consolePanel'); $panel.innerHTML='<div style="text-align:center;color:var(--text-tertiary);padding:40px">加载中…</div>';
    switch(state.consoleTab){
      case 'status': loadStatus(); break;
      case 'memory': loadMemory(); break;
      case 'tasks': loadTasks(); break;
      case 'caps': loadCaps(); break;
      case 'perception': loadPerception(); break;
      case 'system': loadSystem(); break;
    }
  }
  function card(title,rows){
    var h='<div class="console-card"><h3>'+title+'</h3>';
    rows.forEach(function(r){ h+='<div class="kv"><span class="k">'+r.k+'</span><span class="v">'+r.v+'</span></div>'; });
    return h+'</div>';
  }
  function loadStatus(){
    Promise.all([
      fetch(API+'/api/hud/state').then(function(r){return r.json()}).catch(function(){return {}}),
      fetch(API+'/api/boot/state').then(function(r){return r.json()}).catch(function(){return {}}),
      fetch(API+'/api/agent/state').then(function(r){return r.json()}).catch(function(){return {}}),
      fetch(API+'/api/health').then(function(r){return r.json()}).catch(function(){return {}})
    ]).then(function(arr){
      var h=arr[0],b=arr[1],a=arr[2],he=arr[3];
      var rows=[
        {k:'后端健康',v:(he.status||he.healthy||'OK')+' <span class="dot ok"></span>'},
        {k:'HUD 状态',v:h.state||h.mode||'—'},
        {k:'启动阶段',v:b.phase||b.boot_phase||'—'},
        {k:'Agent 状态',v:a.state||a.status||'—'},
        {k:'当前时间',v:new Date().toLocaleString()}
      ];
      $panel.innerHTML='<h2>运行状态</h2><div class="card-grid">'+card('小6 核心',rows)+'</div>';
    });
  }
  function loadMemory(){
    Promise.all([
      fetch(API+'/api/memories').then(function(r){return r.json()}).catch(function(){return []}),
      fetch(API+'/api/memory/query',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'}).then(function(r){return r.json()}).catch(function(){return {}})
    ]).then(function(arr){
      var mems=arr[0], q=arr[1];
      var html='<h2>记忆库</h2><div class="toolbar"><input type="text" id="memQuery" placeholder="搜索记忆…" style="flex:1;padding:8px 12px;border-radius:8px;border:1px solid var(--border);max-width:360px"><button class="btn-sm" id="btnMemSearch">搜索</button></div>';
      var list=Array.isArray(mems)?mems:(mems.memories||[]);
      if(!list.length){ html+='<p style="color:var(--text-tertiary)">暂无记忆</p>'; }
      else{
        html+='<div class="card-grid">';
        list.slice(0,20).forEach(function(m){
          html+=card(escapeHtml((m.title||m.summary||'记忆').slice(0,30)),[
            {k:'内容',v:escapeHtml((m.content||m.text||'—').toString().slice(0,80))},
            {k:'时间',v:m.created_at||m.updated_at||'—'}
          ]);
        });
        html+='</div>';
      }
      $panel.innerHTML=html;
      $('#btnMemSearch').onclick=function(){
        var qv=$('#memQuery').value;
        fetch(API+'/api/memory/query',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({query:qv})}).then(function(r){return r.json()}).then(function(d){
          // 仅刷新：简化处理
          loadMemory();
        });
      };
    });
  }
  function loadTasks(){
    Promise.all([
      fetch(API+'/api/tasks').then(function(r){return r.json()}).catch(function(){return []}),
      fetch(API+'/api/goals').then(function(r){return r.json()}).catch(function(){return []})
    ]).then(function(arr){
      var tasks=Array.isArray(arr[0])?arr[0]:(arr[0].tasks||[]);
      var goals=Array.isArray(arr[1])?arr[1]:(arr[1].goals||[]);
      var html='<h2>任务与目标</h2>';
      html+='<h3 style="color:var(--text-secondary);margin:18px 0 10px">目标</h3>';
      if(!goals.length) html+='<p style="color:var(--text-tertiary)">暂无目标</p>';
      goals.forEach(function(g){ html+='<div class="list-item"><div class="title">'+escapeHtml(g.title||g.name||'未命名目标')+'</div><div class="meta">'+(g.status||'进行中')+' · '+(g.progress||'0%')+'</div></div>'; });
      html+='<h3 style="color:var(--text-secondary);margin:24px 0 10px">任务</h3>';
      if(!tasks.length) html+='<p style="color:var(--text-tertiary)">暂无任务</p>';
      tasks.forEach(function(t){ html+='<div class="list-item"><div class="title">'+escapeHtml(t.title||t.name||'未命名任务')+'</div><div class="meta">'+(t.status||'待办')+' · '+(t.due||'无截止日期')+'</div></div>'; });
      $panel.innerHTML=html;
    });
  }
  function loadCaps(){
    Promise.all([
      fetch(API+'/api/capabilities').then(function(r){return r.json()}).catch(function(){return {}}),
      fetch(API+'/api/capability_os/catalog').then(function(r){return r.json()}).catch(function(){return {}})
    ]).then(function(arr){
      var items=(arr[0].items||arr[0].capabilities||[]);
      var os=(arr[1].items||arr[1].tools||[]);
      var html='<h2>能力清单</h2>';
      if(items.length){
        html+='<div class="card-grid">';
        items.forEach(function(c){ html+=card(escapeHtml(c.name||c.label||c.id||'能力'),[{k:'描述',v:escapeHtml(c.description||'—')},{k:'ID',v:escapeHtml(c.id||c.tool||'—')}]); });
        html+='</div>';
      }
      if(os.length){
        html+='<h3 style="color:var(--text-secondary);margin:24px 0 10px">OS 工具</h3><div class="card-grid">';
        os.forEach(function(c){ html+=card(escapeHtml(c.name||c.label||c.id||'工具'),[{k:'描述',v:escapeHtml(c.description||'—')}]); });
        html+='</div>';
      }
      if(!items.length&&!os.length) html+='<p style="color:var(--text-tertiary)">未获取到能力列表</p>';
      $panel.innerHTML=html;
    });
  }
  function loadPerception(){
    var html='<h2>感知</h2><div class="toolbar">'+
      '<button class="btn-sm" id="percScreen">🖥 屏幕截图</button>'+
      '<button class="btn-ghost" id="percDesc">📝 描述屏幕</button>'+
      '<button class="btn-ghost" id="percWindow">🪟 当前窗口</button>'+
      '<button class="btn-ghost" id="percOcr">🔍 OCR</button>'+
      '</div><div id="percResult"></div>';
    $panel.innerHTML=html;
    function percShot(){
      $('#percResult').innerHTML='<p style="color:var(--text-tertiary)">截图中…</p>';
      fetch(API+'/api/perception/screen').then(function(r){return r.blob()}).then(function(b){
        var url=URL.createObjectURL(b);
        $('#percResult').innerHTML='<img src="'+url+'" style="max-width:100%;border-radius:10px;border:1px solid var(--border)">';
      }).catch(function(e){ $('#percResult').innerHTML='<p style="color:#dc2626">截图失败：'+e.message+'</p>'; });
    }
    $('#percScreen').onclick=percShot;
    $('#percDesc').onclick=function(){
      $('#percResult').innerHTML='<p style="color:var(--text-tertiary)">描述中…</p>';
      fetch(API+'/api/perception/describe').then(function(r){return r.json()}).then(function(d){ $('#percResult').innerHTML='<div class="console-card"><p>'+escapeHtml(d.description||d.text||JSON.stringify(d))+'</p></div>'; }).catch(function(e){ $('#percResult').innerHTML='<p style="color:#dc2626">失败：'+e.message+'</p>'; });
    };
    $('#percWindow').onclick=function(){
      $('#percResult').innerHTML='<p style="color:var(--text-tertiary)">识别中…</p>';
      fetch(API+'/api/perception/window').then(function(r){return r.json()}).then(function(d){ $('#percResult').innerHTML='<div class="console-card"><pre>'+escapeHtml(JSON.stringify(d,null,2))+'</pre></div>'; }).catch(function(e){ $('#percResult').innerHTML='<p style="color:#dc2626">失败：'+e.message+'</p>'; });
    };
    $('#percOcr').onclick=function(){
      $('#percResult').innerHTML='<p style="color:var(--text-tertiary)">识别中…</p>';
      fetch(API+'/api/perception/ocr').then(function(r){return r.json()}).then(function(d){ $('#percResult').innerHTML='<div class="console-card"><pre>'+escapeHtml(JSON.stringify(d,null,2))+'</pre></div>'; }).catch(function(e){ $('#percResult').innerHTML='<p style="color:#dc2626">失败：'+e.message+'</p>'; });
    };
  }
  function loadSystem(){
    Promise.all([
      fetch(API+'/api/health').then(function(r){return r.json()}).catch(function(){return {}}),
      fetch(API+'/api/version').then(function(r){return r.json()}).catch(function(){return {}}),
      fetch(API+'/api/devices').then(function(r){return r.json()}).catch(function(){return {}}),
      fetch(API+'/api/calendar/next').then(function(r){return r.json()}).catch(function(){return {}}),
      fetch(API+'/api/config').then(function(r){return r.json()}).catch(function(){return {}})
    ]).then(function(arr){
      var he=arr[0],v=arr[1],dev=arr[2],cal=arr[3],cfg=arr[4];
      var html='<h2>系统信息</h2><div class="card-grid">';
      html+=card('健康与版本',[
        {k:'健康',v:he.status||he.healthy||'OK'},
        {k:'版本',v:((v&&v.version)||(v&&v.ver)||'—')},
        {k:'运行端口',v:'8010'}
      ]);
      var devs=Array.isArray(dev)?dev:(dev.devices||[]);
      html+=card('设备',devs.length?[{k:'设备',v:devs.map(function(d){return (d.name||d.id||'设备');}).join(', ')}]:[{k:'设备',v:'—'}]);
      html+='</div>';
      html+='<h3 style="color:var(--text-secondary);margin:24px 0 10px">配置 / 日历</h3><div class="card-grid">';
      html+=card('配置',Object.keys(cfg).length?Object.keys(cfg).map(function(k){return {k:k,v:JSON.stringify(cfg[k]).slice(0,40)};}):[{k:'配置','v':'—'}]);
      html+=card('下一个日程',[
        {k:'标题',v:(cal.title||cal.summary||'—')},
        {k:'时间',v:(cal.start||cal.time||'—')}
      ]);
      html+='</div>';
      $panel.innerHTML=html;
    });
  }

  /* 启动 */
  loadSessions();
  showView('landing');
  $('#inputLanding').focus();
})();
