// 庄周 · 主界面语音球（移植自参考实现 voice-core.js 点阵球渲染）
// 复用 cognitive.html 的 voice-orb-simple.js，由 app.js 的 setOrb() 状态机驱动。
// 对外暴露 window.ZZAvatar（主接口）与兼容别名 window.ZZEarth（承接旧地理定位调用）。

import { createVoiceOrb } from './voice-orb-simple.js?v=20260801b';

const $ = (sel) => document.querySelector(sel);

function init() {
  const canvas = document.getElementById('earth');
  if (!canvas) return;
  const orbWrap = document.getElementById('orbWrap');
  // 全状态 class 映射：让 voice-orb 内部自动回退（done→idle、event→idle）也能反映到 DOM
  const ORB_STATES = ['idle', 'listening', 'thinking', 'processing', 'speaking', 'done', 'event', 'error'];
  function applyOrbState(sk) {
    if (!orbWrap) return;
    ORB_STATES.forEach((s) => orbWrap.classList.remove(s));
    orbWrap.classList.add(sk);
  }

  const orb = createVoiceOrb({
    canvas,
    statusEl: null,
    transcriptEl: null,
    onState: applyOrbState,
  });

  // 首次出现：从 idle 渐入
  orb.start();
  orb.setStatus('idle', '就绪');

  const api = {
    setState(mode) {
      // mode: idle | thinking | speaking
      const statusText = { idle: '就绪', listening: '聆听中', thinking: '思考中', speaking: '回应中' }[mode] || mode;
      orb.setStatus(mode, statusText);
    },
    setTranscript(text) {
      orb.setTranscript(text);
    },
    setVolume(v) {
      orb.setVolume(v);
    },
    // 兼容旧地球组件的地理定位调用：仅更新定位浮标文案
    setLocation(lat, lon, place) {
      const locTxt = document.getElementById('locTxt');
      if (!locTxt) return;
      const p = place || '';
      const latS = lat == null ? '--' : Number(lat).toFixed(2);
      const lonS = lon == null ? '--' : Number(lon).toFixed(2);
      locTxt.innerHTML = `<b>${p}</b> <span class="loc-wx">${latS}°, ${lonS}°</span>`;
    },
    triggerAppear() {
      orb.setStatus('event', '上线');
      setTimeout(() => orb.setStatus('idle', '就绪'), 900);
    },
  };

  window.ZZAvatar = api;
  window.ZZEarth = api; // 向后兼容 app.js 中的 window.ZZEarth.setLocation
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}
