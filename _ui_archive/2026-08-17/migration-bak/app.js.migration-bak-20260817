  /* ---------- 主动智能：语音球附近的通知气泡（舆情/天气/告警） ---------- */
  function renderNotifyBubble(kind, content, ts) {
    // 主动推送改为后台静默运行：不再在语音球旁弹出气泡，仅写入右侧遥测面板的
