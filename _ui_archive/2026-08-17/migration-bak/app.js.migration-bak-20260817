  }

  /* ---------- 发送 ---------- */
  async function send(rawText) {
    const text = (rawText != null ? rawText : input.value).trim();
    const hasImages = pendingImages.length > 0;
    if ((!text && !hasImages) || state.streaming) return;

    input.value = '';
    input.style.height = 'auto';
    const userLabel = text || (hasImages ? '<svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-camera"/></svg> 图片输入' : '');
    addMessage('user', userLabel);
    state.messages.push({ role: 'user', content: userLabel });
    ensureTitle(userLabel);
    persistHistory();
    chatUpdateCbs.forEach(fn => { try { fn(); } catch (e) { console.warn(e); } });
    const imagesPayload = pendingImages.slice();
    pendingImages = [];
    _renderImagePreviews();
    state.turns++;

    const bubble = addMessage('zhuangzhou', '', true);
    setOrb('thinking');
    if (window.ZZCognitiveFeed) window.ZZCognitiveFeed.beginTurn(text);
    btnSend.disabled = true;
    state.streaming = true;
    if (window.ExecutionChannel) window.ExecutionChannel.startExecution(text); // Execution Channel：开启本次执行 episode
    const t0 = performance.now();
    let ttfb = null;
    let buf = '';
    let full = '';
    let streamDone = false;
    const controller = new AbortController();
    const abortTimer = setTimeout(() => controller.abort(), 120000);

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          messages: state.messages,
          session_id: SESSION_ID,
          temperature: state.temperature,
          reasoning: state.reasoning,
          images: imagesPayload,
        }),
        signal: controller.signal,
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      setOrb('speaking');
      if (window.ZZCognitiveFeed) window.ZZCognitiveFeed.speaking();

      while (true) {
        const { value, done } = await reader.read();
        if (done || streamDone) break;
        buf += decoder.decode(value, { stream: true });
        const lines = buf.split('\n');
        buf = lines.pop();
        for (const line of lines) {
          const s = line.trim();
          if (!s.startsWith('data:')) continue;
          const payload = s.slice(5).trim();
          if (payload === '[DONE]') { streamDone = true; break; }
          try {
            const json = JSON.parse(payload);
            if (json.zhuangzhou_event) { handleToolEvent(json); continue; }
            const delta = json.choices?.[0]?.delta?.content || '';
            const usage = json.usage;
            if (delta) {
              if (ttfb === null) {
                ttfb = Math.round(performance.now() - t0);
                $('#mLatency').textContent = '首token ' + ttfb + 'ms';
              }
              full += delta;
              if (window.ZZCognitiveFeed) window.ZZCognitiveFeed.appendReply(delta);
              chatStreamCbs.forEach(fn => { try { fn(delta); } catch (e) { console.warn(e); } });
            }
            if (usage && usage.total_tokens) {
              state.tokens += usage.total_tokens;
              $('#mTokens').textContent = state.tokens;
            }
          } catch (_) {}
        }
      }
      if (!full) {
        bubble.innerHTML = '<span style="color:var(--dim)">（无回复）</span>';
      } else {
        typewriter(bubble, cleanReply(full));
        if (window.ZZCognitiveFeed) window.ZZCognitiveFeed.endTurn();
      }
      state.messages.push({ role: 'zhuangzhou', content: cleanReply(full) });
      persistHistory();
    } catch (e) {
      if (e && e.name === 'AbortError') {
        bubble.innerHTML = '<span style="color:var(--amber)">响应超时（120s），已自动恢复，可重试。</span>';
      } else {
        bubble.innerHTML = '<span style="color:var(--red)">核心连接失败：' + escapeHtml(e.message) + '</span>';
      }
      toast('与小6核心通信异常 — 请确认 server.py 已启动');
    } finally {
      clearTimeout(abortTimer);
      if (!full) setOrb('idle');
      btnSend.disabled = false;
      state.streaming = false;
      if (window.ExecutionChannel) window.ExecutionChannel.completeExecution(); // Execution Channel：收尾 episode
      const ms = Math.round(performance.now() - t0);
      $('#mLatency').textContent = (ttfb !== null ? ('首token ' + ttfb + 'ms / ') : '') + '总 ' + ms + 'ms';
      $('#mTurns').textContent = state.turns;
      refreshMemory();
      if (state.autoTts && full) speak(full);
      // 流式结束：若用户未悬停聊天区，数秒后自动收起对话历史
      scheduleCloseChat(5000);
      chatUpdateCbs.forEach(fn => { try { fn(); } catch (e) { console.warn(e); } });
    }
  }

  /* ---------- 事件绑定 ---------- */

  // 聊天区：输入坞常驻，对话历史默认隐藏；仅点击/聚焦输入框时展开（不再随鼠标悬停出现）
  const chatArea = $('#chatArea');
  const chatHistory = $('#chatHistory');
  let chatCloseTimer = null;
  function isHoveringChat() { return !!(chatArea && chatArea.matches(':hover')); }
  function isTyping() { return document.activeElement === input; }
  function revealChat() {
    if (!chatArea) return;
    clearTimeout(chatCloseTimer);
    chatArea.classList.add('open');
  }
  function scheduleCloseChat(ms = 5000) {
    if (!chatArea) return;
    if (state.streaming || isHoveringChat() || isTyping()) return;
    clearTimeout(chatCloseTimer);
    chatCloseTimer = setTimeout(() => {
      if (state.streaming || isHoveringChat() || isTyping()) return;
      chatArea.classList.remove('open');
    }, ms);
  }
  if (chatArea) {
    // 仅点击/聚焦输入框时展开对话历史；已移除鼠标悬停(mouseenter/mouseleave)触发
    const revealOnInput = () => { clearTimeout(chatCloseTimer); revealChat(); };
    input.addEventListener('click', revealOnInput);
    input.addEventListener('focus', revealOnInput);
  }
  // 点击聊天区之外收起（非流式、输入框未聚焦时）
  document.addEventListener('pointerdown', (e) => {
    if (!chatArea) return;
    if (chatArea.contains(e.target)) return;
    if (state.streaming || isTyping()) return;
    clearTimeout(chatCloseTimer);
    chatArea.classList.remove('open');
  });

  // ── 滚轮滚动历史消息：鼠标不在背景层时，若当前没有前置可滚动层，则滚动聊天历史 ──
  document.addEventListener('wheel', (e) => {
    if (!chatArea || !chatHistory) return;
    const path = e.composedPath ? e.composedPath() : [e.target];
    // 忽略背景层（太阳系画布 / 粒子背景 / 扫描线）
    const isBackground = path.some((el) => {
      if (!(el instanceof Element)) return false;
      return el.id === 'solarCanvas' ||
        el.classList.contains('bg-glow') ||
        el.classList.contains('premium-bg') ||
        el.classList.contains('scanlines');
    });
    if (isBackground) return;
    // 若指针下已有可滚动的最上层容器，交给浏览器原生滚动
    for (const el of path) {
      if (!(el instanceof Element)) continue;
      if (el === document.body || el === document.documentElement) break;
      const style = window.getComputedStyle(el);
      const overflowY = style.overflowY;
      if ((overflowY === 'auto' || overflowY === 'scroll') && el.scrollHeight > el.clientHeight + 2) {
        return; // 让最上层窗口自己滚动
      }
    }
    // 否则把滚轮派发给聊天历史（最上层对话窗口）
    e.preventDefault();
    if (!chatArea.classList.contains('open')) revealChat();
    chatHistory.scrollBy({ top: e.deltaY, behavior: 'smooth' });
    scheduleCloseChat(6000);
  }, { passive: false });

  btnSend.addEventListener('click', () => send());
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
  });
  document.addEventListener('keydown', (e) => {
    if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
    if (e.ctrlKey || e.metaKey) {
      if (e.key.toLowerCase() === 'n') { e.preventDefault(); $('#btnNew')?.click(); }
      if (e.key === ',') { e.preventDefault(); window.ZZSettings?.open(); }
      if (e.key === '/') { e.preventDefault(); input.focus(); }
    }
  });
  input.addEventListener('input', () => {
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 120) + 'px';
  });
  const inputDock = input.closest('.dock');
  if (inputDock) {
    input.addEventListener('focus', () => inputDock.classList.add('focus-within'));
    input.addEventListener('blur', () => inputDock.classList.remove('focus-within'));
  }
  $('#btnNew').addEventListener('click', () => { newSession(); });

  // ============================================================
  // 语音实时对话：点一下开启（持续聆听 + 静音自动断句 → 自动识别 → 自动回复 → 恢复聆听），再点一下关闭
  // ============================================================
  const SPEECH_RMS = 0.014;     // 判定为「在说话」的 RMS 阈值（时域）
  const SILENCE_MS = 1000;      // 连续静音超过此时长 → 判定一句话结束，触发识别
  const MAX_UTTER_MS = 20000;   // 单句最长时长，超时强制断句
  const INTERRUPT_RMS = 0.03;   // 朗读中被用户开口打断的 RMS 阈值（高于聆听阈值，防扬声器回声误触发）

  function _createMicOverlay() {
    if (_mic.overlay) return _mic.overlay;
    const el = document.createElement('div');
    el.className = 'mic-overlay';
    el.innerHTML = `
      <div class="mic-overlay-card">
        <button class="mic-overlay-close" type="button" aria-label="结束语音对话">×</button>
        <div class="mic-overlay-orb">
          <svg viewBox="0 0 24 24" class="ic"><path d="M12 14a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v5a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.9V21h2v-3.1A7 7 0 0 0 19 11h-2Z"/></svg>
          <div class="mic-overlay-waves" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        </div>
        <div class="mic-overlay-meta">
          <div class="mic-overlay-title">聆听中</div>
          <div class="mic-overlay-sub">请说话，说完自动识别</div>
        </div>
      </div>`;
    el.querySelector('.mic-overlay-close')?.addEventListener('click', () => _stopVoiceMode());
    document.body.appendChild(el);
    _mic.overlay = el;
    _mic.hudTitle = el.querySelector('.mic-overlay-title');
    _mic.hudSub = el.querySelector('.mic-overlay-sub');
    _mic.hudBars = el.querySelectorAll('.mic-overlay-waves i');
    return el;
  }

  function _updateHud(title, sub, mode) {
    const el = _createMicOverlay();
    if (title && _mic.hudTitle) _mic.hudTitle.textContent = title;
    if (sub && _mic.hudSub) _mic.hudSub.textContent = sub;
    el.classList.toggle('recognizing', mode === 'recognizing');
    el.classList.toggle('speaking', mode === 'speaking');
    el.classList.toggle('listening', mode !== 'recognizing' && mode !== 'speaking');
  }

  function _showMicOverlay() {
    _createMicOverlay().classList.add('show');
  }

  function _hideMicOverlay() {
    if (_mic.overlay) _mic.overlay.classList.remove('show');
  }

  // 时域 RMS：用于判断是否在说话
  function _computeRms() {
    if (!_mic.analyser || !_mic.timeData) return 0;
    try {
      _mic.analyser.getByteTimeDomainData(_mic.timeData);
      let sum = 0;
      for (let i = 0; i < _mic.timeData.length; i++) {
        const v = (_mic.timeData[i] - 128) / 128;
        sum += v * v;
      }
      return Math.sqrt(sum / _mic.timeData.length);
    } catch (_) { return 0; }
  }

  // 实时对话主循环：驱动波形 + VAD 断句
  function _voiceLoop() {
    if (!_mic.listening) return;
    // 波形（频域）
    if (_mic.analyser && _mic.dataArray && _mic.hudBars) {
      try {
        _mic.analyser.getByteFrequencyData(_mic.dataArray);
        const step = Math.max(1, Math.floor(_mic.dataArray.length / _mic.hudBars.length));
        _mic.hudBars.forEach((bar, i) => {
          const v = _mic.dataArray[i * step] || 0;
          bar.style.height = Math.max(3, Math.min(22, v / 6)) + 'px';
        });
      } catch (_) {}
    }
    if (_mic.finalizing || _mic.suspended === true) {
      // 识别/思考中：丢弃麦克风音频，避免回声被二次捕获
      if (_mic.suspended === true) _mic.pcmBuffers = [];
    } else if (_mic.suspended === 'speaking') {
      // 小6朗读中：监听用户是否开口，检测到即打断（连续 3 帧超阈值去抖，防噪声毛刺误触发）
      const rms = _computeRms();
      if (rms > INTERRUPT_RMS) {
        _mic.interruptHits = (_mic.interruptHits || 0) + 1;
        if (_mic.interruptHits >= 3) _interruptSpeaking();
      } else {
        _mic.interruptHits = 0;
      }
    } else {
      const rms = _computeRms();
      if (rms > SPEECH_RMS) {
        _mic.speechActive = true;
        _mic.lastSpeechTs = Date.now();
        if (!_mic.utterStartTs) _mic.utterStartTs = Date.now();
      }
      if (_mic.speechActive) {
        const sinceSil = Date.now() - _mic.lastSpeechTs;
        const sinceStart = Date.now() - _mic.utterStartTs;
        if (sinceSil > SILENCE_MS || sinceStart > MAX_UTTER_MS) {
          _mic.utterStartTs = 0;
          _mic.speechActive = false;
          _finalizeUtterance(); // 异步；由 finalizing 标志防重入
        }
      } else {
        // 静默期：限制缓冲上限（约 20s）防内存膨胀；断句由上方 SILENCE_MS 触发，不会误删有效语音
        const _rate = _mic.audioCtx ? _mic.audioCtx.sampleRate : 16000;
        const _max = Math.ceil(20 * _rate / 4096);
        if (_mic.pcmBuffers.length > _max) {
          _mic.pcmBuffers.splice(0, _mic.pcmBuffers.length - _max);
        }
      }
    }
    _mic.raf = requestAnimationFrame(_voiceLoop);
  }

  function _setupAnalyser() {
    try {
      if (!_mic.stream) return;
      _mic.audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const src = _mic.audioCtx.createMediaStreamSource(_mic.stream);
      _mic.src = src;
      const analyser = _mic.audioCtx.createAnalyser();
      analyser.fftSize = 64;
      src.connect(analyser);
      _mic.analyser = analyser;
      _mic.dataArray = new Uint8Array(analyser.frequencyBinCount);
      _mic.timeData = new Uint8Array(analyser.fftSize);
    } catch (_) {}
  }

  function _closeAudioCtx() {
    try {
      if (_mic.processor) { try { _mic.processor.disconnect(); } catch (_) {} _mic.processor = null; }
      if (_mic.sink) { try { _mic.sink.disconnect(); } catch (_) {} _mic.sink = null; }
      if (_mic.src) { try { _mic.src.disconnect(); } catch (_) {} _mic.src = null; }
      if (_mic.audioCtx && _mic.audioCtx.state !== 'closed') {
        _mic.audioCtx.close();
      }
    } catch (_) {}
    _mic.audioCtx = null;
    _mic.analyser = null;
    _mic.dataArray = null;
    _mic.timeData = null;
  }

  // 进入语音实时对话模式：持续录音 + VAD 自动断句
  async function _startVoiceMode() {
    if (_mic.listening) return;
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      toast('当前环境不支持麦克风录音（需 HTTPS 或 localhost）');
      return;
    }
    try {
      _mic.stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    } catch (e) {
      toast(e && e.name === 'NotAllowedError' ? '麦克风权限被拒绝' : '无法访问麦克风');
      return;
    }
    _mic.pcmBuffers = [];
    _mic.listening = true;
    _mic.suspended = false;
    _mic.finalizing = false;
    _mic.speechActive = false;
    _mic.lastSpeechTs = 0;
    _mic.utterStartTs = 0;
    _mic.interrupted = false;
    _mic.interruptHits = 0;
    btnMic.classList.add('recording');
    btnMic.title = '点击结束语音对话';
    setOrb('listening');
    _setupAnalyser();
    // PCM 实时采集：经 ScriptProcessorNode 抓 Float32 PCM，零 ffmpeg 依赖
    // （增益 0 接 destination，仅为驱动 onaudioprocess，避免麦克风回放回声）
    if (_mic.src && _mic.audioCtx) {
      try {
        const processor = _mic.audioCtx.createScriptProcessor(4096, 1, 1);
        const sink = _mic.audioCtx.createGain();
        sink.gain.value = 0;
        processor.onaudioprocess = (e) => {
          // 仅在「聆听中(suspended=false)」或「朗读中可被打断(suspended='speaking')」采集 PCM；
          // 识别/思考中(suspended===true)跳过，避免回声污染下一句
          if (_mic.finalizing || !_mic.listening || _mic.suspended === true) return;
          const ch = e.inputBuffer.getChannelData(0);
          _mic.pcmBuffers.push(new Float32Array(ch));
        };
        _mic.src.connect(processor);
        processor.connect(sink);
        sink.connect(_mic.audioCtx.destination);
        _mic.processor = processor;
        _mic.sink = sink;
      } catch (_) {}
    }
    _showMicOverlay();
    _updateHud('聆听中', '请说话，说完自动识别', 'listening');
    _mic.raf = requestAnimationFrame(_voiceLoop);
    _kwsFireVoice(true);
  }

  // 退出语音实时对话模式
  function _stopVoiceMode() {
    if (!_mic.listening) return;
    _mic.listening = false;
    if (_mic.raf) cancelAnimationFrame(_mic.raf);
    _mic.raf = null;
    if (_mic.stream) _mic.stream.getTracks().forEach((t) => t.stop());
    _mic.stream = null;
    _closeAudioCtx();
    _mic.pcmBuffers = [];
    btnMic.classList.remove('recording');
    btnMic.title = '语音实时对话';
    _hideMicOverlay();
    setOrb('idle');
    stopSpeaking();
    _kwsFireVoice(false);
  }

  // 识别/回复结束后，恢复持续聆听
  function _resumeListening() {
    if (!_mic.listening) return;
    _mic.suspended = false;
    _mic.pcmBuffers = [];
    _mic.speechActive = false;
    _mic.lastSpeechTs = 0;
    _mic.utterStartTs = 0;
    setOrb('listening');
    _updateHud('聆听中', '请说话，说完自动识别', 'listening');
  }

  // 语音朗读中被用户开口打断：立即停止 TTS 并恢复聆听（保留已采集的 PCM 作为新句开头，断句自然衔接）
  function _interruptSpeaking() {
    if (_mic.suspended !== 'speaking') return;
    _mic.interrupted = true;
    _mic.interruptHits = 0;
    stopSpeaking(true); // 静默停止（HUD 已有提示），不打断 toast
    _mic.suspended = false;
    _mic.speechActive = true;
    _mic.lastSpeechTs = Date.now();
    _mic.utterStartTs = Date.now();
    setOrb('listening');
    _updateHud('聆听中', '已打断，请继续说…', 'listening');
  }

  // 一句话结束：PCM 拼成 WAV → 一次性 ASR → 自动发问 → 小6自动回复
  // 注：唤醒词检测已移交常驻 KWS 监听（window.ZZKws，见 kws.js），
  // 命中即自动进入语音模式（_startVoiceMode），故本函数不再做 in-flow KWS，避免双 ASR。
  async function _finalizeUtterance() {
    if (_mic.finalizing || !_mic.listening) return;
    _mic.finalizing = true;
    _mic.suspended = true; // 立即暂停采集/识别，避免回声与重复断句
    try {
      const pcm = _mergeFloat32(_mic.pcmBuffers);
      _mic.pcmBuffers = [];
      if (!pcm || !pcm.length) { return; }
      _updateHud('识别中…', '正在转写你的语音…', 'recognizing');
      try {
      const wavBlob = await _encodeWav(pcm, _mic.audioCtx ? _mic.audioCtx.sampleRate : 16000);
      const buf = await wavBlob.arrayBuffer();
        const r = await fetch('/api/asr?ext=.wav', { method: 'POST', body: buf });
        const d = await r.json();
        if (d.ok && d.text && d.text.trim()) {
          _asrFails = 0;
          const t = d.text.trim();
          _updateHud('已识别', '“' + (t.length > 24 ? t.slice(0, 24) + '…' : t) + '”', 'recognizing');
          await _voicePipeline(t);
        } else {
          _noteAsrFail();
          _updateHud('聆听中', d.error ? ('识别失败：' + d.error) : '没听清，请再说一次', 'listening');
          _mic.suspended = false;
        }
      } catch (e) {
        _noteAsrFail();
        _updateHud('聆听中', '识别请求失败，请再说一次', 'listening');
        _mic.suspended = false;
      }
    } finally {
      _mic.finalizing = false;
    }
  }

  // 合并多块 Float32 PCM 为一个连续数组
  function _mergeFloat32(chunks) {
    if (!chunks.length) return null;
    let len = 0;
    for (const c of chunks) len += c.length;
    const out = new Float32Array(len);
    let off = 0;
    for (const c of chunks) { out.set(c, off); off += c.length; }
    return out;
  }

  // 把 Float32 PCM 编码为 16k 单声道 16-bit WAV（Vosk 可直接读取，无需 ffmpeg）
  async function _encodeWav(pcm, origRate) {
    const targetRate = 16000;
    let samples = pcm;
    if (origRate && origRate !== targetRate) {
      try {
        const offline = new OfflineAudioContext(1, Math.max(1, Math.ceil(pcm.length * targetRate / origRate)), targetRate);
        const buf = offline.createBuffer(1, pcm.length, origRate);
        buf.copyToChannel(pcm, 0);
        const src = offline.createBufferSource();
        src.buffer = buf;
        src.connect(offline.destination);
        src.start();
        const rendered = await offline.startRendering();
        samples = rendered.getChannelData(0);
      } catch (_) { samples = pcm; } // 重采样失败则原样（可降级运行）
    }
    const numFrames = samples.length;
    const buffer = new ArrayBuffer(44 + numFrames * 2);
    const view = new DataView(buffer);
    const writeStr = (off, s) => { for (let i = 0; i < s.length; i++) view.setUint8(off + i, s.charCodeAt(i)); };
    writeStr(0, 'RIFF'); view.setUint32(4, 36 + numFrames * 2, true); writeStr(8, 'WAVE');
    writeStr(12, 'fmt '); view.setUint32(16, 16, true); view.setUint16(20, 1, true); view.setUint16(22, 1, true);
    view.setUint32(24, targetRate, true); view.setUint32(28, targetRate * 2, true); view.setUint16(32, 2, true); view.setUint16(34, 16, true);
    writeStr(36, 'data'); view.setUint32(40, numFrames * 2, true);
    let off = 44;
    for (let i = 0; i < numFrames; i++) {
      let s = Math.max(-1, Math.min(1, samples[i]));
      view.setInt16(off, s < 0 ? s * 0x8000 : s * 0x7FFF, true);
      off += 2;
    }
    return new Blob([buffer], { type: 'audio/wav' });
  }

  // 把识别到的文本交给小6，并自动朗读回复发回实时对话
  async function _voicePipeline(text) {
    if (!_mic.listening) return;
    _mic.suspended = true;
    _updateHud('小6回应中', '正在思考并回复…', 'speaking');
    setOrb('thinking');
    const prevAutoTts = state.autoTts;
    state.autoTts = false; // 由语音模式统一控制朗读，避免与全局自动朗读重复
    let reply = '';
    try {
      await send(text);
      const last = state.messages[state.messages.length - 1];
      reply = (last && last.role === 'zhuangzhou') ? last.content : '';
    } catch (_) {
      // 发送异常不影响对话循环，直接恢复聆听
    } finally {
      state.autoTts = prevAutoTts;
    }
    if (reply) {
      setOrb('speaking');
      _mic.suspended = 'speaking';   // 标记朗读中：允许用户开口打断
      _mic.interrupted = false;
      _mic.interruptHits = 0;
      // 读完自动恢复聆听；若被打断则由 _interruptSpeaking 处理（不再重复恢复，避免清空用户已说内容）
      speak(reply, () => { if (!_mic.interrupted) _resumeListening(); }, () => _mic.interrupted);
    } else {
      _resumeListening();
    }
  }

