  // ───────── KWS 语音唤醒（常驻监听）─────────
  // 与正常语音对话（_mic）共用同一套 PCM 采集 / WAV 编码逻辑，但独立持有麦克风流，
  // 以 2.5s 为一块连续抓取并 POST 给 /api/kws；命中唤醒词时由 kws.js 接管触发语音对话。
  const _kws = {
    stream: null, audioCtx: null, src: null, processor: null, sink: null,
    pcmBuffers: [], running: false, onChunk: null, voiceCbs: [],
    chunkMs: 2500, timer: null, busy: false,
  };

  function _kwsFireVoice(active) {
    _kws.voiceCbs.forEach((cb) => { try { cb(active); } catch (e) { console.warn(e); } });
  }

  async function _kwsStart(onChunk) {
    if (_kws.running) { _kws.onChunk = onChunk; return; }
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      console.warn('[KWS] 当前环境不支持麦克风录音');
      return;
    }
    try {
      _kws.stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    } catch (e) {
      console.warn('[KWS] 麦克风获取失败', e);
      return;
    }
    _kws.pcmBuffers = [];
    _kws.running = true;
    _kws.onChunk = onChunk;
    try {
      _kws.audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const src = _kws.audioCtx.createMediaStreamSource(_kws.stream);
      _kws.src = src;
      const processor = _kws.audioCtx.createScriptProcessor(4096, 1, 1);
      const sink = _kws.audioCtx.createGain();
      sink.gain.value = 0; // 仅驱动采集，避免回声回放
      processor.onaudioprocess = (e) => {
        if (!_kws.running) return;
        const ch = e.inputBuffer.getChannelData(0);
        _kws.pcmBuffers.push(new Float32Array(ch));
      };
      src.connect(processor);
      processor.connect(sink);
      sink.connect(_kws.audioCtx.destination);
      _kws.processor = processor;
      _kws.sink = sink;
    } catch (_) {}
    _kws.timer = setInterval(_kwsTick, _kws.chunkMs);
  }

  async function _kwsTick() {
    if (!_kws.running || _kws.busy || !_kws.onChunk) return;
    const pcm = _mergeFloat32(_kws.pcmBuffers);
    _kws.pcmBuffers = [];
    if (!pcm || !pcm.length) return;
    try {
      _kws.busy = true;
      const rate = _kws.audioCtx ? _kws.audioCtx.sampleRate : 16000;
      const blob = await _encodeWav(pcm, rate);
      const buf = await blob.arrayBuffer();
      await _kws.onChunk(buf);
    } catch (e) {
      console.warn('[KWS] 分块处理失败', e);
    } finally {
      _kws.busy = false;
    }
  }

  function _kwsStop() {
    if (!_kws.running) return;
    _kws.running = false;
    if (_kws.timer) { clearInterval(_kws.timer); _kws.timer = null; }
    if (_kws.stream) { _kws.stream.getTracks().forEach((t) => t.stop()); _kws.stream = null; }
    try { if (_kws.processor) _kws.processor.disconnect(); } catch (_) {}
    try { if (_kws.sink) _kws.sink.disconnect(); } catch (_) {}
    try { if (_kws.src) _kws.src.disconnect(); } catch (_) {}
    if (_kws.audioCtx && _kws.audioCtx.state !== 'closed') { try { _kws.audioCtx.close(); } catch (_) {} }
    _kws.audioCtx = null; _kws.processor = null; _kws.sink = null; _kws.src = null;
    _kws.pcmBuffers = [];
    _kws.onChunk = null;
  }

  // ── 暴露语音桥：供 kws.js 复用麦克风流与 WAV 编码，并接管正常语音对话 ──
  window.ZZVoice = {
    startVoice: () => _startVoiceMode(),
    stopVoice: () => _stopVoiceMode(),
    isVoiceActive: () => !!_mic.listening,
    startKws: (onChunk) => _kwsStart(onChunk),
    stopKws: () => _kwsStop(),
    isKwsRunning: () => _kws.running,
    // P11：KWS 性能门控降频（kws.js CPU 监控调用；仅在常驻监听运行时生效）
    setKwsChunkMs: (ms) => { if (_kws.running && ms > 0) _kws.chunkMs = Math.max(800, ms); },
    getKwsChunkMs: () => _kws.chunkMs,
    onVoiceState: (cb) => { if (typeof cb === 'function') _kws.voiceCbs.push(cb); },
  };

  // ── 暴露弹窗桥：供 hotspot.js 单条热点详情与朗读调用 ──
  window.ZZModal = {
    openHotspot: (item) => showModal({ kind: 'hotspot', data: item || {} }),
    speak: (text) => speak(text),
    stopSpeaking,
    close: () => closeModal(),
  };

  // ── 暴露聊天桥：供 hotspot.js 右侧聊天框与主页共享同一会话 ──
  window.ZZChat = {
    send: (text) => send(text),
    getMessages: () => (activeSession() || { messages: [] }).messages,
    getActiveId: () => activeId,
    isStreaming: () => state.streaming,
    onUpdate: (fn) => chatUpdateCbs.push(fn),
    offUpdate: (fn) => { chatUpdateCbs = chatUpdateCbs.filter(f => f !== fn); },
    triggerUpdate: () => chatUpdateCbs.forEach(fn => { try { fn(); } catch (e) { console.warn(e); } }),
    onStreamDelta: (fn) => chatStreamCbs.push(fn),
    offStreamDelta: (fn) => { chatStreamCbs = chatStreamCbs.filter(f => f !== fn); },
    triggerStreamDelta: (delta) => chatStreamCbs.forEach(fn => { try { fn(delta); } catch (e) { console.warn(e); } }),
    // 屏幕/图片附加桥：把 dataURL 推入待发送图片队列并刷新预览（供 screen.js 调用）
    attachImage: (dataUrl) => {
      if (!dataUrl) return;
      pendingImages.push(dataUrl);
      _renderImagePreviews();
      if (window.toast) window.toast('已附加屏幕截图，发送时小6将看到屏幕内容');
    },
    newSession: () => newSession(),
    clearMessages: () => {
      const s = activeSession();
      if (!s) return;
      s.messages = [];
      s.updatedAt = Date.now();
      state.messages = s.messages;
      messagesEl.innerHTML = '';
      app.classList.remove('has-messages');
      persistHistory();
      window.ZZChat.triggerUpdate();
    },
  };

  // 暴露 toast 给 screen.js 等独立模块复用
  window.toast = toast;

  // ── 暴露任务桥 ──
  window.ZZTasksBridge = {
    open: (kind, title, html) => window.ZZTasks && window.ZZTasks.open(kind, title, html),
    close: () => window.ZZTasks && window.ZZTasks.close(),
  };

  // ── 暴露通用侧弹面板桥：后续所有功能统一走此窗口 ──
  window.ZZPanel = {
    open: openZZPanel,
    close: closeZZPanel,
    update: updateZZPanel,
    profile: openAgentProfileCard,
  };
})();
