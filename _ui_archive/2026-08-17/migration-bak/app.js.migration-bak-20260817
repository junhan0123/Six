  function buildBriefingSpeech(d) {
    const w = d.weather || {};
    let s = '早安，老板。';
    if (w.city) s += '今天' + w.city + (w.condition ? ('，' + w.condition) : '') + '，最高' + (w.high || '?') + '度，最低' + (w.low || '?') + '度。';
    const hs = (d.hotspots || []).filter((x) => !x.error);
    if (hs.length) {
      s += '今日热点：';
      hs.slice(0, 3).forEach((it, i) => { s += (i + 1) + '，' + (it.text || '') + '。'; });
    }
    const ts = d.tasks || [];
    if (ts.length) s += '你有' + ts.length + '项待办，例如' + (ts[0].title || ts[0].content || '未命名任务') + '。';
    else s += '今天没有待办。';
    const sg = d.suggestions || [];
    if (sg.length) s += '另外有' + sg.length + '条关于目标推进的建议，详见简报面板。';
    return s;
  }

