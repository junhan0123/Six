/* ============================================================
   小6 · 前端逻辑  —  app.js
   文字对话 + 流式(SSE) + 核心球状态机 + 遥测
   ============================================================ */
(() => {
  const $ = (s) => document.querySelector(s);
  const app = $('#app');

  // 工作日志（右侧遥测）面板初始显隐：默认展开，仅当用户明确关闭过才隐藏。
  (function applyTelemetryDefault() {
    const show = localStorage.getItem('zzu_show_telemetry') !== 'false';
    app.classList.toggle('tele-hidden', !show);
  })();
  const messagesEl = $('#messages');
  const orbWrap = $('.orb-wrap');
  const input = $('#input');
  const btnSend = $('#btnSend');
  const btnTts = $('#btnTts');
  const btnMem = $('#btnMem');
  const btnTtsStop = $('#btnTtsStop');
  const btnMic = $('#btnMic');
  const btnImage = $('#btnImage');
  const btnMedia = $('#btnMedia');
  const fileImage = $('#fileImage');
  const fileMedia = $('#fileMedia');

  const state = {
    messages: [],
    turns: 0,
    tokens: 0,
    streaming: false,
    autoTts: false,
    temperature: 0.7,
    reasoning: false,
  };
  window.__zzState = state;

  // ── 多视图聊天同步：供 hotspot.js 右侧聊天框等二次视图订阅 ──
  const chatUpdateCbs = [];
  const chatStreamCbs = [];

  let toolHideTimer = null;
  let currentAudio = null;
  let currentReader = null;      // P8-2 流式 TTS：fetch body reader（打断时 abort）
  let currentMediaSource = null; // P8-2 流式 TTS：MediaSource（打断时 endOfStream）
  let ttsAudioCtx = null;
  let ttsAnalyser = null;
  let ttsGain = null;        // TTS 音量增益（支持 >1 放大）
  let ttsOrbRaf = null;
  let currentTtsVolume = 1;  // 当前朗读音量（0.5–2.0）

  // 多模态待发送图片（带预览）
  let pendingImages = [];
  // 语音交互状态
  const _mic = {
    stream: null,
    audioCtx: null,
    analyser: null,
    src: null,          // MediaStreamSource（供 VAD analyser 与 PCM 采集共用）
    processor: null,    // ScriptProcessorNode（采集 PCM）
    sink: null,         // 零增益节点（避免麦克风回放回声）
    dataArray: null,
    timeData: null,
    pcmBuffers: [],     // 实时对话采集到的 Float32 PCM 块（断句时拼成 WAV）
    listening: false,   // 是否处于语音实时对话模式
    suspended: false,   // 识别/回复中临时挂起 VAD，避免回声
    finalizing: false,  // 正在断句识别，防重入
    speechActive: false,
    lastSpeechTs: 0,
    utterStartTs: 0,
    interrupted: false,  // 朗读中被用户语音打断
    interruptHits: 0,    // 打断去抖计数（连续超阈值帧数）
    mime: '',
    raf: null,
    overlay: null,
    hudTitle: null,
    hudSub: null,
    hudBars: null,
  };

  // 跨会话身份（长期记忆归属）
  const SESSION_ID = (() => {
    let id = localStorage.getItem('zhuangzhou_sid');
    if (!id) {
      id = 'sid-' + Math.random().toString(36).slice(2) + Date.now().toString(36);
      localStorage.setItem('zhuangzhou_sid', id);
    }
    return id;
  })();

  // —— 多会话持久化：左侧会话面板保留所有对话 ——
  // 每个会话独立保存 messages；刷新/重开浏览器整组恢复，可点击切换、可新建、可删除。
  const SESSIONS_KEY = 'zhuangzhou_sessions_v1';
  const ACTIVE_KEY = 'zhuangzhou_active_session_v1';
  let sessions = [];
  let activeId = null;

  function makeTitle(text) {
    // 去掉首尾空白、常见 emoji、前缀标点，取前 18 个字符作为会话标题
    let t = (text || '').replace(/\s+/g, ' ').trim();
    t = t.replace(/^[\s\u2000-\u206F\uFE00-\uFE0F📷🎬🔊🎤✨⭐🌟💡📝📌✅❌⚠️]+/, '');
    t = t.slice(0, 18).trim();
    return t || '新对话';
  }
  function newSessionObj() {
    return { id: 's-' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6),
             title: '新对话', messages: [], updatedAt: Date.now() };
  }
  function activeSession() {
    return sessions.find(s => s.id === activeId) || sessions[0] || null;
  }
  // 保存全部会话（保留所有对话），并记忆当前激活会话
  function persistHistory() {
    try {
      localStorage.setItem(SESSIONS_KEY, JSON.stringify(sessions));
      localStorage.setItem(ACTIVE_KEY, activeId || '');
    } catch (_) {}
  }
  function loadSessions() {
    let loaded = null;
    try { loaded = JSON.parse(localStorage.getItem(SESSIONS_KEY) || 'null'); } catch {}
    if (Array.isArray(loaded) && loaded.length) {
      sessions = loaded;
    } else {
      // 首次启动：从旧版单条历史迁移，避免丢失既有对话
      let legacy = [];
      try { legacy = JSON.parse(localStorage.getItem('zhuangzhou_history_v1') || '[]'); } catch {}
      legacy = Array.isArray(legacy) ? legacy.filter(m => m && m.role && m.content) : [];
      const seed = newSessionObj();
      seed.title = legacy.length ? makeTitle(legacy[0].content) : '主会话';
      seed.messages = legacy.map(m => ({ role: m.role, content: cleanReply(m.content) }));
      sessions = [seed];
    }
    if (!sessions.length) sessions = [newSessionObj()];
    // 清理历史会话中的舆情/告警主动噪音；并补全「新对话」标题为第一条用户消息摘要
    let dirty = false;
    sessions.forEach((s) => {
      const before = (s.messages || []).length;
      s.messages = (s.messages || []).filter((m) => !isProactiveNoise(m.content));
      if (s.messages.length !== before) dirty = true;
      if ((s.title || '新对话') === '新对话') {
        const firstUser = (s.messages || []).find((m) => m && m.role === 'user');
        if (firstUser && firstUser.content) {
          s.title = makeTitle(firstUser.content);
          dirty = true;
        }
      }
    });
    if (dirty) persistHistory();
    let aid = null;
    try { aid = localStorage.getItem(ACTIVE_KEY); } catch {}
    if (!aid || !sessions.some(s => s.id === aid)) aid = sessions[0].id;
    activeId = aid;
    state.messages = (activeSession() || { messages: [] }).messages;
    renderMessages();
    renderConvList();
    return true;
  }
  function renderMessages() {
    messagesEl.innerHTML = '';
    const msgs = (activeSession() || { messages: [] }).messages;
    if (!msgs.length) {
      app.classList.remove('has-messages');
      return;
    }
    for (const m of msgs) {
      if (!m || !m.role || !m.content) continue;
      if (isProactiveNoise(m.content)) continue;
      addMessage(m.role, m.content);
    }
    app.classList.add('has-messages');
    scrollDown();
    chatUpdateCbs.forEach(fn => { try { fn(); } catch (e) { console.warn(e); } });
  }
  function renderConvList() {
    const list = $('#convList');
    if (!list) return;
    list.innerHTML = '';
    const active = [], archived = [];
    for (const s of sessions) (s.archived ? archived : active).push(s);
    active.sort((a, b) => b.updatedAt - a.updatedAt);
    archived.sort((a, b) => b.updatedAt - a.updatedAt);

    const makeItem = (s) => {
      const item = document.createElement('div');
      item.className = 'conv-item' + (s.id === activeId ? ' active' : '') + (s.archived ? ' archived' : '');
      const dot = document.createElement('span'); dot.className = 'conv-dot';
      const title = document.createElement('span'); title.className = 'conv-title';
      title.textContent = s.title; title.title = s.title;
      const arch = document.createElement('button'); arch.className = 'conv-arch';
      arch.textContent = s.archived ? '<svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-return"/></svg>' : '<svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-inbox"/></svg>'; arch.title = s.archived ? '取消归档' : '归档该会话';
      const del = document.createElement('button'); del.className = 'conv-del'; del.textContent = '×'; del.title = '删除该会话';
      item.append(dot, title, arch, del);
      item.addEventListener('click', (e) => {
        if (e.target === arch || e.target === del) return;
        if (s.archived) return; // 归档项不进入对话
        switchSession(s.id);
      });
      arch.addEventListener('click', (e) => { e.stopPropagation(); toggleArchive(s.id); });
      del.addEventListener('click', (e) => { e.stopPropagation(); deleteSession(s.id); });
      return item;
    };

    for (const s of active) list.appendChild(makeItem(s));

    if (archived.length) {
      const wrap = document.createElement('div'); wrap.className = 'conv-archived';
      const head = document.createElement('button'); head.className = 'conv-archived-head';
      head.innerHTML = `<span><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-inbox"/></svg> 已归档 (${archived.length})</span><span class="conv-archived-caret">▾</span>`;
      const body = document.createElement('div'); body.className = 'conv-archived-body';
      if (!list.classList.contains('show-archived')) body.hidden = true;
      for (const s of archived) body.appendChild(makeItem(s));
      head.addEventListener('click', () => {
        const show = body.hidden;
        body.hidden = !show;
        list.classList.toggle('show-archived', show);
      });
      wrap.append(head, body);
      list.appendChild(wrap);
    }
  }

  function toggleArchive(id) {
    const s = sessions.find((x) => x.id === id);
    if (!s) return;
    s.archived = !s.archived;
    s.updatedAt = Date.now();
    renderConvList();
    persistHistory();
  }
  function switchSession(id) {
    const s = sessions.find(x => x.id === id);
    if (!s) return;
    if (id === activeId) { renderConvList(); return; }
    activeId = id;
    state.messages = s.messages;
    renderMessages();
    renderConvList();
    persistHistory();
  }
  function deleteSession(id) {
    if (sessions.length <= 1) { toast('至少保留一个会话'); return; }
    sessions = sessions.filter(s => s.id !== id);
    if (id === activeId) { activeId = sessions[0].id; state.messages = sessions[0].messages; renderMessages(); }
    renderConvList();
    persistHistory();
  }
  function newSession() {
    const s = newSessionObj();
    sessions.unshift(s);
    activeId = s.id;
    state.messages = s.messages;
    messagesEl.innerHTML = '';
    app.classList.remove('has-messages');
    state.turns = 0; state.tokens = 0;
    $('#mTurns').textContent = '0'; $('#mTokens').textContent = '0';
    renderConvList();
    persistHistory();
    chatUpdateCbs.forEach(fn => { try { fn(); } catch (e) { console.warn(e); } });
  }
  function ensureTitle(firstUserText) {
    const s = activeSession();
    if (!s) return;
    if (s.messages.length === 1) {
      s.title = makeTitle(firstUserText);
      s.updatedAt = Date.now();
      renderConvList();
    }
  }

  // 工具中文名（浮层展示用）
  const TOOL_LABELS = {
    get_time: '查询时间', calculator: '计算', note_save: '记笔记',
    note_list: '翻笔记', profile_set: '记住你', profile_get: '回忆你',
    reminder_set: '设提醒', reminder_list: '看提醒',
    set_task: '记任务', update_task_step: '更新进度', complete_task: '完成任务', task_list: '看任务',
    file_read: '读文件', file_list: '列文件', file_write: '写文件',
    run_shell: '跑命令', web_fetch: '抓取网页', web_search: '联网搜索',
    media_generate: '生成媒体', social_send: '发消息', asr_transcribe: '语音识别',
    get_weather: '查天气', get_hotspots: '看热点', open_hotspot_panel: '开热点大屏',
    play_video: '放视频',
  };

  /* ---------- 工具 ---------- */
  const escapeHtml = (s) => s.replace(/[&<>"']/g, (c) =>
    ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));

  // 打字机：后端非流式一次性返回，前端逐字呈现，保留流式观感
  function typewriter(el, text) {
    el.textContent = '';
    setOrb('speaking');
    let i = 0;
    const step = () => {
      if (i <= text.length) {
        el.textContent = text.slice(0, i);
        i++;
        scrollDown();
        setTimeout(step, 16);
      } else {
        setOrb('idle');
      }
    };
    step();
  }

  function toast(msg) {
    // Step[3] Toast Unification：路由到统一 zz-toast（legacy 接口签名保持兼容）
    if (window.OverlayManager && typeof window.OverlayManager.toast === 'function') {
      window.OverlayManager.toast({ type: 'info', message: msg, legacyDismissMs: 3200 });
      return;
    }
    // 兼容回退：OverlayManager 缺失时仍可用旧 DOM #toast
    const t = $('#toast');
    if (!t) return;
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(t._t);
    t._t = setTimeout(() => t.classList.remove('show'), 3200);
  }

  function setOrb(mode) { // idle | listening | thinking | speaking | error
    orbWrap.classList.remove('listening', 'thinking', 'speaking', 'error');
    if (mode === 'listening') orbWrap.classList.add('listening');
    else if (mode === 'thinking') orbWrap.classList.add('thinking');
    else if (mode === 'speaking') orbWrap.classList.add('speaking');
    else if (mode === 'error') orbWrap.classList.add('error');
    const badge = { idle:'空闲', listening:'聆听中', thinking:'思考中', speaking:'回应中', error:'错误' }[mode] || '空闲';
    orbWrap.dataset.state = badge;
    $('#stateBadge').textContent = badge;
    $('#mState').textContent = mode.toUpperCase();
    $('#mBar').style.width = { idle:'8%', listening:'100%', thinking:'62%', speaking:'40%', error:'100%' }[mode] || '8%';
    if (window.ZZAvatar && window.ZZAvatar.setState) {
      try { window.ZZAvatar.setState(mode); } catch (_) {}
    }
    // P11 全息 HUD：语音球态同步驱动常驻状态光环 + 可选 3D 化身
    const ringMode = { idle: 'idle', listening: 'listening', thinking: 'thinking', processing: 'thinking', speaking: 'speaking', error: 'idle' }[mode] || 'idle';
    if (window.ZZHudRing && window.ZZHudRing.setState) {
      try { window.ZZHudRing.setState(ringMode); } catch (_) {}
    }
    if (window.ZZAvatarScene && window.ZZAvatarScene.setState) {
      try { window.ZZAvatarScene.setState(ringMode); } catch (_) {}
    }
  }

  // 剥离模型自带回显的"小6："前缀，过滤 XML 标签、emoji 和特殊符号
  function cleanReply(text) {
    if (!text) return text;
    text = text.replace(/^\s*小6\s*[:：]\s*/, '');
    // Agnes 偶发会把工具参数标签当成内容吐出；直接剥掉，避免污染会话
    if (/<\/?parameter>/i.test(text)) {
      text = text.replace(/<\/?parameter>/gi, '').replace(/\n\s*\n/g, '\n');
    }
    // 去除所有 emoji（Unicode emoji 范围 + 常见变体选择符 + 零宽连接符组合）
    text = text.replace(
      /[\u{1F600}-\u{1F64F}\u{1F300}-\u{1F5FF}\u{1F680}-\u{1F6FF}\u{1F900}-\u{1F9FF}\u{1FA00}-\u{1FA6F}\u{1FA70}-\u{1FAFF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{FE00}-\u{FE0F}\u{1FAB0}-\u{1FABF}\u{1FAC0}-\u{1FAFF}\u{23E9}-\u{23F3}\u{23F8}-\u{23FA}\u{25AA}-\u{25AB}\u{25B6}\u{25C0}\u{25FB}-\u{25FE}\u{2614}-\u{2615}\u{2648}-\u{2653}\u{267F}\u{2693}\u{26A1}\u{26AA}-\u{26AB}\u{26BD}-\u{26BE}\u{26C4}-\u{26C5}\u{26CE}\u{26D4}\u{26EA}\u{26F2}-\u{26F3}\u{26F5}\u{26FA}\u{26FD}\u{2702}\u{2705}\u{2708}-\u{270D}\u{270F}]+/gu,
      ''
    );
    // 去除零宽连接符/变体选择符残留
    text = text.replace(/[\u200B-\u200D\uFE00-\uFE0F\u{E0020}-\u{E007F}]/gu, '');
    return text.trim();
  }
  // 过滤主动推送中的舆情/告警噪音，避免污染会话历史
  function isProactiveNoise(text) {
    const t = String(text || '');
    return /^\s*🌐\s*舆情扫描更新/.test(t) || /^\s*⚠️/.test(t) || /^\s*🚨/.test(t);
  }

  /* ---------- 渲染消息 ---------- */
  function addMessage(role, text, isTyping = false) {
    const wrap = document.createElement('div');
    wrap.className = `msg ${role}`;
    const initial = role === 'user' ? '你' : '庄';
    const bubbleHtml = isTyping
      ? '<span class="typing"><i></i><i></i><i></i></span>'
      : escapeHtml(text);
    if (role === 'zhuangzhou') {
      wrap.innerHTML = `
        <div class="avatar">${initial}</div>
        <div class="bubble">${bubbleHtml}</div>
        <div class="msg-actions">
          <button class="speak-btn" title="朗读回复">
            <svg viewBox="0 0 24 24" class="ic"><path d="M3 10v4h4l5 5V5L7 10H3Zm13.5 2a4.5 4.5 0 0 0-2.5-4.2v8.4a4.5 4.5 0 0 0 2.5-4.2Z"/></svg>
          </button>
        </div>`;
      const b = wrap.querySelector('.bubble');
      wrap.querySelector('.speak-btn').addEventListener('click', () => speak(b.textContent));
    } else {
      wrap.innerHTML = `<div class="avatar">${initial}</div><div class="bubble">${bubbleHtml}</div>`;
    }
    messagesEl.appendChild(wrap);
    app.classList.add('has-messages');
    scrollDown();
    // 新消息到达时展开对话历史；若用户未悬停聊天区，数秒后自动收起（流式输出期间不收起）
    revealChat();
    scheduleCloseChat(5000);
    return wrap.querySelector('.bubble');
  }

  function scrollDown() {
    if (chatHistory) chatHistory.scrollTop = chatHistory.scrollHeight;
  }

  /* ---------- 工具执行浮层 ---------- */
  function ensureToolOverlay() {
    let el = document.querySelector('.tool-overlay');
    if (!el) {
      el = document.createElement('div');
      el.className = 'tool-overlay';
      ($('.main') || document.body).appendChild(el);
    }
    return el;
  }
  function showToolOverlay(tool, args, status, result) {
    const el = ensureToolOverlay();
    const label = TOOL_LABELS[tool] || tool;
    const argTxt = args ? ' ' + JSON.stringify(args) : '';
    if (status === 'running') {
      el.innerHTML = `<span class="tg-ico"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-gear"/></svg></span>`
        + `<span class="tg-txt">执行工具：<b>${escapeHtml(label)}</b>${escapeHtml(argTxt)}</span>`
        + `<span class="tg-state run">执行中…</span>`;
      el.classList.add('show');
      if (toolHideTimer) clearTimeout(toolHideTimer);
    } else {
      const resTxt = result ? result.slice(0, 70) : '';
      el.innerHTML = `<span class="tg-ico ok">✓</span>`
        + `<span class="tg-txt">工具 <b>${escapeHtml(label)}</b> 已完成</span>`
        + `<span class="tg-state ok">${escapeHtml(resTxt)}</span>`;
      el.classList.add('show');
      toolHideTimer = setTimeout(() => el.classList.remove('show'), 2600);
    }
  }
  // ── Phase 8：Companion 交互桥的接收端（主窗口渲染进程）──
  // 纪律：仅把 Companion 转发的系统动作分发到既有系统（Command/Chat/Goal/Execution/Panel），
  //       不新建任何逻辑系统；Companion 自身仍是纯 Presentation Layer。
  function handleCompanionAction(action) {
    if (!action || !action.type) return;
    switch (action.type) {
      case 'quick-cmd':   // 复用既有 Command Palette（禁止 Companion 内置命令系统）
        if (window.ZZCommandPalette) window.ZZCommandPalette.open();
        break;
      case 'current-task': // Execution 系统：聚焦执行监视
      case 'completion-view':
        if (window.ExecutionChannel) {
          if (window.ExecutionChannel.focus) window.ExecutionChannel.focus();
          else window.ExecutionChannel.mount();
        }
        break;
      case 'system-status': // 系统监控面板（经 PanelManager 唯一入口）
        if (window.PanelManager) PanelManager.openCapability('sysmon');
        else if (window.ZZSysmon) window.ZZSysmon.open();
        break;
      case 'memory':       // 记忆面板（经 PanelManager 唯一入口）
        if (window.PanelManager) PanelManager.openCapability('ai-memory');
        else if (window.ZZMemory) window.ZZMemory.open();
        break;
      case 'settings':     // 设置面板（经 PanelManager 唯一入口）
        if (window.PanelManager) PanelManager.openCapability('settings');
        else if (window.ZZSettings) window.ZZSettings.open();
        break;
      case 'project':      // 复用 Chat 系统：请小6总结当前项目状态
        if (window.ZZChat) window.ZZChat.send('总结当前项目状态');
        break;
      case 'history':      // 复用 Chat 系统：回顾近期对话与任务历史
        if (window.ZZChat) window.ZZChat.send('回顾我们最近的对话与任务历史摘要');
        break;
      case 'execute-suggestion': // 复用既有 Chat 系统真实执行（Companion 命令气泡 / 主动建议「执行」，无新能力）
        if (window.ZZChat) window.ZZChat.send(action.content || '');
        break;
      default:
        break;
    }
  }
  if (window.zhuangzhou && window.zhuangzhou.onCompanionExec) {
    window.zhuangzhou.onCompanionExec(handleCompanionAction);
  }

  function handleToolEvent(ev) {
    if (ev.zhuangzhou_event === 'tool_start') {
      showToolOverlay(ev.tool, ev.args, 'running');
      if (window.ExecutionChannel) window.ExecutionChannel.onToolStart(ev); // Execution Channel 解耦
    } else if (ev.zhuangzhou_event === 'tool_end') {
      showToolOverlay(ev.tool, null, 'done', ev.result);
      if (window.ExecutionChannel) window.ExecutionChannel.onToolEnd(ev);   // Execution Channel 解耦
