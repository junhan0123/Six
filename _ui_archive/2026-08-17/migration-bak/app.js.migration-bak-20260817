  /* ---------- 长期记忆面板 ---------- */
  async function refreshMemory() {
    // P1-3：稳定加载 /api/memory；单次连接偶发关闭兜底重试一次，彻底失败给出可重试提示（不再偶发空白）
    async function loadOnce() {
      const ctrl = new AbortController();
      const to = setTimeout(() => ctrl.abort(), 8000);
      try {
        const r = await fetch('/api/memory', { cache: 'no-store', signal: ctrl.signal });
        if (!r.ok) throw new Error('http ' + r.status);
        return await r.json();
      } finally { clearTimeout(to); }
    }
    let d = null;
    try {
      try { d = await loadOnce(); }
      catch (e1) { d = await loadOnce(); }   // 连接偶发关闭：重试一次
    } catch (e2) {
      const note = $('#memNote');
      if (note) note.innerHTML = '<div class="mem-sub">长期记忆暂时加载失败，<a href="#" id="memRetry">点击重试</a>。</div>';
      const rt = document.getElementById('memRetry');
      if (rt) rt.addEventListener('click', (ev) => { ev.preventDefault(); refreshMemory(); });
      return null;
    }
    const note = $('#memNote');
    const prof = d.profile || [];
    const summary = (d.summary || '').trim();
    let html = '';
    if (prof.length) {
      html += '<div class="mem-list">';
      for (const p of prof) {
        html += `<div class="mi"><span class="mk">${escapeHtml(p.key)}</span>`
              + `<span class="mv">${escapeHtml(p.value)}</span></div>`;
      }
      html += '</div>';
    } else {
      html += '<div class="mem-sub">尚未记录长期记忆。说「叫我老板」或「我喜欢…」即可建立。</div>';
    }
    if (summary) {
      html += '<div class="mem-summary"><div class="mem-sub">长期记忆摘要（自动压缩）</div>'
          + `<div class="mem-sum-text">${escapeHtml(summary)}</div></div>`;
    }
    const rem = d.reminders || [];
    if (rem.length) {
      html += '<div class="mem-summary"><div class="mem-sub">待办提醒</div><div class="mem-sum-text">';
      for (const r of rem) {
        const done = r.done ? ' style="opacity:.45;text-decoration:line-through"' : '';
        html += `<div${done}>[${escapeHtml(r.due || '时间未定')}] ${escapeHtml(r.content)}</div>`;
      }
      html += '</div></div>';
    }
    html += `<div class="mem-sub">画像 ${prof.length} · 提醒 ${rem.length} · 笔记 ${d.note_count || 0} · 对话 ${d.log_count || 0}</div>`;
    note.innerHTML = html;
    btnMem.classList.toggle('has', prof.length > 0 || rem.length > 0);
    let cnt = btnMem.querySelector('.cnt');
    if (!cnt) { cnt = document.createElement('span'); cnt.className = 'cnt'; btnMem.appendChild(cnt); }
    cnt.textContent = prof.length + rem.length;
    return d;
  }

