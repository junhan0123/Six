  async function loadGeo() {
    const el = $('#locTxt');
    // 渲染读数（place 显示名 + 可选坐标 + 可选天气）
    const show = (place, lat, lon, wx, withCoord) => {
      if (!el) return;
      let txt = '<b>' + escapeHtml(place || '定位中…') + '</b>';
      if (withCoord && lat != null) txt += '  <span class="loc-coord">' + lat + ', ' + lon + '</span>';
      if (wx && wx.condition) txt += '  ·  <span class="loc-wx">' + escapeHtml(wx.condition) + ' ' + wx.temp + '°C</span>';
      el.innerHTML = txt;
    };
    const driveEarth = (lat, lon, place) => {
      if (lat != null && lon != null && window.ZZEarth) window.ZZEarth.setLocation(lat, lon, place || '');
    };

    // 0) 设置中用户指定的所在地（最优先，解决 IP 定位不精准）
    const saved = getSavedLocationDisplay();
    if (saved.display || saved.city) {
      const place = saved.display || saved.city;
      show(place, null, null, null, false);
      // 用 IP 坐标驱动地球指向大致区域（仅装饰，不影响读数）
      try {
        const r = await fetch('/api/geo', { cache: 'no-store' });
        const d = await r.json();
        const loc = d.location || {};
        if (loc.lat != null) driveEarth(loc.lat, loc.lon, place);
      } catch (_) { /* 地球不转也不影响读数 */ }
      return;
    }
    // 1) 浏览器实时定位（GPS/WiFi 真实坐标），localhost 为安全上下文可用
    if (navigator.geolocation && (window.isSecureContext !== false)) {
      try {
        const pos = await new Promise((resolve, reject) => {
          navigator.geolocation.getCurrentPosition(resolve, reject, {
            enableHighAccuracy: false, timeout: 8000, maximumAge: 600000,
          });
        });
        const lat = pos.coords.latitude, lon = pos.coords.longitude;
        const r = await fetch('/api/geo/reverse?lat=' + lat + '&lon=' + lon, { cache: 'no-store' });
        const d = await r.json();
        const place = (d.display || '').trim();
        show(place || '实时定位', lat, lon, d.weather, true);
        driveEarth(lat, lon, place || '实时定位');
        return;
      } catch (e) {
        console.warn('[loadGeo] 浏览器定位失败，回退 IP：', e && e.message);
      }
    }
    // 2) 回退：后端公网 IP 定位
    try {
      const r = await fetch('/api/geo', { cache: 'no-store' });
      const d = await r.json();
      const loc = d.location || null;
      const wx = d.weather || null;
      if (loc && loc.city) {
        const place = [loc.district, loc.city, loc.region].filter(Boolean).join(' · ');
        show(place, loc.lat, loc.lon, wx, true);
        driveEarth(loc.lat, loc.lon, place);
        return;
      }
    } catch (e) { /* IP 失败 → 兜底 */ }
    // 3) 最终默认
