  /* ---------- 语音合成 (TTS) ---------- */
  function updateTtsStopButton(playing) {
    if (!btnTtsStop) return;
    btnTtsStop.classList.toggle('show', playing);
  }

  function stopSpeaking(silent) {
    if (currentAudio) {
      try { currentAudio.pause(); } catch (_) {}
      try { if (currentAudio.currentTime) currentAudio.currentTime = 0; } catch (_) {}
      try { URL.revokeObjectURL(currentAudio.src); } catch (_) {}
      currentAudio = null;
    }
    // P8-2 流式 TTS：中止拉流 + 结束 MSE 缓冲，避免后台继续 append
    if (currentReader) { try { currentReader.cancel(); } catch (_) {} currentReader = null; }
    if (currentMediaSource) {
      try { if (currentMediaSource.readyState === 'open') currentMediaSource.endOfStream(); } catch (_) {}
      currentMediaSource = null;
    }
    stopOrbTTSPump();
    updateTtsStopButton(false);
    if (!silent) toast('语音已停止');
  }

  // ── P8-2 流式 TTS：整段 blob 播放（含 MSE 不支持时的降级路径）──
  function playBlob(blob, onDone) {
    const url = URL.createObjectURL(blob);
    currentAudio = new Audio(url);
    currentAudio.volume = Math.min(1, currentTtsVolume); // 经 Web Audio 时由 gain 接管；否则作为兜底上限
    currentAudio.onplay = () => {
      updateTtsStopButton(true);
      attachOrbTTSAnalyser(currentAudio);
      startOrbTTSPump();
    };
    currentAudio.onended = () => {
      updateTtsStopButton(false);
      stopOrbTTSPump();
      URL.revokeObjectURL(url);
      currentAudio = null;
      if (onDone) onDone();
    };
    currentAudio.onerror = () => {
      updateTtsStopButton(false);
      stopOrbTTSPump();
      URL.revokeObjectURL(url);
      currentAudio = null;
      if (onDone) onDone();
    };
    currentAudio.play().catch((e) => {
      console.warn('[TTS] 播放失败', e && e.message);
      updateTtsStopButton(false);
      stopOrbTTSPump();
      URL.revokeObjectURL(url);
      currentAudio = null;
      if (onDone) onDone();
    });
  }

  // ── P8-2 流式 TTS：MediaSource 边收边播（首字延迟最低）──
  // 若 MSE 解码失败或音频错误，自动重新 fetch 整段 blob 兜底，避免用户侧卡死
  function playStreamMSE(r, text, voice, rate, onDone) {
    const audio = new Audio();
    currentAudio = audio;
    audio.volume = Math.min(1, currentTtsVolume);
    const ms = new MediaSource();
    currentMediaSource = ms;
    audio.src = URL.createObjectURL(ms);
    let sb = null;
    const queue = [];
    let fallbackLock = false;

    function appendNext() {
      if (!sb || sb.updating || queue.length === 0) return;
      const chunk = queue.shift();
      try { sb.appendBuffer(chunk); } catch (e) { console.warn('[TTS] appendBuffer 失败', e && e.message); }
    }

    function cleanup() {
      try { if (currentReader) currentReader.cancel(); } catch (_) {}
      try { if (ms.readyState === 'open') ms.endOfStream(); } catch (_) {}
      try { URL.revokeObjectURL(audio.src); } catch (_) {}
      currentReader = null;
      currentMediaSource = null;
      if (currentAudio === audio) currentAudio = null;
    }

    async function fallbackToBlob() {
      if (fallbackLock) return;
      fallbackLock = true;
      console.warn('[TTS] 流式播放失败，自动降级整段 blob');
      cleanup();
      try {
        const r2 = await fetch('/api/speak', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text, voice, rate, stream: false }),
        });
        if (r2.ok) { playBlob(await r2.blob(), onDone); return; }
      } catch (e) {
        console.warn('[TTS] blob 兜底也失败', e && e.message);
      }
      updateTtsStopButton(false);
      if (onDone) onDone();
    }

    audio.onplay = () => {
      updateTtsStopButton(true);
      attachOrbTTSAnalyser(audio);
      startOrbTTSPump();
    };
    audio.onended = () => {
      updateTtsStopButton(false);
      stopOrbTTSPump();
      cleanup();
      if (onDone) onDone();
    };
    audio.onerror = () => { fallbackToBlob(); };
    ms.addEventListener('error', () => { fallbackToBlob(); });

    ms.addEventListener('sourceopen', async () => {
      try {
        sb = ms.addSourceBuffer('audio/mpeg');
        sb.addEventListener('updateend', appendNext);
        // 拿到 source buffer 后再 play，避免过早 reject
        audio.play().catch((e) => { console.warn('[TTS] 流式播放启动失败', e && e.message); fallbackToBlob(); });
        const reader = r.body.getReader();
        currentReader = reader;
        try {
          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            if (value && value.length) { queue.push(value); appendNext(); }
          }
        } catch (e) {
          console.warn('[TTS] 流读取中断（多为被打断）', e && e.message); // 静默忽略
        }
        const finish = () => { try { if (ms.readyState === 'open') ms.endOfStream(); } catch (_) {} };
        if (sb.updating) sb.addEventListener('updateend', finish, { once: true }); else finish();
      } catch (e) {
        console.warn('[TTS] MSE 初始化失败，降级整段 blob', e && e.message);
        fallbackToBlob();
      }
    });
  }

  // ── TTS 播放时把音频音量实时注入语音球，让 speaking 状态随语音跳动（参考实现同款）──
  function attachOrbTTSAnalyser(audio) {
    try {
      if (!window.AudioContext && !window.webkitAudioContext) return null;
      if (!ttsAudioCtx) {
        ttsAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      ttsAnalyser = ttsAudioCtx.createAnalyser();
      ttsAnalyser.fftSize = 256;
      ttsAnalyser.smoothingTimeConstant = 0.5;
      ttsGain = ttsAudioCtx.createGain();
      ttsGain.gain.value = currentTtsVolume; // 支持 >1 放大
      const src = ttsAudioCtx.createMediaElementSource(audio);
      // 走 Web Audio 后由 gain 控制音量，元素自身音量归 1，避免二次衰减
      try { audio.volume = 1; } catch (_) {}
      src.connect(ttsGain);
      ttsGain.connect(ttsAnalyser);
      ttsAnalyser.connect(ttsAudioCtx.destination);
      return ttsAnalyser;
    } catch (e) {
      console.warn('[TTS] 语音球可视化连接失败:', e.message);
      return null;
    }
  }

  function pumpOrbTTSVolume() {
    if (!ttsAnalyser || !window.ZZAvatar) {
      ttsOrbRaf = null;
      return;
    }
    const data = new Uint8Array(ttsAnalyser.frequencyBinCount);
    ttsAnalyser.getByteFrequencyData(data);
    const sum = data.reduce((a, b) => a + b, 0);
    const vol = (sum / data.length) / 255;
    window.ZZAvatar.setVolume(vol);
    ttsOrbRaf = requestAnimationFrame(pumpOrbTTSVolume);
  }

  function startOrbTTSPump() {
    if (ttsOrbRaf) cancelAnimationFrame(ttsOrbRaf);
    ttsOrbRaf = requestAnimationFrame(pumpOrbTTSVolume);
  }

  function stopOrbTTSPump() {
    if (ttsOrbRaf) {
      cancelAnimationFrame(ttsOrbRaf);
      ttsOrbRaf = null;
    }
    if (window.ZZAvatar) window.ZZAvatar.setVolume(0);
  }

  async function speak(text, onDone, cancelCheck) {
    if (!text || !text.trim()) { if (onDone) onDone(); return; }
    stopSpeaking(); // 新朗读自动停止旧语音
    const tts = (window.ZZSettings && window.ZZSettings.get) ? window.ZZSettings.get() : {};
    const voice = tts.ttsVoice || 'zh-CN-YunxiNeural';
    const rate = tts.ttsRate || '+0%';
    currentTtsVolume = (typeof tts.ttsVolume === 'number' && tts.ttsVolume > 0) ? tts.ttsVolume : 1;
    let lastErr = null;
    let preferBlob = false; // 流式同步失败后，下一轮强制走整段 blob
    // 微软 TTS 云直连偶发握手失败/空音频，自动重试应对网络抖动（参数错误 400 不重试）
    for (let attempt = 0; attempt < 3; attempt++) {
      try {
        const r = await fetch('/api/speak', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            text,
            voice,
            rate,
            stream: preferBlob ? false : undefined,
          }),
        });
        if (r.ok) {
          // 已被取消（如语音模式中被用户打断）→ 放弃播放，不触发 onDone
          if (cancelCheck && cancelCheck()) return;
          const mode = r.headers.get('X-TTS-Mode');
          const supportsMSE = !!(window.MediaSource && MediaSource.isTypeSupported('audio/mpeg'));
          if (mode === 'stream' && supportsMSE && !preferBlob) {
            playStreamMSE(r, text, voice, rate, onDone);    // P8-2 真流式：边收边播
          } else {
            const blob = await r.blob();
            playBlob(blob, onDone);      // 整段 blob（含 MSE 不支持时的降级）
          }
          return; // 成功（onDone 在播完时触发）
        }
        if (r.status === 400) {
          const e = await r.json().catch(() => ({}));
          toast('语音合成失败：' + (e.error || r.status));
          if (onDone) onDone();
          return;
        }
        lastErr = 'HTTP ' + r.status;
      } catch (e) {
        lastErr = e.message;
      }
      // 若流式初始化失败（如 MSE 解码错误），下一轮强制请求整段 blob
      preferBlob = true;
      if (attempt < 2) await new Promise((res) => setTimeout(res, 1200)); // 间隔重试
    }
    updateTtsStopButton(false);
    toast('语音合成失败，请稍后重试：' + lastErr);
    if (onDone) onDone();
  }

  /* ---------- 功能弹窗（modal） ---------- */
  // 通用遮罩容器（首次使用时惰性挂载到 body）
  let _modalMask = null;
  function modalRoot() {
    if (!_modalMask) {
      _modalMask = document.createElement('div');
      _modalMask.className = 'modal-mask';
      _modalMask.addEventListener('click', (e) => {
        if (e.target === _modalMask) closeModal();
      });
      document.body.appendChild(_modalMask);
    }
    return _modalMask;
  }
  function hideModalMask() {
    if (_modalMask) _modalMask.classList.remove('show');
  }
  function closeModal() {
    if (window.OverlayManager && window.OverlayManager.isOpen('modal-mask')) window.OverlayManager.close('modal-mask');
    else hideModalMask();
  }
  function showModal(ev) {
    // 首页聚合热点弹窗已移除：聊天触发「更新实时新闻」不再自动弹出多平台热点卡片。
    if (ev && ev.kind === 'hotspots') return;
    const root = modalRoot();
    let html = '';
    if (ev.kind === 'weather') {
      html = renderWeatherModal(ev.data);
    } else if (ev.kind === 'hotspot') {
      html = renderHotspotModal(ev.data);
    } else if (ev.kind === 'agent_approval') {
      html = renderApprovalModal(ev);
    } else {
      html = `<div class="modal-close">×</div><div style="color:var(--dim);padding:20px">暂不支持的弹窗类型：${escapeHtml(ev.kind || '')}</div>`;
    }
    root.innerHTML = '<div class="modal-card">' + html + '</div>';
    // 关闭按钮
    root.querySelectorAll('.modal-close').forEach((b) => b.addEventListener('click', closeModal));
    // 外链（查看原文 / 平台条目）
    root.querySelectorAll('[data-url]').forEach((el) => {
      el.style.cursor = 'pointer';
      el.addEventListener('click', () => {
        const u = el.getAttribute('data-url') || '';
        if (u) window.open(u, '_blank', 'noopener');
      });
    });
    // 朗读按钮
    root.querySelectorAll('[data-summary]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const t = btn.getAttribute('data-summary') || '';
        if (t) speak(t);
      });
    });
    // Agent 审批卡：批准/拒绝 → POST /api/agent/approval
    root.querySelectorAll('[data-approval]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const ticket = btn.getAttribute('data-ticket') || '';
        const decision = btn.getAttribute('data-approval') || '';
        if (!ticket || !decision) return;
        const all = root.querySelectorAll('[data-approval]');
        const label = btn.textContent;
        all.forEach((b) => { b.disabled = true; });
        btn.textContent = '处理中…';
        fetch('/api/agent/approval?ticket=' + encodeURIComponent(ticket) + '&decision=' + encodeURIComponent(decision), { method: 'POST' })
          .then(() => { closeModal(); })
          .catch(() => {
            all.forEach((b) => { b.disabled = false; });
            btn.textContent = label;
            toast('审批提交失败，请重试');
          });
      });
    });
    root.classList.add('show');
    // Sprint 1/2：modal-mask 登记到 OverlayManager（统一 ESC / 焦点 / 栈；保留高位 z-index）
    if (window.OverlayManager) window.OverlayManager.track('modal-mask', { el: root, onClose: hideModalMask, type: window.OverlayManager.OverlayType.MODAL, trap: true, keepZIndex: true });
  }

