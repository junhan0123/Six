  function renderBriefing(d) {
    const w = d.weather || {};
    let h = '<div class="briefing-sec"><div class="briefing-sec-h">🌤 今日天气</div>';
    h += w.error
      ? '<div class="briefing-empty">天气获取失败</div>'
      : '<div class="briefing-weather"><b>' + esc(w.city || '本地') + '</b> · ' + esc(w.condition || '—') +
        '，当前 ' + esc(w.temp || '—') + '°，最高 ' + esc(w.high || '—') + '° / 最低 ' + esc(w.low || '—') + '°</div>';
    h += '</div>';

    h += '<div class="briefing-sec"><div class="briefing-sec-h"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-flame"/></svg> 今日热点</div>';
    const hs = d.hotspots || [];
    if (!hs.length || hs[0].error) {
      h += '<div class="briefing-empty">暂无热点</div>';
    } else {
      h += '<ul class="briefing-list">';
      hs.forEach((it, i) => {
        h += '<li><span class="briefing-rank">' + (i + 1) + '</span><span>' + esc(it.text || '') +
             (it.heat ? '<span class="briefing-heat">' + esc(it.heat) + '</span>' : '') + '</span></li>';
      });
      h += '</ul>';
    }
    h += '</div>';

    h += '<div class="briefing-sec"><div class="briefing-sec-h"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-check"/></svg> 待办</div>';
    const ts = d.tasks || [];
    if (!ts.length) {
      h += '<div class="briefing-empty">今天没有待办，轻松一下</div>';
    } else {
      h += '<ul class="briefing-list">';
      ts.forEach((t) => {
        h += '<li><span class="briefing-rank">•</span><span class="briefing-task">' +
             esc(t.title || t.content || '未命名任务') + '</span></li>';
      });
      h += '</ul>';
    }
    h += '</div>';

    // 今日建议（P4-C：停滞提醒 + 临近到期）
    const sg = d.suggestions || [];
    h += '<div class="briefing-sec"><div class="briefing-sec-h"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-idea"/></svg> 今日建议</div>';
    if (!sg.length) {
      h += '<div class="briefing-empty">目标都在推进中，暂无特别提示</div>';
    } else {
      h += '<ul class="briefing-list">';
      sg.forEach((t) => {
        h += '<li><span class="briefing-rank"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-idea"/></svg></span><span class="briefing-task">' + esc(t) + '</span></li>';
      });
      h += '</ul>';
    }
    h += '</div>';

    return h;
