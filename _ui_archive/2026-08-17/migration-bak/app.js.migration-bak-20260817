  /* ---------- 主动智能：接收服务端推送（复用全局 SSE 单例） ---------- */
  function connectProactive() {
    if (!window.ZZSSE) return;
    window.ZZSSE.onMessage((raw) => {
      try {
        const json = JSON.parse(raw);
        if (json && json.zhuangzhou_event === 'proactive') {
          const k = json.kind;
          // 首页仅保留天气通知；舆情/告警类主动消息不再显示（也不存入历史）。
          if (k === 'hotspot' || k === 'alert') return;
          if (k === 'rule_panel') { openRulePanel(json.content); return; }
          if (k === 'weather') renderNotifyBubble(k, json.content, json.ts);
          else renderProactive(json);
        } else if (json && json.zhuangzhou_event === 'scene') {
          // 后台任务（如软件安装进度）经 /api/stream 实时推送的声明式卡片
          if (window.ZZScene) window.ZZScene.apply(json);
        } else if (json && json.zhuangzhou_event === 'modal') {
          // Agent Runtime 后台审批卡（agent_approval 等）
          showModal(json);
        } else if (json && json.zhuangzhou_event === 'agent_state') {
          // Agent Runtime 编排状态变更
          updateAgentState(json);
        } else if (json && json.zhuangzhou_event === 'hud_state') {
          // P11 全息 HUD：Agent 编排态映射到光环/化身（语音态由 setOrb 驱动，二者互补）
          const st = json.state === 'thinking' ? 'thinking' : 'idle';
          if (window.ZZHudRing && window.ZZHudRing.setState) {
            try { window.ZZHudRing.setState(st); } catch (_) {}
          }
          if (window.ZZAvatarScene && window.ZZAvatarScene.setState) {
            try { window.ZZAvatarScene.setState(st); } catch (_) {}
          }
        }
      } catch (_) {}
    });
    refreshAgentState();
  }

