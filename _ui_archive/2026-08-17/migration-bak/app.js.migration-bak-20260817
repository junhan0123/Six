  /* ---------- 核心状态指示 ---------- */
  function setCoreState(state, text) {
    const pill = document.getElementById('corePill');
    if (!pill) return;
    const txt = pill.querySelector('#corePillTxt');
    pill.classList.toggle('ok', state === 'ok');
    pill.classList.toggle('warn', state === 'warn'); // state 为 offline/failed 时两者皆移除 → 默认红色
    if (txt) txt.textContent = text;
  }

  async function health() {
    if (!checkProtocol()) return;
    try {
      const r = await fetch('/api/health', { cache: 'no-store' });
      const d = await r.json();
      setCoreState('ok', '核心在线 · ' + (d.model || ''));
      const mModel = document.getElementById('mModel');
      if (mModel) mModel.textContent = d.model || '—';
    } catch (e) {
      setCoreState('offline', '核心离线');
