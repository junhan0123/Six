  /* ---------- 前端启动自检 ---------- */
  // 启动即检测：WebGL 能力、关键模块桥注册、Three.js 资源可达，
  // 直接暴露地球/语音球不显示的根因（如 ZZEarth 未注册、WebGL 不可用）。
  async function frontendSelfCheck() {
    const pill = $('#fePill');
    const txt = $('#fePillTxt');
    if (!pill || !txt) return;

    const detail = [];
    let fatal = false; // 致命：地球/语音球必然不可用
    let warn = false;  // 警告：部分能力缺失，但核心可用

    // 1) WebGL 支持
    let webgl = false;
    try {
      const c = document.createElement('canvas');
      webgl = !!(window.WebGLRenderingContext &&
        (c.getContext('webgl2') || c.getContext('webgl') || c.getContext('experimental-webgl')));
    } catch (e) { webgl = false; }
    detail.push('WebGL ' + (webgl ? '✓' : '✗'));
    if (!webgl) fatal = true;

    // 2) 关键模块桥注册（代表对应子模块初始化成功）
    const bridges = {
      ZZModal: !!window.ZZModal,
      ZZEarth: !!window.ZZEarth,
      ZZAvatar: !!window.ZZAvatar,
      ZZCognitiveFeed: !!window.ZZCognitiveFeed,
      ZZSettings: !!window.ZZSettings,
    };
    const bridgeOk = Object.values(bridges).filter(Boolean).length;
    const bridgeTotal = Object.keys(bridges).length;
    detail.push('模块桥 ' + bridgeOk + '/' + bridgeTotal);
    if (!bridges.ZZModal || !bridges.ZZEarth) fatal = true;
    else if (bridgeOk < bridgeTotal) warn = true;

    // 3) Three.js 资源可达（本地优先，CDN 兜底；若 ZZEarth 已注册说明实际可用）
    let threeRes = 'unknown';
    try {
      const r = await fetch('./vendor/three/three.module.js', { method: 'HEAD', cache: 'no-store' });
      threeRes = r.ok ? '本地 200' : ('本地 ' + r.status);
    } catch (e) {
      threeRes = '本地不可达';
    }
    detail.push('Three ' + threeRes);
    if (threeRes !== '本地 200' && !bridges.ZZEarth) warn = true;

    // 综合展示
    pill.classList.remove('ok', 'warn');
    if (fatal) {
      txt.textContent = '前端自检 ✗';
      // 保持默认红色（.status-pill 基色即红）
    } else if (warn) {
      pill.classList.add('warn');
      txt.textContent = '前端自检 <svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-warning"/></svg>';
    } else {
      pill.classList.add('ok');
      txt.textContent = '前端自检 ✓';
    }
    pill.title = '前端自检明细 · ' + detail.join(' · ');
    console.log('[前端自检] ' + detail.join(' · '));
  }
  // 各子模块为 defer module，会在 DOMContentLoaded 前完成初始化，此处等待其就绪后检测
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => { frontendSelfCheck().catch(() => {}); });
  } else {
    requestAnimationFrame(() => { frontendSelfCheck().catch(() => {}); });
