        html += '<div class="ap-card-title" style="margin:16px 0 8px">全部任务</div><div class="ap-ov-list">' +
          tasks.slice(0, 12).map(function (t) {
            return '<div class="ap-ov-card"><span class="ap-ov-title">' + esc(t.title || ('任务 #' + t.id)) + '</span>' +
              '<span class="ap-ov-meta"><b>' + esc(t.status || '') + '</b><span>' + esc(t.updated || '') + '</span></span></div>';
          }).join('') + '</div>';
      }
      openOverlay('工作', '目标与任务 · /api/goals · /api/tasks', html);
    },

    settings: function () {
      var h = snap.health || {};
      var a = snap.agent || {};
      var loc = location.origin;

      var html = '' +
        /* ── 功能偏好（可交互）── */
        '<div class="ap-set-group"><div class="ap-set-group-title">功能偏好</div>' +
        setRow('web', '联网搜索', '默认开启，搜索时自动联网', toolModes.web) +
        setRow('think', '深度思考', '启用后回复前先进行深度推理', toolModes.think) +
        setRow('speak', '语音播报', '回复完成后自动朗读', autoSpeak) +
        '</div>' +
        /* ── 系统概览（原 DATA 面板降级至此）── */
        '<div class="ap-set-group"><div class="ap-set-group-title">系统概览</div>' +
        '<div class="ap-set-row"><span class="ap-set-label">目标 / 任务</span><b style="color:var(--ap-cyan)">' + activeGoals().length + ' / ' + snap.tasks.filter(isOpenTask).length + '</b></div>' +
        '<div class="ap-set-row"><span class="ap-set-label">记忆 / 知识</span><b style="color:var(--ap-cyan)">' + (snap.memories || []).length + ' / ' + asList(snap.knowledge, 'docs').length + '</b></div>' +
        '<div class="ap-set-row"><span class="ap-set-label">能力登记</span><b style="color:var(--ap-cyan)">' + (snap.capabilities || []).length + ' 项</b></div>' +
        '<div class="ap-set-row"><span class="ap-set-label">待办提醒</span><b style="color:var(--ap-cyan)">' + ((snap.memory && Array.isArray(snap.memory.reminders)) ? snap.memory.reminders.filter(function (r) { return !r.done; }).length : 0) + ' 条</b></div>' +
        '</div>' +
        /* ── 代码执行模式 ── */
        '<div class="ap-set-group"><div class="ap-set-group-title">代码执行</div>' +
        '<div class="ap-set-row"><span class="ap-set-label">执行模式<small>根据指令内容自动判断</small></span>' +
        '<div class="ap-set-seg" data-seg-code">' +
          '<button type="button" data-val="off"' + (toolModes.code === false ? ' class="is-active"' : '') + '>关闭</button>' +
          '<button type="button" data-val="auto"' + (toolModes.code !== false && toolModes.code !== true ? ' class="is-active"' : '') + '>自适应</button>' +
          '<button type="button" data-val="on"' + (toolModes.code === true ? ' class="is-active"' : '') + '>强制开</button>' +
        '</div></div>' +
        '</div>' +
        /* ── 系统信息（只读）── */
        '<div class="ap-set-group"><div class="ap-set-group-title">系统信息</div>' +
        '<div class="ap-set-row"><span class="ap-set-label">AI 名称</span>' +
        '<input class="ap-set-input" id="setAiName" value="' + esc(h.ai_name || '小6') + '" style="width:140px" /></div>' +
        '<div class="ap-set-row"><span class="ap-set-label">模型</span><b style="font-family:var(--ap-font-mono);font-size:12px;color:var(--ap-cyan)">' + esc(h.model || '—') + '</b></div>' +
        '<div class="ap-set-row"><span class="ap-set-label">提供方</span><b style="font-family:var(--ap-font-mono);font-size:12px;color:var(--ap-text)">' + esc(h.provider || '—') + '</b></div>' +
        '<div class="ap-set-row"><span class="ap-set-label">已挂载工具</span><b style="color:var(--ap-cyan)">' + (Array.isArray(h.tools) ? h.tools.length : '—') + ' 项</b></div>' +
        '<div class="ap-set-row"><span class="ap-set-label">TTS 引擎</span><b style="color:var(--ap-text)">' + esc(h.tts_backend || '—') + '</b></div>' +
        '<div class="ap-set-row"><span class="ap-set-label">数据接口</span><b style="font-family:var(--ap-font-mono);font-size:11.5px;color:var(--ap-dim)">' + loc + '</b></div>' +
        '<div class="ap-set-row"><span class="ap-set-label">当前状态</span><b style="color:' + (String(a.state || 'IDLE').toUpperCase() === 'ERROR' ? '#f87171' : 'var(--ap-green)') + '">' + stateText(String(a.state || 'IDLE').toUpperCase()) + '</b></div>' +
        '</div>' +
        /* ── 版本信息 ── */
        '<div class="ap-empty" style="text-align:left;padding:14px 2px;color:var(--ap-faint)">小6 AETHER PRO v2.3 · 本地个人 AI 副驾<br/>全息语音球 · 深度思考 / 联网搜索 / 代码执行 / 记忆 / 知识 / 项目全量接入。</div>';

      openOverlay('设置与系统', '偏好设置 · 系统状态', html, function () {
        /* 开关事件委托 */
        var body = $('overlayBody');
        body.addEventListener('change', function (e) {
          var sw = e.target.closest('.ap-set-switch input');
          if (!sw) return;
          var key = sw.dataset.key;
          if (key === 'web') { toolModes.web = sw.checked; }
          else if (key === 'think') { toolModes.think = sw.checked; }
          else if (key === 'speak') { setAutoSpeak(sw.checked); }
          savePrefs();
          syncToolbar();
        });
        /* 分段选择器 */
        body.addEventListener('click', function (e) {
          var seg = e.target.closest('.ap-set-seg');
          if (!seg) return;
          var btn = e.target.closest('[data-val]');
          if (!btn) return;
          seg.querySelectorAll('button').forEach(function (b) { b.classList.remove('is-active'); });
          btn.classList.add('is-active');
          var val = btn.getAttribute('data-val');
          if (seg.dataset.segCode !== undefined) {
            toolModes.code = val === 'auto' ? 'auto' : val === 'on';
            savePrefs();
          }
        });
        /* AI 名称保存 */
        var nameInput = $('setAiName');
        if (nameInput) {
          nameInput.addEventListener('change', function () {
            try { localStorage.setItem('zz_aiName', nameInput.value.trim()); } catch (e) {}
            toast('AI 名称已更新');
          });
        }
      });
    }
  };

  function setActiveNav(nav) {
    document.querySelectorAll('.ap-nav-btn').forEach(function (b) {
      b.classList.toggle('is-active', b.getAttribute('data-nav') === nav);
    });
  }

  function initNav() {
    /* 导航切换按钮 */
    var toggle = $('navToggle');
    if (toggle) {
      toggle.addEventListener('click', function () {
        document.body.classList.toggle('nav-open');
        /* 打开导航时关闭右侧面板 */
        document.body.classList.remove('right-open');
      });
    }

    /* 右侧面板关闭按钮 */
    var rightClose = $('rightClose');
    if (rightClose) {
      rightClose.addEventListener('click', function () {
        document.body.classList.remove('right-open');
      });
    }

    /* 导航项点击 */
    document.querySelectorAll('[data-nav]').forEach(function (el) {
      el.addEventListener('click', function () {
        var nav = el.getAttribute('data-nav');
        if (navHandlers[nav]) {
          navHandlers[nav]();
          setActiveNav(nav);
        }
        /* 移动端点击后收起导航 */
        document.body.classList.remove('nav-open');
      });
    });
    $('overlayClose').addEventListener('click', closeOverlay);
    $('overlayScrim').addEventListener('click', closeOverlay);

    /* ESC 关闭所有面板 */
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        document.body.classList.remove('nav-open', 'right-open');
      }
    });

    /* 点击主区域空白处关闭导航 */
    $('coreStage').addEventListener('click', function (e) {
      if (e.target.closest('.ap-nav-toggle') || e.target.closest('.ap-nav')) return;
      document.body.classList.remove('nav-open');
    });
  }

  /* ═══════════ 9. 轮询 ═══════════ */
  function startPolling() {
    fetchSnapshot();
    setInterval(function () {
      Promise.all([getJSON('/api/agent/state'), getJSON('/api/health')]).then(function (res) {
        if (res[0]) snap.agent = res[0];
        if (res[1]) snap.health = res[1];
        renderStatus();
        renderCore();
        renderProc();
      });
    }, 8000);
    setInterval(fetchSnapshot, 30000);
  }

  /* ═══════════ 10. Boot ═══════════ */
  function boot() {
    scaleViewport();
    window.addEventListener('resize', scaleViewport);
    tickClock();
    setInterval(tickClock, 1000 * 15);
    initParticles();   /* Canvas 粒子场（替代旧星空+Lottie） */
    initOrb();        /* Lottie 保留但被 CSS 隐藏 */
    initPetOrb();
    initCmd();
    initNav();
    setAutoSpeak(autoSpeak);
    loadPrefs();
    syncToolbar();
    startPolling();
    startHotPolling();
    setActiveNav('home');
  }

  /* 全局暴露：供外部/脚本打开右侧面板 */
  window.__showRightPanel = function () { document.body.classList.add('right-open'); };
  window.__toggleNav = function () { document.body.classList.toggle('nav-open'); };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
