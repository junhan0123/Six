  /* ═════════ 7.3 VAD 实时语音监听（getUserMedia + AudioContext） ═══════════ */
  var vadStream = null; var vadCtx = null; var vadSource = null; var vadAnalyser = null;
  var vadListening = false; var vadSpeaking = false;
  var VAD_RMS_THRESH = 0.018;   /* 语音阈值 */
  var VAD_SILENCE_MS = 1200;     /* 静默多久算说完（ms） */
  var VAD_MAX_UTTER_MS = 20000;  /* 单次最长录音（ms） */
  var vadSilenceStart = 0; var vadUtterStart = 0;
  var vadAudioChunks = [];        /* 录音片段 */
  var vadProcessor = null;

  function toggleVad() {
    if (vadListening) { stopVad(); return; }
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      toast('当前浏览器不支持麦克风访问');
      return;
    }
    navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true, sampleRate: 16000 } })
      .then(function (stream) {
        vadStream = stream;
        vadCtx = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: 16000 });
        vadSource = vadCtx.createMediaStreamSource(stream);
        vadAnalyser = vadCtx.createAnalyser();
        vadAnalyser.fftSize = 2048;
        vadAnalyser.smoothingTimeConstant = .7;
        vadSource.connect(vadAnalyser);

        /* ScriptProcessor 录制 PCM */
        var bufSize = 4096;
        vadProcessor = vadCtx.createScriptProcessor(bufSize, 1, 1);
        vadProcessor.onaudioprocess = function (e) {
          if (!vadSpeaking && !vadListening) return;
          var data = e.inputBuffer.getChannelData(0);
          /* 转换为 16bit PCM 并缓存 */
          var pcm16 = new Int16Array(data.length);
          for (var i = 0; i < data.length; i++) {
            var s = Math.max(-1, Math.min(1, data[i]));
            pcm16[i] = s < 0 ? s * 0x8000 : s * 0x7FFF;
          }
          if (vadSpeaking) vadAudioChunks.push(pcm16.buffer);
          /* RMS 检测 */
          var rms = 0;
          for (var j = 0; j < data.length; j++) rms += data[j] * data[j];
          rms = Math.sqrt(rms / data.length);
          checkVadLevel(rms);
        };
        vadAnalyser.connect(vadProcessor);
        vadProcessor.connect(vadCtx.destination);

        vadListening = true;
        vadAudioChunks = [];
        $('cmdVad').classList.add('is-listening');
        showPetOrb();   // 语音激活 → 显示白龙马语音球（对齐白龙马 enter() 机制）
        toast('实时监听已开启 · 开始说话');
      })
      .catch(function (err) {
        console.warn('[VAD] 麦克风权限拒绝', err);
        toast('无法访问麦克风 · 请检查浏览器权限设置');
      });
  }

  function stopVad() {
    vadListening = false;
    vadSpeaking = false;
    $('cmdVad').classList.remove('is-listening', 'is-speaking');
    hidePetOrb();   // 语音停止 → 隐藏语音球（对齐白龙马 exit() 机制）
    try {
      if (vadProcessor) { vadProcessor.disconnect(); vadProcessor = null; }
      if (vadAnalyser) { vadAnalyser.disconnect(); vadAnalyser = null; }
      if (vadSource) { vadSource.disconnect(); vadSource = null; }
      if (vadCtx && vadCtx.state !== 'closed') { vadCtx.close().catch(function () {}); vadCtx = null; }
      if (vadStream) { vadStream.getTracks().forEach(function (t) { t.stop(); }); vadStream = null; }
    } catch (e) {}
    vadAudioChunks = [];
  }

  function checkVadLevel(rms) {
    var now = Date.now();
    if (rms > VAD_RMS_THRESH) {
      /* 检测到语音 */
      if (!vadSpeaking) {
        /* 刚开始说话 */
        vadSpeaking = true;
        vadUtterStart = now;
        vadAudioChunks = [];
        $('cmdVad').classList.remove('is-listening');
        $('cmdVad').classList.add('is-speaking');
      }
      vadSilenceStart = now;
      /* 超时保护 */
      if (now - vadUtterStart > VAD_MAX_UTTER_MS) {
        finishVadUtterance();
      }
    } else if (vadSpeaking && (now - vadSilenceStart > VAD_SILENCE_MS)) {
      /* 静默超过阈值 → 说完了 */
      finishVadUtterance();
    }
  }

  function finishVadUtterance() {
    if (!vadSpeaking) return;
    vadSpeaking = false;
    $('cmdVad').classList.remove('is-speaking');
    $('cmdVad').classList.add('is-listening');

    /* 合并 PCM chunks 为 WAV */
    var totalLen = 0;
    for (var c = 0; c < vadAudioChunks.length; c++) totalLen += vadAudioChunks[c].byteLength;
    if (totalLen < 3200) { /* 太短，忽略 */ vadAudioChunks = []; return; }

    var merged = new Int16Array(totalLen / 2);
    var offset = 0;
    for (var i = 0; i < vadAudioChunks.length; i++) {
      var chunk = new Int16Array(vadAudioChunks[i]);
      merged.set(chunk, offset);
      offset += chunk.length;
    }
    var wav = pcmToWav(merged, 16000);
    var blob = new Blob([wav], { type: 'audio/wav' });

    /* 发送到 ASR 接口 */
    var formData = new FormData();
    formData.append('audio', blob, 'vad_utter.wav');

    toast('识别中...');
    fetch('/api/asr?ext=.wav', { method: 'POST', body: formData, credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var text = (d && d.text) || '';
        if (!text.trim()) { toast('未识别到有效内容'); return; }
        $('cmdInput').value = text;
        submitCmd(text);
      })
      .catch(function () { toast('语音识别失败'); });

    vadAudioChunks = [];
  }

  /* PCM Int16 → WAV（浏览器端生成） */
  function pcmToWav(samples, sampleRate) {
    var len = samples.length;
    var buffer = new ArrayBuffer(44 + len * 2);
    var view = new DataView(buffer);
    /* RIFF header */
    writeStr(view, 0, 'RIFF'); view.setUint32(4, 36 + len * 2, true);
    writeStr(view, 8, 'WAVE');
    /* fmt chunk */
    writeStr(view, 12, 'fmt '); view.setUint32(16, 16, true);
    view.setUint16(20, 1, true);         /* PCM */
    view.setUint16(22, 1, true);         /* mono */
    view.setUint32(24, sampleRate, true);
    view.setUint32(28, sampleRate * 2, true); /* byte rate */
    view.setUint16(32, 2, true);         /* block align */
    view.setUint16(34, 16, true);        /* bits per sample */
    /* data chunk */
    writeStr(view, 36, 'data');
    view.setUint32(40, len * 2, true);
    for (var i = 0; i < len; i++) view.setInt16(44 + i * 2, samples[i], true);
    return new Uint8Array(buffer);
  }
  function writeStr(view, offset, str) {
    for (var i = 0; i < str.length; i++) view.setUint8(offset + i, str.charCodeAt(i));
  }

  /* ═════════ 7.4 原有快捷键语音（webkitSpeechRecognition，保留兼容） ═══════════ */
  function toggleMic() {
    var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SR) {
      var h = $('voiceHint');
      h.hidden = false;
      h.textContent = '当前浏览器不支持语音识别';
      setTimeout(function () { h.hidden = true; }, 2600);
      return;
    }
    if (listening) {
      if (window.__zzRec) window.__zzRec.stop();
      return;
    }
    var rec = new SR();
