  /* ── 语音输出（TTS）：回复自动朗读，音色由后端 SoVITS 决定 ── */
  var autoSpeak = (function () {
    try { return localStorage.getItem('zz_autoSpeak') !== '0'; } catch (e) { return true; }
  })();
  var _speakAudio = null;
  function speakText(text) {
    text = String(text || '').replace(/\s+/g, ' ').trim();
    if (!text) return;
    // 打断上一段未播完的语音，避免堆叠
    if (_speakAudio) { try { _speakAudio.pause(); } catch (e) {} _speakAudio = null; }
    var spk = $('cmdSpeak');
    if (spk) spk.classList.add('is-speaking');
    fetch('/api/speak', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text: text, stream: false })
    }).then(function (r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.blob();
    }).then(function (blob) {
      var url = URL.createObjectURL(blob);
      var a = new Audio(url);
      _speakAudio = a;
      a.onended = function () { URL.revokeObjectURL(url); _speakAudio = null; if (spk) spk.classList.remove('is-speaking'); };
      a.onerror = function () { URL.revokeObjectURL(url); _speakAudio = null; if (spk) spk.classList.remove('is-speaking'); };
      return a.play();
    }).catch(function (e) {
      console.warn('[TTS] 合成/播放失败', e && e.message);
      if (spk) spk.classList.remove('is-speaking');
    });
  }
  function setAutoSpeak(on) {
    autoSpeak = !!on;
    try { localStorage.setItem('zz_autoSpeak', autoSpeak ? '1' : '0'); } catch (e) {}
    var btn = $('cmdSpeak');
    if (btn) btn.classList.toggle('is-on', autoSpeak);
  }

  function sendChat(text, opts) {
    opts = opts || {};
    var payload = {
      messages: [{ role: 'user', content: String(text) }],
      session_id: opts.session_id || sessionId
    };
    if (opts.images && opts.images.length) payload.images = opts.images.slice(0, 4);

    busy = true;
    renderStatus();
    if (opts.onStart) opts.onStart();

    return fetch('/api/chat', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    }).then(function (r) {
      if (!r.ok || !r.body) throw new Error('HTTP ' + r.status);
      return r.body.getReader();
    }).then(function (reader) {
      var decoder = new TextDecoder('utf-8');
      var buf = '';
      var reply = '';
      var done = false;

      function pump() {
        return reader.read().then(function (res) {
          if (res.done) { finish(); return; }
          buf += decoder.decode(res.value, { stream: true });
          var blocks = buf.split('\n\n');
          buf = blocks.pop();
          for (var i = 0; i < blocks.length; i++) {
            var raw = blocks[i].trim();
            if (!raw) continue;
            if (raw.indexOf('data:') === 0) raw = raw.slice(5).trim();
            if (raw === '[DONE]') { done = true; finish(); return; }
            var m;
            try { m = JSON.parse(raw); } catch (e) { continue; }
            handle(m);
          }
          if (!done) return pump();
        });
      }

      function handle(m) {
        var ev = m.zhuangzhou_event || m.event;
        if (ev === 'tool_start') {
          if (opts.onTool) opts.onTool('start', m.tool, m.args);
        } else if (ev === 'tool_end') {
          if (opts.onTool) opts.onTool('end', m.tool, m.result, m.ok !== false);
        } else if (m.choices && m.choices[0] && m.choices[0].delta) {
          var dc = m.choices[0].delta.content || '';
          if (dc) {
            reply += dc;
            if (opts.onReply) opts.onReply(dc, reply);
          }
        }
      }

      function finish() {
        busy = false;
        renderStatus();
        if (opts.onDone) opts.onDone(reply);
        setTimeout(fetchSnapshot, 1200);
      }

      pump();
    }).catch(function (err) {
      busy = false;
      renderStatus();
      if (opts.onError) opts.onError(err);
      setTimeout(fetchSnapshot, 600);
    });
  }

