(function () {
  'use strict';

  function $(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function getJSON(url) {
    return fetch(url, { credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json().catch(function () { return null; }) : null; })
      .catch(function () { return null; });
  }
  function asList(v, key) {
    if (Array.isArray(v)) return v;
    if (v && Array.isArray(v[key])) return v[key];
    return [];
  }
  function pad(n) { return n < 10 ? '0' + n : '' + n; }
  function fmtTime(ts) {
    var d = ts ? new Date(String(ts).replace(/-/g, '/')) : new Date();
    if (isNaN(d.getTime())) d = new Date();
    return pad(d.getHours()) + ':' + pad(d.getMinutes());
  }
  /* 轻量提示（复用命令条下方空间，不引第三方库） */
  var _toastTimer = null;
  function toast(msg) {
    var hint = $('voiceHint');
    if (!hint) return;
    hint.textContent = msg;
    hint.hidden = false;
    clearTimeout(_toastTimer);
    _toastTimer = setTimeout(function () { hint.hidden = true; }, 2200);
  }
  function fmtDate(d) {
    d = d || new Date();
    var wd = ['日', '一', '二', '三', '四', '五', '六'][d.getDay()];
    return (d.getMonth() + 1) + '月' + d.getDate() + '日 周' + wd;
  }
  function relTime(ts) {
    if (!ts) return '';
    var d = new Date(String(ts).replace(/-/g, '/'));
    if (isNaN(d.getTime())) return '';
    var diff = Date.now() - d.getTime();
    if (diff < 0) diff = 0;
    var min = Math.floor(diff / 60000);
    if (min < 1) return '刚刚';
    if (min < 60) return min + ' 分钟前';
    var hr = Math.floor(min / 60);
    if (hr < 24) return hr + ' 小时前';
    var day = Math.floor(hr / 24);
    return day < 2 ? '昨天' : (day < 7 ? day + ' 天前' : fmtDate(d));
  }
  function greetWord() {
    var h = new Date().getHours();
    if (h >= 5 && h < 11) return '早上好';
    if (h >= 11 && h < 13) return '中午好';
    if (h >= 13 && h < 18) return '下午好';
    return '晚上好';
