        var docs = asList(snap.knowledge, 'docs');
        if (!docs.length) {
          $('overlayBody').innerHTML = '<span class="ap-empty">知识库为空 · 与小6对话后，知识会自动沉淀为结构化文档</span>';
          return;
        }
        renderKnGraph(docs);
      });
    },

    capabilities: function () {
      openOverlay('能力', '能力 · /api/capabilities', '<span class="ap-empty">正在读取...</span>');
      var caps = snap.capabilities;
      if (!caps.length) {
        $('overlayBody').innerHTML = '<span class="ap-empty">暂无能力数据</span>';
        return;
      }
      $('overlayBody').innerHTML = '<div class="ap-ov-grid" style="margin-bottom:14px">' +
        '<div class="ap-ov-stat"><b>' + caps.length + '</b><span>已登记能力</span></div>' +
        '<div class="ap-ov-stat"><b>' + caps.filter(function (c) { return c.active; }).length + '</b><span>激活中</span></div>' +
        '</div><div class="ap-ov-list">' + caps.map(function (c) {
          return '<div class="ap-ov-card"><span class="ap-ov-title">' + esc(c.icon || '') + ' ' + esc(c.label || c.id) + '</span>' +
            '<span class="ap-ov-meta"><b>' + (c.active ? '激活' : '待命') + '</b><span>' + esc(c.group || '') + '</span></span>' +
            '<span class="ap-ov-excerpt">' + esc(c.description || '') + '</span></div>';
        }).join('') + '</div>';
    },

    work: function () {
      var goals = snap.goals.slice().sort(function (a, b) { return String(b.updated || '').localeCompare(String(a.updated || '')); });
      var tasks = snap.tasks.slice().sort(function (a, b) { return Number(a.id) - Number(b.id); });
      var html = '<div class="ap-ov-grid">' +
        '<div class="ap-ov-stat"><b>' + goals.length + '</b><span>全部目标</span></div>' +
        '<div class="ap-ov-stat"><b>' + activeGoals().length + '</b><span>进行中</span></div>' +
        '<div class="ap-ov-stat"><b>' + tasks.filter(isOpenTask).length + '</b><span>待办任务</span></div></div>';
      if (goals.length) {
        html += '<div class="ap-ov-list" style="margin-top:14px">' + goals.slice(0, 10).map(function (g) {
          var s = String(g.status || '');
          var dim = s === 'active' ? '' : ' style="opacity:.5"';
          return '<div class="ap-ov-card"' + dim + '><span class="ap-ov-title">' + esc(g.title || ('目标 #' + g.id)) + '</span>' +
            '<span class="ap-ov-meta"><b>' + esc(s) + '</b><span>进度 ' + Number(g.progress || 0) + '%</span><span>' + esc(g.updated || '') + '</span></span></div>';
        }).join('') + '</div>';
