  /* ═════════ 7.6 Obsidian 知识图谱 ═══════════ */
  function renderKnGraph(docs) {
    var canvas = $('knCanvas');
    if (!canvas) return;
    var wrap = canvas.parentElement;
    var W = wrap.clientWidth || 620, H = wrap.clientHeight || 420;
    canvas.width = W; canvas.height = H;
    var ctx = canvas.getContext('2d');

    /* 领域配色 */
    var domainColors = {
      '技术': '#22d3ee', '健康': '#34d399', '生活': '#fbbf24',
      '工作': '#a78bfa', '学习': '#f472b6', '其他': '#94a6c4'
    };
    function colorFor(d) { return domainColors[d] || domainColors['其他']; }

    /* 构建节点 */
    var nodes = docs.map(function (d, i) {
      return {
        id: i, title: d.title || '未命名', domain: d.domain || '其他',
        tags: Array.isArray(d.tags) ? d.tags : [],
        x: W / 2 + (Math.random() - .5) * W * .5,
        y: H / 2 + (Math.random() - .5) * H * .5,
        vx: 0, vy: 0, r: Math.max(18, Math.min(32, 14 + (d.title || '').length * .8))
      };
    });

    /* 边：同领域 + 共同标签 */
    var edges = [];
    for (var i = 0; i < nodes.length; i++) {
      for (var j = i + 1; j < nodes.length; j++) {
        var a = nodes[i], b = nodes[j];
        if (a.domain === b.domain) edges.push({ s: i, t: j, w: 1 });
        else {
          var shared = a.tags.filter(function (t) { return b.tags.indexOf(t) >= 0; });
          if (shared.length) edges.push({ s: i, t: j, w: .4 });
        }
      }
    }

    /* 力导向模拟 */
    var dragging = -1, mx = 0, my = 0;
    canvas.addEventListener('mousedown', function (e) {
      var r = canvas.getBoundingClientRect();
      mx = e.clientX - r.left; my = e.clientY - r.top;
      for (var i = nodes.length - 1; i >= 0; i--) {
        var dx = mx - nodes[i].x, dy = my - nodes[i].y;
        if (dx * dx + dy * dy < nodes[i].r * nodes[i].r * 1.8) { dragging = i; return; }
      }
      dragging = -1;
    });
    canvas.addEventListener('mousemove', function (e) {
      if (dragging < 0) return;
      var r = canvas.getBoundingClientRect();
      nodes[dragging].x = e.clientX - r.left;
      nodes[dragging].y = e.clientY - r.top;
    });
    canvas.addEventListener('mouseup', function () { dragging = -1; });

    /* 图例 */
    var legend = $('knLegend');
    var domainsSeen = {};
    docs.forEach(function (d) { domainsSeen[d.domain || '其他'] = true; });
    legend.innerHTML = Object.keys(domainsSeen).map(function (d) {
      return '<span><i style="background:' + colorFor(d) + '"></i>' + esc(d) + '</span>';
    }).join('');

    /* 模拟循环 */
    function step() {
      /* 斥力 */
      for (var i = 0; i < nodes.length; i++) {
        nodes[i].vx *= .9; nodes[i].vy *= .9;
        for (var j = 0; j < nodes.length; j++) {
          if (i === j) continue;
          var dx = nodes[j].x - nodes[i].x, dy = nodes[j].y - nodes[i].y;
          var d2 = dx * dx + dy * dy || 1;
          var f = 800 / d2;
          nodes[i].vx -= dx * f; nodes[i].vy -= dy * f;
        }
      }
      /* 引力（边） */
      for (var e = 0; e < edges.length; e++) {
        var edge = edges[e];
        var na = nodes[edge.s], nb = nodes[edge.t];
        var dx = nb.x - na.x, dy = nb.y - na.y;
        var dist = Math.sqrt(dx * dx + dy * dy) || 1;
        var f = (dist - 120) * .008 * edge.w;
        na.vx += dx * f; na.vy += dy * f;
        nb.vx -= dx * f; nb.vy -= dy * f;
      }
      /* 向心力 */
      for (var k = 0; k < nodes.length; k++) {
        nodes[k].vx += (W / 2 - nodes[k].x) * .002;
        nodes[k].vy += (H / 2 - nodes[k].y) * .002;
        if (k !== dragging) {
          nodes[k].x += nodes[k].vx;
          nodes[k].y += nodes[k].vy;
          /* 边界 */
          nodes[k].x = Math.max(nodes[k].r, Math.min(W - nodes[k].r, nodes[k].x));
          nodes[k].y = Math.max(nodes[k].r, Math.min(H - nodes[k].r, nodes[k].y));
        }
      }
      draw();
      requestAnimationFrame(step);
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      /* 绘制边 */
      for (var e = 0; e < edges.length; e++) {
        var edge = edges[e];
        var na = nodes[edge.s], nb = nodes[edge.t];
        ctx.beginPath();
        ctx.moveTo(na.x, na.y);
        ctx.lineTo(nb.x, nb.y);
        ctx.strokeStyle = 'rgba(120,155,210,' + (.12 + edge.w * .15) + ')';
        ctx.lineWidth = .5 + edge.w;
        ctx.stroke();
      }
      /* 绘制节点 */
      for (var n = 0; n < nodes.length; n++) {
        var nd = nodes[n];
        var col = colorFor(nd.domain);
        /* 光晕 */
        ctx.beginPath();
        ctx.arc(nd.x, nd.y, nd.r + 4, 0, Math.PI * 2);
        ctx.fillStyle = col.replace(')', ',.12)').replace('rgb', 'rgba').replace('#', '');
        /* 简单处理 hex → rgba */
        var glowAlpha = .08;
        try { ctx.fillStyle = 'rgba(' + parseInt(col.slice(1, 3), 16) + ',' + parseInt(col.slice(3, 5), 16) + ',' + parseInt(col.slice(5, 7), 16) + ',' + glowAlpha + ')'; } catch (err) { ctx.fillStyle = 'rgba(148,166,196,.08)'; }
        ctx.fill();
        /* 节点圆 */
        ctx.beginPath();
        ctx.arc(nd.x, nd.y, nd.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(16,25,44,.85)';
        ctx.strokeStyle = col;
        ctx.lineWidth = 1.5;
        ctx.fill();
        ctx.stroke();
        /* 标题文字 */
        ctx.fillStyle = '#e8eef7';
        ctx.font = '11px "PingFang SC", "Microsoft YaHei", sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        var txt = nd.title.length > 10 ? nd.title.slice(0, 9) + '…' : nd.title;
        ctx.fillText(txt, nd.x, nd.y);
      }
    }
    step();
  }

