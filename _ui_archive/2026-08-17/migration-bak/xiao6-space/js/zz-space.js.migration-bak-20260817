        var kind = m.event_type === 'hotspot_event' ? '热点' : (m.event_type === 'conversation' ? '对话' : '记忆');
        var kindColor = kind === '热点' ? '#f472b6' : (kind === '对话' ? '#a78bfa' : '#22d3ee');
