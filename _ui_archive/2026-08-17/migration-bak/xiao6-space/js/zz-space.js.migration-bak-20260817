  /* ═════════ 3.3 Canvas 粒子场（白龙马移植 · 暗色青蓝主题） ═══════════ */
  var __particle = { canvas: null, ctx: null, width: 0, height: 0, particles: [], frame: 0, raf: null };
  function initParticles() {
    var c = $('particleCanvas');
    if (!c) return;
    __particle.canvas = c;
    __particle.ctx = c.getContext('2d');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    function resize() {
      /* 固定 shell 基准尺寸 1600×900（由 scaleViewport 缩放） */
      __particle.width = 1600;
      __particle.height = 900;
      c.width = 1600;
      c.height = 900;

      var count = 90;
      __particle.particles = Array.from({ length: count }, function (_, i) {
        return {
          seed: i * 17.13,
          x: Math.random() * __particle.width,
          y: Math.random() * __particle.height,
          r: 1.2 + Math.random() * 2.8,
          speed: 0.22 + Math.random() * 0.5
        };
      });
    }

    function drawField() {
      var ctx = __particle.ctx;
      var w = __particle.width, h = __particle.height;
      if (!w || !h) { __particle.raf = requestAnimationFrame(drawField); return; }
      ctx.clearRect(0, 0, w, h);

      var cx = w * 0.5, cy = h * 0.48;
      var t = __particle.frame * 0.008;
      /* 暗色主题：青蓝紫色调 */
      var colors = ['#22d3ee', '#a78bfa', '#7aa2f7', '#34d399'];

      /* 轨道环 */
      ctx.lineWidth = 1;
      for (var layer = 0; layer < 4; layer++) {
        ctx.beginPath();
        var amp = 52 + layer * 28;
        var stretch = w * (0.24 + layer * 0.05);
        var offset = t * (0.65 + layer * 0.07);
        for (var i = 0; i <= 180; i++) {
          var th = (i / 180) * Math.PI * 2;
          var px = cx + Math.cos(th + offset) * stretch + Math.sin(th * 2.4 + offset) * 20;
          var py = cy + Math.sin(th * 1.2 + offset) * amp + Math.cos(th * 2 + offset) * 14;
          if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        }
        ctx.strokeStyle = colors[layer] + '38';
        ctx.stroke();
      }

      /* 粒子 */
      for (var pi = 0; pi < __particle.particles.length; pi++) {
        var p = __particle.particles[pi];
        var wave = Math.sin(t + p.seed);
        p.x += Math.cos(t + p.seed) * p.speed;
        p.y += Math.sin(t * 0.8 + p.seed) * p.speed * 0.65;
        if (p.x < -30) p.x = w + 30;
        if (p.x > w + 30) p.x = -30;
        if (p.y < -30) p.y = h + 30;
        if (p.y > h + 30) p.y = -30;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r + wave * 0.35, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(34, 211, 238, .35)';
        ctx.fill();
      }

      /* 连线 */
      for (var i2 = 0; i2 < __particle.particles.length; i2++) {
        for (var j2 = i2 + 1; j2 < __particle.particles.length; j2++) {
          var a = __particle.particles[i2], b = __particle.particles[j2];
          var dx = a.x - b.x, dy = a.y - b.y;
          var dist = Math.hypot(dx, dy);
          if (dist < 120) {
            ctx.beginPath();
            ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = 'rgba(34, 211, 238, ' + (0.12 * (1 - dist / 120)) + ')';
            ctx.stroke();
          }
        }
      }

      __particle.frame++;
      __particle.raf = requestAnimationFrame(drawField);
    }

    resize();
    drawField();
  }

  /* ═══════════ 3.5 白龙马语音球（左上角，默认隐藏） ═══════════ */
  var __petOrb = null;
  function showPetOrb() {
    var o = $('petOrb'); if (o) o.classList.add('visible');
  }
  function hidePetOrb() {
    var o = $('petOrb'); if (o) o.classList.remove('visible');
  }
  function initPetOrb() {
    var el = $('petOrbLottie');
    if (!el || !window.lottie) return;
    try {
      __petOrb = window.lottie.loadAnimation({
        container: el,
        renderer: 'svg',
