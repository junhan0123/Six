  /* ═══════════ 1.5 视口等比缩放（锁定 1600×900 设计基准，元素更大） ═══════════ */
  var BASE_W = 1600, BASE_H = 900;
  function scaleViewport() {
    var shell = $('shell');
    if (!shell) return;
    var s = Math.min(window.innerWidth / BASE_W, window.innerHeight / BASE_H);
    shell.style.transform = 'scale(' + s + ')';
  }

  /* ═══════════ 2. 星尘 ═══════════ */
  function initStars() {
    var c = $('starCanvas');
    if (!c) return;
    var ctx = c.getContext('2d');
    var W = BASE_W, H = BASE_H;
    c.width = W; c.height = H;
    var stars = [];
    var n = Math.min(130, Math.floor(W * H / 16000));
    for (var i = 0; i < n; i++) {
      stars.push({
        x: Math.random() * W, y: Math.random() * H,
        r: Math.random() * 1.2 + 0.25,
        a: Math.random() * 0.45 + 0.12,
        v: Math.random() * 0.05 + 0.01,
        ph: Math.random() * Math.PI * 2,
        tint: Math.random()
      });
    }
    function draw(t) {
      ctx.clearRect(0, 0, W, H);
      for (var i = 0; i < stars.length; i++) {
        var s = stars[i];
        s.y -= s.v;
        if (s.y < -2) { s.y = H + 2; s.x = Math.random() * W; }
        var tw = 0.5 + 0.5 * Math.sin(t / 1000 + s.ph);
        var col = s.tint > 0.82 ? '150,220,235' : (s.tint > 0.66 ? '185,175,245' : '175,195,225');
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(' + col + ',' + (s.a * tw).toFixed(3) + ')';
        ctx.fill();
      }
      requestAnimationFrame(draw);
    }
    requestAnimationFrame(draw);
  }

  /* ═══════════ 3. 全息球 ═══════════ */
  function initOrb() {
    var el = $('orbLottie');
    if (!el || !window.lottie) return;
    try {
