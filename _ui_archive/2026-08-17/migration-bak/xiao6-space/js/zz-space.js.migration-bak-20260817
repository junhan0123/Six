  /* ═══════════ 5. 渲染 ═══════════ */
  function isOpenTask(t) { var s = String(t.status || '').toLowerCase(); return s !== 'done' && s !== 'completed' && s !== 'closed'; }
  function isDoneTask(t) { var s = String(t.status || '').toLowerCase(); return s === 'done' || s === 'completed' || s === 'closed'; }
  function activeGoals() {
