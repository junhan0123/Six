  // 点击语音球 → 弹出热点/互动
  // §24 兼容/过渡：新 Advanced Workspace 不含 #petOrb，做空值守卫避免 FATAL
  var petOrbEl = $('petOrb');
  if (petOrbEl) {
    petOrbEl.addEventListener('click', function () {
      if (window.__showHotTopics) window.__showHotTopics();
    });
  }

  /* ═══════════ 3.6 时事热点（后台 + 按需弹出） ═══════════ */
  var __hotCache = null;      // 缓存热点数据
  var __hotFetchAt = 0;       // 上次拉取时间戳
  var __hotTTL = 5 * 60 * 1000; // 缓存 5 分钟
  var __hotPollTimer = null;   // 后台轮询定时器

  /** 拉取热点（带缓存） */
  function fetchHotTopics(force) {
    var now = Date.now();
    if (!force && __hotCache && (now - __hotFetchAt) < __hotTTL) {
      return Promise.resolve(__hotCache);
    }
    __hotFetchAt = now;
    return getJSON('/api/hotspots').then(function (d) {
      __hotCache = d || {};
      // 更新语音球状态文字
      var stale = !!d.stale;
      var statusEl = $('petOrbStatus');
      if (statusEl) statusEl.textContent = stale ? '离线' : '在线';
      return d;
    }).catch(function () {
      return { error: true, platforms: {} };
    });
  }

  /** 渲染热点面板 */
  function renderHotPanel(data) {
    if (data.error || !data.platforms) {
      return '<div class="ap-empty" style="padding:40px 0">暂无法获取热点数据<br/><span style="font-size:12px;color:var(--ap-faint)">请检查网络或稍后再试</span></div>';
    }
    var plat = data.platforms || {};
    var platOrder = ['wechat', 'weibo', 'douyin', 'xiaohongshu'];
    var html = '<div style="margin-bottom:12px;font-size:12px;color:var(--ap-faint)">' +
      '更新时间：' + esc(data.fetchedAt || '—') +
      (data.stale ? ' <span style="color:var(--ap-warn)">(数据可能过期)</span>' : '') +
      '</div>';
    html += '<div class="ht-grid">';
    platOrder.forEach(function (key) {
      var p = plat[key];
      if (!p || !p.items || !p.items.length) return;
      html += '<div class="ht-card"><div class="ht-card-head">' +
        '<span class="ht-card-label">' + esc(p.label) + '</span></div><div class="ht-card-body">';
      p.items.forEach(function (it, i) {
        var heatBar = it.heat ? '<span class="ht-heat" style="width:' + Math.min(100, Number(it.heat) || 30) + '%"></span>' : '';
        html += '<a class="ht-item' + (i < 3 ? ' ht-top' : '') + '" href="' + esc(it.url || '#') + '" target="_blank" rel="noopener">' +
          '<span class="ht-rank">' + (it.rank || i + 1) + '</span>' +
          '<span class="ht-text">' + esc(it.text) + '</span>' +
          heatBar + '</a>';
      });
      html += '</div></div>';
    });
    html += '</div>';
    return html;
  }

  /** 弹出热点面板 */
  window.__showHotTopics = function () {
    showPetOrb();   // 打开热点时临时显示语音球（关闭后 hidePetOrb）
