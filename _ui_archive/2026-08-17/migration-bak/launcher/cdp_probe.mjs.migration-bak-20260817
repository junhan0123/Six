import http from 'http';

const CDP_PORT = 9222;

function getJSON(path) {
  return new Promise((resolve, reject) => {
    const req = http.get({ host: '127.0.0.1', port: CDP_PORT, path }, (res) => {
      let data = '';
      res.on('data', (c) => { data += c; });
      res.on('end', () => {
        try { resolve(JSON.parse(data)); } catch (e) { resolve(data); }
      });
    });
    req.on('error', reject);
    req.setTimeout(5000, () => { req.destroy(); reject(new Error('timeout')); });
  });
}

try {
  const list = await getJSON('/json/list');
  console.log('CDP pages:', list.length);
  for (const p of list) {
    console.log('---');
    console.log('id:', p.id);
    console.log('title:', p.title);
    console.log('url:', p.url);
    console.log('type:', p.type);
    console.log('webSocketDebuggerUrl:', p.webSocketDebuggerUrl || 'none');
    if (p.url.includes('dyna-orb')) {
      // attach to the page and inspect runtime/console/visible pixels
      const WebSocket = (await import('ws')).default || (await import('ws')).WebSocket;
      const ws = new WebSocket(p.webSocketDebuggerUrl);
      let msgId = 0;
      const send = (method, params = {}) => new Promise((resolve, reject) => {
        const id = ++msgId;
        const handler = (raw) => {
          const m = JSON.parse(raw);
          if (m.id === id) {
            ws.off('message', handler);
            if (m.error) reject(m.error); else resolve(m.result);
          }
        };
        ws.on('message', handler);
        ws.send(JSON.stringify({ id, method, params }));
      });
      await new Promise(r => ws.on('open', r));
      // Enable console + runtime
      await send('Runtime.enable');
      await send('Log.enable');
      await send('Console.enable');
      // Evaluate: check ZZDynaOrb, canvas pixel sample, document bg
      const evalOrb = await send('Runtime.evaluate', {
        expression: `
          (function(){
            var c = document.getElementById('orb-canvas');
            var ctx = c ? c.getContext('2d') : null;
            var px = null;
            if (c && ctx) {
              var d = ctx.getImageData(c.width/2, c.height/2, 1, 1).data;
              px = [d[0], d[1], d[2], d[3]];
            }
            return {
              ZZDynaOrb: typeof window.ZZDynaOrb,
              orbMethods: window.ZZDynaOrb ? Object.keys(window.ZZDynaOrb) : null,
              canvasSize: c ? {w: c.width, h: c.height} : null,
              centerPixel: px,
              bodyBg: getComputedStyle(document.body).backgroundColor,
              bodyChildren: document.body.children.length,
              errors: window.__orbErrors || []
            };
          })()
        `,
        returnByValue: true
      });
      console.log('orb runtime:', JSON.stringify(evalOrb.result.value, null, 2));
      // Take a screenshot to see if anything is rendered
      try {
        const cap = await send('Page.captureScreenshot', { format: 'png' });
        console.log('screenshot_base64_length:', cap.data.length);
        // save screenshot for inspection
        const fs = await import('fs');
        fs.writeFileSync('G:/ZhuangZhou/zhuangzhou-ui/launcher/logs/orb_screenshot.png', Buffer.from(cap.data, 'base64'));
        console.log('saved orb_screenshot.png');
      } catch (e) {
        console.log('screenshot_error:', e.message || e);
      }
      ws.close();
    }
  }
} catch (e) {
  console.error('PROBE_ERROR:', e.message || e);
}
