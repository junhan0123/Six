# zz_launch.ps1 - 小6一键启动器 (部署层，不修改产品代码)
# 功能：解析 venv python -> 健康检查 /api/health -> 幂等拉起后端(server.py, 端口 8010)
#       -> 清除冲突环境变量起 Electron 桌面分身 -> (默认)打开 Web 端
# 用法：
#   powershell -ExecutionPolicy Bypass -File zz_launch.ps1          # 完整启动(后端+桌宠+Web)
#   powershell -ExecutionPolicy Bypass -File zz_launch.ps1 -NoWeb   # 静默启动(后端+桌宠, 不开浏览器, 用于开机自启)
# 红线：不修改注册表/系统设置/环境变量；不改动 server.py 与 Electron 产品代码；
#       可选增强依赖缺失时由 server.py 内部降级，不在此自动安装。

[CmdletBinding()]
param(
    [switch]$NoWeb      # 静默模式：不打开浏览器(用于开机自启)
)

$ErrorActionPreference = 'Continue'
$LauncherDir = Split-Path -Parent $MyInvocation.MyCommand.Definition
$ConfigPath  = Join-Path $LauncherDir 'launcher_config.json'

function Log($msg) {
    $line = "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') $msg"
    Write-Output $line
    try { Add-Content -Path (Join-Path $LauncherDir 'logs\startup.log') -Value $line -Encoding UTF8 } catch {}
}

try { New-Item -ItemType Directory -Force -Path (Join-Path $LauncherDir 'logs') | Out-Null } catch {}

try {
    $cfg = Get-Content $ConfigPath -Raw -Encoding UTF8 | ConvertFrom-Json
} catch {
    Write-Error "无法读取配置: $ConfigPath"; exit 1
}

$ProjRoot  = Resolve-Path (Join-Path $LauncherDir $cfg.project.root)
$LogsDir   = Join-Path $LauncherDir $cfg.logs.dir
$BackendPIDFile  = Join-Path $LauncherDir $cfg.pid_files.backend
$ElectronPIDFile = Join-Path $LauncherDir $cfg.pid_files.electron
$BackendLog  = Join-Path $LauncherDir $cfg.backend.log_file
$ErrDir      = $LogsDir

$Port = $cfg.backend.port
if ($env:ZHUANGZHOU_PORT) { $Port = $env:ZHUANGZHOU_PORT }
$Host = $cfg.backend.host
$HealthURL = "http://$Host`:$Port$($cfg.backend.health_endpoint)"
$WebURL = "http://localhost:$Port/zz-space/index.html"

Log "[START] 小6一键启动器 (NoWeb=$NoWeb)"

# ---- 解析 Python 解释器 ----
$py = $null
$VenvPy = Join-Path $env:USERPROFILE '.workbuddy\binaries\python\envs\default\Scripts\python.exe'
if (Test-Path $VenvPy) {
    $py = $VenvPy
} elseif ($cfg.backend.python_bin) {
    $py = $cfg.backend.python_bin
} else {
    $p3 = (Get-Command python3 -ErrorAction SilentlyContinue).Source
    if ($p3) { $py = $p3 } else { $py = (Get-Command python -ErrorAction SilentlyContinue).Source }
}
if (-not $py -or -not (Test-Path $py)) {
    Log "ERROR: 未找到 Python 解释器，请检查 venv 或 launcher_config.json 的 backend.python_bin"
    exit 1
}
Log "Python 解释器: $py"

# ---- 健康检查函数 ----
function Test-Backend {
    try {
        $r = Invoke-WebRequest -Uri $HealthURL -TimeoutSec 3 -UseBasicParsing -ErrorAction Stop
        return ($r.StatusCode -eq 200)
    } catch { return $false }
}

# ---- 1. 幂等启动后端 ----
$backendWasRunning = Test-Backend
if ($backendWasRunning) {
    Log "后端已运行 (HTTP 200 @ $HealthURL)，跳过启动"
} else {
    try {
        $p = Start-Process -FilePath $py -ArgumentList $cfg.backend.script `
            -WorkingDirectory $ProjRoot `
            -RedirectStandardOutput $BackendLog -RedirectStandardError (Join-Path $ErrDir 'backend.err') `
            -PassThru
        $p.Id | Set-Content -Path $BackendPIDFile -Encoding ascii
        Log "后端已启动 PID=$($p.Id)"
    } catch {
        Log "ERROR: 启动后端失败: $_"
        exit 1
    }
    $deadline = (Get-Date).AddSeconds($cfg.backend.health_timeout_sec)
    $ok = $false
    while ((Get-Date) -lt $deadline) {
        if (Test-Backend) { $ok = $true; break }
        Start-Sleep -Seconds 1
    }
    if (-not $ok) {
        Log "ERROR: 后端健康检查超时 ($HealthURL)，详见 $BackendLog"
        exit 1
    }
    Log "后端健康检查通过 ($HealthURL)"
}

# ---- 2. 启动 Electron 桌面分身 (PNG 序列帧桌宠) ----
# 清除由外部工具注入、会导致 Electron 进入 Node 模式或拒绝启动的环境变量
Remove-Item Env:\ELECTRON_RUN_AS_NODE -ErrorAction SilentlyContinue
Remove-Item Env:\NODE_OPTIONS -ErrorAction SilentlyContinue

$electronRunning = $false
try {
    $proc = Get-Process -Name 'electron' -ErrorAction SilentlyContinue
    if ($proc) { $electronRunning = $true }
} catch {}

if ($electronRunning) {
    Log "Electron 桌面分身已在运行，跳过启动"
} else {
    try {
        $ebin = (Resolve-Path (Join-Path $LauncherDir $cfg.electron.bin)).Path
        $p = Start-Process -FilePath $ebin -ArgumentList $cfg.electron.args `
            -WorkingDirectory $ProjRoot `
            -RedirectStandardOutput (Join-Path $LauncherDir $cfg.electron.log_file) `
            -RedirectStandardError (Join-Path $ErrDir 'electron.err') `
            -PassThru
        $p.Id | Set-Content -Path $ElectronPIDFile -Encoding ascii
        Log "Electron 桌面分身已启动 PID=$($p.Id) -> $($cfg.electron.url)"
    } catch {
        Log "WARN: 启动 Electron 失败(不影响后端/Web): $_"
    }
}

# ---- 3. 打开 Web 端 ----
if ($NoWeb) {
    Log "[DONE] 静默启动完成（后端+桌面分身，未打开浏览器）"
} else {
    try {
        Start-Process -FilePath $WebURL
        Log "[DONE] 小6已启动：后端@$Port、桌面分身、Web 端($WebURL)"
    } catch {
        Log "WARN: 打开 Web 端失败(后端已可用，可手动访问 $WebURL): $_"
    }
}
