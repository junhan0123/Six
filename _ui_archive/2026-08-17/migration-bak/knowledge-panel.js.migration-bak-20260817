// knowledge-panel.js —— 全屏「知识库」面板（Phase 35 · P2-1）
// 后端 /api/knowledge 已就绪：{ docs:[{title,name,type,updated_at,...}], stats:{} }
// 本文件仅为只读展示入口，不引入任何业务能力 / 依赖，不修改 Agent Runtime / Memory 核心。
// 浮层模式与 doc.js 保持一致（OverlayManager 统一 ESC / 焦点 / 栈）。

const KNOW = { panel: null, open: false, docs: [], keyword: '' };

function knowEscapeHtml(str) {
  return String(str == null ? '' : str).replace(/[&<>"']/g, (c) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  }[c]));
}

function knowFmtTime(ts) {
  if (!ts) return '—';
  const n = Number(ts);
  const d = new Date(String(ts).length <= 10 ? n * 1000 : n);
  if (isNaN(d.getTime())) return String(ts);
  const p = (x) => String(x).padStart(2, '0');
  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
}

function knowBuild() {
  if (KNOW.panel) return;
  const html = `
  <div class="know-panel" id="know-panel" role="dialog" aria-label="知识库">
    <div class="know-backdrop" data-close="1"></div>
    <div class="know-stage glass">
      <div class="know-bar">
        <div class="know-title"><span class="know-dot"></span>知识库</div>
        <div class="know-meta" id="know-meta"></div>
        <button class="know-close" id="know-close" title="关闭（Esc）" aria-label="关闭"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-close"/></svg></button>
      </div>
      <div class="know-search-wrap">
        <input class="know-search" id="know-search" type="search" placeholder="筛选知识主题…" />
      </div>
      <div class="know-body" id="know-body"></div>
    </div>
  </div>`;
  document.body.insertAdjacentHTML('beforeend', html);
  KNOW.panel = document.getElementById('know-panel');
  document.getElementById('know-close').addEventListener('click', knowClose);
  KNOW.panel.querySelector('[data-close]').addEventListener('click', knowClose);
  const search = document.getElementById('know-search');
  search.addEventListener('input', () => { KNOW.keyword = search.value.trim().toLowerCase(); knowRenderList(); });
}

async function knowLoad() {
  const body = document.getElementById('know-body');
  body.innerHTML = `<div class="know-loading">正在读取知识库…</div>`;
  try {
    const r = await fetch('/api/knowledge', { method: 'GET', cache: 'no-store' });
    const d = await r.json();
    if (d && d.error) {
      body.innerHTML = `<div class="know-empty">知识库读取失败：${knowEscapeHtml(String(d.error))}</div>`;
      return;
    }
    KNOW.docs = Array.isArray(d && d.docs) ? d.docs : [];
    const stats = (d && d.stats) || {};
    const meta = document.getElementById('know-meta');
    if (meta) {
      const parts = [];
      if (stats.doc_count != null) parts.push(stats.doc_count + ' 文档');
      if (stats.note_count != null) parts.push(stats.note_count + ' 笔记');
      if (!parts.length) parts.push(KNOW.docs.length + ' 主题');
      meta.textContent = parts.join(' · ');
    }
    knowRenderList();
  } catch (e) {
    body.innerHTML = `<div class="know-empty">知识库加载失败：${knowEscapeHtml(String((e && e.message) || e))}</div>`;
  }
}

function knowRenderList() {
  const body = document.getElementById('know-body');
  if (!body) return;
  const kw = KNOW.keyword;
  const docs = KNOW.docs.filter((doc) => {
    if (!kw) return true;
    const hay = ((doc.title || doc.name || '') + ' ' + (doc.type || '') + ' ' + (doc.summary || '')).toLowerCase();
    return hay.indexOf(kw) !== -1;
  });
  if (!docs.length) {
    body.innerHTML = `<div class="know-empty">${kw ? '没有匹配「' + knowEscapeHtml(kw) + '」的知识主题' : '知识库为空'}</div>`;
    return;
  }
  body.innerHTML = `
    <div class="know-list-head">${docs.length} 个知识主题</div>
    <div class="know-list">${docs.map((doc, i) => {
      const title = doc.title || doc.name || '(未命名)';
      const type = doc.type ? String(doc.type) : '';
      const updated = doc.updated_at || doc.mtime || '';
      return `<div class="know-row" data-idx="${i}">
        <div class="know-row-main">
          <div class="know-row-name">${knowEscapeHtml(title)}</div>
          <div class="know-row-meta">
            ${type ? `<span class="know-type">${knowEscapeHtml(type)}</span>` : ''}
            <span class="know-time">${knowFmtTime(updated)}</span>
          </div>
        </div>
        <div class="know-row-go">›</div>
      </div>`;
    }).join('')}</div>`;
}

function knowOpen() {
  knowBuild();
  knowLoad();
  requestAnimationFrame(() => document.body.classList.add('knowledge-mode'));
  KNOW.open = true;
  window.dispatchEvent(new CustomEvent('zhuangzhou:knowledge-mode', { detail: { active: true } }));
  // 登记到 OverlayManager（统一 ESC / 焦点 / 栈），与 doc.js 一致
  if (window.OverlayManager && typeof window.OverlayManager.track === 'function') {
    window.OverlayManager.track('knowledge', {
      el: KNOW.panel,
      onClose: knowCloseImpl,
      type: window.OverlayManager.OverlayType ? window.OverlayManager.OverlayType.PANEL : 'panel',
      trap: false,
    });
  }
}

function knowCloseImpl() {
  document.body.classList.remove('knowledge-mode');
  KNOW.open = false;
  window.dispatchEvent(new CustomEvent('zhuangzhou:knowledge-mode', { detail: { active: false } }));
}

function knowClose() {
  if (window.OverlayManager && window.OverlayManager.isOpen && window.OverlayManager.isOpen('knowledge')) {
    window.OverlayManager.close('knowledge');
  } else {
    knowCloseImpl();
  }
}

window.ZZKnowledge = { open: knowOpen, close: knowClose };
