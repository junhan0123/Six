// screen.js —— 屏幕捕获（P0b 感知层）
// 浏览器原生 getDisplayMedia 截取屏幕帧 → canvas → PNG dataURL →
// 经 window.ZZChat.attachImage 桥推入待发送图片队列，随消息以多模态发给模型。
// 走的是与「上传图片」完全相同的视觉通道（/api/chat 已支持 images 多模态），
// 因此庄周能直接「看到」屏幕内容（界面/图表/文字皆可），无需本地 OCR 依赖。
//
// 隐私边界：截图仅暂存在浏览器内存并随本次对话发送，不落盘、不常驻、不自动触发；
// 必须由用户主动点击按钮才捕获（浏览器也强制要求用户手势 + 授权选择共享源）。

const ZZScreen = {
  capturing: false,

  isSupported() {
    return !!(navigator.mediaDevices && navigator.mediaDevices.getDisplayMedia);
  },

  async capture() {
    if (this.capturing) return;
    if (!this.isSupported()) {
      if (window.toast) window.toast('当前环境不支持屏幕捕获（需 https/localhost 且浏览器支持 getDisplayMedia）');
      return;
    }
    this.capturing = true;
    let stream = null;
    try {
      // 仅取视频，不取系统音频；frameRate 限低以减小数据量
      stream = await navigator.mediaDevices.getDisplayMedia({
        video: { frameRate: 2 },
        audio: false,
      });

      const track = stream.getVideoTracks()[0];
      if (!track) throw new Error('未获取到屏幕视频轨道');

      // 用隐藏 video 承接帧
      const video = document.createElement('video');
      video.srcObject = stream;
      video.muted = true;
      await new Promise((res, rej) => {
        video.onloadedmetadata = () => { video.play().then(res).catch(rej); };
        video.onerror = rej;
      });
      // 等一帧确保有画面
      await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));

      const w = video.videoWidth || 1280;
      const h = video.videoHeight || 720;
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(video, 0, 0, w, h);

      // 停止轨道（否则浏览器共享条会一直挂着）
      stream.getTracks().forEach((t) => t.stop());

      const dataUrl = canvas.toDataURL('image/png');

      // 推入聊天图片队列（复用图片预览与多模态发送）
      if (window.ZZChat && window.ZZChat.attachImage) {
        window.ZZChat.attachImage(dataUrl);
      } else if (window.toast) {
        window.toast('聊天桥未就绪，请刷新页面后重试');
      }
    } catch (e) {
      // 用户取消选择共享源会抛 NotAllowedError，属正常交互，不报错
      if (e && e.name === 'NotAllowedError') {
        if (window.toast) window.toast('已取消屏幕共享');
      } else {
        console.warn('[Screen] 捕获失败', e);
        if (window.toast) window.toast('屏幕捕获失败：' + (e && e.message ? e.message : e));
      }
    } finally {
      if (stream) stream.getTracks().forEach((t) => { try { t.stop(); } catch (_) {} });
      this.capturing = false;
    }
  },
};

// 绑定工具栏按钮（DOM 在脚本加载时已存在，脚本位于 body 末尾）
(function bindScreenButton() {
  const btn = document.getElementById('btnScreen');
  if (!btn) return;
  btn.addEventListener('click', () => ZZScreen.capture());
})();

window.ZZScreen = ZZScreen;
