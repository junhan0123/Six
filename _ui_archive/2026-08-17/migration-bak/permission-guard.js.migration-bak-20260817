/*
 * permission-guard.js — 庄周 Phase 7 Order 2 · 前端权限闸门（规划/校验/预览）
 * 职责：把一次电脑动作经 AppState 合约发布 COMPUTER_ACTION_* 事件；权威裁决由后端
 *       Policy Engine 完成（经由注入的 decider）。前端 Guard 不直连 OS 执行器。
 * 纪律：本文件只 emit 领域事件（经 AppState.applyEvent，单一写入入口）；可执行器
 *       仅作模拟（注入），真实执行在后端。满足“Agent 不得直调 executor”结构约束。
 */
(function (global) {
  'use strict';
  var ZZ = global.ZZ_EVENTS;
  var ZZCap = global.ZZCapabilities;
  var AppState = global.AppState;

  // 默认 decider：前端本地预览裁决，镜像 Policy Engine 风险 → 层级（LOW=auto, MEDIUM=confirm）。
  // 生产环境注入后端裁决（经 SSE/审批卡）。
  function defaultDecider(action) {
    var risk = ZZCap.riskOf(action.capability);
    if (risk === 'HIGH' || risk === 'CRITICAL') return { decision: 'deny', reason: '风险等级 ' + risk + ' 在 Order 2 未实现' };
    if (risk === 'LOW') return { decision: 'auto', reason: '只读 / 低危能力，自动执行' };
    return { decision: 'confirm', reason: '中危能力，需人工确认' }; // MEDIUM
  }

  // 默认 mock 执行器（安全）：仅返回模拟回执，不触真实 OS。
  function mockExecutor(action) {
    return { ok: true, kind: 'mock', capability: action.capability, target: action.target,
             note: '前端模拟执行，未触真实 OS' };
  }

  function PermissionGuard(opts) {
    opts = opts || {};
    this.decider = opts.decider || defaultDecider;
    this.executor = opts.executor || mockExecutor;
    this._events = [];
    var self = this;
    if (AppState && AppState.subscribe) {
      this._unsub = AppState.subscribe('*', function (e) {
        if (e && e.name && e.name.indexOf('COMPUTER_ACTION_') === 0) self._events.push(e);
      });
    }
  }

  PermissionGuard.prototype.plan = function (capability, target, parameters, opts) {
    opts = opts || {};
    if (!ZZCap.isKnown(capability)) throw new Error('未知能力，拒绝规划: ' + capability);
    var Action = global.ZZComputerAction;
    var action = new Action(capability, target, parameters, opts);
    action.status = 'planned';
    AppState.applyEvent(ZZ.EVENTS.COMPUTER_ACTION_PLANNED, _planned(action));
    return action;
  };

  PermissionGuard.prototype.decide = function (action, ctx) {
    ctx = ctx || {};
    if (!ZZCap.isKnown(action.capability)) {
      action.permissionDecision = 'deny';
      action.decisionReason = '能力未注册';
      AppState.applyEvent(ZZ.EVENTS.COMPUTER_ACTION_DENIED, _denied(action, '能力未注册'));
      return { decision: 'deny', reason: '能力未注册' };
    }
    var risk = ZZCap.riskOf(action.capability);
    if (risk === 'HIGH' || risk === 'CRITICAL') {
      action.permissionDecision = 'deny';
      action.decisionReason = '风险等级 ' + risk + ' 在 Order 2 未实现';
      action.status = 'denied';
      AppState.applyEvent(ZZ.EVENTS.COMPUTER_ACTION_DENIED, _denied(action, action.decisionReason));
      return { decision: 'deny', reason: action.decisionReason };
    }
    var dec = this.decider(action, ctx) || { decision: 'confirm' };
    action.permissionDecision = dec.decision;
    action.decisionReason = dec.reason;
    if (dec.decision === 'block' || dec.decision === 'deny') {
      action.status = 'denied';
      AppState.applyEvent(ZZ.EVENTS.COMPUTER_ACTION_DENIED, _denied(action, dec.reason));
    }
    return dec;
  };

  PermissionGuard.prototype.run = function (action, ctx) {
    ctx = ctx || {};
    var dec = this.decide(action, ctx);
    var d = dec.decision;
    if (d === 'block' || d === 'deny') return action;
    if (d === 'confirm') {
      if (!ctx.autoApprove) {
        // 前端无后端裁决时，默认保持待确认（交由后端审批卡）；
        // 仅 hermetic 测试可传 ctx.simulateApprove=true 模拟用户批准。
        if (!ctx.simulateApprove) {
          action.permissionDecision = 'confirm';
          return action; // 等待后端审批（不 emit CALLED）
        }
      }
    }
    action.status = 'called';
    AppState.applyEvent(ZZ.EVENTS.COMPUTER_ACTION_CALLED, _called(action));
    try {
      var result = this.executor(action);
      action.result = result;
      action.status = 'done';
      AppState.applyEvent(ZZ.EVENTS.COMPUTER_ACTION_DONE, _done(action, result));
      // —— Order 3：Verification（仅当注入 verifier 时复核；真实复核在后端）——
      if (ctx.verifier) {
        var v = ctx.verifier(action, action.result) || { verified: false, detail: '' };
        action.verified = v.verified;
        action.verificationDetail = v.detail;
        if (v.verified) {
          AppState.applyEvent(ZZ.EVENTS.COMPUTER_ACTION_VERIFIED, _verified(action, v.detail));
        } else {
          AppState.applyEvent(ZZ.EVENTS.COMPUTER_ACTION_UNVERIFIED, _unverified(action, v.detail));
        }
      }
    } catch (e) {
      action.result = { error: String((e && e.message) || e) };
      action.status = 'failed';
      AppState.applyEvent(ZZ.EVENTS.COMPUTER_ACTION_FAILED, _failed(action, String((e && e.message) || e)));
    }
    return action;
  };

  function _planned(a) { return { actionId: a.actionId, capability: a.capability, target: a.target, risk: a.risk, expectedEffect: a.expectedEffect, parameters: a.parameters, goalId: a.goalId }; }
  function _called(a) { return { actionId: a.actionId, capability: a.capability, permissionDecision: a.permissionDecision, goalId: a.goalId }; }
  function _done(a, result) { return { actionId: a.actionId, capability: a.capability, result: result, goalId: a.goalId }; }
  function _failed(a, error) { return { actionId: a.actionId, capability: a.capability, error: error, goalId: a.goalId }; }
  function _denied(a, reason) { return { actionId: a.actionId, capability: a.capability, risk: a.risk, reason: reason, goalId: a.goalId }; }
  function _verified(a, detail) { return { actionId: a.actionId, capability: a.capability, verified: true, detail: detail, goalId: a.goalId }; }
  function _unverified(a, detail) { return { actionId: a.actionId, capability: a.capability, verified: false, detail: detail, goalId: a.goalId }; }

  global.ZZPermissionGuard = PermissionGuard;
  if (typeof module !== 'undefined' && module.exports) module.exports = PermissionGuard;
})(typeof window !== 'undefined' ? window : globalThis);
