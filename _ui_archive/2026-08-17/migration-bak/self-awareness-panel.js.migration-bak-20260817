// self-awareness-panel.js —— 自我认知透明层（Phase 36.2 · Task 1）
// 产品化既有 self_awareness 能力：让用户理解「庄周当前的认知状态 / 自检发现 / 能力边界」。
// 纪律：只读展示 + 可选「立即自检」(POST /api/self_awareness/run) + 叠加式纠错（/api/notes）；
//       绝不改写 Memory V2 核心 / Agent Runtime / Planner / Executor / EventBus；不拟人化。
// 复用 OverlayManager 统一浮层栈；body.self-awareness-mode 表现类；window.ZZSelfAwareness 暴露入口。

const SAW = {
  panel: null,
  open: false,
  status: null,
  cache: [],        // SSE 缓存的 self_awareness 自检记录（{ts, content, importance}）
  subscribed: false,
  feedback: [],      // 已提交的纠错（用于徽章判定，可选）
};

function sawEscapeHtml(str) {
  return String(str == null ? '' : str).replace(/[&<>"']/g, (c) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  }[c]));
}

function sawFmtTime(ts) {
  if (!ts) return '—';
  // 兼容 "2026-08-12 09:03:11" 与 时间戳
  const d = new Date(String(ts).replace(' ', 'T'));
  if (!isNaN(d.getTime())) {
    const p = (x) => String(x).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
  }
  return String(ts);
}

function sawRelTime(ts) {
  if (!ts) return '尚未自检';
  const d = new Date(String(ts).replace(' ', 'T'));
  if (isNaN(d.getTime())) return sawFmtTime(ts);
  const diff = Date.now() - d.getTime();
  if (diff < 60000) return '刚刚';
  if (diff < 3600000) return Math.floor(diff / 60000) + ' 分钟前';
  if (diff < 86400000) return Math.floor(diff / 3600000) + ' 小时前';
  return Math.floor(diff / 86400000) + ' 天前';
}

function sawBadge(healthy) {
  return healthy
    ? { cls: 'ok', label: '状态良好' }
    : { cls: 'warn', label: '有待确认事项' };
}

function sawBuild() {
  if (SAW.panel) return;
  const html = `
  <div class="saw-panel" id="saw-panel" role="dialog" aria-label="自我认知">
    <div class="saw-backdrop" data-close="1"></div>
    <div class="saw-stage glass">
      <div class="saw-bar">
        <div class="saw-title"><span class="saw-dot"></span>自我认知 · 庄周状态</div>
        <div class="saw-meta" id="saw-meta"></div>
        <button class="saw-refresh" id="saw-refresh" title="重新加载">↻</button>
        <button class="saw-close" id="saw-close" title="关闭（Esc）" aria-label="关闭"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-close"/></svg></button>
      </div>
      <div class="saw-body" id="saw-body"></div>
    </div>
  </div>`;
  document.body.insertAdjacentHTML('beforeend', html);
  SAW.panel = document.getElementById('saw-panel');
  document.getElementById('saw-close').addEventListener('click', sawClose);
  SAW.panel.querySelector('[data-close]').addEventListener('click', sawClose);
  document.getElementById('saw-refresh').addEventListener('click', () => sawLoad());
}

async function sawLoad() {
  const body = document.getElementById('saw-body');
  if (body) body.innerHTML = `<div class="saw-loading">正在读取自我认知状态…</div>`;
  try {
    const st = await fetch('/api/self_awareness/status', { cache: 'no-store' }).then((r) => r.json()).catch(() => null);
    SAW.status = st || {};
    sawRender();
  } catch (e) {
    if (body) body.innerHTML = `<div class="saw-empty">自我认知状态加载失败：${sawEscapeHtml(String(e && e.message || e))}</div>`;
  }
}

function sawRender() {
  const body = document.getElementById('saw-body');
  if (!body) return;
  const st = SAW.status || {};
  const healthy = !!st.healthy;
  const b = sawBadge(healthy);
  const meta = document.getElementById('saw-meta');
  if (meta) meta.textContent = (st.pending != null ? ('待确认 ' + st.pending) : '');

  const statusCard = `
    <div class="saw-status saw-status-${healthy ? 'ok' : 'warn'}">
      <span class="saw-badge ${b.cls}"><span class="dot"></span>${sawEscapeHtml(b.label)}</span>
      <div class="saw-status-main">
        <div class="saw-summary">${sawEscapeHtml(st.summary || '暂无状态信息')}</div>
        <div class="saw-status-sub">上次自检：${sawRelTime(st.last_run)} · 待你确认事项：<b>${st.pending != null ? st.pending : '—'}</b></div>
      </div>
    </div>`;

  const boundary = `
    <div class="saw-boundary">
      <div class="saw-boundary-title">能力边界（请知悉）</div>
      <p>庄周可持续观察自身健康、能力供给与记忆真值，并据此给出可优化建议。
      这是<b>程序化的自我观察</b>，<b>并非人类的意识或自主意志</b>。
      所有「待确认事项」均由你最终决定，庄周不会自行改动核心。</p>
    </div>`;

  let feed = `<div class="saw-feed-title">自检记录（来自庄周自检循环）</div>`;
  if (SAW.cache.length) {
    feed += SAW.cache.slice().reverse().slice(0, 12).map((r) => `
      <div class="saw-feed-item">
        <div class="saw-feed-text">${sawEscapeHtml(r.content)}</div>
        <div class="saw-feed-meta">${sawRelTime(r.ts)} · 来源：庄周自检（仅观察，不执行）</div>
      </div>`).join('');
  } else {
    feed += `<div class="saw-feed-empty">暂无实时自检记录。点击「立即自检」可触发一轮观察。</div>`;
  }

  const feedback = `
    <div class="saw-feedback">
      <div class="saw-feedback-title">对庄周的自我认知有意见？（叠加纠错，不修改原状态）</div>
      <textarea class="saw-feedback-ta" id="saw-fb" placeholder="例如：这项「可优化事项」不准确 / 我并不需要这类提醒…"></textarea>
      <div class="saw-feedback-actions">
        <button class="saw-fb-cancel" id="saw-fb-cancel">取消</button>
        <button class="saw-fb-save" id="saw-fb-save">提交纠错</button>
      </div>
    </div>`;

  body.innerHTML = statusCard + boundary + feed + feedback;

  const run = document.createElement('button');
  run.className = 'saw-run';
  run.textContent = '立即自检';
  run.addEventListener('click', () => sawRun(run));
  body.querySelector('.saw-status').appendChild(run);

  const ta = body.querySelector('#saw-fb');
  body.querySelector('#saw-fb-cancel').addEventListener('click', () => { ta.value = ''; });
  body.querySelector('#saw-fb-save').addEventListener('click', () => {
    const v = ta.value.trim();
    if (!v) { ta.focus(); return; }
    sawFeedback(v, body.querySelector('#saw-fb-save'));
  });
}

async function sawRun(btn) {
  btn.disabled = true; btn.textContent = '自检中…';
  try {
    const r = await fetch('/api/self_awareness/run', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
    const d = await r.json().catch(() => ({}));
    sawToast((d && d.ok) ? '已触发一轮自检' : ('自检触发失败：' + sawEscapeHtml(String(d.error || '未知'))));
  } catch (e) {
    sawToast('请求失败：' + sawEscapeHtml(String(e && e.message || e)));
  } finally {
    btn.disabled = false; btn.textContent = '立即自检';
    setTimeout(() => sawLoad(), 400);
  }
}

async function sawFeedback(text, saveBtn) {
  const md = '自我认知纠错：\n\n' + text + '\n\n> 由用户在「自我认知」面板提交，作为叠加式纠正，不修改庄周原状态。';
  try {
    const r = await fetch('/api/notes', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        title: '自我认知纠错 · ' + sawFmtTime(new Date()).slice(0, 16),
        markdown: md,
        tags: 'aw:feedback',
        folder: '智能反馈',
        aliases: '',
      }),
    });
    const d = await r.json().catch(() => ({}));
    if (d && d.ok) {
      SAW.feedback.push({ markdown: md });
      sawToast('已记录纠错（叠加生效，原状态不变）');
      const ta = document.getElementById('saw-fb'); if (ta) ta.value = '';
    } else {
      sawToast('纠错提交失败：' + sawEscapeHtml(String(d.error || '未知')));
      if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = '提交纠错'; }
    }
  } catch (e) {
    sawToast('请求失败：' + sawEscapeHtml(String(e && e.message || e)));
    if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = '提交纠错'; }
  }
}

function sawToast(msg) {
  let el = document.getElementById('saw-toast');
  if (!el) {
    el = document.createElement('div');
    el.id = 'saw-toast';
    el.className = 'saw-toast';
    document.body.appendChild(el);
  }
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(el._t);
  el._t = setTimeout(() => el.classList.remove('show'), 2600);
}

// SSE：缓存 self_awareness 自检记录（跨会话展示，避免打开面板时空白）
function sawOnMessage(raw) {
  if (!raw) return;
  let msg;
  try { msg = typeof raw === 'string' ? JSON.parse(raw) : raw; } catch (_) { return; }
  if (!msg || msg.zhuangzhou_event !== 'proactive') return;
  if (msg.kind !== 'self_awareness') return;
  SAW.cache.push({ ts: msg.ts || sawFmtTime(new Date()), content: msg.content || '', importance: msg.importance });
  if (SAW.cache.length > 30) SAW.cache = SAW.cache.slice(-30);
  if (SAW.open) sawRender();
}

function sawSubscribe() {
  if (SAW.subscribed) return;
  if (window.ZZSSE && window.ZZSSE.onMessage) window.ZZSSE.onMessage(sawOnMessage);
  SAW.subscribed = true;
}

function sawOpen() {
  sawBuild();
  sawSubscribe();
  sawLoad();
  requestAnimationFrame(() => document.body.classList.add('self-awareness-mode'));
  SAW.open = true;
  window.dispatchEvent(new CustomEvent('zhuangzhou:saw-mode', { detail: { active: true } }));
  if (window.OverlayManager) {
    const type = (window.OverlayManager.OverlayType) ? window.OverlayManager.OverlayType.PANEL : 'panel';
    window.OverlayManager.track('self-awareness', { el: SAW.panel, onClose: sawCloseImpl, type: type, trap: false });
  }
}
function sawCloseImpl() {
  document.body.classList.remove('self-awareness-mode');
  SAW.open = false;
  window.dispatchEvent(new CustomEvent('zhuangzhou:saw-mode', { detail: { active: false } }));
}
function sawClose() {
  if (window.OverlayManager && window.OverlayManager.isOpen && window.OverlayManager.isOpen('self-awareness')) window.OverlayManager.close('self-awareness');
  else sawCloseImpl();
}

window.ZZSelfAwareness = { open: sawOpen, close: sawClose };
