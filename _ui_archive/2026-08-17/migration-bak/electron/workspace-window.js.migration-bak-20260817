'use strict';

/**
 * electron/workspace-window.js — Phase 3 · ZhuangZhou Advanced Workspace 窗口工厂
 * ----------------------------------------------------------------------------
 * 职责：创建标准（有边框/标题栏）工作区主窗口，加载 zz-space/index.html。
 *
 * 安全（与 avatar-window 一致，继承 §25）：
 *   - contextIsolation: true / nodeIntegration: false / sandbox: true
 *   - will-navigate 仅放行 localhost / 127.0.0.1（借用 security.isSafeNavigation）
 *   - 禁止渲染进程弹出新窗口（target=_blank / window.open）
 * 本模块不加载任何 AI / Runtime 逻辑，仅做"窗口存在"。
 */

const { BrowserWindow, screen } = require('electron');
const path = require('path');
const { isSafeNavigation } = require('./security');

const WINDOW_W = 1600;
const WINDOW_H = 920;
const MIN_W = 960;
const MIN_H = 620;

function createWorkspaceWindow(opts) {
  opts = opts || {};

  // 主屏居中（基于 workArea，避开任务栏）
  let x = 0;
  let y = 0;
  try {
    const display = screen.getPrimaryDisplay();
    const area = (display && display.workAreaSize) || { width: 1280, height: 720 };
    x = Math.max(0, Math.round((area.width - WINDOW_W) / 2));
    y = Math.max(0, Math.round((area.height - WINDOW_H) / 2));
  } catch (e) {
    x = 0;
    y = 0;
  }

  const win = new BrowserWindow({
    width: WINDOW_W,
    height: WINDOW_H,
    minWidth: MIN_W,
    minHeight: MIN_H,
    x: x,
    y: y,
    show: false,
    backgroundColor: '#07090d',
    autoHideMenuBar: true,
    title: '小6 · 对话',
    webPreferences: {
      preload: opts.preload || path.join(__dirname, 'preload.js'),
      contextIsolation: true,
      nodeIntegration: false,
      webSecurity: true,
      sandbox: true,
      spellcheck: false,
    },
  });

  // 导航守卫：仅允许 localhost / 127.0.0.1 的 http(s) 导航
  win.webContents.on('will-navigate', function (event, url) {
    if (!isSafeNavigation(url)) {
      event.preventDefault();
      console.warn('[workspace][security] 拦截非白名单导航: ' + String(url));
    }
  });

  // 禁止渲染进程弹出新窗口
  win.webContents.setWindowOpenHandler(function () {
    return { action: 'deny' };
  });

  // 避免白屏闪烁：ready 后再显示
  win.once('ready-to-show', function () {
    if (!win.isDestroyed()) win.show();
  });

  win.on('closed', function () {
    // 引用由调用方（main.js）维护
  });

  const target = opts.url || 'http://localhost:8010/zz-space/index.html';
  win.loadURL(target);

  return win;
}

module.exports = { createWorkspaceWindow, WINDOW_W, WINDOW_H, MIN_W, MIN_H };
