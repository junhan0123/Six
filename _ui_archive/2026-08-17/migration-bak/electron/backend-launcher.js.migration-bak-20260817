'use strict';

/**
 * electron/backend-launcher.js — Phase 38C · C3 端口身份校验 / 冲突安全
 * ----------------------------------------------------------------------------
 * 纯 Electron 侧逻辑；不改动 server.py（Phase 37 基线，红线 READ ONLY）。
 *
 * 职责（仅探测与解析，零侵入）：
 *   - probeBackendIdentity(port): 确认该端口确为「庄周」后端。
 *       做法：GET /api/health，校验返回体含庄周专属标记（ai_name 字符串 + features 对象）。
 *       若端口无响应 / 返回非庄周结构（如被其它程序占用），返回 false。
 *   - resolveBackendPort(preferred, maxOffset): 端口冲突安全。
 *       1) 首选端口若为庄周后端的身份 → 直接用；
 *       2) 否则自 8001 起依次偏移，寻找确为庄周后端的端口；
 *       3) 均未命中 → 回退首选端口（由调用方决定如何连接/启动，本模块不自动拉起）。
 *
 * 纪律：
 *   - 不自动拉起 server.py（保持 Phase 31「后端已在运行」契约，避免超范围）。
 *   - 不修改任何运行时 / 业务代码 / 红线资产。
 */

const http = require('http');

function probeBackendIdentity(port, timeoutMs) {
  timeoutMs = timeoutMs || 1500;
  return new Promise(function (resolve) {
    let req;
    try {
      req = http.get(
        { host: '127.0.0.1', port: port, path: '/api/health', timeout: timeoutMs },
        function (res) {
          let body = '';
          res.on('data', function (c) { body += c; });
          res.on('end', function () {
            try {
              const d = JSON.parse(body);
              // 庄周专属标记：ai_name 字符串 + features 对象（区别于任意占端口的程序）
              const isZhuangZhou =
                d && typeof d.ai_name === 'string' &&
                d.features && typeof d.features === 'object';
              resolve(!!isZhuangZhou);
            } catch (e) {
              resolve(false);
            }
          });
        }
      );
    } catch (e) {
      resolve(false);
      return;
    }
    req.on('error', function () { resolve(false); });
    req.on('timeout', function () { try { req.destroy(); } catch (e) {} resolve(false); });
  });
}

function resolveBackendPort(preferred, maxOffset) {
  preferred = parseInt(preferred, 10);
  if (!preferred || preferred < 1) preferred = 8010;
  maxOffset = parseInt(maxOffset, 10);
  if (!maxOffset || maxOffset < 1) maxOffset = 10;

  return (async function () {
    // 1) 首选端口若是庄周后端的身份，直接用
    if (await probeBackendIdentity(preferred)) {
      return { port: preferred, offset: 0, verified: true };
    }
    // 2) 否则自 8001 起偏移，寻找确为庄周后端的端口
    for (let i = 1; i <= maxOffset; i++) {
      const p = 8010 + i; // 8001, 8002, ...
      if (await probeBackendIdentity(p)) {
        return { port: p, offset: i, verified: true };
      }
    }
    // 3) 均未命中 → 回退首选端口（不自动拉起，仅连接）
    return { port: preferred, offset: 0, verified: false };
  })();
}

module.exports = { probeBackendIdentity: probeBackendIdentity, resolveBackendPort: resolveBackendPort };
