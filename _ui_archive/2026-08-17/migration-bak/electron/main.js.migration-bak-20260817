'use strict';

/**
 * electron/main.js — ZhuangZhou · Canonical Electron Shell (Phase 3)
 * ----------------------------------------------------------------------------
 * 单一 canonical Electron 壳：同时承载
 *   - Voice Orb 桌宠窗口（desktop-avatar/dyna-orb.html，透明置顶）
 *   - Advanced Workspace 工作区窗口（zz-space/index.html，三栏主界面）
 * 合并自原孤儿壳 gui/main.js 中「真正需要」的窗口 / tray / 语音合成自启逻辑（§2）。
 *
 * 红线自检（继承并强化）：
 *   - 后端 server.py 由 launcher（zz_launch.bat）拉起；本进程不拉起后端，仅探测端口身份。
 *   - 不加载任何 AI / Runtime 逻辑；仅做窗口壳 + 最小 IPC 桥。
 *   - 不修改聊天接口 / Agent Runtime / Core 契约（不构成第二个 Runtime）。
 *   - 渲染进程经 preload 仅暴露受限窗口控制桥（contextIsolation + 无 nodeIntegration + sandbox）。
 */

const { app, ipcMain, shell, Tray, Menu, nativeImage } = require('electron');
const net = require('net');
const fs = require('fs');
const { spawn } = require('child_process');
const path = require('path');
const { createAvatarWindow } = require('./avatar-window');
const { createWorkspaceWindow } = require('./workspace-window');
const { resolveBackendPort } = require('./backend-launcher');
const { isSafeExternalUrl } = require('./security');

// 禁用硬件加速：与已验证的桌宠窗口一致，避免无 GPU / 远程桌面下 GPU 子进程 FATAL 崩溃。
app.disableHardwareAcceleration();

const ICON = 'F:\\桌面\\庄周 外观设计\\小6.ico';

// GPT-SoVITS 语音合成服务（可选；仅当安装存在时自启，避免环境差异崩溃）
const SOVITS_PY = 'D:\\GPT-SoVITS\\venv\\Scripts\\python.exe';
const SOVITS_CWD = 'D:\\GPT-SoVITS';
const SOVITS_PORT = 9880;
const SOVITS_VBS = 'G:\\ZhuangZhou\\zhuangzhou-ui\\launcher\\sovits-launcher.vbs';
let sovitsSpawned = false;

let avatarWin = null;
let workspaceWin = null;
let tray = null;

function backendBaseUrl() {
  const port = process.env.ZHUANGZHOU_PORT || '8010';
  return 'http://localhost:' + port;
}

function probePortOf(port) {
  return new Promise(function (resolve) {
    const s = net.connect({ port: port, host: '127.0.0.1' });
    s.on('connect', function () { try { s.destroy(); } catch (e) {} resolve(true); });
    s.on('error', function () { try { s.destroy(); } catch (e) {} resolve(false); });
  });
}

// 语音合成服务自启：受路径守卫，缺失即跳过（不阻断主流程）
function ensureSoVITS() {
  probePortOf(SOVITS_PORT).then(function (ok) {
    if (ok || sovitsSpawned) return;
    sovitsSpawned = true;
    if (!fs.existsSync(SOVITS_PY)) {
      console.log('[main] SoVITS 未安装（路径不存在），跳过语音合成自启: ' + SOVITS_PY);
      return;
    }
    console.log('[main] 启动 GPT-SoVITS 语音合成 (9880) ...');
    try {
      const child = spawn('C:\\Windows\\System32\\wscript.exe', [SOVITS_VBS], {
        cwd: SOVITS_CWD,
        detached: true,
        stdio: 'ignore',
        windowsHide: true,
      });
      child.unref();
    } catch (e) {
      console.error('[main] SoVITS 启动失败', e);
    }
  });
}

async function bootstrap() {
  // 端口身份校验 / 冲突安全：解析真实庄周后端端口（含偏移回退）
  const preferred = process.env.ZHUANGZHOU_PORT || '8010';
  const resolved = await resolveBackendPort(preferred);
  if (resolved.offset !== 0 || !resolved.verified) {
    console.log('[main] 端口解析: 首选 ' + preferred + ' -> 使用 ' + resolved.port +
      (resolved.verified ? ' (已校验为庄周后端的身份)' : ' (未检测到庄周后端，按首选端口连接)'));
  }
  process.env.ZHUANGZHOU_PORT = String(resolved.port);

  const base = backendBaseUrl();
  const preload = path.join(__dirname, 'preload.js');

  // Voice Orb 桌宠窗口（透明置顶）
  avatarWin = createAvatarWindow({
    url: base + '/desktop-avatar/dyna-orb.html',
    preload: preload,
  });

  // 主窗口：ChatGPT/DeepSeek 风格聊天界面（会话 / 对话 / 设置，工具执行内联）
  workspaceWin = createWorkspaceWindow({
    url: base + '/gui/chat.html',
    preload: preload,
  });

  // 语音合成服务（可选自启，受路径守卫）
  ensureSoVITS();

  // ── IPC：渲染页 → 窗口控制（最小副作用，无任何执行语义） ──
  ipcMain.on('avatar:close', function () {
    if (avatarWin && !avatarWin.isDestroyed()) avatarWin.close();
  });
  ipcMain.on('avatar:hide', function () {
    if (avatarWin && !avatarWin.isDestroyed()) avatarWin.hide();
  });
  // Phase 3 · GUI→Voice 桥（W13）：聚焦 / 拉起 Voice Orb
  ipcMain.on('avatar:focus', function () {
    try {
      if (avatarWin && !avatarWin.isDestroyed()) {
        if (!avatarWin.isVisible()) avatarWin.show();
        avatarWin.focus();
      }
    } catch (e) { /* 忽略 */ }
  });
  ipcMain.handle('avatar:open-chat', function () {
    // 语音球点击「打开对话」→ 聚焦主聊天窗口（不再开浏览器）
    try {
      if (workspaceWin && !workspaceWin.isDestroyed()) {
        if (!workspaceWin.isVisible()) workspaceWin.show();
        workspaceWin.focus();
      }
    } catch (e) { /* 忽略 */ }
  });
  ipcMain.on('avatar:set-ignore-mouse', function (e, ignore) {
    if (avatarWin && !avatarWin.isDestroyed()) {
      try { avatarWin.setIgnoreMouseEvents(Boolean(ignore), { forward: true }); } catch (_) {}
    }
  });
  ipcMain.on('avatar:move', function (e, dx, dy) {
    if (avatarWin && !avatarWin.isDestroyed()) {
      try {
        const [x, y] = avatarWin.getPosition();
        avatarWin.setPosition(x + Number(dx || 0), y + Number(dy || 0));
      } catch (_) {}
    }
  });

  // 桌宠就绪后向后端上报 AVATAR_READY，推进统一启动状态（最小副作用：一次 HTTP POST）
  avatarWin.once('ready-to-show', function () {
    const port = process.env.ZHUANGZHOU_PORT || '8010';
    const url = 'http://localhost:' + port + '/api/boot/avatar-ready';
    const post = (typeof fetch === 'function') ? fetch(url, { method: 'POST' }) : null;
    if (post && typeof post.catch === 'function') post.catch(function () {});
  });

  createTray();

  if (process.argv.includes('--help')) {
    console.log('[main] 用法: electron . [--port=PORT]  默认端口 8010');
  }
}

function createTray() {
  let icon;
  try {
    icon = fs.existsSync(ICON) ? nativeImage.createFromPath(ICON) : nativeImage.createEmpty();
    if (!icon || icon.isEmpty()) icon = nativeImage.createEmpty();
  } catch (e) {
    icon = nativeImage.createEmpty();
  }
  try {
    tray = new Tray(icon);
  } catch (e) {
    console.warn('[main] 托盘创建失败（可能无图形会话），跳过: ' + String(e));
    tray = null;
    return;
  }
  tray.setToolTip('小6 · AI 桌面伙伴');
  tray.setContextMenu(Menu.buildFromTemplate([
    { label: '显示/隐藏 对话', click: function () { toggleWorkspace(); } },
    { label: '显示/隐藏 语音球', click: function () { toggleOrb(); } },
    { type: 'separator' },
    { label: '退出 小6', click: function () { app.quit(); } },
  ]));
  tray.on('click', function () { toggleWorkspace(); });
}

function toggleWorkspace() {
  if (!workspaceWin || workspaceWin.isDestroyed()) return;
  if (workspaceWin.isVisible()) workspaceWin.hide();
  else { workspaceWin.show(); workspaceWin.focus(); }
}

function toggleOrb() {
  if (!avatarWin || avatarWin.isDestroyed()) return;
  if (avatarWin.isVisible()) avatarWin.hide();
  else avatarWin.show();
}

// 单实例锁：防止用户/启动器误开多个 Electron 实例，避免重复语音球/聊天 GUI
const gotTheLock = app.requestSingleInstanceLock();
if (!gotTheLock) {
  console.log('[main] 已有 Electron 实例在运行，退出本进程');
  app.quit();
  process.exit(0);
}
app.on('second-instance', function (event, argv, cwd) {
  console.log('[main] 收到第二个实例启动，聚焦现有窗口');
  try {
    if (workspaceWin && !workspaceWin.isDestroyed()) {
      if (!workspaceWin.isVisible()) workspaceWin.show();
      workspaceWin.focus();
    }
    if (avatarWin && !avatarWin.isDestroyed()) {
      if (!avatarWin.isVisible()) avatarWin.show();
      avatarWin.focus();
    }
  } catch (_) {}
});

app.whenReady().then(bootstrap);

// 有托盘时关闭所有窗口不退出（托盘常驻）；无托盘（macOS 除外）退出
app.on('window-all-closed', function () {
  if (!tray && process.platform !== 'darwin') app.quit();
});

app.on('activate', function () {
  // 有托盘时由托盘管理窗口；无托盘且无窗口时重建
  if (tray) return;
  if (require('electron').BrowserWindow.getAllWindows().length === 0) {
    bootstrap();
  }
});
