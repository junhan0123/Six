'use strict';

/**
 * electron/avatar-window.js — Phase 31 · 庄周桌面数字人窗口工厂
 * ----------------------------------------------------------------------------
 * 职责：创建透明、无边框、置顶的 Avatar 桌宠窗口。仅做"窗口存在"，
 * 不加载任何 AI 逻辑、不执行电脑操作、不修改后端。
 *
 * 窗口规格（来自 Phase 31 设计）：
 *   - 透明背景 (transparent:true)
 *   - 无边框 (frame:false)
 *   - 始终置顶 (alwaysOnTop:true)
 *   - 固定 320x480
 *   - 默认右下角
 *   - 关闭/隐藏由渲染页经 preload 的最小 electronAPI 触发
 */

const { BrowserWindow, screen } = require('electron');
const path = require('path');
const { isSafeNavigation } = require('./security');

const WINDOW_W = 213;
const WINDOW_H = 320;
const MARGIN = 18;

function createAvatarWindow(opts) {
  opts = opts || {};

  // 默认右下角（基于主屏 workArea，避开任务栏）
  let x = 0;
  let y = 0;
  try {
    const display = screen.getPrimaryDisplay();
    const area = (display && display.workAreaSize) || { width: 1280, height: 720 };
    x = Math.max(0, area.width - WINDOW_W - MARGIN);
    y = Math.max(0, area.height - WINDOW_H - MARGIN);
  } catch (e) {
    x = 0;
    y = 0;
  }

  const win = new BrowserWindow({
    width: WINDOW_W,
    height: WINDOW_H,
    x: x,
    y: y,
    transparent: true,
    frame: false,
    alwaysOnTop: true,
    resizable: false,
    movable: true,
    show: false,
    skipTaskbar: true,
    webPreferences: {
      preload: opts.preload || path.join(__dirname, 'preload.js'),
      contextIsolation: true,
      nodeIntegration: false,
      webSecurity: true,
      sandbox: true,
    },
  });

  // Phase 47.4 · E-06 导航守卫：仅允许 localhost/127.0.0.1 的 http(s) 导航，
  // 其余（file:/javascript:/data:/about:/chrome:/devtools:/外部域等）一律阻止。
  win.webContents.on('will-navigate', function (event, url) {
    if (!isSafeNavigation(url)) {
      event.preventDefault();
      console.warn('[desktop-avatar][security] 拦截非白名单导航: ' + String(url));
    }
  });

  // Phase 47.4 · 防御：禁止渲染进程弹出新窗口（target=_blank / window.open 等）。
  win.webContents.setWindowOpenHandler(function () {
    return { action: 'deny' };
  });

  // 避免白屏闪烁：ready 后再显示
  win.once('ready-to-show', function () {
    if (!win.isDestroyed()) win.show();
  });

  // 关闭/隐藏由渲染页按钮经 ipc 触发（见 main.js 注册）
  win.on('closed', function () {
    // 窗口关闭即释放引用；应用退出由 main.js 的 window-all-closed 处理
  });

  const target = opts.url || 'http://localhost:8010/desktop-avatar/dyna-orb.html';

  // 后端就绪前页面会 404/空白 → 透明窗口不可见。后端起来后自动重试加载（最多 60 次，约 90s）。
  let _loadAttempts = 0;
  const MAX_LOAD_ATTEMPTS = 60;
  function loadOrRetry() {
    try { win.loadURL(target); } catch (e) { /* 忽略单次失败，交给 did-fail-load 重试 */ }
  }
  win.webContents.on('did-fail-load', function () {
    _loadAttempts++;
    if (_loadAttempts <= MAX_LOAD_ATTEMPTS) {
      setTimeout(loadOrRetry, 1500);
    }
  });

  loadOrRetry();

  return win;
}

module.exports = { createAvatarWindow, WINDOW_W, WINDOW_H };
