/* ============================================================
 * UI-4C-2 · Unified Home Fusion v1.0
 * 身份：Senior Product Designer / AI OS Experience Architect
 * 性质：纯表现层 ADDITIVE 最高覆盖（必须位于 ui4c-visible-upgrade.css 之后）
 * ------------------------------------------------------------
 * 纪律（严格遵守 brief 红线）：
 *  - 不修改 Galaxy 数据 / solar-system.js / Backend / Agent / 新增页面 / 新增 Event Contract。
 *  - 不触碰 fixed 定位、不修改三面板外层、零逻辑改动、不新增/重定义令牌体系。
 *  - 仅消费既有令牌（--accent / --accent-2 / --presence-color / --bg / --surface /
 *    --border / --text / --text-dim / --muted / --glow）。
 *  - 保护 Phase 8 AI Presence 三唯一：只消费 body[data-presence] 与 --presence-color，不重定义。
 * 目标映射：
 *  - H1 默认首屏融合：首页 = 唯一主空间「ZhuangZhou AI OS Home」。
 *  - H2 Galaxy 环境化降权：默认 Galaxy → 沉静氛围层，不抢注意力。
 *  - H3 中央焦点升级：强化 Primary Focus（AI 身份/状态 + Intent 入口 + 当前任务），弱化次级面板。
 *  - H4 导航统一（感知层）：将「星图」从平级「第二首页」入口重新归类为次级「环境」入口。
 * 作用域：首页态限定 body:not(.chat-mode):not(.universe-mode)，工作台/宇宙态视觉零变化。
 * ============================================================ */

/* ───────────────── H2 · Galaxy Ambient Integration ─────────────────
 * 默认降权 Galaxy：从「中等亮度星空前景」转为「沉静的环境层」。
 * 仅覆盖默认首页态；universe-mode 仍由 spatial-runtime/ui2 提亮（不破坏既有放大视图）。 */
body:not(.chat-mode):not(.universe-mode) #solarCanvas {
  filter: brightness(0.46) saturate(0.6) contrast(0.95);
  transition: filter var(--dur-slow) var(--ease-soft);
}
/* 叙事纱更轻：仅留空间氛围，而非前景遮罩 */
body:not(.chat-mode):not(.universe-mode) .galaxy-veil {
  opacity: 0.5;
}
/* 在 galaxy-veil 上叠加径向渐晕：中心通透（仍感身处宇宙）、四周沉入背景（环境化） */
body:not(.chat-mode):not(.universe-mode) .galaxy-veil::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(125% 120% at 50% 44%,
    transparent 36%,
    color-mix(in srgb, var(--bg) 42%, transparent) 78%,
    color-mix(in srgb, var(--bg) 66%, transparent) 100%);
}

/* ───────────────── H1 / H3 · Default Home Fusion & Central Focus ─────────────────
 * 首页 = 唯一主空间（AI OS 工作空间）。强化 Primary Focus，弱化次级面板，消除多余视觉中心。 */

/* H3-a · AI 身份锚点（os-core / hero）：以 Presence 颜色点缀微光环，回答「AI 在哪」 */
body:not(.chat-mode):not(.universe-mode) .os-core {
  position: relative;
}
body:not(.chat-mode):not(.universe-mode) .os-core::after {
  content: "";
  position: absolute;
  inset: -10px;
  border-radius: inherit;
  pointer-events: none;
  box-shadow:
    0 0 0 1px color-mix(in srgb, var(--presence-color, var(--accent)) 32%, transparent),
    0 0 56px -10px color-mix(in srgb, var(--presence-color, var(--accent)) 30%, transparent);
}

/* H3-b · 次级面板（能力矩阵/洞察）默认退后：它们是上下文抽屉，不是主焦点 */
body:not(.chat-mode):not(.universe-mode) .os-side .os-panel {
  opacity: 0.8;
  transition: opacity var(--dur-base) var(--ease-soft);
}
body:not(.chat-mode):not(.universe-mode) .os-side:hover .os-panel,
body.os-context-open:not(.chat-mode):not(.universe-mode) .os-side .os-panel {
  opacity: 1;
}

/* H3-c · 当前任务（Timeline）与 Intent 入口（Dock）保持清晰主焦点
 * （UI-4C-1 已强化玻璃语言与 Presence 联动，本阶段仅确保不被稀释，故不额外弱化） */

/* ───────────────── H4 · Navigation Simplification（感知层统一）─────────────────
 * 将「星图」从与 对话/指令/助理/设置 平级的「第二首页」入口，
 * 重新归类为次级「环境」入口（暗示 Galaxy 是始终在场的氛围，而非另一个应用）。
 * 不移除任何导航功能、不改 JS / 事件契约。 */

/* 品牌锚点：强调「你在此处 · 庄周 AI OS 首页」，作为唯一主空间身份标记 */
body:not(.chat-mode):not(.universe-mode) .os-nav-brand {
  box-shadow:
    0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent),
    0 6px 18px -6px var(--glow);
}

/* 星图按钮：次级「环境」处理 —— 默认降权、细描边、悬停/激活恢复，
 * 明确区别于功能导航簇（对话/指令/助理/设置）。 */
body:not(.chat-mode):not(.universe-mode) .os-nav-btn[data-nav="galaxy"] {
  opacity: 0.5;
  border: 1px dashed color-mix(in srgb, var(--accent) 30%, transparent);
  background: color-mix(in srgb, var(--accent) 6%, transparent);
}
body:not(.chat-mode):not(.universe-mode) .os-nav-btn[data-nav="galaxy"]:hover,
body:not(.chat-mode):not(.universe-mode) .os-nav-btn[data-nav="galaxy"].active {
  opacity: 1;
  border-style: solid;
  background: color-mix(in srgb, var(--accent) 14%, transparent);
}

/* 功能导航簇保持满权重，形成「单一 AI OS 主导航」主轴 */
body:not(.chat-mode):not(.universe-mode) .os-nav-btn:not([data-nav="galaxy"]) {
  opacity: 1;
}

/* ───────────────── 响应式 · Narrow（≤980）：导航形态保持统一 ─────────────────
 * 沿用 ui2 既有「导航横排」职责，仅确保 galaxy 次级处理在窄屏同样生效。 */
@media (max-width: 980px) {
  body:not(.chat-mode):not(.universe-mode) .os-nav-btn[data-nav="galaxy"] {
    opacity: 0.5;
    border: 1px dashed color-mix(in srgb, var(--accent) 30%, transparent);
  }
  body:not(.chat-mode):not(.universe-mode) .os-nav-btn[data-nav="galaxy"].active {
    opacity: 1;
    border-style: solid;
  }
}
