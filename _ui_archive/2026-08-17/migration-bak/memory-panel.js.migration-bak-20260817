// memory-panel.js —— 全屏「记忆审查」面板（注意：与既有的 memory.js 记忆图谱功能无关，请勿互相覆盖）
// 由 app.js handleToolEvent 收到 { zhuangzhou_event:'panel', panel:'memory', data } 时调用 window.ZZMemory.open(data)
// 行为：
//   GET /api/memory_audit?action=audit → {stores:[{name,count,samples:[...],note?}], totals:{}, generated_at}
//   每个 store 渲染为卡片（名称、条数、最多 5 行截断样本）；提供「清理」按钮
//   清理：GET /api/memory_audit?action=prune&store=<name>&keep_days=30 → 刷新（清理前 window.confirm）

const MEM = { panel: null, open: false };

// 本地转义：避免依赖其它模块作用域内的 escapeHtml
function escapeHtml(str) {
  return String(str == null ? '' : str).replace(/[&<>"']/g, (c) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  }[c]));
}

function memBuild() {
  if (MEM.panel) return;
  const html = `
  <div class="memory-panel" id="memory-panel" role="dialog" aria-label="记忆审查">
    <div class="memory-backdrop" data-close="1"></div>
    <div class="memory-stage glass">
      <div class="memory-bar">
        <div class="memory-title"><span class="memory-dot"></span>记忆审查</div>
        <button class="memory-refresh" id="memory-refresh" title="刷新">↻</button>
        <button class="memory-close" id="memory-close" title="关闭（Esc）" aria-label="关闭"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-close"/></svg></button>
      </div>
      <div class="memory-body" id="memory-body"></div>
    </div>
  </div>`;
  document.body.insertAdjacentHTML('beforeend', html);
  MEM.panel = document.getElementById('memory-panel');
  document.getElementById('memory-close').addEventListener('click', memClose);
  MEM.panel.querySelector('[data-close]').addEventListener('click', memClose);
  document.getElementById('memory-refresh').addEventListener('click', () => memAudit());
}

function memFmtTime(ts) {
  if (!ts) return '—';
  const d = new Date(ts * (String(ts).length <= 10 ? 1000 : 1));
  if (isNaN(d.getTime())) return String(ts);
  const p = (x) => String(x).padStart(2, '0');
  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
}

function memSampleLines(samples) {
  if (!Array.isArray(samples) || !samples.length) return `<div class="mem-sample-empty">（无样本）</div>`;
  const lines = samples.slice(0, 5).map((s) => {
    let txt = '';
    try { txt = (typeof s === 'string') ? s : JSON.stringify(s); } catch (_) { txt = String(s); }
    if (txt.length > 120) txt = txt.slice(0, 120) + '…';
    return `<div class="mem-sample-line">${escapeHtml(txt)}</div>`;
  }).join('');
  const more = samples.length > 5 ? `<div class="mem-sample-more">…等 ${samples.length} 条</div>` : '';
  return lines + more;
}

function memStoreCard(store) {
  const name = store && store.name != null ? String(store.name) : '未命名';
  const count = store && store.count != null ? Number(store.count) : 0;
  const note = store && store.note ? `<div class="mem-store-note">${escapeHtml(String(store.note))}</div>` : '';
  return `
    <div class="mem-card">
      <div class="mem-store-head">
        <div class="mem-store-name">${escapeHtml(name)}</div>
        <div class="mem-store-count"><b>${count}</b> 条</div>
      </div>
      <div class="mem-samples">${memSampleLines(store ? store.samples : null)}</div>
      ${note}
      <button class="mem-prune" data-store="${escapeHtml(name)}">清理</button>
    </div>`;
}

async function memAudit() {
  const body = document.getElementById('memory-body');
  body.innerHTML = `<div class="mem-loading">正在审计记忆库…</div>`;
  try {
    const r = await fetch('/api/memory_audit?action=audit', { method: 'GET' });
    const d = await r.json();
    const stores = (d && Array.isArray(d.stores)) ? d.stores : [];
    const generatedAt = d && d.generated_at ? memFmtTime(d.generated_at) : '';
    const totals = d && d.totals ? d.totals : {};
    const totalCount = totals.count != null ? Number(totals.count)
      : stores.reduce((s, x) => s + (Number(x.count) || 0), 0);
    const head = `
      <div class="mem-summary">
        <span>共 <b>${totalCount}</b> 条记忆</span>
        ${generatedAt ? `<span class="mem-gen">生成于 ${generatedAt}</span>` : ''}
      </div>`;
    if (!stores.length) {
      body.innerHTML = head + `<div class="mem-empty">暂无记忆数据</div><div id="mem-learn" class="mem-learn-wrap"></div>`;
      memLoadLearnings();
      return;
    }
    body.innerHTML = head + `<div class="mem-grid">${stores.map(memStoreCard).join('')}</div><div id="mem-learn" class="mem-learn-wrap"></div>`;
    body.querySelectorAll('.mem-prune').forEach((btn) => {
      btn.addEventListener('click', () => memPrune(btn.getAttribute('data-store')));
    });
    memLoadLearnings();
  } catch (e) {
    body.innerHTML = `<div class="mem-empty">记忆审计失败：${escapeHtml(String(e && e.message || e))}</div>`;
  }
}

function memLearnCard(item) {
  const id = item && item.id != null ? Number(item.id) : 0;
  const content = item && item.content != null ? String(item.content) : '';
  const type = item && item.type ? String(item.type) : 'feedback';
  const typeLabel = { feedback: '用户偏好', correction: '纠错', distill: '经验' }[type] || type;
  const typeCls = { feedback: 'l-fb', correction: 'l-cr', distill: 'l-di' }[type] || 'l-fb';
  const weight = item && item.weight != null ? Number(item.weight) : 1;
  const created = item && item.created ? memFmtTime(item.created) : '';
  return `
    <div class="learn-card">
      <div class="learn-head">
        <span class="learn-tag ${typeCls}">${escapeHtml(typeLabel)}</span>
        <span class="learn-weight">权重 ${weight.toFixed(1)}</span>
        ${created ? `<span class="learn-time">${escapeHtml(created)}</span>` : ''}
      </div>
      <div class="learn-content">${escapeHtml(content)}</div>
      <button class="learn-del" data-id="${id}" title="删除这条学习经验">删除</button>
    </div>`;
}

async function memLoadLearnings() {
  const wrap = document.getElementById('mem-learn');
  if (!wrap) return;
  wrap.innerHTML = `<div class="mem-loading" style="padding:18px">正在加载学习经验…</div>`;
  try {
    const r = await fetch('/api/learnings?action=list&limit=50', { method: 'GET' });
    const d = await r.json();
    const items = (d && Array.isArray(d.learnings)) ? d.learnings : [];
    if (!items.length) {
      wrap.innerHTML = `<div class="learn-heading"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-book"/></svg> 自我学习经验</div>`
        + `<div class="mem-sample-empty" style="padding:8px 2px">暂无学习经验。可在对话中直接说「记住…」「别再…」「以后…」让庄周学会你的偏好。</div>`;
      return;
    }
    wrap.innerHTML = `<div class="learn-heading"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-book"/></svg> 自我学习经验（${items.length}）</div>`
      + `<div class="learn-grid">${items.map(memLearnCard).join('')}</div>`;
    wrap.querySelectorAll('.learn-del').forEach((btn) => {
      btn.addEventListener('click', () => memLearnDelete(Number(btn.getAttribute('data-id'))));
    });
  } catch (e) {
    wrap.innerHTML = `<div class="mem-error">学习经验加载失败：${escapeHtml(String(e && e.message || e))}</div>`;
  }
}

async function memLearnDelete(id) {
  if (!id) return;
  if (!window.confirm('删除这条学习经验吗？删除后庄周将不再据此回应。')) return;
  try {
    const r = await fetch('/api/learnings?action=delete&id=' + id, { method: 'GET' });
    const d = await r.json();
    if (d && d.ok) {
      await memLoadLearnings();
    }
  } catch (e) {
    /* 忽略：删除失败不阻塞面板 */
  }
}

async function memPrune(store) {
  if (!store) return;
  if (!window.confirm(`确定清理「${store}」的记忆吗？将仅保留最近 30 天的数据，此操作不可撤销。`)) return;
  const body = document.getElementById('memory-body');
  const btn = body.querySelector(`.mem-prune[data-store="${CSS.escape(store)}"]`);
  if (btn) { btn.disabled = true; btn.textContent = '清理中…'; }
  try {
    const r = await fetch('/api/memory_audit?action=prune&store=' + encodeURIComponent(store) + '&keep_days=30', { method: 'GET' });
    const d = await r.json();
    if (d && d.ok) {
      await memAudit();
    } else {
      if (btn) { btn.disabled = false; btn.textContent = '清理'; }
      body.insertAdjacentHTML('afterbegin', `<div class="mem-error">清理失败：${escapeHtml((d && d.error) ? String(d.error) : '未知错误')}</div>`);
    }
  } catch (e) {
    if (btn) { btn.disabled = false; btn.textContent = '清理'; }
    body.insertAdjacentHTML('afterbegin', `<div class="mem-error">清理请求失败：${escapeHtml(String(e && e.message || e))}</div>`);
  }
}

function memOpen(data) {
  memBuild();
  memAudit();
  requestAnimationFrame(() => document.body.classList.add('memory-mode'));
  MEM.open = true;
  window.dispatchEvent(new CustomEvent('zhuangzhou:memory-mode', { detail: { active: true } }));
  // Sprint 1/2：登记到 OverlayManager（统一 ESC / 焦点 / 栈）
  if (window.OverlayManager) window.OverlayManager.track('memory', { el: MEM.panel, onClose: memCloseImpl, type: window.OverlayManager.OverlayType.PANEL, trap: false });
}

function memCloseImpl() {
  document.body.classList.remove('memory-mode');
  MEM.open = false;
  window.dispatchEvent(new CustomEvent('zhuangzhou:memory-mode', { detail: { active: false } }));
}

function memClose() {
  if (window.OverlayManager && window.OverlayManager.isOpen('memory')) window.OverlayManager.close('memory');
  else memCloseImpl();
}

window.ZZMemory = { open: memOpen, close: memClose, audit: memAudit };
