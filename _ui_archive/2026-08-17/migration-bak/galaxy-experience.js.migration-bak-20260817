/*
 * galaxy-experience.js — 庄周 AI OS UI Alpha · Phase 3 · Galaxy Experience Layer (GEL)
 * ----------------------------------------------------------------------------
 * 性质：纯表现层 + 受控交互包装层（DECISION_004 / Golden State 红线-5）。
 * 纪律（严格 Implementation-Only / Architecture Frozen）：
 *   - 绝不修改 solar-system.js 本体（银河本体视觉资产 100% 保留）。
 *   - 绝不修改 Galaxy 数据结构 / 节点模型 / 事件协议 / 导航协议。
 *   - 绝不持有可写状态、绝不读写 AppState（除经既有事件契约只读 focus 投影）。
 *   - 不新增 Capability；"进入"动作路由到既有能力面板的唯一入口（PanelManager.openCapability）。
 * 职责：
 *   1) 背景叙事纱（galaxy-veil，CSS 已处理，universe 模式淡出）。
 *   2) 状态提示（gx-status，只读 AppState.focus / GalaxyState 投影）。
 *   3) 节点信息卡（gx-card，聚焦某领域节点时展示其类型/状态/描述）。
 *   4) 交互反馈层：聚焦 → 状态提示更新；Esc 返回 → 卡片收起。
 * 设计目标：让 Galaxy 从"背景装饰"升为"庄周 AI OS 的空间入口"——用户理解：
 *   太阳=庄周核心，轨道=Goal，星球=能力域，卫星=Agent，环=Memory，流星=主动推送。
 * 可在浏览器中运行（依赖 window.AppState / window.GalaxyState，二者均先于本文件加载）。
 */
(function (global) {
  'use strict';

  // —— 只读数据投影（绝不写状态）——
  function _getAppState() { return global.AppState || null; }
  function _getGalaxyState() { return global.GalaxyState || null; }
  function _getFocus() {
    var AS = _getAppState();
    return (AS && typeof AS.getFocus === 'function') ? AS.getFocus() : { capability: null, id: null };
  }

  // —— 银河本体语义（来自 DECISION_004 / GALAXY_INTERACTION_SPEC，仅用于展示标签，不改隐喻）——
  var KIND_LABEL = {
    core: '庄周核心', goal: '目标轨道', agent: '智能体卫星',
    task: '任务节点', memory: '记忆环', knowledge: '知识链接', intent: '意图流'
  };

  // —— 生命周期态 → 展示色 + 中文标签（与 overlay-runtime.steadyLifecycle 收敛，仅展示）——
  var STATE_VIEW = {
    Dormant:   { color: 'var(--muted)',  label: '休眠' },
    Created:   { color: 'var(--accent-2)', label: '已创建' },
    Running:   { color: 'var(--ok)',     label: '运行中' },
    Thinking:  { color: 'var(--accent)', label: '思考中' },
    Waiting:   { color: 'var(--warn)',   label: '等待中' },
    Completed: { color: 'var(--ok)',     label: '已完成' },
    Failed:    { color: 'var(--danger)', label: '失败' },
    Archived:  { color: 'var(--muted)',  label: '已归档' }
  };
  function _stateView(s) { return STATE_VIEW[s] || { color: 'var(--muted)', label: s || '未知' }; }

  // —— “进入”动作：经既有能力面板唯一入口，不新增 Capability ——
  function _enterCapability(kind) {
    var id = (kind === 'goal') ? 'capabilities' : 'capabilities';
    if (global.PanelManager && typeof global.PanelManager.openCapability === 'function') {
      global.PanelManager.openCapability(id);
    } else if (global.ZZCapabilities && typeof global.ZZCapabilities.open === 'function') {
      global.ZZCapabilities.open();
    }
    // 关闭宇宙视图，回到工作台以查看能力面板（受控交互，不改导航协议）
    document.body.classList.remove('universe-mode');
    var uv = document.getElementById('universeView');
    if (uv) uv.classList.remove('open');
  }

  // —— DOM 引用（容错：缺失则静默退出，不影响银河本体）——
  var elStatusText, elCard, elKind, elTitle, elStateDot, elStateLabel, elDesc, elEnter, elClose;
  function _cache() {
    elStatusText = document.getElementById('gxStatusText');
    elCard = document.getElementById('gxCard');
    elKind = document.getElementById('gxKind');
    elTitle = document.getElementById('gxTitle');
    elStateDot = document.getElementById('gxStateDot');
    elStateLabel = document.getElementById('gxStateLabel');
    elDesc = document.getElementById('gxDesc');
    elEnter = document.getElementById('gxEnterBtn');
    elClose = document.getElementById('gxCloseBtn');
  }

  // —— 渲染：聚焦态变化 → 更新 GEL（纯展示）——
  function _render() {
    if (!elCard) return;
    var focus = _getFocus();
    var uv = document.getElementById('universeView');
    if (!focus || !focus.id) {
      // 未聚焦任何领域节点：收起卡片，状态提示回到就绪
      if (uv) uv.classList.remove('gx-active');
      elCard.setAttribute('aria-hidden', 'true');
      if (elStatusText) elStatusText.textContent = '星系导航就绪 · 点击星球进入空间入口';
      return;
    }
    var GS = _getGalaxyState();
    var node = (GS && typeof GS.getNode === 'function') ? GS.getNode(focus.id) : null;
    if (!node) { if (uv) uv.classList.remove('gx-active'); return; }

    var kind = KIND_LABEL[node.type] || node.type || '节点';
    var sv = _stateView(node.state);
    var meta = node.metadata || {};

    if (elKind) elKind.textContent = kind;
    if (elTitle) elTitle.textContent = meta.title || meta.name || node.id;
    if (elStateDot) elStateDot.style.background = sv.color;
    if (elStateLabel) elStateLabel.textContent = sv.label;
    if (elDesc) {
      var parts = [];
      if (meta.desc) parts.push(meta.desc);
      else if (meta.summary) parts.push(meta.summary);
      parts.push('这是「' + kind + '」在庄周 AI OS 中的空间投影。');
      elDesc.textContent = parts.join(' ');
    }
    // “进入”按钮语义：聚焦领域节点 → 进入对应能力/目标空间（既有面板）
    if (elEnter) {
      elEnter.textContent = (node.type === 'goal') ? '查看目标' : '查看能力';
      elEnter.onclick = function () { _enterCapability(node.type); };
    }
    if (elClose) {
      elClose.onclick = function () {
        if (uv) uv.classList.remove('gx-active');
        elCard.setAttribute('aria-hidden', 'true');
      };
    }

    if (uv) uv.classList.add('gx-active');
    elCard.setAttribute('aria-hidden', 'false');
    if (elStatusText) elStatusText.textContent = '已聚焦：' + (meta.title || meta.name || node.id);
  }

  // —— 订阅：仅读 AppState 事件，绝不写 ——
  function init() {
    _cache();
    if (!elCard) return; // 容错：DOM 缺失不影响银河
    var AS = _getAppState();
    if (AS && typeof AS.subscribe === 'function') {
      AS.subscribe('*', function () { try { _render(); } catch (e) { /* 隔离异常 */ } });
    }
    var GS = _getGalaxyState();
    if (GS && typeof GS.onNodeChange === 'function') {
      GS.onNodeChange(function () { try { _render(); } catch (e) { /* 隔离异常 */ } });
    }
    _render();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();

  global.GalaxyExperience = { init: init, render: _render };
})(typeof window !== 'undefined' ? window : globalThis);
