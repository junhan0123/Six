// capability-center.js —— 能力中心（Phase 36.1 · Task 3）
// 产品化 /api/capabilities：让用户理解「庄周能做什么 / 怎么触发 / 当前是否激活」。
// 纪律：仅展示 + 引导；绝不自动执行任何能力（红线）。
// 使用入口三态路由：
//   panel（有对应面板）→ 打开面板；
//   inject（对话驱动）→ 预填输入框，由用户发送；
//   restricted（高风险，如电脑操作）→ 仅提示需确认，预填谨慎问句；
//   background（后台自动）→ 仅状态说明。
// 复用 OverlayManager 统一浮层栈；body.capc-mode 表现类；window.ZZCapabilityCenter 暴露入口。

const CAPC = { panel: null, open: false, items: [], keyword: '' };

function capcEscapeHtml(str) {
  return String(str == null ? '' : str).replace(/[&<>"']/g, (c) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  }[c]));
}

// 三态路由判定：优先映射到已注册面板；其次高风险/受限；再次对话触发；最后后台自动
function capcRoute(cap) {
  const id = cap.id || '';
  const label = cap.label || '';
  const hay = (id + ' ' + label).toLowerCase();
  if (window.PanelManager && typeof window.PanelManager.list === 'function' && window.PanelManager.list().indexOf(id) >= 0) return 'panel';
  if (/computer|action|操作|执行|文件|屏幕|控制/.test(hay)) return 'restricted';
  if (cap.triggers && cap.triggers.length) return 'inject';
  return 'background';
}

function capcRouteNote(route) {
  if (route === 'panel') return '点击打开对应面板，在面板内查看 / 操作。';
  if (route === 'inject') return '对话驱动：点击下方把示例问句填入输入框，发送后由庄周在对话中触发。';
  if (route === 'restricted') return '受限能力：庄周不会自动操作你的电脑；请在对话中说明需求，由你逐条确认后执行。';
  return '后台自动运行：无需你操作，庄周在相关对话中自动启用。';
}

function capcBuild() {
  if (CAPC.panel) return;
  const html = `
  <div class="capc-panel" id="capc-panel" role="dialog" aria-label="能力中心">
    <div class="capc-backdrop" data-close="1"></div>
    <div class="capc-stage glass">
      <div class="capc-bar">
        <div class="capc-title"><span class="capc-dot"></span>能力中心</div>
        <div class="capc-meta" id="capc-meta"></div>
        <button class="capc-refresh" id="capc-refresh" title="刷新">↻</button>
        <button class="capc-close" id="capc-close" title="关闭（Esc）" aria-label="关闭"><svg class="zz-icon stroke" aria-hidden="true"><use href="#zz-close"/></svg></button>
      </div>
      <div class="capc-search-wrap">
        <input class="capc-search" id="capc-search" type="search" placeholder="筛选能力（名称 / 描述 / 触发词）…" />
      </div>
      <div class="capc-body" id="capc-body"></div>
    </div>
  </div>`;
  document.body.insertAdjacentHTML('beforeend', html);
  CAPC.panel = document.getElementById('capc-panel');
  document.getElementById('capc-close').addEventListener('click', capcClose);
  CAPC.panel.querySelector('[data-close]').addEventListener('click', capcClose);
  document.getElementById('capc-refresh').addEventListener('click', () => capcLoad());
  const search = document.getElementById('capc-search');
  search.addEventListener('input', () => { CAPC.keyword = search.value.trim().toLowerCase(); capcRender(); });
}

async function capcLoad() {
  const body = document.getElementById('capc-body');
  if (body) body.innerHTML = `<div class="capc-loading">正在读取能力清单…</div>`;
  try {
    const r = await fetch('/api/capabilities', { cache: 'no-store' });
    const d = await r.json();
    CAPC.items = (d && Array.isArray(d.items)) ? d.items : [];
    const meta = document.getElementById('capc-meta');
    if (meta) {
      const active = CAPC.items.filter((c) => c.active).length;
      meta.textContent = '共 ' + CAPC.items.length + ' · 已激活 ' + active;
    }
    capcRender();
  } catch (e) {
    if (body) body.innerHTML = `<div class="capc-empty">能力加载失败：${capcEscapeHtml(String(e && e.message || e))}</div>`;
  }
}

function capcRender() {
  const body = document.getElementById('capc-body');
  if (!body) return;
  const kw = CAPC.keyword;
  const items = CAPC.items.filter((c) => {
    if (!kw) return true;
    const hay = ((c.label || '') + ' ' + (c.description || '') + ' ' + (c.group || '') + ' ' + (c.triggers || []).join(' ')).toLowerCase();
    return hay.indexOf(kw) >= 0;
  });
  if (!items.length) {
    body.innerHTML = `<div class="capc-empty">${kw ? '没有匹配「' + capcEscapeHtml(kw) + '」的能力' : '暂无可用的能力'}</div>`;
    return;
  }
  const groups = {};
  items.forEach((c) => { const g = c.group || '其他'; (groups[g] = groups[g] || []).push(c); });
  let html = '';
  Object.keys(groups).forEach((g) => {
    html += `<section class="capc-group"><div class="capc-group-title">${capcEscapeHtml(g)} <span class="capc-group-count">${groups[g].length}</span></div>`;
    html += `<div class="capc-grid">${groups[g].map(capcCard).join('')}</div></section>`;
  });
  body.innerHTML = html;
  capcBind(body);
}

function capcCard(c) {
  const route = capcRoute(c);
  const tags = (c.triggers || []).map((t) => `<span class="capc-chip">${capcEscapeHtml(t)}</span>`).join('');
  const active = c.active ? '<span class="capc-status on">● 已激活</span>' : '<span class="capc-status off">○ 待命</span>';
  return `
  <div class="capc-card" data-id="${capcEscapeHtml(c.id || '')}" data-route="${route}">
    <div class="capc-card-top">
      <span class="capc-icon">${capcEscapeHtml(c.icon || '🧩')}</span>
      <div class="capc-card-h">
        <div class="capc-card-title">${capcEscapeHtml(c.label || c.id || '(未命名)')}</div>
        ${active}
      </div>
    </div>
    <p class="capc-desc">${capcEscapeHtml(c.description || '')}</p>
    ${tags ? `<div class="capc-chips">${tags}</div>` : ''}
    <div class="capc-how"><div class="capc-how-label">工作原理</div><p>${capcEscapeHtml(c.how || '（暂无说明）')}</p></div>
    <div class="capc-route-note">${capcEscapeHtml(capcRouteNote(route))}</div>
    <div class="capc-actions">${capcRouteBtn(c, route)}</div>
  </div>`;
}

function capcRouteBtn(c, route) {
  if (route === 'panel') {
    return `<button class="capc-use" data-route="panel" data-id="${capcEscapeHtml(c.id || '')}">打开面板</button>`;
  }
  if (route === 'inject') {
    const sample = (c.triggers && c.triggers[0]) ? c.triggers[0] : ('介绍一下' + (c.label || ''));
    return `<button class="capc-use" data-route="inject" data-sample="${capcEscapeHtml(sample)}">试一试：填入对话</button>`;
  }
  if (route === 'restricted') {
    const careful = '庄周，我想用「' + (c.label || c.id) + '」：请先告诉我你会怎么做、需要我确认哪些步骤，不要自行操作。';
    return `<button class="capc-use capc-use-warn" data-route="restricted" data-sample="${capcEscapeHtml(careful)}">在对话中确认使用</button>`;
  }
  return `<span class="capc-bg-tag">后台自动</span>`;
}

function capcBind(root) {
  root.querySelectorAll('.capc-use').forEach((btn) => {
    btn.addEventListener('click', () => {
      const route = btn.getAttribute('data-route');
      const id = btn.getAttribute('data-id');
      const sample = btn.getAttribute('data-sample') || '';
      if (route === 'panel') {
        if (window.PanelManager) PanelManager.openCapability(id);
        else capcToast('未找到对应面板');
      } else if (route === 'inject' || route === 'restricted') {
        capcInject(sample);
      }
    });
  });
}

// 仅预填输入框并聚焦，由用户主动发送——绝不自动执行能力
function capcInject(q) {
  const input = document.getElementById('input');
  if (!input) { capcToast('未找到输入框'); return; }
  input.value = q;
  input.focus();
  capcToast('已填入输入框，发送后由庄周在对话中处理');
}

function capcToast(msg) {
  let el = document.getElementById('capc-toast');
  if (!el) {
    el = document.createElement('div');
    el.id = 'capc-toast';
    el.className = 'memc-toast';
    document.body.appendChild(el);
  }
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(el._t);
  el._t = setTimeout(() => el.classList.remove('show'), 2600);
}

function capcOpen() {
  capcBuild();
  capcLoad();
  requestAnimationFrame(() => document.body.classList.add('capc-mode'));
  CAPC.open = true;
  window.dispatchEvent(new CustomEvent('zhuangzhou:capc-mode', { detail: { active: true } }));
  if (window.OverlayManager) {
    const type = (window.OverlayManager.OverlayType) ? window.OverlayManager.OverlayType.PANEL : 'panel';
    window.OverlayManager.track('capability-center', { el: CAPC.panel, onClose: capcCloseImpl, type: type, trap: false });
  }
}
function capcCloseImpl() {
  document.body.classList.remove('capc-mode');
  CAPC.open = false;
  window.dispatchEvent(new CustomEvent('zhuangzhou:capc-mode', { detail: { active: false } }));
}
function capcClose() {
  if (window.OverlayManager && window.OverlayManager.isOpen && window.OverlayManager.isOpen('capability-center')) window.OverlayManager.close('capability-center');
  else capcCloseImpl();
}

window.ZZCapabilityCenter = { open: capcOpen, close: capcClose };
