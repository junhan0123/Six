/*
 * capability-health.js — ZhuangZhou 能力健康状态 · 单一真相源（Phase 38I · P1-1）
 *
 * 职责：统一定义"能力健康状态"枚举与渲染元数据，供 dependency-manager.js / control-center.js
 *       共用，消除此前两套私有枚举（DM 8 态 / CC 7 态）不一致、且未覆盖规约 §八 12 态的问题。
 *
 * 纪律（REALITY FIRST）：
 *   - 本模块只定义"状态名 + 展示"，绝不自行判定状态；真实状态一律由探测端点（/api/health /
 *     /api/ready / /api/asr/status / /api/test-llm …）派生。
 *   - 禁 ON/OFF 二值、禁"配置存在即 READY"的造假。
 *   - 不新增后端 / 不改 server.py / 不改 EventBus。
 *
 * 规约 §八 12 态（canonical）：
 *   UNKNOWN / CHECKING / READY / NOT_CONFIGURED / CONFIGURED / MISSING /
 *   INSTALLING / INSTALL_FAILED / CONNECTION_FAILED / UNAVAILABLE / OPTIONAL / NOT_IMPLEMENTED
 *
 * 历史兼容：保留 NOT_TESTED / NOT_INSTALLED / ERROR / DISABLED 作为同值别名键，
 *   使既有 dependency-manager.js 的 CSS class（zz-dep__row--not_tested 等）与渲染无需改动。
 */
(function (global) {
  'use strict';

  /* 状态常量（字符串值即 CSS class 后缀 / 渲染 key，保持向后兼容） */
  var CAP_STATE = {
    // —— 规约 12 态 ——
    UNKNOWN:           'unknown',
    CHECKING:          'checking',
    READY:             'ready',
    NOT_CONFIGURED:    'not_configured',
    CONFIGURED:        'configured',        // 已配置但未验证（"配置 ≠ READY" 的真实中间态）
    MISSING:           'missing',
    INSTALLING:        'installing',
    INSTALL_FAILED:    'install_failed',
    CONNECTION_FAILED: 'connection_failed', // 已配置但连通测试失败（展示真实原因）
    UNAVAILABLE:       'unavailable',
    OPTIONAL:          'optional',
    NOT_IMPLEMENTED:   'not_implemented',    // 该 Provider / 能力后端未实现 → "暂未支持"

    // —— 历史兼容（保持旧字符串值，避免破坏既有 CSS class / 渲染）——
    NOT_TESTED:        'not_tested',
    NOT_INSTALLED:     'not_installed',
    ERROR:             'error',
    DISABLED:          'disabled'
  };

  /* 单一渲染元数据：cls 必须落在既有 zz 徽章 / 状态点的调色板内（ok/warn/bad/muted/plan） */
  var META = {
    unknown:           { cls: 'muted', label: '未知' },
    checking:          { cls: 'warn',  label: '检测中' },
    ready:             { cls: 'ok',    label: '就绪' },
    not_configured:    { cls: 'warn',  label: '未配置' },
    configured:        { cls: 'warn',  label: '已配置·待验证' },
    not_tested:        { cls: 'warn',  label: '已配置·待验证' },
    missing:           { cls: 'warn',  label: '未安装' },
    not_installed:     { cls: 'warn',  label: '未安装' },
    installing:        { cls: 'warn',  label: '安装中' },
    install_failed:    { cls: 'bad',   label: '安装失败' },
    connection_failed: { cls: 'bad',   label: '连接失败' },
    unavailable:       { cls: 'bad',   label: '不可用' },
    optional:          { cls: 'muted', label: '可选' },
    not_implemented:   { cls: 'muted', label: '暂未支持' },
    error:             { cls: 'bad',   label: '异常' },
    disabled:          { cls: 'muted', label: '已停用' }
  };

  function meta(state) { return META[String(state)] || META.unavailable; }
  function cls(state) { return meta(state).cls; }
  function label(state) { return meta(state).label; }
  function badge(state, extraCls) {
    var m = meta(state);
    return '<span class="zz-cc__badge zz-cc__badge--' + m.cls + (extraCls ? ' ' + extraCls : '') + '">' + m.label + '</span>';
  }

  global.ZZCapabilityHealth = {
    CAP_STATE: CAP_STATE,
    META: META,
    meta: meta,
    cls: cls,
    label: label,
    badge: badge
  };
})(typeof window !== 'undefined' ? window : globalThis);
