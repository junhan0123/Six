/* 庄周 · HUD 情境上下文（P13/P9 前端消费层，独立模块）
 * 轮询环境感知 / 跨端接力端点，将精简上下文推送到 glance 卡（window.ZZGlance）；
 * 所有端点均经 feature gate：enabled:False 时跳过，零开销。
 * 性能：20s 轮询；页面隐藏（visibilitychange）时暂停；仅在上下文变化时更新 glance。
 */
(function () {
  "use strict";

  var POLL_MS = 20000;
  var lastMsg = "";

  function api(path) {
    return fetch(path, { method: "GET" })
      .then(function (r) { return r.json().catch(function () { return {}; }); })
      .catch(function () { return {}; });
  }

  function push(text, kind) {
    if (!window.ZZGlance || !window.ZZGlance.update) return;
    if (text === lastMsg) return; // 去抖：仅变化才更新
    lastMsg = text;
    window.ZZGlance.update(text, { kind: kind || "info" });
  }

  function summarizeFocus(focus) {
    if (!focus) return null;
    var app = focus.app || focus.name || focus.title;
    if (!app) return null;
    var extra = focus.title && focus.title !== app ? " · " + focus.title : "";
    return "正在使用 " + app + extra;
  }

  function summarizeCalendar(nxt) {
    if (!nxt) return null;
    var t = nxt.start || nxt.time || nxt.due || "";
    var title = nxt.title || nxt.subject || nxt.summary || "日程";
    return "下一日程 " + (t ? t + " · " : "") + title;
  }

  async function tick() {
    if (document.visibilityState === "hidden") return;

    try {
      var focusRes = await api("/api/focus/app");
      if (focusRes.enabled && focusRes.focus) {
        var f = summarizeFocus(focusRes.focus);
        if (f) { push(f, "info"); return; }
      }
    } catch (e) { /* 忽略单端点异常 */ }

    try {
      var calRes = await api("/api/calendar/next");
      if (calRes.enabled && calRes.next) {
        var c = summarizeCalendar(calRes.next);
        if (c) { push(c, "info"); return; }
      }
    } catch (e) { /* 忽略 */ }

    try {
      var xRes = await api("/api/cross-device/status");
      if (xRes.enabled && xRes.pending > 0) {
        push("有 " + xRes.pending + " 条跨端接力待领取", "info");
        return;
      }
    } catch (e) { /* 忽略 */ }

    // 无上下文：重置去抖基线，避免下次轮询重复推送旧消息
    lastMsg = "";
  }

  function start() {
    if (!window.ZZGlance) {
      // glance-card.js 可能尚未就绪，稍后重试
      setTimeout(start, 800);
      return;
    }
    tick();
    setInterval(tick, POLL_MS);
    document.addEventListener("visibilitychange", function () {
      if (document.visibilityState === "visible") tick();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start);
  } else {
    start();
  }
})();
