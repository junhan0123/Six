/*
 * phase6-order3.frontend.test.js — Phase 6 Order 3 前端状态基础设施验证
 * 运行：node tests/phase6-order3.frontend.test.js
 * 验证项：Agent/Task 生命周期事件 -> AppState reducer -> Galaxy 节点投影
 *          -> 三者状态同步（Goal/Agent/Task 不互覆）-> UI 观察者。
 * 不依赖浏览器 / Three.js / 网络（纯状态机单测）。
 */
'use strict';
const assert = require('assert');
const path = require('path');

const ZZ = require(path.join(__dirname, '../zz-events.js'));
const AppState = require(path.join(__dirname, '../app-state.js'));
const GalaxyState = require(path.join(__dirname, '../galaxy-state.js'));
const E = ZZ.EVENTS;

let pass = 0, fail = 0;
function check(name, fn) {
  try { fn(); console.log('  [PASS] ' + name); pass++; }
  catch (e) { console.log('  [FAIL] ' + name + '\n      ' + e.message); fail++; }
}

// UI 观察者（模拟现有 UI 自动响应 Agent/Task 状态变化）
const uiEvents = [];
const unsub = AppState.subscribe('*', (payload, name) => uiEvents.push({ name, payload }));

// 1) Goal 创建 + Agent 创建（Agent 是 Goal 轨道的卫星）
AppState.applyEvent(E.GOAL_CREATED, { goalId: 7, title: '分析当前项目', priority: 'high' });
AppState.applyEvent(E.AGENT_CREATED, { agentId: 'a7', goalId: 7, name: '庄周编排体', type: 'orchestrator' });
check('AGENT_CREATED: agent 已创建且状态=Created', () => {
  const a = AppState.getAgent('a7');
  assert.ok(a && a.status === 'Created');
});
check('AGENT_CREATED: agent.goalId 关联 Goal', () => {
  assert.strictEqual(AppState.getAgent('a7').goalId, 7);
});
check('AGENT_CREATED: 银河节点 agent:a7 已建(type=agent)', () => {
  const n = GalaxyState.getNode('agent:a7');
  assert.ok(n && n.type === 'agent');
});
check('AGENT_CREATED: 银河节点 state=Created', () => {
  assert.strictEqual(GalaxyState.getNode('agent:a7').state, 'Created');
});
// 关键：Agent 创建不破坏 Goal 状态
check('状态同步：Agent 创建不覆盖 Goal 状态(Created)', () => {
  assert.strictEqual(AppState.getGoal(7).status, 'Created');
});

// 2) Agent 启动 + 思考（规划中）
AppState.applyEvent(E.AGENT_STARTED, { agentId: 'a7', goalId: 7 });
check('AGENT_STARTED: 状态=Started', () => {
  assert.strictEqual(AppState.getAgent('a7').status, 'Started');
});
check('AGENT_STARTED: execution.currentAgentId 已设', () => {
  assert.strictEqual(AppState.getState().execution.currentAgentId, 'a7');
});
AppState.applyEvent(E.AGENT_THINKING, { agentId: 'a7', goalId: 7 });
check('AGENT_THINKING: 状态=Thinking', () => {
  assert.strictEqual(AppState.getAgent('a7').status, 'Thinking');
});
check('AGENT_THINKING: 银河节点 state=Thinking', () => {
  assert.strictEqual(GalaxyState.getNode('agent:a7').state, 'Thinking');
});

// 3) Task 创建 + 启动 + 运行（Task 是 Agent 轨道上的节点）
AppState.applyEvent(E.TASK_CREATED, { taskId: 101, goalId: 7, agentId: 'a7', title: '读取项目结构' });
check('TASK_CREATED: task 已建且状态=Created', () => {
  assert.strictEqual(AppState.getTask(101).status, 'Created');
});
check('TASK_CREATED: task.agentId 关联 Agent', () => {
  assert.strictEqual(AppState.getTask(101).agentId, 'a7');
});
AppState.applyEvent(E.TASK_STARTED, { taskId: 101, goalId: 7, agentId: 'a7' });
check('TASK_STARTED: 状态=Started', () => {
  assert.strictEqual(AppState.getTask(101).status, 'Started');
});
check('TASK_STARTED: execution.currentTaskId 已设', () => {
  assert.strictEqual(AppState.getState().execution.currentTaskId, 101);
});
AppState.applyEvent(E.TASK_RUNNING, { taskId: 101, goalId: 7, agentId: 'a7', progress: 40 });
check('TASK_RUNNING: 状态=Running + 进度=40', () => {
  const t = AppState.getTask(101);
  assert.strictEqual(t.status, 'Running');
  assert.strictEqual(t.progress, 40);
});
check('TASK_RUNNING: 银河节点 task:101 type=task state=Running', () => {
  const n = GalaxyState.getNode('task:101');
  assert.ok(n && n.type === 'task' && n.state === 'Running');
});
// 关键：Task 状态变化不覆盖 Agent / Goal
check('状态同步：Task 运行不覆盖 Agent(Thinking)/Goal(Created)', () => {
  assert.strictEqual(AppState.getAgent('a7').status, 'Thinking');
  assert.strictEqual(AppState.getGoal(7).status, 'Created');
});

// 4) Task 完成
AppState.applyEvent(E.TASK_COMPLETED, { taskId: 101 });
check('TASK_COMPLETED: 状态=Completed', () => {
  assert.strictEqual(AppState.getTask(101).status, 'Completed');
});
check('TASK_COMPLETED: 银河节点 state=Completed', () => {
  assert.strictEqual(GalaxyState.getNode('task:101').state, 'Completed');
});

// 5) Agent 完成（反思后）+ Goal 完成
AppState.applyEvent(E.AGENT_COMPLETED, { agentId: 'a7', goalId: 7 });
AppState.applyEvent(E.GOAL_COMPLETED, { goalId: 7, progress: 100 });
check('AGENT_COMPLETED: 状态=Completed', () => {
  assert.strictEqual(AppState.getAgent('a7').status, 'Completed');
});
check('AGENT_COMPLETED: 银河节点 state=Completed', () => {
  assert.strictEqual(GalaxyState.getNode('agent:a7').state, 'Completed');
});
check('GOAL_COMPLETED: Goal 状态=Completed（三者终态一致）', () => {
  assert.strictEqual(AppState.getGoal(7).status, 'Completed');
});

// 6) 失败路径（独立 agent/task）：AGENT_WAITING + TASK_FAILED + AGENT_FAILED
AppState.applyEvent(E.AGENT_CREATED, { agentId: 'a9', goalId: 9, name: 'x', type: 'orchestrator' });
AppState.applyEvent(E.AGENT_WAITING, { agentId: 'a9', goalId: 9, taskId: 900 });
check('AGENT_WAITING: 状态=Waiting', () => {
  assert.strictEqual(AppState.getAgent('a9').status, 'Waiting');
});
AppState.applyEvent(E.TASK_CREATED, { taskId: 900, goalId: 9, agentId: 'a9', title: '危险操作' });
AppState.applyEvent(E.TASK_FAILED, { taskId: 900, error: 'permission denied' });
AppState.applyEvent(E.AGENT_FAILED, { agentId: 'a9', goalId: 9, error: 'boom' });
check('TASK_FAILED: 状态=Failed + error 记录', () => {
  const t = AppState.getTask(900);
  assert.strictEqual(t.status, 'Failed');
  assert.strictEqual(t.error, 'permission denied');
});
check('AGENT_FAILED: 状态=Failed + 银河节点 state=Error', () => {
  assert.strictEqual(AppState.getAgent('a9').status, 'Failed');
  assert.strictEqual(GalaxyState.getNode('agent:a9').state, 'Error');
});

// 7) GalaxyState 投影（纯数据层，无 Three.js/DOM）—— Satellite / Orbit Node
check('GalaxyState.getAgentNodes() 含 2 个 agent 卫星', () => {
  assert.strictEqual(GalaxyState.getAgentNodes().length, 2);
});
check('GalaxyState.getTaskNodes() 含 2 个 task 轨道节点', () => {
  assert.strictEqual(GalaxyState.getTaskNodes().length, 2);
});
check('Agent 卫星含 relation.goalId', () => {
  const n = GalaxyState.getAgentNodes().find(x => x.id === 'agent:a7');
  assert.ok(n && n.relation.goalId === 7);
});
check('Task 节点含 relation.agentId + relation.goalId', () => {
  const n = GalaxyState.getTaskNodes().find(x => x.id === 'task:101');
  assert.ok(n && n.relation.agentId === 'a7' && n.relation.goalId === 7);
});

// 8) UI 观察者收到完整 Agent/Task 生命周期（数据驱动，无视觉）
const seq = uiEvents.map(e => e.name);
['AGENT_CREATED', 'AGENT_STARTED', 'AGENT_THINKING', 'TASK_CREATED',
 'TASK_RUNNING', 'TASK_COMPLETED', 'AGENT_COMPLETED'].forEach(ev => {
  check('UI 观察者收到 ' + ev, () => {
    assert.ok(seq.includes(ev), '未收到 ' + ev);
  });
});

// 9) 单一来源纪律：38 个合约名（Order4 在 Order1-3 的 29 上净 +3 → 32；Order5 新增 INTENT_* 6 个 → 38），无同义、无字符串硬编码漏网
check('zz-events.js 含全部 7 个 Agent 生命周期事件', () => {
  assert.ok([E.AGENT_CREATED, E.AGENT_STARTED, E.AGENT_THINKING, E.AGENT_WORKING,
    E.AGENT_WAITING, E.AGENT_COMPLETED, E.AGENT_FAILED].every(Boolean));
});
check('zz-events.js 含全部 5 个 Task 生命周期事件', () => {
  assert.ok([E.TASK_CREATED, E.TASK_STARTED, E.TASK_RUNNING, E.TASK_COMPLETED, E.TASK_FAILED].every(Boolean));
});
check('合约总数为 71（单一来源对齐后端，Order5 38 + Phase7 Order1 19 + Phase7 Order2 5 + Phase7 Order3 2 → 64）', () => {
  assert.strictEqual(ZZ.names().length, 71);
});
check('非合约事件被 applyEvent 拒绝（无绕过）', () => {
  const before = Object.keys(AppState.getState().agents).length;
  AppState.applyEvent('AGENT_MADE_UP', { agentId: 'z' });
  assert.strictEqual(Object.keys(AppState.getState().agents).length, before);
});

unsub();
console.log(`\nFRONTEND (Order 3): ${fail === 0 ? 'PASS' : 'FAIL'}  (passed=${pass}, failed=${fail})`);
process.exit(fail === 0 ? 0 : 1);
