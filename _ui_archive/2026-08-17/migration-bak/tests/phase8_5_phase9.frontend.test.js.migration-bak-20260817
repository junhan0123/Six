'use strict';
const assert = require('assert');
const path = require('path');
const fs = require('fs');

let pass = 0, fail = 0;
function check(name, fn) {
  try { fn(); console.log('  ✓ ' + name); pass++; }
  catch (e) { console.log('  ✗ ' + name + '\n      ' + e.message); fail++; }
}
async function checkA(name, fn) {
  try { await fn(); console.log('  ✓ ' + name); pass++; }
  catch (e) { console.log('  ✗ ' + name + '\n      ' + e.message); fail++; }
}

// ── 轻量 fake DOM（不依赖 jsdom）──
function El(id) {
  this.id = id;
  this._text = ''; this._cn = ''; this._hidden = false; this._html = '';
  this.classList = {
    _s: new Set(),
    add(c) { this._s.add(c); }, remove(c) { this._s.delete(c); },
    contains(c) { return this._s.has(c); },
    toggle(c, f) { if (f === undefined) f = !this._s.has(c); if (f) this._s.add(c); else this._s.delete(c); return f; },
  };
  this.style = { _p: {}, setProperty(k, v) { this._p[k] = v; }, boxShadow: '' };
  this.dataset = {}; this._listeners = {};
}
El.prototype.setAttribute = function (k, v) { this['_a_' + k] = v; };
El.prototype.getAttribute = function (k) { return this['_a_' + k] != null ? this['_a_' + k] : null; };
Object.defineProperty(El.prototype, 'textContent', { get() { return this._text; }, set(v) { this._text = v; } });
Object.defineProperty(El.prototype, 'className', { get() { return this._cn; }, set(v) { this._cn = v; } });
Object.defineProperty(El.prototype, 'innerHTML', { get() { return this._html; }, set(v) { this._html = v; } });
Object.defineProperty(El.prototype, 'hidden', { get() { return this._hidden; }, set(v) { this._hidden = !!v; } });
El.prototype.addEventListener = function (t, fn) { (this._listeners[t] = this._listeners[t] || []).push(fn); };
El.prototype.querySelector = function () { return null; };
El.prototype.contains = function () { return false; };
El.prototype.closest = function () { return null; };
El.prototype.scrollIntoView = function () {};

const registry = {};
const docListeners = {};
const fakeDocument = {
  readyState: 'complete',
  getElementById(id) { if (!registry[id]) registry[id] = new El(id); return registry[id]; },
  addEventListener(t, fn) { (docListeners[t] = docListeners[t] || []).push(fn); },
  createElement() { return new El('x'); },
  body: new El('body'),
};

function fire(el, type, ev) { (el._listeners[type] || []).forEach(fn => fn(ev || {})); }

// 全局 fetch 桩：把 assets/avatar/*.svg 当本地文件读（同源托管，无 CORS）
let FORCE_FETCH_REJECT = false;
global.fetch = function (url) {
  return new Promise((resolve, reject) => {
    if (FORCE_FETCH_REJECT) { reject(new Error('forced-reject')); return; }
    const p = path.join(__dirname, '..', String(url));
    fs.readFile(p, 'utf8', (err, data) => {
      if (err) reject(err);
      else resolve({ ok: true, text() { return Promise.resolve(data); } });
    });
  });
};

// ── 真实状态基础设施（与产品同套，保证无本地模拟）──
function loadFresh() {
  ['../zz-events.js', '../app-state.js', '../execution-channel.js', '../avatar-state.js',
   '../avatar-assets.js', '../avatar-renderer.js'].forEach(m => {
    try { delete require.cache[require.resolve(m)]; } catch (_) {}
  });
  require(path.join(__dirname, '../zz-events.js'));
  const AppState = require(path.join(__dirname, '../app-state.js'));
  const EC = require(path.join(__dirname, '../execution-channel.js'));
  const AvatarState = require(path.join(__dirname, '../avatar-state.js'));
  const AvatarAssets = require(path.join(__dirname, '../avatar-assets.js'));
  const AvatarRenderer = require(path.join(__dirname, '../avatar-renderer.js'));
  global.AppState = AppState; global.ExecutionChannel = EC;
  global.AvatarState = AvatarState; global.AvatarAssets = AvatarAssets; global.AvatarRenderer = AvatarRenderer;
  return { AppState, EC, AvatarState, AvatarAssets, AvatarRenderer };
}

// ── ZZSSE 桩（记录 onState/onMessage 回调，供测试触发）──
function makeZZSSE() {
  const h = { state: [], message: [] };
  return {
    getState() { return 'open'; },
    onState(cb) { h.state.push(cb); },
    onMessage(cb) { h.message.push(cb); },
    _emitState() { h.state.forEach(f => { try { f(); } catch (_) {} }); },
    _emitMessage(raw) { h.message.forEach(f => { try { f(raw); } catch (_) {} }); },
  };
}

function setupBridge(opts) {
  opts = opts || {};
  const actions = []; const prefs = []; const dndSync = []; let visible = true;
  const bridge = {
    show() { bridge._show = true; },
    action(a) { actions.push(a); },
    setPref(p) { prefs.push(p); },
    getPrefs() { return Promise.resolve(opts.prefs || { pos: null, ui: {} }); },
    syncDnd(enabled) { dndSync.push(!!enabled); },
    getDnd() { return Promise.resolve(opts.dnd || { dnd: false }); },
    setCompanionVisible(v) { visible = !!v; },
    _actions: actions, _prefs: prefs, _dndSync: dndSync, _visible: () => visible,
  };
  return bridge;
}

function bootCompanion(bridge, zzsse) {
  global.window = {
    AvatarState: global.AvatarState, AppState: global.AppState,
    ExecutionChannel: global.ExecutionChannel, ZZSSE: zzsse,
    AvatarAssets: global.AvatarAssets, AvatarRenderer: global.AvatarRenderer,
    zhuangzhou: bridge,
  };
  global.document = fakeDocument;
  try { delete require.cache[require.resolve(path.join(__dirname, '../companion.js'))]; } catch (_) {}
  require(path.join(__dirname, '../companion.js'));
}

(async function main() {
  const { AppState, EC, AvatarState, AvatarRenderer } = loadFresh();
  const zzsse = makeZZSSE();
  const bridge = setupBridge();
  bootCompanion(bridge, zzsse);
  await new Promise(r => setTimeout(r, 0)); // 等 getPrefs/loadDndFromBackend 异步落地

  console.log('\n[启动1] main.js 启动仅显庄周，主窗默认隐藏（需 flag 才显）');
  check('main.js shouldShowMainOnStart 依赖 --show-main / ZH_SHOW_MAIN，默认 false', () => {
    const src = fs.readFileSync(path.join(__dirname, '../../electron/main.js'), 'utf8');
    assert.ok(/--show-main/.test(src), '未检查 --show-main');
    assert.ok(/ZH_SHOW_MAIN/.test(src), '未检查 ZH_SHOW_MAIN 环境变量');
    // ready-to-show 必须受 shouldShowMainOnStart 守卫（默认不显主窗）
    assert.ok(/shouldShowMainOnStart\(\)\s*&&/.test(src), 'ready-to-show 未受 shouldShowMainOnStart 守卫');
  });

  console.log('\n[启动2] companion.html 引入 avatar-assets/renderer 且版本号已 bump');
  check('companion.html 加载 avatar-assets.js / avatar-renderer.js（v=20260805a1）', () => {
    const html = fs.readFileSync(path.join(__dirname, '../companion.html'), 'utf8');
    assert.ok(/avatar-assets\.js\?v=20260805a1/.test(html), '缺 avatar-assets 引入或版本号未 bump');
    assert.ok(/avatar-renderer\.js\?v=20260805a1/.test(html), '缺 avatar-renderer 引入或版本号未 bump');
    assert.ok(/companion\.js\?v=20260805c1/.test(html), 'companion.js 版本号未同步 bump');
  });

  console.log('\n[启动3] 庄周默认启动可见 + AvatarRenderer 投影（data-state + SVG 注入）');
  await checkA('启动后 companionRoot 可见（未隐藏），avatar data-state 已设置', async () => {
    const root = fakeDocument.getElementById('companionRoot');
    assert.strictEqual(root.hidden, false, 'companionRoot 不应默认隐藏');
    const av = fakeDocument.getElementById('avatar');
    assert.ok(av.getAttribute('data-state'), 'avatar 未设置 data-state');
    await new Promise(r => setTimeout(r, 10)); // 等 SVG 异步注入
    assert.ok(av.innerHTML.indexOf('avatar-svg') >= 0, '未注入 avatar-svg');
  });

  console.log('\n[启动4] 启动不自动展开主窗（bridge.show 未被启动调用）');
  check('boot 后 bridge._show 仍为 falsy（主窗保持隐藏直到用户动作）', () => {
    assert.strictEqual(bridge._show, undefined, '启动即调用了 bridge.show，违背仅显庄周');
  });

  console.log('\n[Avatar5] AvatarRenderer 按态注入正确 SVG（EXECUTING）');
  await checkA('render(EXECUTING) → data-state + class + 注入 executing.svg', async () => {
    const el = new El('r5');
    AvatarRenderer.render(el, 'EXECUTING', '#56d364');
    assert.strictEqual(el.getAttribute('data-state'), 'EXECUTING');
    assert.ok(el.className.indexOf('avatar--executing') >= 0, 'class 未含 avatar--executing');
    await new Promise(r => setTimeout(r, 10));
    assert.ok(el.innerHTML.indexOf('avatar-svg') >= 0, '未注入 avatar-svg 容器');
    assert.ok(el.innerHTML.indexOf('<svg') >= 0, '未注入 SVG 内容');
    assert.ok(el.innerHTML.indexOf('aria-label="执行中"') >= 0, 'SVG 内容不匹配 executing 态');
  });

  console.log('\n[Avatar6] 资源失败降级 fallbackFace（不空白）');
  await checkA('fetch 失败时降级为 CSS 脸（含 avatar-eye），不空白', async () => {
    FORCE_FETCH_REJECT = true;
    const el = new El('r6');
    AvatarRenderer.render(el, 'THINKING', '#8b9bff');
    await new Promise(r => setTimeout(r, 10));
    FORCE_FETCH_REJECT = false;
    assert.ok(el.innerHTML.indexOf('avatar-eye') >= 0, '降级未渲染 CSS 脸 avatar-eye');
    assert.ok(el.innerHTML.length > 0, '降级后内容空白');
  });

  console.log('\n[Proactive7] 庄周订阅并显示 proactive 普通消息');
  await checkA('onProactiveMessage(proactive, normal) → 通知显示且文案正确（非 cn-error）', async () => {
    zzsse._emitMessage({ zhuangzhou_event: 'proactive', kind: 'goal', content: '提醒：周报待提交', importance: 'normal' });
    await new Promise(r => setTimeout(r, 0));
    const n = fakeDocument.getElementById('notify');
    assert.strictEqual(n.hidden, false, '普通 proactive 通知未显示');
    assert.strictEqual(fakeDocument.getElementById('notifyText').textContent, '提醒：周报待提交');
    assert.ok(n.className.indexOf('cn-error') < 0, '普通消息不应标记 cn-error');
  });

  console.log('\n[Proactive8] error 类消息 → cn-error');
  await checkA('onProactiveMessage(proactive, kind=error) → 异常样式 cn-error', async () => {
    zzsse._emitMessage({ zhuangzhou_event: 'proactive', kind: 'error', content: 'X 崩溃', importance: 'critical' });
    await new Promise(r => setTimeout(r, 0));
    const n = fakeDocument.getElementById('notify');
    assert.strictEqual(n.hidden, false, 'error 通知未显示');
    assert.ok(n.className.indexOf('cn-error') >= 0, 'error 消息未标记 cn-error');
  });

  console.log('\n[Proactive9] proactive_result(CREATE_GOAL) → 已主动创建目标');
  await checkA('onProactiveMessage(proactive_result, CREATE_GOAL) → 告知已创建目标', async () => {
    zzsse._emitMessage({ zhuangzhou_event: 'proactive_result', action: 'CREATE_GOAL', title: '推进：季度报告', goal_id: 5 });
    await new Promise(r => setTimeout(r, 0));
    const n = fakeDocument.getElementById('notify');
    assert.strictEqual(n.hidden, false, 'CREATE_GOAL 结果通知未显示');
    assert.ok(fakeDocument.getElementById('notifyText').textContent.indexOf('已主动创建目标') >= 0, '缺「已主动创建目标」');
    assert.ok(fakeDocument.getElementById('notifyText').textContent.indexOf('推进：季度报告') >= 0, '缺目标标题');
  });

  console.log('\n[Proactive10] DND 下普通抑制、critical 突破');
  await checkA('开启 DND：普通 proactive 被抑制，critical 突破显示', async () => {
    // 经菜单切换开启 DND（验证 toggle 链路同时打点 B2 同步）
    fire(fakeDocument.getElementById('quickMenu'), 'click', { target: { closest: () => ({ getAttribute: () => 'toggle-dnd' }) } });
    await new Promise(r => setTimeout(r, 0));
    assert.ok(bridge._dndSync.some(v => v === true), '开启 DND 未同步后端');
    // 先收起上一条通知（模拟 6s 自动隐藏已过期），再测抑制
    fakeDocument.getElementById('notify').hidden = true;
    // 普通消息 → 抑制（不显）
    zzsse._emitMessage({ zhuangzhou_event: 'proactive', kind: 'goal', content: '普通提醒', importance: 'normal' });
    await new Promise(r => setTimeout(r, 0));
    assert.strictEqual(fakeDocument.getElementById('notify').hidden, true, 'DND 下普通消息不应显示');
    // critical → 突破
    zzsse._emitMessage({ zhuangzhou_event: 'proactive', kind: 'goal', content: '紧急：磁盘满', importance: 'critical' });
    await new Promise(r => setTimeout(r, 0));
    assert.strictEqual(fakeDocument.getElementById('notify').hidden, false, 'critical 应突破 DND 显示');
  });

  console.log('\n[Proactive11] DND 同步经 IPC 桥，无 fetch / /api/ 直连');
  check('companion.js DND 走 bridge.syncDnd / bridge.getDnd，不含 fetch(/api/)', () => {
    const src = fs.readFileSync(path.join(__dirname, '../companion.js'), 'utf8');
    assert.ok(src.includes('bridge.syncDnd'), '未使用 bridge.syncDnd 同步 DND');
    assert.ok(src.includes('bridge.getDnd'), '未使用 bridge.getDnd 校准 DND');
    assert.ok(!src.includes('fetch('), '含 fetch 直连后端（违反 IPC 桥纪律）');
    assert.ok(!src.includes('/api/'), '含 /api/ 直连后端（违反 IPC 桥纪律）');
  });
  check('订阅 SSE 主动消息经 ZZSSE.onMessage（非自建 EventBus）', () => {
    const src = fs.readFileSync(path.join(__dirname, '../companion.js'), 'utf8');
    assert.ok(/ZZSSE\.onMessage/.test(src), '未订阅 ZZSSE.onMessage');
    assert.ok(!/new EventBus/.test(src), '含 new EventBus（第二事件系统）');
  });

  console.log(`\nPHASE 8.5 + 9 FRONTEND: ${fail === 0 ? 'PASS' : 'FAIL'}  (passed=${pass}, failed=${fail})`);
  process.exit(fail === 0 ? 0 : 1);
})();
