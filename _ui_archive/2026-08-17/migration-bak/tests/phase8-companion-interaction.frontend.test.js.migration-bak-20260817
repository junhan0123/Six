/*
 * phase8-companion-interaction.frontend.test.js — Phase 8 Companion Interaction Layer v1.0
 * 运行：node tests/phase8-companion-interaction.frontend.test.js
 * 验证项（对应需求 5 场景 + 纪律）：
 *   场景1 点击菜单执行任务：各系统动作经 companion:action IPC 桥（bridge.action）转发，禁止仅 open-main
 *   场景2 执行中庄周同步变化：EXECUTING 态 + Hover 气泡读自 ExecutionChannel 真实数据（无本地模拟）
 *   场景3 完成通知：COMPLETED 跃迁弹通知，点击 → completion-view
 *   场景4 异常提示：ERROR 跃迁弹异常通知（cn-error）
 *   场景5 重启后设置保留：getPrefs 恢复 paused/dnd；toggle 调用 setPref 持久化请求
 * 纪律：纯 Presentation Layer，无第二 Runtime/State/Memory/EventBus；IPC 桥非 API 直连。
 */
'use strict';
const assert = require('assert');
const path = require('path');
const fs = require('fs');

let pass = 0, fail = 0;
function check(name, fn) {
  try { fn(); console.log('  ✓ ' + name); pass++; }
  catch (e) { console.log('  ✗ ' + name + '\n      ' + e.message); fail++; }
}
async function checkA(name, fn) {
  try { await fn(); console.log('  ✓ ' + name); pass++; }
  catch (e) { console.log('  ✗ ' + name + '\n      ' + e.message); fail++; }
}

// ── 轻量 fake DOM（不依赖 jsdom）──
function El(id) {
  this.id = id;
  this._text = ''; this._cn = ''; this._hidden = false;
  this.classList = {
    _s: new Set(),
    add(c) { this._s.add(c); }, remove(c) { this._s.delete(c); },
    contains(c) { return this._s.has(c); },
    toggle(c, f) { if (f === undefined) f = !this._s.has(c); if (f) this._s.add(c); else this._s.delete(c); return f; },
  };
  this.style = { _p: {}, setProperty(k, v) { this._p[k] = v; }, boxShadow: '' };
  this.dataset = {}; this._listeners = {};
}
El.prototype.setAttribute = function (k, v) { this['_a_' + k] = v; };
El.prototype.getAttribute = function (k) { return this['_a_' + k] != null ? this['_a_' + k] : null; };
Object.defineProperty(El.prototype, 'textContent', { get() { return this._text; }, set(v) { this._text = v; } });
Object.defineProperty(El.prototype, 'className', { get() { return this._cn; }, set(v) { this._cn = v; } });
Object.defineProperty(El.prototype, 'hidden', { get() { return this._hidden; }, set(v) { this._hidden = !!v; } });
El.prototype.addEventListener = function (t, fn) { (this._listeners[t] = this._listeners[t] || []).push(fn); };
El.prototype.contains = function () { return false; };
El.prototype.closest = function () { return null; };
El.prototype.scrollIntoView = function () {};

const registry = {};
const docListeners = {};
const fakeDocument = {
  readyState: 'complete',
  getElementById(id) { if (!registry[id]) registry[id] = new El(id); return registry[id]; },
  addEventListener(t, fn) { (docListeners[t] = docListeners[t] || []).push(fn); },
  createElement() { return new El('x'); },
  body: new El('body'),
};

function fire(el, type, ev) { (el._listeners[type] || []).forEach(fn => fn(ev || {})); }

// ── 真实状态基础设施（与产品同套，保证无本地模拟）──
function loadFresh() {
  ['../zz-events.js', '../app-state.js', '../execution-channel.js', '../avatar-state.js'].forEach(m => {
    try { delete require.cache[require.resolve(m)]; } catch (_) {}
  });
  require(path.join(__dirname, '../zz-events.js'));
  const AppState = require(path.join(__dirname, '../app-state.js'));
  const EC = require(path.join(__dirname, '../execution-channel.js'));
  const AvatarState = require(path.join(__dirname, '../avatar-state.js'));
  global.AppState = AppState; global.ExecutionChannel = EC; global.AvatarState = AvatarState; global.ZZSSE = undefined;
  return { AppState, EC, AvatarState };
}

function setupBridge(opts) {
  opts = opts || {};
  const actions = []; const prefs = []; let visible = true;
  const bridge = {
    show() { bridge._show = true; },
    action(a) { actions.push(a); },
    setPref(p) { prefs.push(p); },
    getPrefs() { return opts.prefs || { pos: null, ui: {} }; },
    setCompanionVisible(v) { visible = !!v; },
    _actions: actions, _prefs: prefs, _visible: () => visible,
  };
  return bridge;
}

// 全局 window/document 注入（companion.js 为 IIFE，按全局读取）
function bootCompanion(bridge) {
  global.window = {
    AvatarState: global.AvatarState, AppState: global.AppState,
    ExecutionChannel: global.ExecutionChannel, ZZSSE: global.ZZSSE,
    zhuangzhou: bridge,
  };
  global.document = fakeDocument;
  // 清除上次 require 缓存以便干净重入
  try { delete require.cache[require.resolve(path.join(__dirname, '../companion.js'))]; } catch (_) {}
  require(path.join(__dirname, '../companion.js'));
}

(async function main() {
  const { AppState, EC } = loadFresh();
  const bridge = setupBridge();
  bootCompanion(bridge);

  console.log('\n[场景1] 点击菜单执行任务（经 companion:action IPC 桥，禁止仅 open-main）');
  check('快速指令 → bridge.action({type:"quick-cmd"})', () => {
    fire(fakeDocument.getElementById('quickMenu'), 'click', { target: { closest: () => ({ getAttribute: () => 'quick-cmd' }) } });
    assert.ok(bridge._actions.some(a => a.type === 'quick-cmd'), '未发送 quick-cmd');
  });
  check('当前任务 → bridge.action({type:"current-task"})', () => {
    fire(fakeDocument.getElementById('quickMenu'), 'click', { target: { closest: () => ({ getAttribute: () => 'current-task' }) } });
    assert.ok(bridge._actions.some(a => a.type === 'current-task'));
  });
  check('系统状态 / 记忆 / 项目状态 / 设置 均发往既有系统（非仅 open-main）', () => {
    ['system-status', 'memory', 'project', 'settings'].forEach(t => {
      fire(fakeDocument.getElementById('quickMenu'), 'click', { target: { closest: () => ({ getAttribute: () => t }) } });
    });
    ['system-status', 'memory', 'project', 'settings'].forEach(t => {
      assert.ok(bridge._actions.some(a => a.type === t), '缺少 ' + t);
    });
    assert.ok(!bridge._actions.some(a => a.type === 'open-main' && a !== undefined), '不应误发 open-main 作为系统动作');
  });
  check('打开庄周 → bridge.show()（主窗口焦点）', () => {
    fire(fakeDocument.getElementById('quickMenu'), 'click', { target: { closest: () => ({ getAttribute: () => 'open-main' }) } });
    assert.ok(bridge._show === true, '未调用 show()');
  });

  console.log('\n[场景2] 执行中庄周同步变化 + Hover 气泡（真实数据，无本地模拟）');
  check('EXECUTING：ExecutionChannel 进行中 → avatar data-state=EXECUTING', () => {
    EC.startExecution('分析当前项目');
    EC.onToolStart({ tool: 'file_read' });
    const av = fakeDocument.getElementById('avatar');
    assert.strictEqual(av.getAttribute('data-state'), 'EXECUTING');
  });
  check('Hover 气泡读自真实 ExecutionChannel（任务=分析当前项目，阶段含进度%）', () => {
    fire(fakeDocument.getElementById('avatar'), 'mouseenter');
    const bubble = fakeDocument.getElementById('statusBubble');
    assert.strictEqual(bubble.hidden, false, '气泡未显示');
    const sbTask = fakeDocument.getElementById('sbTask').textContent;
    const sbPhase = fakeDocument.getElementById('sbPhase').textContent;
    assert.ok(sbTask.indexOf('分析当前项目') >= 0, '任务未跟随真实 prompt: ' + sbTask);
    assert.ok(sbPhase.indexOf('读取文件') >= 0 && sbPhase.indexOf('%') >= 0, '阶段未含真实工具+进度: ' + sbPhase);
    fire(fakeDocument.getElementById('avatar'), 'mouseleave');
  });

  console.log('\n[场景3] 完成通知（点击查看结果）');
  let notifyEl;
  check('COMPLETED 跃迁 → 通知显示且含任务文案', () => {
    EC.onToolEnd({ tool: 'file_read', result: 'ok' }); // 真实流程：后端先发 tool_end 收尾步骤
    EC.completeExecution(); // 触发 render → 进入 COMPLETED
    notifyEl = fakeDocument.getElementById('notify');
    assert.strictEqual(notifyEl.hidden, false, '完成通知未显示');
    assert.ok(fakeDocument.getElementById('notifyText').textContent.indexOf('分析当前项目') >= 0, '通知文案缺任务');
  });
  check('点击通知 → bridge.action({type:"completion-view"})', () => {
    fire(notifyEl, 'click');
    assert.ok(bridge._actions.some(a => a.type === 'completion-view'), '未发送 completion-view');
    assert.strictEqual(notifyEl.hidden, true, '点击后通知未隐藏');
  });

  console.log('\n[场景4] 异常提示');
  check('ERROR 跃迁 → 异常通知（cn-error）', () => {
    AppState.applyEvent('ERROR_OCCURRED', { message: 'agent crashed', severity: 'error' });
    const n = fakeDocument.getElementById('notify');
    assert.strictEqual(n.hidden, false, '异常通知未显示');
    assert.ok(n.className.indexOf('cn-error') >= 0, '异常通知未标记 cn-error');
    assert.ok(fakeDocument.getElementById('notifyText').textContent.indexOf('agent crashed') >= 0);
  });

  console.log('\n[场景5] 重启后设置保留（prefs 恢复 + toggle 持久化请求）');
  await checkA('getPrefs 返回 paused → 初始化应用（root 加 paused 类，按钮 is-on）', async () => {
    // 重新启动一个 Companion 实例，模拟“重启后读取 companion.json”
    const b2 = setupBridge({ prefs: { pos: [10, 20], ui: { paused: true, dnd: false } } });
    loadFresh();
    bootCompanion(b2);
    await new Promise(r => setTimeout(r, 0)); // 等 getPrefs Promise 落地
    const root = fakeDocument.getElementById('companionRoot');
    assert.ok(root.classList.contains('companion-root--paused'), 'paused 偏好未恢复');
    const ctlPause = fakeDocument.getElementById('ctlPause');
    assert.ok(ctlPause.classList.contains('is-on'), '暂停按钮未标记 is-on');
  });
  check('toggle 勿扰 → bridge.setPref({dnd:true}) 且按钮标记 is-on', () => {
    // 复用主实例 bridge（已含场景1-4 的动作记录）；先重置以获得干净断言
    const b3 = setupBridge();
    loadFresh();
    bootCompanion(b3);
    fire(fakeDocument.getElementById('quickMenu'), 'click', { target: { closest: () => ({ getAttribute: () => 'toggle-dnd' }) } });
    assert.ok(b3._prefs.some(p => p.dnd === true), '未持久化 dnd 偏好');
    assert.ok(fakeDocument.getElementById('ctlDnd').classList.contains('is-on'), '勿扰按钮未标记 is-on');
  });
  check('隐藏庄周 → bridge.setCompanionVisible(false) + setPref({hidden:true})', () => {
    const b4 = setupBridge();
    loadFresh();
    bootCompanion(b4);
    fire(fakeDocument.getElementById('quickMenu'), 'click', { target: { closest: () => ({ getAttribute: () => 'hide' }) } });
    assert.strictEqual(b4._visible(), false, '未隐藏窗口');
    assert.ok(b4._prefs.some(p => p.hidden === true), '未持久化 hidden 偏好');
  });

  console.log('\n[纪律] 纯 Presentation Layer / IPC 桥 / 无第二系统');
  check('companion.js 不经 fetch / /api/ 直连后端（走 IPC 桥）', () => {
    const src = fs.readFileSync(path.join(__dirname, '../companion.js'), 'utf8');
    assert.ok(!src.includes('fetch('), '含 fetch 直连');
    assert.ok(!src.includes('/api/'), '含 /api/ 直连');
    assert.ok(src.includes('bridge.action'), '未使用 companion:action IPC 桥');
  });
  check('companion.js 不新建 AppState/EventBus/持久化（无第二状态系统）', () => {
    const src = fs.readFileSync(path.join(__dirname, '../companion.js'), 'utf8');
    assert.ok(!/new EventBus/.test(src), '含 new EventBus');
    assert.ok(!/localStorage/.test(src) && !/IndexedDB/.test(src), '引入了持久化存储');
    assert.ok(/global\.AppState|window\.AppState/.test(src), '未消费既有 AppState');
    assert.ok(/window\.ExecutionChannel|ExecutionChannel/.test(src), '未消费既有 ExecutionChannel');
  });

  console.log(`\nCOMPANION INTERACTION (Phase 8): ${fail === 0 ? 'PASS' : 'FAIL'}  (passed=${pass}, failed=${fail})`);
  process.exit(fail === 0 ? 0 : 1);
})();
