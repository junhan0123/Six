/*
 * phase6-order1.frontend.test.js — Phase 6 Order 1 前端状态基础设施验证
 * 运行：node tests/phase6-order1.frontend.test.js
 * 验证项：A 事件链 / B Goal 生命周期 / C 旧系统兼容（预留事件不破坏）
 * 不依赖浏览器 / Three.js / 网络（纯状态机单测）。
 */
'use strict';
const assert = require('assert');
const path = require('path');

// 加载顺序即浏览器中的 script 顺序：事件名 → 状态核心 → 银河数据层 → 桥接
const ZZ = require(path.join(__dirname, '../zz-events.js'));
const AppState = require(path.join(__dirname, '../app-state.js'));
const GalaxyState = require(path.join(__dirname, '../galaxy-state.js'));
const Bridge = require(path.join(__dirname, '../event-bridge.js'));

let pass = 0, fail = 0;
function check(name, fn) {
  try { fn(); console.log('  ✓ ' + name); pass++; }
  catch (e) { console.log('  ✗ ' + name + '\n      ' + e.message); fail++; }
}

console.log('\n[A] 事件链：GOAL_CREATED → STATE_SYNC → Frontend State → UI Observer');
check('GOAL_CREATED 经 SSE 信封被桥接并写入 AppState', () => {
  let fired = false;
  AppState.subscribe('GOAL_CREATED', () => { fired = true; });
  const envelope = JSON.stringify({
    zhuangzhou_event: 'GOAL_CREATED',
    payload: { goalId: 'g1', title: '写周报', priority: 'high', timeline: 'today', workspaceId: 'ws1' },
    ts: 123
  });
  Bridge.ingest(envelope);
  assert.ok(fired, 'GOAL_CREATED 观察者未触发');
  assert.ok(AppState.getGoal('g1'), 'Goal 未进入状态核心');
  assert.strictEqual(AppState.getGoal('g1').status, 'Created');
});
check('STATE_SYNC 把快照合并进统一状态并通知观察者', () => {
  let fired = false;
  AppState.subscribe('STATE_SYNC', () => { fired = true; });
  const snap = JSON.stringify({
    zhuangzhou_event: 'STATE_SYNC',
    payload: { goals: { g1: { id: 'g1', title: '写周报', status: 'Running' } }, focus: { capability: 'goal', id: 'g1' } },
    ts: 124
  });
  Bridge.ingest(snap);
  assert.ok(fired, 'STATE_SYNC 观察者未触发');
  assert.strictEqual(AppState.getGoal('g1').status, 'Running', '快照未合并');
  assert.strictEqual(AppState.state.focus.id, 'g1');
});
check('非合约事件名被拒绝（单一来源纪律）', () => {
  const before = Object.keys(AppState.state.goals).length;
  Bridge.ingest(JSON.stringify({ zhuangzhou_event: 'GOAL_MADE_UP', payload: {}, ts: 1 }));
  assert.strictEqual(Object.keys(AppState.state.goals).length, before, '非法事件不应写入状态');
});

console.log('\n[B] Goal 生命周期：Created → Visible → Running → Completed → Stored');
check('Created(Dormant) → Agent 启动(Running) → Task 运行 → Task 完成 → Memory 沉淀', () => {
  AppState.applyEvent('GOAL_CREATED', { goalId: 'g2', title: '调研竞品', priority: 'normal', workspaceId: 'ws1' });
  assert.strictEqual(AppState.getGoal('g2').status, 'Created');            // Created
  assert.ok(GalaxyState.getNode('goal:g2'), '银河节点未生成(Visible)');     // Visible（节点投影出现）

  AppState.applyEvent('AGENT_CREATED', { agentId: 'a1', goalId: 'g2', name: '研究员', type: 'researcher' });
  AppState.applyEvent('AGENT_STARTED', { agentId: 'a1', goalId: 'g2', name: '研究员', type: 'researcher', runId: 'r1' });
  AppState.applyEvent('TASK_CREATED', { taskId: 't1', goalId: 'g2', agentId: 'a1', title: '调研子任务' });
  AppState.applyEvent('TASK_RUNNING', { taskId: 't1', goalId: 'g2', agentId: 'a1', progress: 40 });
  assert.strictEqual(AppState.getAgent('a1').status, 'Started');          // Started（Agent 生命周期：Created->Started->...）
  assert.strictEqual(AppState.getTask('t1').status, 'Running');
  assert.strictEqual(GalaxyState.getNode('agent:a1').state, 'Started');
  assert.strictEqual(GalaxyState.getNode('task:t1').state, 'Running');

  AppState.applyEvent('TASK_COMPLETED', { taskId: 't1' });
  assert.strictEqual(AppState.getTask('t1').status, 'Completed');          // Completed
  assert.strictEqual(GalaxyState.getNode('task:t1').state, 'Completed');

  AppState.applyEvent('MEMORY_UPDATED', { memoryId: 'm1', scope: 'workspace', kind: 'write' });
  assert.ok(AppState.state.memory.m1, '记忆未沉淀(Stored)');               // Stored（落库信号）
  assert.strictEqual(GalaxyState.getNode('memory:m1').state, 'updated');

  // 全链节点存在且状态词一致（交互 §5.2）
  const n = GalaxyState.getNodes();
  assert.ok(n.find(x => x.id === 'goal:g2' && x.type === 'goal'));
  assert.ok(n.find(x => x.id === 'agent:a1' && x.state === 'Started'));
  assert.ok(n.find(x => x.id === 'task:t1' && x.state === 'Completed'));
});

console.log('\n[C] 旧系统兼容：预留事件 / 错误事件不破坏状态核心');
check('预留事件（TOOL_CALLED 等本阶段未实现 handler）安全忽略，不抛错', () => {
  assert.doesNotThrow(() => {
    AppState.applyEvent('TOOL_CALLED', { toolId: 'x', agentId: 'a1', goalId: 'g2' });
    AppState.applyEvent('FOCUS_CHANGED', { capability: 'goal', id: 'g2' });
    AppState.applyEvent('WORKSPACE_SWITCHED', { workspaceId: 'ws1' });
  });
});
check('ERROR_OCCURRED 进入执行态且生成 error 节点（无黑盒）', () => {
  AppState.applyEvent('ERROR_OCCURRED', { sourceType: 'agent', sourceId: 'a1', message: 'timeout', severity: 'error' });
  assert.strictEqual(AppState.state.execution.errors.length, 1);
  assert.ok(GalaxyState.getNode('error:a1'), '错误未可视化');
});
check('事件名单一来源：ZZ_EVENTS 含 64 个合约名且无同义', () => {
  const names = ZZ.names();
  assert.strictEqual(names.length, 71, '合约事件=71（Order6 38 + Intent 6 + Phase7 Order1 19 + Phase7 Order2 7 + Phase7 Order3 2 + Phase8 Order1 2）');
  assert.ok(ZZ.isEvent('GOAL_CREATED') && ZZ.isEvent('STATE_SYNC') && ZZ.isEvent('TASK_COMPLETED'));
  assert.ok(ZZ.isEvent('AGENT_CREATED') && ZZ.isEvent('TASK_CREATED') && ZZ.isEvent('AGENT_WAITING'));
  assert.ok(!ZZ.isEvent('goal_created'), '不应存在同义小写事件名');
});

console.log('\n──────── 结果 ────────');
console.log('  PASS: ' + pass + '   FAIL: ' + fail);
process.exit(fail === 0 ? 0 : 1);
