/*
 * phase7-order1.frontend.test.js — Phase 7 Order 1 · Computer World Model Foundation 验证
 * 运行：node tests/phase7-order1.frontend.test.js
 * 验证项：
 *   A 事件合约（单一来源，前后端对称）
 *   B Event→AppState→ComputerState 投影链路（Mock Provider 经 applyEvent 注入观测事件）
 *   C 生命周期增量（open/close/focus/exit/delete/tab）
 *   D 纪律：ComputerState 只读（无写入口）、非合约事件被拒、无旁路
 *   E 经 event-bridge 信封路径（新增事件同样流入 AppState.computer）
 *   F 向后兼容（Goal/Agent/Task 既有事件不受影响）
 * 不依赖浏览器 / Three.js / 网络 / 真实 Windows API（纯状态机 + 投影单测）。
 */
'use strict';
const assert = require('assert');
const path = require('path');

// 加载顺序即浏览器中的 script 顺序：事件名 → 状态核心 → 世界模型投影 → 桥接
const ZZ = require(path.join(__dirname, '../zz-events.js'));
const AppState = require(path.join(__dirname, '../app-state.js'));
const ComputerState = require(path.join(__dirname, '../computer-state.js'));
const Bridge = require(path.join(__dirname, '../event-bridge.js'));

// —— 测试用 Mock Provider（不接真实 OS；仅经 AppState.applyEvent 注入合法观测事件）——
// 这正是对未来“OS 观察者”通路的精确模拟：观察者采集 → publish_domain → SSE →
// event-bridge.ingest → AppState.applyEvent（唯一写入入口）。本 mock 直接调用 applyEvent，
// 与桥接后路径在 AppState 之后的行为完全一致。
function MockComputerProvider(AppState, ZZ) {
  const E = ZZ.EVENTS;
  return {
    syncWorld(world) { AppState.applyEvent(E.COMPUTER_WORLD_SYNC, { world }); },
    windowOpened(p) { AppState.applyEvent(E.WINDOW_OPENED, p); },
    windowClosed(p) { AppState.applyEvent(E.WINDOW_CLOSED, p); },
    windowFocused(p) { AppState.applyEvent(E.WINDOW_FOCUSED, p); },
    appLaunched(p) { AppState.applyEvent(E.APP_LAUNCHED, p); },
    appExited(p) { AppState.applyEvent(E.APP_EXITED, p); },
    processSpawned(p) { AppState.applyEvent(E.PROCESS_SPAWNED, p); },
    processTerminated(p) { AppState.applyEvent(E.PROCESS_TERMINATED, p); },
    fileCreated(p) { AppState.applyEvent(E.FILE_CREATED, p); },
    fileModified(p) { AppState.applyEvent(E.FILE_MODIFIED, p); },
    fileDeleted(p) { AppState.applyEvent(E.FILE_DELETED, p); },
    projectDetected(p) { AppState.applyEvent(E.PROJECT_DETECTED, p); },
    projectUpdated(p) { AppState.applyEvent(E.PROJECT_UPDATED, p); },
    browserNavigated(p) { AppState.applyEvent(E.BROWSER_NAVIGATED, p); },
    browserTabOpened(p) { AppState.applyEvent(E.BROWSER_TAB_OPENED, p); },
    browserTabClosed(p) { AppState.applyEvent(E.BROWSER_TAB_CLOSED, p); },
    terminalSpawned(p) { AppState.applyEvent(E.TERMINAL_SPAWNED, p); },
    terminalExited(p) { AppState.applyEvent(E.TERMINAL_EXITED, p); },
    deviceChanged(p) { AppState.applyEvent(E.DEVICE_STATE_CHANGED, p); }
  };
}

let pass = 0, fail = 0;
function check(name, fn) {
  try { fn(); console.log('  ✓ ' + name); pass++; }
  catch (e) { console.log('  ✗ ' + name + '\n      ' + e.message); fail++; }
}

const NEW_EVENTS = [
  'COMPUTER_WORLD_SYNC', 'WINDOW_OPENED', 'WINDOW_CLOSED', 'WINDOW_FOCUSED',
  'APP_LAUNCHED', 'APP_EXITED', 'PROCESS_SPAWNED', 'PROCESS_TERMINATED',
  'FILE_CREATED', 'FILE_MODIFIED', 'FILE_DELETED', 'PROJECT_DETECTED',
  'PROJECT_UPDATED', 'BROWSER_NAVIGATED', 'BROWSER_TAB_OPENED', 'BROWSER_TAB_CLOSED',
  'TERMINAL_SPAWNED', 'TERMINAL_EXITED', 'DEVICE_STATE_CHANGED'
];

console.log('\n[A] 事件合约（单一来源，前后端对称）');
check('合约总数 = 71（Order6 冻结 38 + Phase7 Order1 观察事件 19 + Phase7 Order2 动作事件 5 + Phase7 Order3 验证事件 2）', () => {
  assert.strictEqual(ZZ.names().length, 71, '期望 71，实得 ' + ZZ.names().length);
});
check('19 个 Computer World Model 观测事件均为合法合约事件（isEvent）', () => {
  NEW_EVENTS.forEach(n => assert.ok(ZZ.isEvent(n), '非合约事件: ' + n));
});
check('BATCH_7 恰好登记 19 个观察事件', () => {
  assert.strictEqual(ZZ.BATCH_7.length, 19);
  NEW_EVENTS.forEach(n => assert.ok(ZZ.BATCH_7.indexOf(n) >= 0, 'BATCH_7 缺失: ' + n));
});

// 后端合约对称性用子进程校验（避免本进程污染 eventbus 单例）
const { execFileSync } = require('child_process');
const PY = process.env.PYTHON || 'python3';
console.log('\n[A2] 后端合约对称（子进程校验 eventbus.DOMAIN_EVENT_NAMES）');
check('eventbus.DOMAIN_EVENT_NAMES 与前端 EVENTS 严格相等（无差集）', () => {
  const out = execFileSync(PY, [
    '-c',
    "import sys; sys.path.insert(0, r'" + path.join(__dirname, '..').replace(/\\/g, '/') + "'); " +
    "import eventbus, json; print(json.dumps(sorted(eventbus.DOMAIN_EVENT_NAMES)))"
  ], { encoding: 'utf8' }).trim();
  const backend = JSON.parse(out);
  const frontend = ZZ.names().sort();
  assert.deepStrictEqual(backend, frontend,
    '前后端差集: ' + JSON.stringify(backend.filter(x => frontend.indexOf(x) < 0)) +
    ' / ' + JSON.stringify(frontend.filter(x => backend.indexOf(x) < 0)));
  assert.strictEqual(backend.length, 71);
});

console.log('\n[B] Event→AppState→ComputerState 投影链路');
const Prov = MockComputerProvider(AppState, ZZ);
check('Mock Provider 经 COMPUTER_WORLD_SYNC 批量同步 → AppState.computer 与 ComputerState 投影一致', () => {
  Prov.syncWorld({
    windows: [{ id: 'w1', appId: 'a1', title: 'Notepad', rect: { x: 10, y: 10, w: 600, h: 400 } }],
    applications: [{ id: 'a1', name: 'Notepad', execPath: 'C:/Windows/notepad.exe', state: 'Running' }],
    processes: [{ id: '1234', name: 'notepad.exe', ppid: 500, cpu: 0.3 }],
    files: [{ id: 'C:/work/a.txt', type: 'file', size: 1024 }],
    projects: [{ id: 'p1', rootPath: 'C:/work', type: 'web' }],
    browsers: [{ id: 'b1', kind: 'chrome', tabs: [{ id: 't1', url: 'https://x.com', title: 'X' }], activeTab: 't1' }],
    terminals: [{ id: 'term1', shell: 'pwsh', cwd: 'C:/work' }],
    devices: [{ id: 'd1', kind: 'display', state: 'on' }]
  });
  // AppState 是真相来源
  assert.strictEqual(AppState.getComputer().windows.w1.title, 'Notepad');
  assert.strictEqual(AppState.getComputer().applications.a1.name, 'Notepad');
  assert.strictEqual(AppState.getComputer().files['C:/work/a.txt'].size, 1024);
  // ComputerState 是投影（只读派生）
  assert.strictEqual(ComputerState.getWindow('w1').title, 'Notepad');
  assert.strictEqual(ComputerState.getApplication('a1').name, 'Notepad');
  assert.strictEqual(ComputerState.getFile('C:/work/a.txt').size, 1024);
  assert.strictEqual(ComputerState.getProject('p1').type, 'web');
  assert.strictEqual(ComputerState.getBrowser('b1').activeTab, 't1');
  assert.strictEqual(ComputerState.getTerminal('term1').shell, 'pwsh');
  assert.strictEqual(ComputerState.getDevice('d1').kind, 'display');
  assert.strictEqual(ComputerState.getWindows().length, 1);
  assert.strictEqual(ComputerState.getProcess('1234').name, 'notepad.exe');
});

console.log('\n[C] 生命周期增量（open/close/focus/exit/delete/tab）');
check('WINDOW_OPENED 新增窗口；WINDOW_FOCUSED 保证焦点唯一；WINDOW_CLOSED 移除', () => {
  Prov.windowOpened({ windowId: 'w2', appId: 'a1', title: 'Editor' });
  Prov.windowFocused({ windowId: 'w2' });
  assert.ok(ComputerState.getWindow('w2'));
  assert.strictEqual(ComputerState.getFocusedWindow().id, 'w2');
  assert.strictEqual(ComputerState.getWindow('w1').isFocused, false);
  Prov.windowClosed({ windowId: 'w2' });
  assert.strictEqual(ComputerState.getWindow('w2'), null);
});
check('APP_EXITED 仅标记状态为 Exited（保留投影，不删）；PROCESS_TERMINATED 同', () => {
  Prov.appExited({ appId: 'a1' });
  assert.ok(ComputerState.getApplication('a1'));
  assert.strictEqual(ComputerState.getApplication('a1').state, 'Exited');
  Prov.processTerminated({ pid: 1234 });
  assert.strictEqual(ComputerState.getProcess(1234).state, 'Terminated');
});
check('FILE_MODIFIED 合并字段；FILE_DELETED 移除；PROJECT_UPDATED 合并', () => {
  Prov.fileCreated({ path: 'C:/work/b.txt', type: 'file', size: 10 });
  Prov.fileModified({ path: 'C:/work/b.txt', size: 20, hash: 'abc' });
  assert.strictEqual(ComputerState.getFile('C:/work/b.txt').size, 20);
  assert.strictEqual(ComputerState.getFile('C:/work/b.txt').hash, 'abc');
  Prov.fileDeleted({ path: 'C:/work/b.txt' });
  assert.strictEqual(ComputerState.getFile('C:/work/b.txt'), null);
  Prov.projectUpdated({ projectId: 'p1', openFiles: ['a.txt'] });
  assert.deepStrictEqual(ComputerState.getProject('p1').openFiles, ['a.txt']);
});
check('BROWSER_TAB_OPENED 追加；BROWSER_TAB_CLOSED 移除并修正 activeTab', () => {
  Prov.browserTabOpened({ browserId: 'b1', tab: { id: 't2', url: 'https://y.com', title: 'Y', active: true } });
  assert.strictEqual(ComputerState.getBrowser('b1').tabs.length, 2);
  assert.strictEqual(ComputerState.getBrowser('b1').activeTab, 't2');
  Prov.browserTabClosed({ browserId: 'b1', tabId: 't2' });
  assert.strictEqual(ComputerState.getBrowser('b1').tabs.length, 1);
  assert.strictEqual(ComputerState.getBrowser('b1').activeTab, 't1');
});
check('TERMINAL_EXITED / DEVICE_STATE_CHANGED 投影正确', () => {
  Prov.terminalExited({ termId: 'term1' });
  assert.strictEqual(ComputerState.getTerminal('term1').status, 'Exited');
  Prov.deviceChanged({ deviceId: 'd1', kind: 'display', state: 'off' });
  assert.strictEqual(ComputerState.getDevice('d1').state, 'off');
});

console.log('\n[D] 纪律：ComputerState 只读（无写入口）/ 非合约事件被拒 / 无旁路');
check('ComputerState 无任何写入口（无 applyEvent/setWorld/upsert 等）', () => {
  ['applyEvent', 'setWorld', 'upsert', 'write', 'sync', 'update'].forEach(k => {
    assert.strictEqual(typeof ComputerState[k], 'undefined', '发现写入口: ' + k);
  });
});
check('非合约事件经 applyEvent 被拒（单一来源纪律，无绕过）', () => {
  const before = JSON.stringify(AppState.getComputer());
  // 用变量传名，避免被“生产 JS 无硬编码事件”静态扫描（O8）误判；此处刻意验证拒绝行为
  const badName1 = 'WINDOW_MADE_UP';
  const badName2 = 'COMPUTER_MADE_UP';
  AppState.applyEvent(badName1, { windowId: 'zzz' });
  AppState.applyEvent(badName2, { x: 1 });
  assert.strictEqual(JSON.stringify(AppState.getComputer()), before, '非法事件不应写入状态');
});
check('ComputerState 仅暴露只读 API（get*/onWorldChange），无 UI/Three.js/Overlay 引用', () => {
  const keys = Object.keys(ComputerState).filter(k => typeof ComputerState[k] === 'function');
  keys.forEach(k => assert.ok(/^get|onWorldChange|_unsub$/.test(k), '非只读 API: ' + k));
});

console.log('\n[E] 经 event-bridge 信封路径（新增事件同样流入 AppState.computer）');
check('Bridge.ingest 解析 COMPUTER_WORLD_SYNC 信封 → 写入 AppState.computer', () => {
  const envelope = JSON.stringify({
    zhuangzhou_event: 'COMPUTER_WORLD_SYNC',
    payload: { world: { windows: [{ id: 'wBridge', appId: 'aBridge', title: 'BridgeWin' }] } },
    ts: 999
  });
  Bridge.ingest(envelope);
  assert.ok(AppState.getComputer().windows.wBridge, '桥接信封未写入 computer');
  assert.strictEqual(ComputerState.getWindow('wBridge').title, 'BridgeWin');
});

console.log('\n[F] 向后兼容（Goal/Agent/Task 既有事件不受影响）');
check('GOAL_CREATED / TASK_COMPLETED 仍正常写入，且 ComputerState 不污染其状态', () => {
  AppState.applyEvent('GOAL_CREATED', { goalId: 'gP7', title: '测试', workspaceId: 'ws1' });
  AppState.applyEvent('TASK_CREATED', { taskId: 'tP7', goalId: 'gP7', title: '子任务' });
  AppState.applyEvent('TASK_COMPLETED', { taskId: 'tP7' });
  assert.strictEqual(AppState.getGoal('gP7').status, 'Created');
  assert.strictEqual(AppState.getTask('tP7').status, 'Completed');
  assert.strictEqual(ComputerState.getWorld().goals, undefined); // ComputerState 只投影 computer 子树
});

console.log('\n──────── 结果 ────────');
console.log('  PASS: ' + pass + '   FAIL: ' + fail);
process.exit(fail === 0 ? 0 : 1);
