/*
 * avatar-state.js — Phase 7 Desktop Companion · 庄周(Avatar)状态派生
 * ----------------------------------------------------------------------------
 * 职责：把已有 AppState + ExecutionChannel 投影为 Avatar 渲染状态（单一来源，无副本）。
 *
 * 纪律（最高约束）：
 *   - 本模块【不持有任何状态】：无任何 module-level 可变状态，仅消费输入并输出 render state。
 *   - 不新建 EventBus / State System / Runtime / Memory。
 *   - 完全复用既有 AppState（统一状态核心）与 ExecutionChannel（执行通道）。
 *   - 仅提供纯函数 derive()，相同输入恒得相同输出；可作为 Presentation Layer 的安全投影。
 *
 * 状态优先级：OFFLINE > ERROR > EXECUTING > THINKING > PLANNING > WAITING > COMPLETED > IDLE
 */
(function (global) {
  'use strict';

  // 唯一状态权威（AvatarState 是单一来源，禁止任何模块另立一份 STATES/META）。
  // Phase 25 扩展：纳入 LISTENING / SPEAKING（语音交互态）与 LEARNING / WARNING（成长/告警态），
  // 使 AvatarState 完整覆盖「AI 状态 → Avatar 状态」所需全部规范态。
  //   派生优先级不变；LISTENING/SPEAKING/LEARNING/WARNING 由 Avatar Controller 经语音/学习信号注入，
  //   derive() 自身不产出这些态（保持纯函数、无副作用）。
  // REMIND 不在此列——它是 Companion 通知子类型，非 Presence 主态。
  var STATES = [
    'IDLE', 'LISTENING', 'WAITING', 'THINKING', 'PLANNING',
    'EXECUTING', 'SPEAKING', 'LEARNING', 'COMPLETED', 'WARNING',
    'ERROR', 'OFFLINE'
  ];

  // 状态呈现元信息（仅展示用，非业务逻辑；色彩令牌与前端主题对齐）
  // 权威色唯一来源：所有消费方（Voice Orb / AI Core / Consciousness Core / Avatar Controller）均只读此处。
  var META = {
    IDLE:      { label: '待命',     color: '#5fb3c8' },
    LISTENING: { label: '聆听中',   color: '#5fd3e0' },
    WAITING:   { label: '等待指令', color: '#f0b35e' },
    THINKING:  { label: '思考中',   color: '#8b9bff' },
    PLANNING:  { label: '规划中',   color: '#c08bff' },
    EXECUTING: { label: '执行中',   color: '#56d364' },
    SPEAKING:  { label: '回应中',   color: '#2dd4bf' },
    LEARNING:  { label: '学习中',   color: '#5fd0e0' },
    COMPLETED: { label: '已完成',   color: '#56d3a0' },
    WARNING:   { label: '注意',     color: '#ffa94d' },
    ERROR:     { label: '异常',     color: '#ff6b6b' },
    OFFLINE:   { label: '离线',     color: '#8a93a6' },
  };

  function _result(state, context) {
    var m = META[state] || META.IDLE;
    return {
      state: state,
      label: m.label,
      color: m.color,
      context: context || {},
    };
  }

  function _progress(steps) {
    if (!steps || !steps.length) return 0;
    var done = 0;
    for (var i = 0; i < steps.length; i++) if (steps[i].status === 'completed') done++;
    return Math.round((done / steps.length) * 100);
  }

  // 在对象集合中查找第一个匹配 status 的成员（无状态存储，纯遍历）
  function _anyWithStatus(collection, status) {
    if (!collection) return null;
    for (var id in collection) {
      if (collection[id] && collection[id].status === status) return collection[id];
    }
    return null;
  }

  /**
   * 纯函数派生 Avatar 状态。
   * @param {object} appState      AppState.getState() 的快照（单一来源）
   * @param {object} execSnapshot  ExecutionChannel.getSnapshot()（{current, history}）
   * @param {object} [meta]        { online:boolean, now:number, recencyMs:number }
   * @returns {{state,label,color,context}}
   */
  function derive(appState, execSnapshot, meta) {
    meta = meta || {};
    var online = meta.online !== false; // 默认在线
    var nowTs = (typeof meta.now === 'number') ? meta.now : Date.now();
    var recencyMs = (typeof meta.recencyMs === 'number') ? meta.recencyMs : 8000;

    // 1) OFFLINE：SSE / 后端不可达
    if (!online) {
      return _result('OFFLINE', { reason: 'backend-unreachable' });
    }

    var exec = (execSnapshot && execSnapshot.current) ? execSnapshot.current : null;
    var execSteps = exec ? (exec.steps || []) : [];
    var execRunning = !!(exec && exec.status === 'running');
    var execRunningStep = null;
    for (var i = 0; i < execSteps.length; i++) {
      if (execSteps[i].status === 'running') { execRunningStep = execSteps[i]; break; }
    }

    var agents = (appState && appState.agents) || {};
    var goals = (appState && appState.goals) || {};
    var intents = (appState && appState.intents) || {};
    var tasks = (appState && appState.tasks) || {};
    var execution = (appState && appState.execution) || { errors: [] };

    // 2) ERROR：近期错误 或 agent/task Failed
    var errors = execution.errors || [];
    var lastError = errors.length ? errors[errors.length - 1] : null;
    var errorRecent = !!(lastError && (nowTs - (lastError.ts || 0)) < recencyMs);
    var agentFailed = _anyWithStatus(agents, 'Failed');
    var taskFailed = _anyWithStatus(tasks, 'Failed');
    if (errorRecent || agentFailed || taskFailed) {
      var src = agentFailed ? ('agent:' + agentFailed.id)
        : (taskFailed ? ('task:' + taskFailed.id) : 'system');
      var msg = lastError ? (lastError.message || '') : (agentFailed ? 'agent-failed' : 'task-failed');
      return _result('ERROR', { error: msg, source: src });
    }

    // 3) EXECUTING：执行通道进行中 或 agent Working
    if (execRunning || execRunningStep || _anyWithStatus(agents, 'Working')) {
      return _result('EXECUTING', {
        prompt: exec ? (exec.prompt || '') : '',
        tool: execRunningStep ? (execRunningStep.label || execRunningStep.tool) : null,
        progress: _progress(execSteps),
      });
    }

    // 4) THINKING：agent Thinking
    var thinking = _anyWithStatus(agents, 'Thinking');
    if (thinking) return _result('THINKING', { agentId: thinking.id });

    // 5) PLANNING：intent 分析中/已分类/已接收/已接受，或 goal 进行中，或 agent Started
    var planContext = {};
    var planning = false;
    for (var iid in intents) {
      var it = intents[iid];
      if (it && ['Received', 'Analyzing', 'Classified', 'Accepted'].indexOf(it.status) >= 0) {
        planning = true; planContext.intent = it.title || it.text || iid; break;
      }
    }
    if (!planning) {
      for (var gid in goals) {
        var g = goals[gid];
        if (g && ['Started', 'Running'].indexOf(g.status) >= 0) {
          planning = true; planContext.goal = g.title || gid; break;
        }
      }
    }
    if (!planning && _anyWithStatus(agents, 'Started')) planning = true;
    if (planning) return _result('PLANNING', planContext);

    // 6) WAITING：agent Waiting 或 有待确认 intent
    var waiting = _anyWithStatus(agents, 'Waiting');
    if (!waiting) {
      for (var wid in intents) {
        var w = intents[wid];
        if (w && w.status === 'Accepted' && w.needsConfirm) { waiting = true; break; }
      }
    }
    if (waiting) return _result('WAITING', {});

    // 7) COMPLETED：近期完成的执行（短时展示）
    if (exec && exec.status === 'completed') {
      var completedAt = exec.completedAt || 0;
      if (nowTs - completedAt < recencyMs) {
        return _result('COMPLETED', { prompt: exec.prompt || '' });
      }
    }

    // 8) IDLE
    return _result('IDLE', {});
  }

  // 便捷入口：直接从既有全局派生（不改变任何状态，仅读取）
  function deriveFromGlobals(meta) {
    var AppState = global.AppState;
    var ExecutionChannel = global.ExecutionChannel;
    var ZZSSE = global.ZZSSE;
    var appState = (AppState && AppState.getState) ? AppState.getState() : {};
    // 注意：ExecutionChannel.getSnapshot() 是私有函数；公开 API 为 getCurrent()/getExecutions()
    var execSnap = { current: null, history: [] };
    if (ExecutionChannel && ExecutionChannel.getCurrent) {
      execSnap.current = ExecutionChannel.getCurrent();
      execSnap.history = (typeof ExecutionChannel.getExecutions === 'function') ? ExecutionChannel.getExecutions() : [];
    }
    var online = true;
    if (ZZSSE && typeof ZZSSE.getState === 'function') online = ZZSSE.getState() === 'open';
    var m = {};
    if (meta) for (var k in meta) m[k] = meta[k];
    m.online = online;
    return derive(appState, execSnap, m);
  }

  function label(state) { return (META[state] || META.IDLE).label; }
  function color(state) { return (META[state] || META.IDLE).color; }

  var API = {
    STATES: STATES,
    META: META,
    derive: derive,
    deriveFromGlobals: deriveFromGlobals,
    label: label,
    color: color,
  };

  global.AvatarState = API;
  if (typeof module !== 'undefined' && module.exports) module.exports = API;
})(typeof window !== 'undefined' ? window : globalThis);
