@echo off
chcp 65001 >nul
cd /d "G:\ZhuangZhou\zhuangzhou-ui"

:: 优先使用已装好依赖的 python（isolated venv 优先，否则退回系统 python）
set "VENV_PY=%USERPROFILE%\.workbuddy\binaries\python\envs\default\Scripts\python.exe"
if exist "%VENV_PY%" (set "PY=%VENV_PY%") else (set "PY=python")

:: 检查 8010 端口是否已有 ZhuangZhou 核心在跑
echo 检查 ZhuangZhou 核心状态...
"%PY%" -c "import socket; s=socket.socket(); s.settimeout(0.5); s.connect(('127.0.0.1',8010)); print('RUNNING')" >nul 2>&1
if %errorlevel%==0 (
    echo 核心已在运行，直接打开庄周桌面分身...
    goto launch_desktop
)

echo 正在启动 ZhuangZhou 指挥核心...
start "ZhuangZhou Core" "%PY%" server.py

:: 等待核心启动（最多 10 秒）
for /L %%i in (1,1,20) do (
    "%PY%" -c "import socket; s=socket.socket(); s.settimeout(0.5); s.connect(('127.0.0.1',8010))" >nul 2>&1
    if %errorlevel%==0 goto launch_desktop
    timeout /t 0.5 /nobreak >nul
)

echo 启动超时，请检查 python 是否可用。
pause
exit /b

:launch_desktop
echo 核心已就绪，正在打开庄周桌面分身（PNG 序列帧桌宠）...
:: 关键：清除会破坏 Electron 启动的环境变量（本机 agent 环境曾预设）
set "ELECTRON_RUN_AS_NODE="
set "NODE_OPTIONS="

set "ELECTRON=G:\ZhuangZhou\zhuangzhou-ui\launcher\electron-bin\electron.exe"
if not exist "%ELECTRON%" (
    echo 未找到 Electron 运行时，改开浏览器桌面页...
    start "" "http://localhost:8010/zz-space/index.html"
    exit /b
)

:: 启动 Electron 桌面分身（加载 canonical Voice Orb: desktop-avatar/dyna-orb.html）
:: 若已有一个分身窗口在跑，则不再重复拉起
tasklist 2>nul | find /i "electron.exe" >nul
if %errorlevel%==0 (
    echo 桌面分身已在运行，直接打开聊天界面...
    goto open_chat
)
start "" "%ELECTRON%" . --disable-gpu-sandbox

:open_chat
:: 打开主干聊天界面（已移除太阳系背景；含文本对话 / 能力 / 记忆入口）
:: 桌宠为可视化状态伴侣，对话与能力操作在主干界面进行。
start "" "http://localhost:8010/zz-space/index.html"
exit /b
