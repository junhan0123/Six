/*
 * event-bridge.js — 小6 Phase 6 · 后端→前端 桥接（解决 R1：UI-Runtime 断裂）
 * ----------------------------------------------------------------------------
 * 链路：Backend Event → Transport Layer(/api/stream SSE) → Frontend Event Bus(zz:sse) → App State
 * 职责：
 *   - 订阅 sse-manager.js 扇出的 zz:sse 消息（统一重连/状态广播已由 sse-manager 负责）。
 *   - 解析合约信封 {"zhuangzhou_event": <NAME>, "payload": {...}, "ts": ...}，
 *     仅接受 ZZ_EVENTS 白名单内的事件名（单一来源纪律，拒绝同义/未知事件）。
 *   - 调 AppState.applyEvent 写入统一状态核心。UI 永不直接读后端内部数据（readiness §4 R1）。
 * 设计依据：readiness §2.2（Event Bus=单一状态源传输）/ §4（回流纪律）/ §5.2（事件纪律）。
 * 注意：本文件不新建传输连接（复用既有 /api/stream），只做“信封→状态”的桥接。
 */
(function (global) {
  'use strict';
  var AppState = global.AppState;
  var ZZ = global.ZZ_EVENTS;

  function ingest(raw) {
    var msg;
    try {
      msg = (typeof raw === 'string') ? JSON.parse(raw) : raw;
    } catch (e) {
      return; // 心跳/注释/非法帧忽略
    }
    if (!msg || typeof msg !== 'object') return;
    var name = msg.zhuangzhou_event || msg.event || null;
    if (!name || !ZZ || !ZZ.isEvent(name)) return; // 仅接受合约事件名
    AppState.applyEvent(name, msg.payload || {});
  }

  function start() {
    // 优先复用既有 SSE 单例（sse-manager.js 已先行加载并连接）
    if (global.ZZSSE && typeof global.ZZSSE.onMessage === 'function') {
      global.ZZSSE.onMessage(ingest);
      return;
    }
    // 兜底：若 sse-manager 未加载，则自建连接（保持桥接可用）
    if (typeof EventSource !== 'undefined') {
      try {
        var es = new EventSource('/api/stream');
        es.onmessage = function (ev) { if (ev && ev.data) ingest(ev.data); };
      } catch (e) { /* 连接失败由上层状态广播感知 */ }
    }
  }

  var API = { start: start, ingest: ingest };

  global.ZZEventBridge = API;
  if (typeof module !== 'undefined' && module.exports) module.exports = API;

  // 自动启动（sse-manager.js 已先加载，ZZSSE 存在）
  if (global.ZZSSE) start();
})(typeof window !== 'undefined' ? window : globalThis);
