{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZhuangZhou Identity Model v1.0",
  "description": "庄周身份与自我模型层的单一来源 schema。每个段落带 source/confidence/updated/status 以支持可信度治理与来源追踪。",
  "type": "object",
  "required": ["schema_version", "agent"],
  "properties": {
    "schema_version": { "type": "string" },
    "agent": {
      "type": "object",
      "required": ["name", "role", "self_statement"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "self_statement": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "enum": ["system_declared", "user_confirmed", "config", "project_state", "conversation", "inference"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "updated": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "legacy", "deprecated"] }
      }
    },
    "user_relationship": {
      "type": "object",
      "properties": {
        "user_role": { "type": "string" },
        "relationship": { "type": "string" },
        "address_as": { "type": "string" },
        "source": { "type": "string", "enum": ["system_declared", "user_confirmed", "config", "project_state", "conversation", "inference"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "updated": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "legacy", "deprecated"] }
      }
    },
    "project_understanding": {
      "type": "object",
      "properties": {
        "primary_project": { "type": "string" },
        "nature": { "type": "string" },
        "source": { "type": "string", "enum": ["system_declared", "user_confirmed", "config", "project_state", "conversation", "inference"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "updated": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "legacy", "deprecated"] }
      }
    },
    "behavior_style": {
      "type": "object",
      "properties": {
        "tone": { "type": "string" },
        "style": { "type": "string" },
        "boundaries": { "type": "array", "items": { "type": "string" } },
        "quirks": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string", "enum": ["system_declared", "user_confirmed", "config", "project_state", "conversation", "inference"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "updated": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "legacy", "deprecated"] }
      }
    },
    "long_term_objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["objective"],
        "properties": {
          "objective": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "enum": ["system_declared", "user_confirmed", "config", "project_state", "conversation", "inference"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "updated": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "legacy", "deprecated"] }
        }
      }
    }
  }
}
