.map-coord-muted{color:var(--dim2)}
.map-section-title{font-size:13px;letter-spacing:1px;color:var(--dim2);text-transform:uppercase;margin:6px 0 14px}
.map-chip-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px}
.map-chip{background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:var(--radius-md);padding:14px;transition:var(--motion-fast)}
.map-chip:hover{border-color:var(--line-strong);transform:translateY(-2px)}
.map-chip-name{font:600 15px/1.3 'Rajdhani',system-ui,sans-serif;color:var(--txt);margin-bottom:6px}
.map-chip-coord{font-family: var(--font-mono);font-size:12px;color:var(--cyan)}

/* 文档 */
.doc-body{flex:1;width:100%;max-width:1180px;margin:0 auto;overflow:auto;color:var(--dim)}
.doc-loading,.doc-empty{padding:40px;text-align:center;color:var(--dim);font-size:15px}
.doc-list-head{font-size:13px;letter-spacing:1px;color:var(--dim2);text-transform:uppercase;margin-bottom:12px}
.doc-list{display:flex;flex-direction:column;gap:10px}
.doc-row{display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:var(--radius-md);padding:14px 18px;cursor:pointer;transition:var(--motion-fast)}
.doc-row:hover{border-color:var(--line-strong);background:rgba(34,211,238,.08);transform:translateX(4px)}
.doc-row-main{flex:1;min-width:0}
.doc-row-name{font:600 16px/1.3 'Rajdhani',system-ui,sans-serif;color:var(--txt);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.doc-row-meta{display:flex;gap:14px;margin-top:6px;font-size:12px;color:var(--dim)}
.doc-ext{color:var(--cyan)}
.doc-row-go{color:var(--dim);font-size:22px}

/* ── Phase 35 · 知识库面板（know-*，复用 doc 视觉语言，独立类名避免与 doc-mode 冲突） ── */
.know-panel{position:fixed;inset:0;z-index:80;display:none;align-items:center;justify-content:center}
body.knowledge-mode .know-panel{display:flex}
.know-backdrop{position:absolute;inset:0;background:rgba(6,10,18,.55);backdrop-filter:blur(6px)}
.know-stage{position:relative;width:min(960px,92vw);height:min(78vh,720px);background:var(--panel,#0d1320cc);border:1px solid var(--line);border-radius:var(--radius-lg,18px);box-shadow:0 30px 80px rgba(0,0,0,.5);display:flex;flex-direction:column;overflow:hidden}
.know-bar{display:flex;align-items:center;gap:12px;padding:14px 18px;border-bottom:1px solid var(--line)}
.know-title{display:flex;align-items:center;gap:8px;font:700 18px/1 'Rajdhani',system-ui,sans-serif;color:var(--txt)}
.know-dot{width:8px;height:8px;border-radius:50%;background:#56d364;box-shadow:0 0 8px #56d364}
.know-meta{margin-left:6px;font-size:12px;color:var(--dim)}
.know-close{margin-left:auto;width:30px;height:30px;border:none;border-radius:8px;background:rgba(255,255,255,.1);color:var(--txt);cursor:pointer;display:flex;align-items:center;justify-content:center}
.know-close:hover{background:rgba(255,255,255,.2)}
.know-search-wrap{padding:10px 18px;border-bottom:1px solid var(--line)}
.know-search{width:100%;padding:9px 12px;border-radius:10px;border:1px solid var(--line);background:rgba(255,255,255,.04);color:var(--txt);font-size:14px;outline:none}
.know-search:focus{border-color:var(--line-strong)}
.know-body{flex:1;width:100%;max-width:1180px;margin:0 auto;overflow:auto;color:var(--dim);padding:18px}
.know-list-head{font-size:13px;color:var(--dim);margin-bottom:12px}
.know-row{display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:var(--radius-md,14px);padding:14px 18px;cursor:pointer;transition:var(--motion-fast,.2s)}
.know-row:hover{border-color:var(--line-strong);background:rgba(34,211,238,.08);transform:translateX(4px)}
.know-row-main{flex:1;min-width:0}
.know-row-name{font:600 16px/1.3 'Rajdhani',system-ui,sans-serif;color:var(--txt);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.know-row-meta{display:flex;gap:14px;margin-top:6px;font-size:12px;color:var(--dim)}
.know-type{color:#f0b35e}
.know-row-go{color:var(--dim);font-size:22px}
.know-empty,.know-loading{padding:30px;text-align:center;color:var(--dim);font-size:14px}

/* ── Phase 35 · P1-1 语音不可用：麦克风置灰态 ── */
#btnMic:disabled,#btnMic.mic-disabled{opacity:.4;cursor:not-allowed;filter:grayscale(1)}
.doc-read-head{margin-bottom:14px}
.doc-read-name{font:600 18px/1.3 'Rajdhani',system-ui,sans-serif;color:var(--txt)}
.doc-read-meta{margin-top:6px;font-size:12px;color:var(--dim)}
.doc-content{background:rgba(0,0,0,.28);border:1px solid var(--line);border-radius:var(--radius-md);padding:18px;
  font-family: var(--font-mono);font-size:13px;line-height:1.7;color:var(--txt);
  white-space:pre-wrap;word-break:break-word;max-height:calc(100vh - 220px);overflow:auto}

/* 记忆审查 */
.memory-body{flex:1;width:100%;max-width:1180px;margin:0 auto;overflow:auto;color:var(--dim)}
.mem-loading,.mem-empty{padding:40px;text-align:center;color:var(--dim);font-size:15px}
.mem-summary{display:flex;gap:18px;align-items:center;font-size:13px;color:var(--dim);margin-bottom:16px}
.mem-summary b{color:var(--teal);font-size:16px}
.mem-gen{color:var(--dim2)}
.mem-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.mem-card{background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:var(--radius-md);padding:18px;display:flex;flex-direction:column;gap:12px;transition:var(--motion-fast)}
.mem-card:hover{border-color:var(--line-strong)}
.mem-store-head{display:flex;align-items:center;justify-content:space-between;gap:12px}
.mem-store-name{font:600 17px/1.3 'Rajdhani',system-ui,sans-serif;color:var(--txt)}
.mem-store-count{font-size:13px;color:var(--dim)}
.mem-store-count b{color:var(--teal);font-size:18px}
.mem-samples{background:rgba(0,0,0,.25);border:1px solid var(--line);border-radius:var(--radius-sm);padding:10px 12px;max-height:160px;overflow:auto}
.mem-sample-empty{color:var(--dim2);font-size:13px}
.mem-sample-line{font-family: var(--font-mono);font-size:12px;color:var(--dim);line-height:1.6;white-space:pre-wrap;word-break:break-word}
.mem-sample-more{margin-top:6px;font-size:11px;color:var(--dim2)}
.mem-store-note{font-size:12px;color:var(--amber)}
.mem-prune{align-self:flex-start;padding:8px 16px;border-radius:var(--radius-sm);border:1px solid var(--line);background:rgba(255,255,255,.05);color:var(--dim);font-size:13px;cursor:pointer;transition:var(--motion-fast)}
.mem-prune:hover:not(:disabled){background:rgba(255,80,80,.16);border-color:rgba(255,80,80,.5);color:#fff}
.mem-prune:disabled{opacity:.5;cursor:default}
.mem-error{margin-bottom:14px;padding:10px 14px;border-radius:var(--radius-sm);background:rgba(255,80,80,.12);border:1px solid rgba(255,80,80,.4);color:#ffd5d5;font-size:13px}

/* 自我学习经验区块（记忆审查面板内） */
.mem-learn-wrap{margin-top:22px}
.learn-heading{font:600 15px/1.3 'Rajdhani',system-ui,sans-serif;color:var(--txt);margin-bottom:12px;letter-spacing:.5px}
.learn-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:14px}
.learn-card{background:rgba(45,212,191,.05);border:1px solid var(--line);border-radius:var(--radius-md);padding:14px 16px;display:flex;flex-direction:column;gap:10px;transition:var(--motion-fast)}
.learn-card:hover{border-color:rgba(45,212,191,.5)}
.learn-head{display:flex;align-items:center;gap:10px;font-size:12px}
.learn-tag{padding:2px 10px;border-radius:var(--radius-lg);font-size:11px;font-weight:600}
.learn-tag.l-fb{background:color-mix(in srgb, var(--accent) 16%, transparent);color:var(--cyan)}
.learn-tag.l-cr{background:rgba(255,80,80,.16);color:#ff9a9a}
.learn-tag.l-di{background:rgba(167,139,250,.16);color:#c4b5fd}
.learn-weight{color:var(--dim2)}
.learn-time{margin-left:auto;color:var(--dim2);font-family: var(--font-mono);font-size:11px}
.learn-content{font-size:14px;line-height:1.55;color:var(--txt);white-space:pre-wrap;word-break:break-word}
.learn-del{align-self:flex-start;padding:6px 14px;border-radius:var(--radius-sm);border:1px solid var(--line);background:rgba(255,255,255,.04);color:var(--dim);font-size:12px;cursor:pointer;transition:var(--motion-fast)}
.learn-del:hover:not(:disabled){background:rgba(255,80,80,.16);border-color:rgba(255,80,80,.5);color:#fff}

/* 审视分身 */
.review-body{flex:1;width:100%;max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:18px;overflow:hidden}
.review-col{display:flex;flex-direction:column;min-height:0;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:var(--radius-md);overflow:hidden}
.review-left{border-color:color-mix(in srgb, var(--accent) 35%, transparent)}
.review-right{border-color:color-mix(in srgb, var(--warn) 35%, transparent)}
.review-col-head{padding:14px 18px;font:600 15px/1.2 'Rajdhani',system-ui,sans-serif;letter-spacing:.4px;color:var(--cyan);border-bottom:1px solid var(--line);background:rgba(255,255,255,.03)}
.review-col-head-crit{color:var(--amber)}
.review-col-content{flex:1;padding:18px;overflow:auto;font-size:14px;line-height:1.8;color:var(--txt);white-space:pre-wrap;word-break:break-word}
@media (max-width: 980px){
  .review-body{grid-template-columns:1fr;overflow:auto}
  .review-col{min-height:240px}
}

/* KWS 语音唤醒指示 */
.kws-indicator{
  position:fixed;left:50%;bottom:96px;transform:translateX(-50%) translateY(8px);
  display:flex;align-items:center;gap:10px;padding:8px 16px;border-radius:var(--radius-pill);
  background:rgba(10,16,24,.6);border:1px solid var(--line);
  backdrop-filter: var(--glass-2);opacity:0;visibility:hidden;transition:var(--motion-base);z-index: var(--z-float);
  font:500 13px/1 'Rajdhani',system-ui,sans-serif;color:var(--dim);letter-spacing:.4px;
  pointer-events:none;
}
.kws-indicator.on{opacity:1;visibility:visible;transform:translateX(-50%) translateY(0)}
.kws-pulse{width:10px;height:10px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 0 rgba(34,211,238,.6);animation:kwsPulse 1.8s infinite}
@keyframes kwsPulse{
  0%{box-shadow:0 0 0 0 rgba(34,211,238,.55)}
  70%{box-shadow:0 0 0 12px rgba(34,211,238,0)}
  100%{box-shadow:0 0 0 0 rgba(34,211,238,0)}
}

/* 长期记忆查询（Phase 12 · P12-4） */
.memq-panel{position:fixed;inset:0;z-index: var(--z-overlay-raised);visibility:hidden;opacity:0;transition:opacity var(--motion-base) var(--ease-soft),visibility var(--motion-base)}
body.memq-mode .memq-panel{visibility:visible;opacity:1}
.memq-backdrop{position:absolute;inset:0;background:var(--ws-overlay-scrim);backdrop-filter: var(--glass-2)}
.memq-stage{position:absolute;inset:0;display:flex;flex-direction:column;gap:14px;padding:26px;
  background:linear-gradient(160deg,rgba(10,16,24,.72),rgba(6,10,16,.80))}
.memq-bar{display:flex;align-items:center;gap:12px;width:100%;max-width:1180px;margin:0 auto}
.memq-title{flex:1;min-width:0;font:600 16px/1.2 'Rajdhani',system-ui,sans-serif;letter-spacing:.4px;color:var(--txt);
  display:flex;align-items:center;gap:10px}
.memq-dot{width:10px;height:10px;border-radius:50%;background:var(--teal);box-shadow:0 0 10px var(--teal)}
.memq-close{flex:none;height:40px;min-width:40px;padding:0 12px;border-radius:var(--radius-md);border:1px solid var(--line);
  background:rgba(255,255,255,.06);color:var(--txt);font-size:16px;cursor:pointer;transition:var(--motion-fast);
  display:flex;align-items:center;justify-content:center}
.memq-close:hover{background:rgba(255,80,80,.18);border-color:rgba(255,80,80,.5);color:#fff;transform:rotate(90deg)}
.memq-search{display:flex;align-items:center;gap:10px;width:100%;max-width:1180px;margin:0 auto;
  background:var(--input-bg-soft);border:1px solid var(--input-border);border-radius:var(--radius-md);padding:8px 12px;
  transition:var(--motion-fast)}
.memq-search:focus-within{border-color:var(--teal);box-shadow:0 0 0 3px rgba(45,212,191,.12)}
.memq-caret{font-size:16px;opacity:.8}
.memq-input{flex:1;min-width:0;background:transparent;border:0;outline:none;color:var(--text);
  font-size:15px;font-family: var(--font-ui)}
.memq-input::placeholder{color:var(--input-placeholder)}
.memq-go{flex:none;height:36px;padding:0 18px;border-radius:var(--radius-sm);border:1px solid var(--teal);
  background:rgba(45,212,191,.14);color:#d6fff6;font-size:14px;cursor:pointer;transition:var(--motion-fast);
  font-family: var(--font-ui);font-weight:600}
.memq-go:hover{background:rgba(45,212,191,.26);color:#fff}
.memq-body{flex:1;width:100%;max-width:1180px;margin:0 auto;overflow:auto;color:var(--dim)}
.memq-hint{padding:48px 20px;text-align:center;color:var(--dim);font-size:15px;line-height:1.8}
.memq-loading,.memq-empty{padding:48px 20px;text-align:center;color:var(--dim);font-size:15px;line-height:1.8}
.memq-summary{display:flex;gap:12px;align-items:center;font-size:13px;color:var(--dim);margin-bottom:16px}
.memq-summary b{color:var(--teal);font-size:16px}
.memq-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px}
.memq-card{background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:var(--radius-md);padding:16px 18px;
  display:flex;flex-direction:column;gap:10px;transition:var(--motion-fast)}
.memq-card:hover{border-color:var(--line-strong);background:rgba(45,212,191,.05);transform:translateY(-2px)}
.memq-card-head{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.memq-tag{font-size:11px;font-family: var(--font-mono);letter-spacing:.5px;padding:2px 10px;border-radius:var(--radius-pill);
  border:1px solid var(--line);color:var(--dim);background:rgba(255,255,255,.04)}
.memq-type{color:#bfeaff;border-color:color-mix(in srgb, var(--accent) 35%, transparent);background:rgba(34,211,238,.08)}
.memq-src{color:#9fe9d8;border-color:rgba(45,212,191,.3);background:rgba(45,212,191,.07)}
.memq-senti{color:#ffd9a8;border-color:color-mix(in srgb, var(--warn) 35%, transparent);background:rgba(245,181,68,.08)}
.memq-date{margin-left:auto;font-size:11px;color:var(--dim2);font-family: var(--font-mono)}
.memq-card-title{font:600 17px/1.3 'Rajdhani',system-ui,sans-serif;color:var(--txt)}
.memq-content{font-size:14px;line-height:1.65;color:var(--txt);opacity:.9;white-space:pre-wrap;word-break:break-word}
.memq-content.multi{max-height:200px;overflow:auto;background:rgba(0,0,0,.25);border:1px solid var(--line);
  border-radius:var(--radius-sm);padding:10px 12px}
.memq-tags{display:flex;gap:6px;flex-wrap:wrap}

/* ── 用户画像面板（Phase 2 · P1 认知层）── */
.up-loading{color:var(--dim);font-size:13px;font-family: var(--font-mono);padding:8px 0}
.up-refresh{
  padding:4px 10px;border-radius:var(--radius-sm);cursor:pointer;
  border:1px solid var(--border);background:rgba(34,211,238,.08);
  color:#bfeaff;font-size:11px;font-family: var(--font-mono);transition:var(--motion-fast);
}
.up-refresh:hover{color:#fff;border-color:rgba(34,211,238,.6);background:color-mix(in srgb, var(--accent) 16%, transparent)}
.up-ep-list{display:grid;gap:10px;margin-top:4px}
.up-ep{padding:10px 12px;border-radius:var(--radius-sm);border:1px solid rgba(255,255,255,.08);
  background:rgba(10,16,24,.4);border-left:3px solid var(--teal)}
.up-ep-head{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
.up-ep-cat{font-family: var(--font-mono);font-size:10px;letter-spacing:1px;
  color:var(--teal);text-transform:uppercase;border:1px solid rgba(45,212,191,.3);
  border-radius:var(--radius-xs);padding:1px 6px;white-space:nowrap}
.up-ep-title{font-family: var(--font-ui);font-size:15px;font-weight:600;color:#fff;line-height:1.2}
.up-ep-sum{margin-top:6px;font-size:13px;line-height:1.5;color:var(--txt);opacity:.85;overflow-wrap:anywhere}
.up-ep-meta{margin-top:6px;font-size:10px;color:var(--dim);font-family: var(--font-mono)}

/* ===== 天气搜索增强：候选下拉 + 历史（#352 完善搜索） ===== */
.wx-search-wrap { position: relative; display: flex; gap: 6px; }
.wx-suggest {
  position: absolute; top: calc(100% + 7px); left: 0; right: 0; z-index: var(--z-popover);
  background: rgba(9,14,20,.97); border: 1px solid var(--line); border-radius: var(--radius-md);
  padding: 6px; display: flex; flex-direction: column; gap: 2px;
  box-shadow: var(--elev-3); max-height: 280px; overflow: auto;
  backdrop-filter: var(--glass-2);
}
.wx-suggest[hidden] { display: none; }
.wx-suggest-h {
  font-size: 11px; color: var(--dim); padding: 4px 10px 6px;
  letter-spacing: .16em; font-family: var(--font-mono);
}
.wx-suggest-item {
  display: flex; align-items: center; gap: 10px; text-align: left; width: 100%;
  background: transparent; border: 0; color: var(--txt); cursor: pointer;
  padding: 10px 12px; border-radius: var(--radius-sm); font-size: 14px;
  font-family: var(--font-ui); font-weight: 600;
  transition: background var(--motion-fast), color var(--motion-fast);
}
.wx-suggest-item:hover, .wx-suggest-item.active {
  background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 16%, transparent), rgba(34,211,238,.06));
  color: #fff;
}
.wx-suggest-item .wx-sug-ico { font-size: 14px; opacity: .82; }

/* ===== #354 档案卡：使用统计 + 实时状态 ===== */
.zz-stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 14px 0; }
.zz-stat {
  background: rgba(255,255,255,.04); border: 1px solid var(--line);
  border-radius: var(--radius-md); padding: 12px 6px; text-align: center;
}
.zz-stat-n { font-family: var(--font-display); font-size: 22px; font-weight: 800; color: var(--cyan); line-height: 1.1; }
.zz-stat-l { font-size: 11px; color: var(--dim); margin-top: 4px; letter-spacing: .08em; }
.zz-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 8px; vertical-align: middle; }
.zz-dot.on { background: var(--teal); box-shadow: 0 0 8px var(--teal); }
.zz-dot.off { background: var(--dim2); }
.zz-panel-list.zz-mini li { font-size: 13px; padding: 4px 0; }
.zz-seg { font-size: 11px; color: var(--teal); font-weight: 600; margin-left: 6px; }
.zz-muted { color: var(--dim); font-size: 13px; padding: 2px 0; }

/* ===== #356 会话归档 ===== */
.conv-arch {
  opacity: 0; background: none; border: none; color: var(--dim2); cursor: pointer;
  font-size: 13px; line-height: 1; padding: 2px 4px; border-radius: var(--radius-xs); transition: opacity var(--motion-fast), color var(--motion-fast);
}
.conv-arch:hover { color: var(--cyan); background: rgba(34,211,238,.12); }
.conv-item.archived { opacity: .58; }
.conv-item.archived .conv-title { font-style: italic; }
.conv-archived { margin-top: 10px; border-top: 1px solid var(--line); padding-top: 8px; }
.conv-archived-head {
  display: flex; justify-content: space-between; align-items: center; width: 100%;
  background: transparent; border: none; color: var(--dim); cursor: pointer;
  font-size: 12px; padding: 6px 4px; font-family: var(--font-ui); letter-spacing: .05em;
}
.conv-archived-head:hover { color: var(--txt); }
.conv-archived-caret { transition: transform var(--motion-fast); }
.conv-archived-body { display: flex; flex-direction: column; gap: 4px; padding-top: 4px; }

/* 太阳系可视化 — 全屏唯一背景（在 .app 之下，覆盖整个视口） */
.solar-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: var(--z-ground);
  pointer-events: auto; /* 允许拖拽查看 / 点击星球 */
  cursor: default; /* 箭头光标 */
}
.solar-canvas:active { cursor: default; }

/* ═══ Workspace Pinned Panel Chrome (UI-only) ═══
 * 由 PanelManager._applyPinChrome 在 overlayId 类面板 pinned 时打上 .ws-pinned；
 * 纯视觉标记，不引入任何行为 / 状态。 */
.ws-pinned {
  outline: 2px solid var(--accent);
  outline-offset: -2px;
}

/* ═══ Phase 36.1 · 智能可见性三面板（记忆中心 / 关于我 / 能力中心）═══
 * 复用 knowledge-panel 浮层范式；仅表现层，不引入业务能力 / 状态 / 运行时。 */
.memc-panel, .about-panel, .capc-panel { position: fixed; inset: 0; z-index: 80; display: none; align-items: center; justify-content: center; }
body.memc-mode .memc-panel, body.aboutme-mode .about-panel, body.capc-mode .capc-panel { display: flex; }
.memc-backdrop, .about-backdrop, .capc-backdrop { position: absolute; inset: 0; background: rgba(6,10,18,.55); backdrop-filter: blur(6px); }
.memc-stage, .about-stage, .capc-stage {
  position: relative; width: min(980px, 94vw); height: min(80vh, 760px);
  background: var(--panel, #0d1320cc); border: 1px solid var(--line); border-radius: var(--radius-lg, 18px);
  box-shadow: 0 30px 80px rgba(0,0,0,.5); display: flex; flex-direction: column; overflow: hidden;
}
.memc-bar, .about-bar, .capc-bar { display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--line); }
.memc-title, .about-title, .capc-title { display: flex; align-items: center; gap: 8px; font: 700 18px/1 'Rajdhani', system-ui, sans-serif; color: var(--txt); }
.memc-dot, .about-dot, .capc-dot { width: 8px; height: 8px; border-radius: 50%; background: #56d364; box-shadow: 0 0 8px #56d364; }
.capc-dot { background: #22d3ee; box-shadow: 0 0 8px #22d3ee; }
.about-dot { background: #a78bfa; box-shadow: 0 0 8px #a78bfa; }
.memc-meta, .about-meta, .capc-meta { margin-left: 6px; font-size: 12px; color: var(--dim); }
.memc-refresh, .about-refresh, .capc-refresh { margin-left: auto; }
.memc-close, .about-close, .capc-close, .memc-refresh, .about-refresh, .capc-refresh {
  width: 30px; height: 30px; border: none; border-radius: 8px; background: rgba(255,255,255,.1);
  color: var(--txt); cursor: pointer; display: flex; align-items: center; justify-content: center;
}
.memc-close:hover, .about-close:hover, .capc-close:hover, .memc-refresh:hover, .about-refresh:hover, .capc-refresh:hover { background: rgba(255,255,255,.2); }
.memc-search-wrap, .capc-search-wrap { padding: 10px 18px; border-bottom: 1px solid var(--line); }
.memc-search, .capc-search { width: 100%; padding: 9px 12px; border-radius: 10px; border: 1px solid var(--line); background: rgba(255,255,255,.04); color: var(--txt); font-size: 14px; outline: none; }
.memc-search:focus, .capc-search:focus { border-color: var(--line-strong); }
.memc-body, .about-body, .capc-body { flex: 1; width: 100%; max-width: 1180px; margin: 0 auto; overflow: auto; color: var(--dim); padding: 18px; }
.memc-loading, .memc-empty, .about-loading, .about-empty, .capc-loading, .capc-empty { padding: 40px; text-align: center; color: var(--dim); font-size: 15px; }
.memc-list-head, .capc-group-title { font-size: 13px; color: var(--dim); margin-bottom: 12px; }
.memc-group-title, .capc-group-title, .about-section-title {
  font: 600 15px/1.3 'Rajdhani', system-ui, sans-serif; color: var(--txt); margin: 18px 0 10px; letter-spacing: .5px;
}
.about-section-title { margin-top: 22px; }
.memc-group-count, .capc-group-count { color: var(--dim2); font-weight: 400; margin-left: 6px; }
.memc-grid, .capc-grid, .about-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 14px; }

/* 记忆中心卡片 */
.memc-row, .capc-card {
  background: rgba(255,255,255,.04); border: 1px solid var(--line); border-radius: var(--radius-md, 14px);
  padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; transition: var(--motion-fast, .2s);
}
.memc-row:hover, .capc-card:hover { border-color: var(--line-strong); }
.memc-row-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.memc-row-title { font: 600 15px/1.3 'Rajdhani', system-ui, sans-serif; color: var(--txt); }
.memc-content { font-size: 13px; line-height: 1.55; color: var(--dim); max-height: 72px; overflow: auto; white-space: pre-wrap; word-break: break-word; }
.memc-tags, .capc-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.memc-chip, .capc-chip { font-size: 11px; padding: 2px 9px; border-radius: 999px; background: rgba(34,211,238,.1); color: var(--cyan); border: 1px solid rgba(34,211,238,.2); }
.memc-kvs, .abt-kvs { display: flex; flex-wrap: wrap; gap: 12px; font-size: 12px; color: var(--dim2); }
.memc-kv b, .abt-kv b { color: var(--txt); font-weight: 600; }
.memc-actions, .abt-actions, .capc-actions { display: flex; gap: 8px; margin-top: 2px; }

/* 三态可信度徽章（记忆中心 / 关于我 共用） */
.memc-badge { display: inline-flex; align-items: center; gap: 5px; padding: 2px 9px; border-radius: 999px; font-size: 11px; font-weight: 600; border: 1px solid var(--line); white-space: nowrap; }
.memc-badge .dot { width: 7px; height: 7px; border-radius: 50%; }
.memc-badge.inf { color: #f0b35e; background: rgba(240,179,94,.12); } .memc-badge.inf .dot { background: #f0b35e; }
.memc-badge.ok { color: #56d364; background: rgba(86,211,100,.12); } .memc-badge.ok .dot { background: #56d364; }
.memc-badge.sys { color: #8b98a9; background: rgba(139,152,169,.14); } .memc-badge.sys .dot { background: #8b98a9; }

/* 纠正 / 反馈内联编辑器 */
.memc-edit, .abt-edit { margin-top: 4px; }
.memc-edit[hidden], .abt-edit[hidden] { display: none; }
.memc-edit-box, .abt-edit-box { background: rgba(0,0,0,.25); border: 1px solid var(--line); border-radius: var(--radius-sm, 10px); padding: 10px; display: flex; flex-direction: column; gap: 8px; }
.memc-edit-ta, .abt-edit-ta { width: 100%; min-height: 64px; resize: vertical; padding: 8px 10px; border-radius: 8px; border: 1px solid var(--line); background: rgba(255,255,255,.04); color: var(--txt); font-size: 13px; font-family: var(--font-mono, monospace); outline: none; }
.memc-edit-ta:focus, .abt-edit-ta:focus { border-color: var(--line-strong); }
.memc-edit-actions, .abt-edit-actions { display: flex; justify-content: flex-end; gap: 8px; }
.memc-edit-cancel, .abt-edit-cancel { padding: 6px 14px; border-radius: var(--radius-sm, 10px); border: 1px solid var(--line); background: transparent; color: var(--dim); font-size: 12px; cursor: pointer; }
.memc-edit-save, .abt-edit-save { padding: 6px 14px; border-radius: var(--radius-sm, 10px); border: 1px solid rgba(34,211,238,.4); background: rgba(34,211,238,.14); color: var(--cyan); font-size: 12px; cursor: pointer; }
.memc-edit-save:hover, .abt-edit-save:hover { background: rgba(34,211,238,.24); }
.memc-edit-save:disabled, .abt-edit-save:disabled { opacity: .5; cursor: default; }

/* 关于我 */
.about-banner { margin: 14px 18px 0; padding: 10px 14px; border-radius: var(--radius-md, 14px); background: rgba(167,139,250,.08); border: 1px solid rgba(167,139,250,.25); color: var(--dim); font-size: 12.5px; line-height: 1.6; }
.abt-row { background: rgba(255,255,255,.04); border: 1px solid var(--line); border-radius: var(--radius-md, 14px); padding: 14px 16px; display: flex; flex-direction: column; gap: 9px; transition: var(--motion-fast, .2s); }
.abt-row:hover { border-color: var(--line-strong); }
.abt-row-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.abt-row-label { font: 600 15px/1.3 'Rajdhani', system-ui, sans-serif; color: var(--txt); }
.abt-row-val { font-size: 13px; line-height: 1.55; color: var(--txt); white-space: pre-wrap; word-break: break-word; }

/* 能力中心 */
.capc-card-top { display: flex; align-items: flex-start; gap: 12px; }
.capc-icon { font-size: 22px; line-height: 1; }
.capc-card-h { display: flex; flex-direction: column; gap: 4px; }
.capc-card-title { font: 600 16px/1.3 'Rajdhani', system-ui, sans-serif; color: var(--txt); }
.capc-status { font-size: 11px; }
.capc-status.on { color: #56d364; } .capc-status.off { color: var(--dim2); }
.capc-desc { font-size: 13px; line-height: 1.6; color: var(--dim); margin: 0; }
.capc-how { background: rgba(0,0,0,.22); border: 1px solid var(--line); border-radius: var(--radius-sm, 10px); padding: 10px 12px; }
.capc-how-label { font-size: 11px; color: var(--dim2); margin-bottom: 4px; letter-spacing: .5px; }
.capc-how p { font-size: 12.5px; line-height: 1.6; color: var(--dim); margin: 0; white-space: pre-wrap; }
.capc-route-note { font-size: 12px; line-height: 1.55; color: var(--amber); }
.capc-bg-tag { display: inline-block; font-size: 11px; color: var(--dim2); border: 1px dashed var(--line); padding: 6px 12px; border-radius: var(--radius-sm, 10px); }

/* 操作按钮（记忆中心 / 关于我 / 能力中心 共用） */
.memc-archive, .memc-correct, .abt-fb, .capc-use { padding: 7px 14px; border-radius: var(--radius-sm, 10px); border: 1px solid var(--line); background: rgba(255,255,255,.05); color: var(--txt); font-size: 13px; cursor: pointer; transition: var(--motion-fast, .2s); }
.memc-correct:hover, .abt-fb:hover, .capc-use:hover { border-color: var(--line-strong); background: rgba(34,211,238,.1); }
.memc-archive:hover:not(:disabled) { background: rgba(255,80,80,.16); border-color: rgba(255,80,80,.5); color: #fff; }
.memc-archive:disabled { opacity: .4; cursor: default; }
.capc-use-warn { border-color: rgba(240,179,94,.4); color: #f0b35e; }
.capc-use-warn:hover { background: rgba(240,179,94,.12); }

/* 轻提示 toast（三面板共用） */
.memc-toast { position: fixed; left: 50%; bottom: 40px; transform: translateX(-50%) translateY(20px); background: rgba(13,19,32,.96); border: 1px solid var(--line); color: var(--txt); padding: 10px 18px; border-radius: 12px; font-size: 13px; opacity: 0; pointer-events: none; transition: var(--motion-fast, .2s); z-index: 200; max-width: 80vw; }
.memc-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ═══ Phase 36.2 · 智能交互（自我认知透明层 + 每日智能 Glance）═══
 * 复用 36.1 浮层范式；仅表现层，不引入业务能力 / 状态 / 运行时。 */
.saw-panel { position: fixed; inset: 0; z-index: 80; display: none; align-items: center; justify-content: center; }
body.self-awareness-mode .saw-panel { display: flex; }
.saw-backdrop { position: absolute; inset: 0; background: rgba(6,10,18,.55); backdrop-filter: blur(6px); }
.saw-stage {
  position: relative; width: min(720px, 94vw); height: min(82vh, 720px);
  background: var(--panel, #0d1320cc); border: 1px solid var(--line); border-radius: var(--radius-lg, 18px);
  box-shadow: 0 30px 80px rgba(0,0,0,.5); display: flex; flex-direction: column; overflow: hidden;
}
.saw-bar { display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--line); }
.saw-title { display: flex; align-items: center; gap: 8px; font: 700 18px/1 'Rajdhani', system-ui, sans-serif; color: var(--txt); }
.saw-dot { width: 8px; height: 8px; border-radius: 50%; background: #22d3ee; box-shadow: 0 0 8px #22d3ee; }
.saw-meta { margin-left: 6px; font-size: 12px; color: var(--dim); }
.saw-refresh { margin-left: auto; }
.saw-close, .saw-refresh { width: 30px; height: 30px; border: none; border-radius: 8px; background: rgba(255,255,255,.1); color: var(--txt); cursor: pointer; display: flex; align-items: center; justify-content: center; }
.saw-close:hover, .saw-refresh:hover { background: rgba(255,255,255,.2); }
.saw-body { flex: 1; overflow: auto; padding: 18px; color: var(--dim); display: flex; flex-direction: column; gap: 16px; }
.saw-loading, .saw-empty, .saw-feed-empty { padding: 28px; text-align: center; color: var(--dim); font-size: 14px; }

.saw-status { position: relative; display: flex; gap: 16px; align-items: flex-start; background: rgba(255,255,255,.04); border: 1px solid var(--line); border-radius: var(--radius-md, 14px); padding: 16px 18px; }
.saw-status-ok { border-color: rgba(86,211,100,.35); }
.saw-status-warn { border-color: rgba(240,179,94,.4); }
.saw-badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; border: 1px solid var(--line); white-space: nowrap; }
.saw-badge .dot { width: 7px; height: 7px; border-radius: 50%; }
.saw-badge.ok { color: #56d364; background: rgba(86,211,100,.12); } .saw-badge.ok .dot { background: #56d364; }
.saw-badge.warn { color: #f0b35e; background: rgba(240,179,94,.12); } .saw-badge.warn .dot { background: #f0b35e; }
.saw-status-main { flex: 1; display: flex; flex-direction: column; gap: 6px; }
.saw-summary { font: 600 16px/1.4 'Rajdhani', system-ui, sans-serif; color: var(--txt); }
.saw-status-sub { font-size: 12.5px; color: var(--dim); }
.saw-status-sub b { color: var(--txt); }
.saw-run { position: absolute; top: 14px; right: 16px; padding: 6px 14px; border-radius: var(--radius-sm, 10px); border: 1px solid rgba(34,211,238,.4); background: rgba(34,211,238,.14); color: var(--cyan); font-size: 13px; cursor: pointer; }
.saw-run:hover { background: rgba(34,211,238,.24); }
.saw-run:disabled { opacity: .5; cursor: default; }

.saw-boundary { padding: 12px 14px; border-radius: var(--radius-md, 14px); background: rgba(34,211,238,.06); border: 1px solid rgba(34,211,238,.22); }
.saw-boundary-title { font-size: 12px; font-weight: 600; color: var(--cyan); margin-bottom: 6px; letter-spacing: .5px; }
.saw-boundary p { margin: 0; font-size: 13px; line-height: 1.65; color: var(--dim); }
.saw-boundary b { color: var(--txt); }

.saw-feed-title { font: 600 13px/1.3 'Rajdhani', system-ui, sans-serif; color: var(--txt); letter-spacing: .5px; text-transform: uppercase; }
.saw-feed-item { background: rgba(255,255,255,.03); border: 1px solid var(--line); border-left: 3px solid rgba(34,211,238,.5); border-radius: var(--radius-sm, 10px); padding: 10px 12px; }
.saw-feed-text { font-size: 13px; line-height: 1.55; color: var(--txt); white-space: pre-wrap; word-break: break-word; }
.saw-feed-meta { font-size: 11px; color: var(--dim2); margin-top: 4px; }

.saw-feedback { padding: 12px 14px; border-radius: var(--radius-md, 14px); background: rgba(0,0,0,.22); border: 1px solid var(--line); }
.saw-feedback-title { font-size: 12.5px; color: var(--dim); margin-bottom: 8px; }
.saw-feedback-ta { width: 100%; min-height: 56px; resize: vertical; padding: 8px 10px; border-radius: 8px; border: 1px solid var(--line); background: rgba(255,255,255,.04); color: var(--txt); font-size: 13px; font-family: var(--font-mono, monospace); outline: none; }
.saw-feedback-ta:focus { border-color: var(--line-strong); }
.saw-feedback-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px; }
.saw-fb-cancel { padding: 6px 14px; border-radius: var(--radius-sm, 10px); border: 1px solid var(--line); background: transparent; color: var(--dim); font-size: 12px; cursor: pointer; }
.saw-fb-save { padding: 6px 14px; border-radius: var(--radius-sm, 10px); border: 1px solid rgba(34,211,238,.4); background: rgba(34,211,238,.14); color: var(--cyan); font-size: 12px; cursor: pointer; }
.saw-fb-save:hover { background: rgba(34,211,238,.24); }
.saw-fb-save:disabled { opacity: .5; cursor: default; }

/* 自我认知 toast（独立实例，避免与三面板冲突） */
.saw-toast { position: fixed; left: 50%; bottom: 40px; transform: translateX(-50%) translateY(20px); background: rgba(13,19,32,.96); border: 1px solid var(--line); color: var(--txt); padding: 10px 18px; border-radius: 12px; font-size: 13px; opacity: 0; pointer-events: none; transition: var(--motion-fast, .2s); z-index: 200; max-width: 80vw; }
.saw-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ───────────────── Execution Visibility（Phase 37.1 · 执行状态面板） ───────────────── */
.execv-panel { position: fixed; inset: 0; z-index: 80; display: none; align-items: center; justify-content: center; }
body.execution-mode .execv-panel { display: flex; }
.execv-backdrop { position: absolute; inset: 0; background: rgba(6,10,18,.55); backdrop-filter: blur(6px); }
.execv-stage {
  position: relative; width: min(720px, 94vw); height: min(82vh, 720px);
  background: var(--panel, #0d1320cc); border: 1px solid var(--line); border-radius: var(--radius-lg, 18px);
  box-shadow: 0 30px 80px rgba(0,0,0,.5); display: flex; flex-direction: column; overflow: hidden;
}
.execv-bar { display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--line); }
.execv-title { display: flex; align-items: center; gap: 8px; font: 700 18px/1 'Rajdhani', system-ui, sans-serif; color: var(--txt); }
.execv-dot { width: 8px; height: 8px; border-radius: 50%; background: #22d3ee; box-shadow: 0 0 8px #22d3ee; }
.execv-meta { margin-left: 6px; font-size: 12px; color: var(--dim); }
.execv-refresh { margin-left: auto; }
.execv-close, .execv-refresh { width: 30px; height: 30px; border: none; border-radius: 8px; background: rgba(255,255,255,.1); color: var(--txt); cursor: pointer; display: flex; align-items: center; justify-content: center; }
.execv-close:hover, .execv-refresh:hover { background: rgba(255,255,255,.2); }
.execv-body { flex: 1; overflow: auto; padding: 18px; color: var(--dim); display: flex; flex-direction: column; gap: 16px; }
.execv-loading, .execv-empty { padding: 28px; text-align: center; color: var(--dim); font-size: 14px; }

.execv-status { position: relative; display: flex; gap: 16px; align-items: flex-start; background: rgba(255,255,255,.04); border: 1px solid var(--line); border-radius: var(--radius-md, 14px); padding: 16px 18px; }
.execv-status-idle { border-color: rgba(255,255,255,.18); }
.execv-status-running { border-color: rgba(34,211,238,.35); }
.execv-status-done { border-color: rgba(86,211,100,.35); }
.execv-status-failed { border-color: rgba(255,107,107,.4); }
.execv-status-unknown { border-color: rgba(255,255,255,.18); }
.execv-badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; border: 1px solid var(--line); white-space: nowrap; }
.execv-badge .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--dim); }
.execv-badge.idle { color: var(--dim); background: rgba(255,255,255,.08); }
.execv-badge.running { color: #22d3ee; background: rgba(34,211,238,.12); } .execv-badge.running .dot { background: #22d3ee; box-shadow: 0 0 6px #22d3ee; }
.execv-badge.done { color: #56d364; background: rgba(86,211,100,.12); } .execv-badge.done .dot { background: #56d364; }
.execv-badge.failed { color: #ff6b6b; background: rgba(255,107,107,.12); } .execv-badge.failed .dot { background: #ff6b6b; }
.execv-badge.unknown { color: var(--dim); background: rgba(255,255,255,.08); }
.execv-status-main { flex: 1; display: flex; flex-direction: column; gap: 6px; }
.execv-row { display: flex; gap: 10px; font-size: 13px; line-height: 1.5; padding: 2px 0; }
.execv-k { flex: 0 0 72px; color: var(--dim); }
.execv-v { color: var(--txt); }
.execv-row-warn .execv-v { color: #f0b35e; }
.execv-report { white-space: pre-wrap; word-break: break-word; }
.execv-risk { display: flex; gap: 10px; padding: 12px 14px; border-radius: var(--radius-md, 14px); background: rgba(240,179,94,.08); border: 1px solid rgba(240,179,94,.3); }
.execv-risk-ico { color: #f0b35e; font-size: 15px; line-height: 1.4; }
.execv-risk b { color: var(--txt); }
.execv-risk div { font-size: 13px; line-height: 1.6; color: var(--dim); }

.execv-section-title { font: 600 13px/1.3 'Rajdhani', system-ui, sans-serif; color: var(--txt); letter-spacing: .5px; text-transform: uppercase; margin-top: 2px; }
.execv-task { background: rgba(255,255,255,.03); border: 1px solid var(--line); border-radius: var(--radius-md, 14px); overflow: hidden; margin-bottom: 8px; }
.execv-task-head { width: 100%; display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: transparent; border: none; color: var(--txt); cursor: pointer; text-align: left; font: 600 14px/1.3 'Rajdhani', system-ui, sans-serif; }
.execv-task-title { flex: 1; }
.execv-task-meta { color: var(--dim); font-size: 12px; margin-left: auto; font-weight: 500; }
.execv-caret { color: var(--dim); transition: transform .18s; font-size: 10px; }
.execv-task.is-open .execv-caret { transform: rotate(90deg); }
.execv-task-detail { display: none; padding: 0 14px 14px; flex-direction: column; gap: 10px; }
.execv-task.is-open .execv-task-detail { display: block; }
.execv-steps { display: flex; flex-direction: column; gap: 4px; }
.execv-step { display: flex; gap: 8px; align-items: center; font-size: 13px; color: var(--dim); padding: 4px 0; }
.execv-step-no { flex: 0 0 20px; width: 20px; height: 20px; border-radius: 50%; background: rgba(255,255,255,.06); color: var(--dim); display: flex; align-items: center; justify-content: center; font-size: 11px; }
.execv-step.is-done { color: #56d364; } .execv-step.is-done .execv-step-no { background: rgba(86,211,100,.15); color: #56d364; }
