/* ============================================================
   热点追踪大屏样式（Task #29）
   ============================================================ */
/* 热点覆盖层：左侧大屏 + 右侧聊天框，整体从左侧滑入 */
.hs-overlay {
  position: fixed;
  inset: 0;
  z-index: var(--z-rail);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  padding: 2.4vh 2.4vw;
  pointer-events: none;
  opacity: 0;
  transform: translateX(-24px);
  transition: opacity var(--motion-base) var(--ease-soft), transform var(--motion-slow) var(--ease-soft);
  background: var(--ws-overlay-scrim);
  backdrop-filter: var(--glass-2);
  overflow: hidden;
}
body.hotspot-mode .hs-overlay {
  pointer-events: auto;
  opacity: 1;
  transform: none;
}

.hs-scale-stage {
  width: 1920px;
  height: 1080px;
  flex: 0 0 auto;
  position: relative;
  transform-origin: center center;
  overflow: hidden;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  box-shadow: var(--elev-3);
}

.hotspot-panel {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  z-index: var(--z-base);
  border-radius: 0;
  background: transparent;
  border: none;
  opacity: 1;
  pointer-events: none;
  display: flex;
  flex-direction: column;
}
body.hotspot-mode .hotspot-panel { pointer-events: auto; }

/* 热点模式时隐藏主页自身的侧栏/语音/控制台，避免与覆盖层重叠 */
body.hotspot-mode #panel-l1,
body.hotspot-mode #panel-l2,
body.hotspot-mode #voice-panel,
body.hotspot-mode .console {
  display: none;
}

/* 右侧聊天框：与主会话联动的玻璃拟态延伸视图 */
.hs-chat {
  flex: 1 1 0;
  width: auto;
  max-width: 420px;
  min-width: 280px;
  height: 100%;
  display: flex;
  flex-direction: column;
  border-radius: var(--radius-lg);
  background:
    radial-gradient(140% 90% at 100% -10%, rgba(34,211,238,.10), transparent 55%),
    radial-gradient(120% 60% at 0% 100%, rgba(45,212,191,.06), transparent 50%),
    color-mix(in srgb, var(--void) 92%, #001018);
  border: 1px solid rgba(120, 180, 255, 0.16);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.04),
    inset 0 0 0 1px rgba(0,0,0,.45),
    0 30px 90px rgba(0,0,0,.60);
  overflow: hidden;
  pointer-events: none;
  backdrop-filter: var(--glass-2);
}
body.hotspot-mode .hs-chat { pointer-events: auto; }

.hs-chat-head {
  flex: 0 0 auto;
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 16px;
  border-bottom: 1px solid rgba(120,180,255,.10);
  background: linear-gradient(180deg, rgba(34,211,238,.06), transparent);
}
.hs-chat-title-block { display: flex; flex-direction: column; gap: 2px; }
.hs-chat-title { font-family: var(--font-ui); font-weight: 700; font-size: 15px; color: var(--text); display: flex; align-items: center; gap: 8px; letter-spacing: .3px; }
.hs-chat-sub { font-size: 11px; color: var(--dim); font-family: var(--font-mono); }
.hs-chat-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: #2dd4bf;
  box-shadow: 0 0 10px #2dd4bf, 0 0 18px rgba(45,212,191,.45);
  animation: hsChatPulse 2s ease-in-out infinite;
}
@keyframes hsChatPulse { 0%,100% { opacity: .45; transform: scale(.9); } 50% { opacity: 1; transform: scale(1); } }
.hs-chat-clear {
  background: rgba(255,255,255,.04); border: 1px solid var(--line); color: var(--dim);
  border-radius:var(--radius-sm); padding: 6px 10px; cursor: pointer; font-size: 12px; transition: var(--motion-fast);
  font-family: var(--font-mono);
}
.hs-chat-clear:hover { border-color: var(--cyan); color: var(--cyan); background: rgba(34,211,238,.08); }

/* 热点上下文 chip：把选中地域和对话链接起来 */
.hs-chat-context { flex: 0 0 auto; min-height: 0; }
.hs-chat-context[hidden] { display: none; }
.hs-ctx-chip {
  margin: 12px 14px 0;
  padding: 10px 12px;
  display: flex; align-items: center; gap: 10px;
  border-radius: var(--radius-md);
  background: rgba(34,211,238,.08);
  border: 1px solid rgba(34,211,238,.22);
  box-shadow: 0 0 16px rgba(34,211,238,.08);
  animation: hsChatIn var(--motion-base) ease-out both;
}
.hs-ctx-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--cyan); box-shadow: 0 0 8px var(--cyan);
  flex: 0 0 auto;
}
.hs-ctx-main { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
.hs-ctx-region { font-size: 13px; font-weight: 600; color: var(--text); }
.hs-ctx-meta { font-size: 11px; color: var(--dim); font-family: var(--font-mono); }
.hs-ctx-ask, .hs-ctx-close {
  flex: 0 0 auto; border-radius: var(--radius-sm); cursor: pointer; transition: var(--motion-fast); font-size: 12px;
}
.hs-ctx-ask {
  padding: 6px 10px; border: 1px solid var(--cyan); background: rgba(34,211,238,.12); color: var(--cyan);
  font-family: var(--font-ui); font-weight: 700;
}
.hs-ctx-ask:hover { background: var(--cyan); color: #061018; box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 35%, transparent); }
.hs-ctx-close {
  width: 26px; height: 26px; padding: 0; border: 1px solid var(--line); background: transparent; color: var(--dim);
  display: grid; place-items: center;
}
.hs-ctx-close:hover { border-color: var(--danger); color: var(--danger); }

.hs-chat-log {
  flex: 1 1 0; min-height: 0; overflow-y: auto;
  padding: 14px; display: flex; flex-direction: column; gap: 10px;
}
.hs-chat-empty {
  color: var(--dim); font-size: 13px; text-align: center; margin: auto; padding: 0 20px; line-height: 1.6;
  display: flex; flex-direction: column; align-items: center; gap: 8px;
}
.hs-chat-empty-icon { font-size: 34px; opacity: .7; filter: drop-shadow(0 0 12px rgba(34,211,238,.25)); }
.hs-chat-empty-title { font-size: 15px; color: var(--text); font-weight: 600; }
.hs-chat-empty-sub { font-size: 12px; color: var(--dim); }
.hs-chat-bubble {
  max-width: 88%; padding: 10px 14px; border-radius: var(--radius-md); font-size: 14px; line-height: 1.65;
  white-space: pre-wrap; word-break: break-word;
  animation: hsChatIn var(--motion-base) var(--ease-premium) both;
  box-shadow: 0 2px 8px rgba(0,0,0,.12);
}
@keyframes hsChatIn { from { opacity: 0; transform: translateY(8px) scale(.98); } to { opacity: 1; transform: none; } }
.hs-chat-user {
  align-self: flex-end;
  background: linear-gradient(135deg, rgba(34,211,238,.24), rgba(45,212,191,.18));
  border: 1px solid rgba(34,211,238,.38);
  color: var(--text);
  border-bottom-right-radius: 5px;
}
.hs-chat-bot {
  align-self: flex-start;
  background: rgba(10,16,28,.65);
  border: 1px solid var(--border);
  color: var(--text);
  border-bottom-left-radius: 5px;
}
.hs-chat-bot.hs-streaming {
  background: rgba(10,16,28,.45);
  border-style: dashed;
  animation: hsStreamPulse 1.2s ease-in-out infinite;
}
@keyframes hsStreamPulse { 0%,100%{border-color:var(--border)} 50%{border-color:rgba(34,211,238,.45)} }

.hs-chat-input {
  flex: 0 0 auto; display: flex; gap: 8px; padding: 12px 14px;
  border-top: 1px solid rgba(120,180,255,.10);
  background: rgba(6,10,18,.55);
}
.hs-chat-input textarea {
  flex: 1 1 0; resize: none; min-height: 40px; max-height: 120px;
  background: rgba(255,255,255,.05); border: 1px solid var(--line); border-radius: var(--radius-md);
  color: var(--text); font-size: 14px; padding: 10px 12px; font-family: inherit; line-height: 1.5;
  transition: var(--motion-fast);
}
.hs-chat-input textarea::placeholder { color: var(--dim); }
.hs-chat-input textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(34,211,238,.12), inset 0 0 12px rgba(34,211,238,.06); background: rgba(255,255,255,.07); }
.hs-chat-send {
  flex: 0 0 auto; align-self: flex-end; width: 40px; height: 40px; border-radius: var(--radius-md);
  border: 1px solid var(--cyan); background: rgba(34,211,238,.12); color: var(--cyan);
  display: grid; place-items: center; cursor: pointer; transition: var(--motion-fast);
}
.hs-chat-send:hover:not(:disabled) { background: var(--cyan); color: #061018; box-shadow: 0 0 18px rgba(34,211,238,.40); }
.hs-chat-send:disabled { opacity: .45; cursor: default; }
.hs-chat-send .ic { width: 18px; height: 18px; fill: currentColor; }
.hs-chat-mic {
  flex: 0 0 auto; align-self: flex-end; width: 40px; height: 40px; border-radius: var(--radius-md);
  border: 1px solid var(--line); background: rgba(255,255,255,.05); color: var(--dim);
  display: grid; place-items: center; cursor: pointer; transition: var(--motion-fast);
}
.hs-chat-mic .ic { width: 18px; height: 18px; fill: currentColor; pointer-events: none; }
.hs-chat-mic:hover { color: var(--cyan); border-color: var(--line-strong); background: rgba(34,211,238,.07); }
.hs-chat-mic.recording { color: #fff; border-color: var(--cyan); background: rgba(34,211,238,.18); animation: hsMicPulse 1.1s ease-in-out infinite; }

@media (max-width: 1199px) {
  .hotspot-panel { width: min(620px, 64vw); }
  .hs-chat { width: min(360px, 32vw); }
}

