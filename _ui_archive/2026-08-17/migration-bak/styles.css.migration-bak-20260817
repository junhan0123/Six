/* ============================================================
   ZhuangZhou · Retro-futuristic HUD  —  styles.css
   字体: Orbitron / Rajdhani / Share Tech Mono
   配色: 虚空黑 + 青(#22D3EE) + 青绿(#2DD4BF) + 琥珀(#F5B544) + 警戒红(#FF4D4D)
   ============================================================ */
/* Design Tokens 已统一至 ui2.css（唯一权威来源）。本文件仅保留组件样式，引用 ui2.css 提供的变量。
 *
 * —— Legacy CSS 边界标记（UI Alpha Program · Phase 1 · 2026-08-07）——
 * 本文件为历史遗留单体（202KB / 3764 行），是"组件样式层"而非"令牌源"。
 * 纪律（继承自 Component System Sprint / DESIGN.md）：禁止在 styles.css 新增令牌或组件 class；
 * 所有颜色/间距/阴影/层级/动效须走 ui2.css 令牌；改色/间距/阴影先改令牌再引用。
 *
 * 经 Phase 1 执行收口后，本文件残留的"原始 rgba()/hex"仅限以下两类、属刻意保留（非缺陷）：
 *   1) 装饰性渐变/光晕（radial/linear-gradient 中的 rgba、霓虹光晕、玻璃高光），属视觉质感，
 *      已在 ui2.css 通过 --surface/-2/--border/--glow 等令牌覆盖语义；逐值重写会触发视觉回归，故保留。
 *   2) 主题相关装饰色（如霓虹青 #22D3EE / 琥珀 #F5B544）在 dark-cyan 等主题下即 --accent，
 *      在 midnight 主题下为刻意双色 HUD 风格，不强行统一为单 --accent。
 * 语义色（danger/warn/ok/accent/border/text）已路由至 var(--*)：
 *   - 危险态 #ff6b6b → var(--danger)（27 处，styles.css）
 *   - 原始 cubic-bezier(0.2,0.9,0.2,1) → var(--ease-glitch)；var(--ease-out-soft) 已提升 :root
 *   - 原始 0.12s/.08s/.8s 过渡 → var(--dur-micro)/var(--dur-tick)/var(--dur-meter)
 * 任何"统一收口"应在 ui2.css 增量层进行，不在此文件大面积重写（避免零评审视觉回归）。
 */

*{box-sizing:border-box;margin:0;padding:0}
[hidden]{display:none!important}
html,body{height:100%}
body{
  background:var(--void);
  color:var(--txt);
  font-family: var(--font-ui);
  overflow:hidden;
  -webkit-font-smoothing:antialiased;
  display:flex;
  align-items:center;
  justify-content:center;
  width:100vw;
  height:100vh;
}
.ic{width:var(--icon-size);height:var(--icon-size);fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.ic.f{fill:currentColor;stroke:none}

/* ---------- 背景层 ---------- */
.bg-glow{
  position:fixed;inset:0;z-index: var(--z-ground);
  background:
    radial-gradient(60% 50% at 22% 18%,color-mix(in srgb, var(--accent) 16%, transparent),transparent 60%),
    radial-gradient(50% 45% at 82% 78%,rgba(245,181,68,.10),transparent 60%),
    radial-gradient(40% 40% at 60% 50%,rgba(45,212,191,.10),transparent 60%);
}
.scanlines{
  position:fixed;inset:0;z-index: var(--z-scanlines);pointer-events:none;opacity:.35;
  background:repeating-linear-gradient(to bottom,rgba(255,255,255,.025) 0 1px,transparent 1px 3px);
  mix-blend-mode:overlay;
}
/* 屏幕边缘暗角已移除（用户要求：去掉最外侧背景边框） */

/* ---------- P4-A 沉浸式粒子背景层（独立于 .app 的 scale 变换） ---------- */
.premium-bg{position:fixed;inset:0;z-index: var(--z-base);pointer-events:none;display:block}
@media (prefers-reduced-motion:reduce){.premium-bg{display:none}}
body.reduced-motion .premium-bg{display:none}

/* ---------- 布局（固定 1920×1080 画布，整体等比缩放） ---------- */
.app{
  position:relative;z-index: var(--z-stage);
  display:grid;
  grid-template-columns:248px 1fr 300px;
  width:1920px;
  height:1080px;
  gap:14px;padding:14px;
  transform-origin:center center;
  flex:none;
  will-change:transform;
}
.app.tele-hidden{grid-template-columns:248px 1fr 0}

/* 四角括弧装饰已移除（用户要求：去掉左上/右下直角） */

/* ---------- 左侧指令栏 ---------- */
.rail{
  display:flex;flex-direction:column;gap:16px;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:var(--radius-md);
  padding:18px 16px;
  backdrop-filter: var(--glass-2);
  position:relative;overflow:hidden;
}
.rail::after{content:"";position:absolute;top:0;left:0;width:3px;height:100%;
  background:linear-gradient(var(--cyan),var(--teal));opacity:.7}
.brand{display:flex;align-items:center;gap:12px}
.brand-mark{width:42px;height:42px;border-radius:var(--radius-sm);display:grid;place-items:center;
  background:radial-gradient(circle at 30% 30%,rgba(34,211,238,.25),rgba(11,16,22,.9));
  border:1px solid var(--line-strong);box-shadow:var(--shadow-glow)}
.brand-mark .ic.f{fill:var(--cyan);stroke:none;width:24px;height:24px}
.brand-name{font-family: var(--font-display);font-weight:900;letter-spacing:3px;font-size:18px;
  background:linear-gradient(90deg,var(--cyan),var(--teal));-webkit-background-clip:text;background-clip:text;color:transparent}
.brand-sub{display:block;font-family: var(--font-mono);font-size:10px;color:var(--dim2);letter-spacing:2px}

/* @deprecated → 未来 .zz-button（青色轨道 CTA 变体）。值来源已收口到 ui2.css --btn-rail-bg（零视觉变化）。 */
.btn-new{
  display:flex;align-items:center;justify-content:center;gap:8px;
  padding:12px;border-radius:var(--radius-sm);cursor:pointer;
  background:var(--btn-rail-bg);
  border:1px solid var(--line-strong);color:var(--txt);
  font-family: var(--font-ui);font-weight:600;font-size:15px;letter-spacing:1px;
  transition:var(--motion-fast);
}
.btn-new .ic{fill:var(--cyan);stroke:none;width:18px;height:18px}
.btn-new:hover{box-shadow:var(--shadow-glow);transform:translateY(-1px)}

.rail-section{display:flex;flex-direction:column;gap:10px}
.rail-label{font-family: var(--font-mono);font-size:11px;letter-spacing:2px;color:var(--dim2);
  padding-left:2px;border-left:2px solid var(--teal);padding-left:8px}
.conv-list{display:flex;flex-direction:column;gap:6px;max-height:32vh;overflow-y:auto;padding-right:3px}
.conv-list::-webkit-scrollbar{width:6px}
.conv-list::-webkit-scrollbar-thumb{background:color-mix(in srgb, var(--cyan) 25%, transparent);border-radius:var(--radius-xs)}
.conv-list::-webkit-scrollbar-track{background:transparent}
.conv-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:var(--radius-sm);
  background:var(--panel);border:1px solid transparent;font-size:14px;color:var(--dim);cursor:pointer;transition:var(--motion-fast)}
.conv-item .conv-title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:0}
.conv-item.active{background:color-mix(in srgb, var(--cyan) 8%, transparent);border-color:var(--line);color:var(--txt)}
.conv-item:hover .conv-del, .conv-item:hover .conv-arch{opacity:1}
.conv-del{margin-left:auto;opacity:0;background:none;border:none;color:var(--dim2);cursor:pointer;
  font-size:15px;line-height:1;padding:2px 6px;border-radius:var(--radius-xs);transition:var(--motion-fast);flex:0 0 auto}
.conv-del:hover{color:var(--danger);background:rgba(255,107,107,.12)}
.conv-dot{width:7px;height:7px;border-radius:50%;background:var(--teal);box-shadow:0 0 8px var(--teal);flex:0 0 auto}

.chip-row{display:flex;flex-wrap:wrap;gap:7px}
.chip{padding:8px 12px;border-radius:var(--radius-lg);cursor:pointer;font-family: var(--font-ui);font-size:13px;font-weight:500;
  background:var(--panel);border:1px solid var(--line);color:var(--dim);transition:var(--motion-fast)}
.chip:hover{color:var(--cyan);border-color:var(--line-strong);background:color-mix(in srgb, var(--cyan) 7%, transparent)}

/* 快捷能力：参考顶部「更多」按钮样式，做成带图标的小按钮 */
.quick-actions{margin-top:2px}
.quick-chips{gap:8px}
.quick-chip{
  --qc-c:var(--cyan);
  display:inline-flex;align-items:center;gap:6px;cursor:pointer;
  font-family: var(--font-ui);font-size:13px;font-weight:600;
  color:var(--dim);white-space:nowrap;
  padding:8px 12px;border-radius:var(--radius-sm);
  background:rgba(255,255,255,.04);border:1px solid var(--line);
  position:relative;isolation:isolate;overflow:hidden;
  transition:color var(--motion-fast),border-color var(--motion-fast),background var(--motion-fast),box-shadow var(--motion-fast),transform var(--motion-fast)}
.quick-chip .qc-ico{font-size:14px;line-height:1;transition:transform var(--motion-fast),filter var(--motion-fast)}
.quick-chip .qc-lbl{position:relative}
.quick-chip::before{
  content:"";position:absolute;left:10px;right:10px;top:0;height:1px;
  background:linear-gradient(90deg,transparent,var(--qc-c),transparent);opacity:.2;transition:opacity var(--motion-base)}
.quick-chip::after{
  content:"";position:absolute;inset:0;z-index:-1;border-radius:inherit;
  background:radial-gradient(120% 150% at 50% -25%,color-mix(in srgb,var(--qc-c) 24%,transparent),transparent 70%);
  opacity:0;transition:opacity var(--motion-base)}
.quick-chip:hover{
  color:#fff;border-color:color-mix(in srgb,var(--qc-c) 55%,var(--line));
  background:color-mix(in srgb,var(--qc-c) 10%,rgba(255,255,255,.04));
  box-shadow:0 0 0 1px color-mix(in srgb,var(--qc-c) 22%,transparent),0 6px 18px color-mix(in srgb,var(--qc-c) 18%,transparent);
  transform:translateY(-1.5px)}
.quick-chip:hover::after{opacity:1}
.quick-chip:hover::before{opacity:.7}
.quick-chip:hover .qc-ico{transform:scale(1.14);filter:drop-shadow(0 0 6px color-mix(in srgb,var(--qc-c) 75%,transparent))}
.quick-chip:active{transform:translateY(0) scale(.96)}

.rail-foot{margin-top:auto}
.status-pill{display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:var(--radius-lg);
  background:rgba(255,77,77,.08);border:1px solid rgba(255,77,77,.3);font-size:13px;color:var(--red);font-family: var(--font-mono)}
.status-pill .dot{width:8px;height:8px;border-radius:50%;background:var(--red);box-shadow:0 0 8px var(--red);animation:pulse 1.6s infinite}
.status-pill.ok{background:rgba(45,212,191,.08);border-color:rgba(45,212,191,.35);color:var(--teal)}
.status-pill.ok .dot{background:var(--teal);box-shadow:0 0 8px var(--teal)}
.status-pill.warn{background:rgba(245,181,68,.10);border-color:rgba(245,181,68,.4);color:#f5b544}
.status-pill.warn .dot{background:#f5b544;box-shadow:0 0 8px #f5b544}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}

/* ---------- 主区 ---------- */
.main{display:flex;flex-direction:column;gap:12px;min-width:0}
.hud-bar{display:flex;align-items:center;justify-content:space-between;
  padding:10px 18px;border-radius:var(--radius-md);
  background:var(--panel);border:1px solid var(--line);backdrop-filter: var(--glass-2);
  position:relative;z-index: var(--z-hud)}
.hud-left{display:flex;align-items:center;gap:14px}
.hud-tag{font-family: var(--font-display);font-size:11px;letter-spacing:3px;color:var(--cyan);
  border:1px solid var(--line-strong);padding:4px 10px;border-radius:var(--radius-xs)}
.hud-line{font-family: var(--font-mono);font-size:13px;color:var(--dim)}
.hud-sep{width:1px;height:18px;background:var(--line)}
.hud-state{font-family: var(--font-display);font-size:13px;letter-spacing:2px;color:var(--amber);
  border:1px solid rgba(245,181,68,.4);padding:4px 12px;border-radius:var(--radius-sm);
  text-shadow:0 0 10px rgba(245,181,68,.4)}
.hud-right{display:flex;align-items:center;gap:14px}
.tts-toggle{display:flex;align-items:center;gap:8px;cursor:pointer;
  font-family: var(--font-ui);font-size:13px;color:var(--dim);
  background:rgba(34,211,238,.06);border:1px solid var(--line);
  padding:6px 12px;border-radius:var(--radius-sm);transition:var(--motion-fast)}
.tts-toggle:hover{color:var(--txt);border-color:var(--line-strong)}
.tts-toggle svg{width:16px;height:16px;fill:var(--cyan)}
.tts-toggle .sw{width:30px;height:16px;border-radius:var(--radius-sm);background:rgba(139,152,169,.3);position:relative;transition:var(--motion-fast)}
.tts-toggle .sw::after{content:"";position:absolute;top:2px;left:2px;width:12px;height:12px;border-radius:50%;
  background:var(--dim);transition:var(--motion-fast)}
.tts-toggle.on{border-color:var(--cyan);color:var(--cyan)}
.tts-toggle.on .sw{background:rgba(34,211,238,.4)}
.tts-toggle.on .sw::after{left:16px;background:var(--cyan);box-shadow:0 0 8px var(--cyan)}

.tts-stop-btn{display:none;align-items:center;gap:6px;cursor:pointer;
  font-family: var(--font-ui);font-size:13px;color:#ffd0d0;
  background:rgba(255,77,77,.12);border:1px solid rgba(255,77,77,.45);
  padding:6px 12px;border-radius:var(--radius-sm);transition:var(--motion-fast);animation:pulseStop 1.4s ease-in-out infinite}
.tts-stop-btn.show{display:inline-flex}
.tts-stop-btn:hover{background:rgba(255,77,77,.22);border-color:rgba(255,77,77,.65);color:#fff;
  box-shadow:0 0 14px rgba(255,77,77,.35)}
.tts-stop-btn svg{width:15px;height:15px;fill:currentColor}
@keyframes pulseStop{0%,100%{box-shadow:0 0 0 0 rgba(255,77,77,.25)}50%{box-shadow:0 0 12px 2px rgba(255,77,77,.18)}}

.mem-toggle{display:flex;align-items:center;gap:8px;cursor:pointer;
  font-family: var(--font-ui);font-size:13px;color:var(--dim);
  background:rgba(167,139,250,.06);border:1px solid var(--line);
  padding:6px 12px;border-radius:var(--radius-sm);transition:var(--motion-fast)}
.mem-toggle:hover{color:var(--txt);border-color:var(--line-strong)}
.mem-toggle svg{width:16px;height:16px;fill:var(--violet)}
.mem-toggle.has{color:var(--violet);border-color:var(--violet)}
.mem-toggle .cnt{font-family: var(--font-mono);font-size:11px;background:rgba(167,139,250,.2);
  border-radius:var(--radius-xs);padding:0 6px;min-width:16px;text-align:center}
.mem-list{display:flex;flex-direction:column;gap:8px;margin-top:4px}
.mem-list .mi{display:flex;gap:8px;align-items:baseline;font-size:13px;line-height:1.4}
.mem-list .mk{color:var(--violet);font-family: var(--font-ui);font-weight:600;flex:0 0 auto}
.mem-list .mv{color:var(--txt)}
.mem-sub{font-size:12px;color:var(--dim);font-family: var(--font-mono);margin-top:6px}
.mem-summary{margin-top:10px;padding:10px 12px;border:1px solid rgba(167,139,250,.28);border-radius:var(--radius-sm);background:rgba(167,139,250,.07)}
.mem-sum-text{font-size:13px;line-height:1.55;color:var(--txt);white-space:pre-wrap;margin-top:3px}

.main{position:relative}

/* 原中央舞台区已移除，聊天区自动撑满主区 */
.chat-area{flex:1;justify-content:flex-end}

@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}

/* ---- 主界面语音球（常驻左侧 rail，固定在“新建会话”上方） ---- */
.orb-wrap{position:relative;width:420px;height:420px;display:grid;place-items:center;z-index: var(--z-orb);
  transition:width var(--motion-slow), height var(--motion-slow), filter var(--motion-base)}
/* 语音球移到 rail 后：固定尺寸，不再移动到角落 */
.rail .orb-wrap{width:160px;height:160px;margin:6px auto 4px}
.rail .orb-wrap .loc-readout{display:none}
.rail .orb-canvas-main{width:142px;height:142px}
.rail .earth-glow{width:152px;height:152px}

/* 语音球 hover 状态提示 */
.orb-wrap::after{
  content:attr(data-state);
  position:absolute;left:50%;bottom:-30px;transform:translateX(-50%);
  padding:6px 12px;border-radius:var(--radius-sm);
  background:rgba(8,14,20,.92);border:1px solid var(--line-strong);
  box-shadow:0 0 18px rgba(34,211,238,.22);
  color:var(--cyan);font-family: var(--font-mono);font-size:12px;letter-spacing:.5px;
  white-space:nowrap;opacity:0;pointer-events:none;
  transition:opacity var(--motion-fast) var(--ease-soft),transform var(--motion-fast) var(--ease-soft);z-index: var(--z-hud)}
.orb-wrap:hover::after{opacity:1;transform:translateX(-50%) translateY(0)}
.orb-wrap.thinking::after{color:var(--teal);border-color:rgba(45,212,191,.55);box-shadow:0 0 18px rgba(45,212,191,.22)}
.orb-wrap.listening::after{color:var(--cyan);border-color:rgba(34,211,238,.55);box-shadow:0 0 18px rgba(34,211,238,.22)}
.orb-wrap.speaking::after{color:var(--teal);border-color:rgba(45,212,191,.55);box-shadow:0 0 18px rgba(45,212,191,.22)}
.orb-wrap.error::after{color:var(--red);border-color:rgba(255,77,77,.55);box-shadow:0 0 18px rgba(255,77,77,.22)}

.orb-canvas-main{position:relative;width:360px;height:360px;display:block;z-index: var(--z-stage);
  filter:drop-shadow(0 0 34px rgba(34,211,238,.38));transition:width var(--motion-slow), height var(--motion-slow), filter var(--motion-base), transform var(--motion-base)}
/* 去掉 idle 呼吸缩放：球体大小恒定，仅由 voice-orb-simple.js 旋转点阵云（形状动、大小不动） */
.app:not(.has-messages) .orb-canvas-main{animation:none}

.earth-glow{position:absolute;inset:0;margin:auto;width:320px;height:320px;border-radius:50%;z-index: var(--z-ground);pointer-events:none;
  background:radial-gradient(circle,rgba(34,211,238,.26),rgba(45,212,191,.07) 45%,transparent 70%);
  filter:blur(8px)}

.orb-wrap.thinking .orb-canvas-main{filter:drop-shadow(0 0 46px rgba(45,212,191,.55)) brightness(1.08)}
.orb-wrap.speaking .orb-canvas-main{filter:drop-shadow(0 0 46px rgba(45,212,191,.6)) brightness(1.06)}
.orb-wrap.listening .orb-canvas-main{filter:drop-shadow(0 0 46px rgba(34,211,238,.6)) brightness(1.08)}

/* 定位浮标 */
.loc-readout{position:absolute;bottom:2px;left:50%;transform:translateX(-50%);z-index: var(--z-stage-deco);
  display:flex;align-items:center;gap:8px;white-space:nowrap;
  padding:8px 14px;border-radius:var(--radius-pill);cursor:default;
  background:rgba(8,14,20,.72);border:1px solid var(--line-strong);
  backdrop-filter: var(--glass-2);box-shadow:var(--shadow-glow);
  font-family: var(--font-mono);font-size:13px;color:var(--txt);max-width:300px;overflow:hidden}
.loc-readout .loc-pin{color:var(--cyan);font-size:13px;text-shadow:0 0 8px var(--cyan);flex:0 0 auto}
.loc-readout .loc-txt{color:var(--txt);letter-spacing:.3px;overflow:hidden;text-overflow:ellipsis}
.loc-readout .loc-txt b{color:var(--cyan);font-weight:600}
.loc-readout .loc-wx{color:var(--teal)}
.loc-readout .loc-coord{opacity:.55;font-family:var(--font-mono);font-size:.78em;letter-spacing:.2px}
@keyframes spin{to{transform:rotate(360deg)}}
.orb{position:relative;width:96px;height:96px;border-radius:50%;display:grid;place-items:center;
  background:radial-gradient(circle at 35% 30%,rgba(34,211,238,.55),rgba(11,16,22,.9) 70%);
  border:1px solid var(--line-strong);box-shadow:0 0 40px rgba(34,211,238,.45),inset 0 0 30px var(--border)}
.orb-core{position:absolute;width:38px;height:38px;border-radius:50%;
  background:radial-gradient(circle,#fff,rgba(34,211,238,.6));box-shadow:0 0 20px var(--cyan);
  animation:breathe 3.4s ease-in-out infinite}
@keyframes breathe{0%,100%{transform:scale(.85);opacity:.8}50%{transform:scale(1.05);opacity:1}}
.orb-wave{position:absolute;display:flex;align-items:flex-end;gap:4px;height:26px;opacity:0;transition:var(--motion-base)}
.orb-wave span{width:3px;height:8px;background:var(--cyan);border-radius:var(--radius-xs);box-shadow:0 0 6px var(--cyan)}
/* thinking/speaking 状态 */
.orb-wrap.thinking .orb{animation:shake 1.1s ease-in-out infinite}
.orb-wrap.thinking .orb-core{background:radial-gradient(circle,#fff,var(--teal));box-shadow:0 0 24px var(--teal)}
.orb-wrap.listening .orb{animation:listenPulse 1.1s ease-in-out infinite}
.orb-wrap.listening .orb-core{background:radial-gradient(circle,#fff,rgba(34,211,238,.85));box-shadow:0 0 26px var(--cyan)}
.orb-wrap.speaking .orb-wave{opacity:1}
.orb-wrap.speaking .orb-wave span{animation:eq var(--dur-focus) ease-in-out infinite}
.orb-wrap.speaking .orb-wave span:nth-child(2){animation-delay:.12s}
.orb-wrap.speaking .orb-wave span:nth-child(3){animation-delay:.24s}
.orb-wrap.speaking .orb-wave span:nth-child(4){animation-delay:.36s}
.orb-wrap.speaking .orb-wave span:nth-child(5){animation-delay:.48s}
@keyframes eq{0%,100%{height:8px}50%{height:24px}}
@keyframes shake{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
@keyframes listenPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.04)}}
.hero-title{font-family: var(--font-display);font-weight:700;font-size:26px;letter-spacing:4px;
  background:linear-gradient(90deg,var(--cyan),var(--teal));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero-sub{color:var(--dim);font-size:15px;letter-spacing:.5px}
.hero-hints{display:flex;gap:10px;margin-top:0;flex-wrap:wrap;justify-content:center}
.hint{padding:10px 16px;border-radius:var(--radius-lg);cursor:pointer;font-family: var(--font-ui);font-size:14px;font-weight:500;
  background:rgba(255,255,255,.04);border:1px solid var(--line);color:var(--dim);transition:var(--motion-fast)}
.hint:hover{color:var(--cyan);border-color:var(--line-strong);box-shadow:var(--shadow-glow)}

/* ---- 消息流 ---- */
.messages{display:flex;flex-direction:column;gap:18px;width:100%;max-width:1100px;margin:0 auto}

/* 聊天区：输入坞常驻，对话历史 hover 时折叠展开 */
.chat-area{
  display:flex;flex-direction:column;align-items:stretch;
  width:100%;max-width:min(100%,1340px);margin:0 auto;
  position:relative;z-index: var(--z-content);
  pointer-events:none; /* 空白处穿透到太阳系画布，仅输入框/历史可交互 */
}
/* 可折叠的对话历史：默认收起 */
/* ── A3 · Conversation Panel 同化：背景改 OS 玻璃令牌（替代硬编码暗色渐变），其余边框/半径/玻璃保持 ── */
.chat-history{
  display:flex;flex-direction:column;justify-content:flex-end;
  margin:0 4px;
  border-radius:var(--radius-lg) var(--radius-lg) 0 0;
  background:var(--glass);
  border:1px solid var(--line);border-bottom:none;
  backdrop-filter: var(--glass-2);
  max-height:0;opacity:0;overflow:hidden;pointer-events:none;
  transform:translateY(14px);
  transition:max-height var(--motion-slow) var(--ease-premium),opacity var(--motion-base) var(--ease-soft),
             transform var(--motion-slow) var(--ease-premium),border-color var(--motion-fast),box-shadow var(--motion-base);
}
.chat-area.open .chat-history{
  max-height:min(84vh,940px);opacity:1;transform:none;overflow:auto;pointer-events:auto;
  border-color:var(--line-strong);
  box-shadow:var(--shadow-glow); /* A3 · 复用 OS 发光令牌（替代硬编码青色 .10）*/
}
.chat-history .messages{
  display:flex;flex-direction:column;gap:18px;
  padding:16px 18px 8px;
}
.chat-history{
  overscroll-behavior:contain;
  scroll-behavior:smooth;
  scrollbar-width:thin;
  scrollbar-color:var(--line-strong) transparent;
}
.chat-history::-webkit-scrollbar{width:6px}
.chat-history::-webkit-scrollbar-thumb{background:var(--line-strong);border-radius:var(--radius-xs)}

/* 输入坞：常驻 */
.chat-area .dock{
  margin:0 4px 10px;
  padding:12px 14px;
  border-radius:0 0 var(--radius-lg) var(--radius-lg);
  background:var(--glass); /* A3 · 同化 OS 玻璃令牌（替代硬编码暗色渐变）*/
  border-top:1px solid var(--line);
  backdrop-filter: var(--glass-2);
  transition:var(--motion-fast);
  pointer-events:auto; /* 输入框始终可交互 */
}
.chat-area .dock.focus-within{border-color:var(--accent);box-shadow:var(--shadow-glow)}
.chat-area.open .dock{border-color:var(--line-strong)}

.msg{display:flex;gap:14px;animation:msgIn var(--motion-base) var(--ease-soft) both}
@keyframes msgIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.msg .avatar{width:38px;height:38px;flex:0 0 38px;border-radius:var(--radius-sm);display:grid;place-items:center;
  font-family: var(--font-display);font-size:13px;font-weight:700}
.msg.user{flex-direction:row-reverse}
.msg.user .avatar{background:color-mix(in srgb, var(--amber) 16%, transparent);border:1px solid color-mix(in srgb, var(--amber) 40%, transparent);color:var(--amber) /* A3 · 令牌化琥珀强调 */}
.msg.zhuangzhou .avatar{background:color-mix(in srgb, var(--cyan) 16%, transparent);border:1px solid var(--line-strong);color:var(--cyan) /* A3 · 令牌化青色强调 */}
.bubble{padding:14px 16px;border-radius:var(--radius-md);max-width:72%;font-size:16px;line-height:1.6;letter-spacing:.2px;
  border:1px solid var(--line);background:var(--panel) /* A3 · 同化 OS 面板令牌（替代硬编码白 .03）*/}
.msg.user .bubble{background:color-mix(in srgb, var(--amber) 10%, transparent);border-color:color-mix(in srgb, var(--amber) 30%, transparent);border-top-right-radius:var(--radius-xs) /* A3 · 令牌化琥珀 + 半径令牌 */}
.msg.zhuangzhou .bubble{border-top-left-radius:var(--radius-xs);background:color-mix(in srgb, var(--cyan) 8%, transparent) /* A3 · 令牌化青色 + 半径令牌 */}
.bubble .typing{display:inline-flex;gap:6px;align-items:center;height:20px}
.bubble .typing i{width:7px;height:7px;border-radius:50%;background:var(--cyan);animation:blink 1.2s infinite}
.bubble .typing i:nth-child(2){animation-delay:.2s}.bubble .typing i:nth-child(3){animation-delay:.4s}
@keyframes blink{0%,100%{opacity:.3;transform:translateY(0)}50%{opacity:1;transform:translateY(-3px)}}
.msg-actions{display:flex;align-items:flex-start;padding-top:8px;opacity:0;transition:var(--motion-fast)}
.msg:hover .msg-actions{opacity:1}
.msg.proactive .bubble{background:color-mix(in srgb, var(--cyan) 12%, transparent);border:1px solid color-mix(in srgb, var(--accent) 35%, transparent);box-shadow:var(--shadow-glow) /* A3 · 令牌化 + 复用 OS 发光 */}
.proactive-tag{display:inline-block;align-self:flex-start;margin:0 0 4px 52px;padding:2px 10px;border-radius:var(--radius-pill);font-size:11px;letter-spacing:1px;font-family: var(--font-mono);color:var(--cyan);background:color-mix(in srgb, var(--cyan) 12%, transparent);border:1px solid color-mix(in srgb, var(--accent) 35%, transparent)}
.speak-btn{width:30px;height:30px;border-radius:var(--radius-sm);cursor:pointer;color:var(--dim);
  background:color-mix(in srgb, var(--cyan) 10%, transparent);border:1px solid var(--line);display:grid;place-items:center;transition:var(--motion-fast) /* A3 · 令牌化 */}
.speak-btn .ic{width:15px;height:15px;fill:var(--cyan);stroke:none}
.speak-btn:hover{color:var(--cyan);border-color:var(--line-strong);box-shadow:var(--shadow-glow)}

/* ---------- 工具执行浮层 ---------- */
.tool-overlay{position:absolute;left:50%;bottom:18px;transform:translateX(-50%) translateY(14px);
  display:flex;align-items:center;gap:12px;max-width:90%;padding:12px 18px;border-radius:var(--radius-md);
  background:var(--panel-solid);border:1px solid var(--line-strong);box-shadow:var(--shadow-glow); /* A3 · 令牌化实体底色（主题自适应）*/
  font-family: var(--font-ui);font-size:14px;color:var(--txt);opacity:0;pointer-events:none;
  transition:var(--motion-base);z-index: var(--z-popover);backdrop-filter: var(--glass-2)}
.tool-overlay.show{opacity:1;transform:translateX(-50%) translateY(0)}
.tool-overlay .tg-ico{font-size:15px;color:var(--amber);animation:spin 3s linear infinite}
.tool-overlay .tg-ico.ok{color:var(--teal);animation:none}
.tool-overlay .tg-txt b{color:var(--cyan);font-weight:700}
.tool-overlay .tg-state{font-family: var(--font-mono);font-size:12px;color:var(--dim);
  padding-left:10px;border-left:1px solid var(--line);max-width:320px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tool-overlay .tg-state.run{color:var(--amber)}
.tool-overlay .tg-state.ok{color:var(--teal)}

/* ---------- 声明式场景卡片（scene） ---------- */
/* 挂在中央 stage 区（语音球下方），构成庄周想「声明」的可视化界面；按 id 幂等渲染/移除 */
.scene-layer{position:absolute;left:0;right:0;bottom:0;top:0;display:flex;flex-direction:column;
  align-items:center;justify-content:flex-end;gap:14px;padding:0 24px 30px;pointer-events:none;z-index: var(--z-content)}
.scene-card{position:relative;width:min(440px,86%);max-height:52%;overflow:auto;pointer-events:auto;
  border-radius:var(--radius-lg);padding:16px 18px;background:var(--glass);border:1px solid var(--line-strong);
  box-shadow:var(--shadow-glow);backdrop-filter: var(--glass-3);
  opacity:0;transform:translateY(16px) scale(.97);transition:opacity var(--motion-base) var(--ease-soft),transform var(--motion-base) var(--ease-premium)}
.scene-card.entering{opacity:1;transform:translateY(0) scale(1)}
.scene-card.leaving{opacity:0;transform:translateY(10px) scale(.97)}
.scene-card[data-kind="progress"]{border-color:rgba(45,212,191,.4)}
.scene-card[data-kind="choice"]{border-color:rgba(34,211,238,.38)}
.scene-card[data-kind="media"]{border-color:rgba(245,181,68,.34)}
.sc-head{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.sc-kind{font-size:15px;filter:drop-shadow(0 0 6px rgba(34,211,238,.5))}
.sc-title{font-family: var(--font-display);font-size:15px;font-weight:700;color:var(--txt);
  letter-spacing:.4px;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sc-close{flex:0 0 auto;width:24px;height:24px;border-radius:var(--radius-sm);cursor:pointer;color:var(--dim);
  background:transparent;border:1px solid var(--line);display:grid;place-items:center;font-size:15px;line-height:1;
  transition:var(--motion-fast);margin-left:auto}
.sc-close:hover{color:var(--txt);border-color:var(--line-strong);background:rgba(255,255,255,.06)}
.sc-close--bare{position:absolute;top:10px;right:12px;margin:0}
.sc-body{font-size:14px;color:var(--txt);line-height:1.6}
.sc-text{white-space:pre-wrap;word-break:break-word;color:var(--txt)}
.sc-list{list-style:none;margin:8px 0 0;padding:0;display:flex;flex-direction:column;gap:7px}
.sc-list li{padding:8px 12px;border-radius:var(--radius-sm);background:rgba(255,255,255,.04);border:1px solid var(--line);
  color:var(--txt);font-size:14px}
.sc-list li::before{content:"▹";color:var(--cyan);margin-right:8px}
.sc-choices{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px}
.sc-choice{cursor:pointer;padding:10px 16px;border-radius:var(--radius-sm);font-family: var(--font-ui);font-size:14px;font-weight:600;
  color:var(--cyan);background:rgba(34,211,238,.08);border:1px solid color-mix(in srgb, var(--accent) 35%, transparent);transition:var(--motion-fast)}
.sc-choice:hover{background:rgba(34,211,238,.18);border-color:var(--cyan);transform:translateY(-1px)}
.sc-choice:active{transform:translateY(0) scale(.98)}
.sc-media-btn{cursor:pointer;margin-top:10px;padding:10px 16px;border-radius:var(--radius-sm);font-family: var(--font-ui);font-size:14px;
  font-weight:600;color:var(--amber);background:rgba(245,181,68,.08);border:1px solid color-mix(in srgb, var(--warn) 35%, transparent);transition:var(--motion-fast)}
.sc-media-btn:hover{background:rgba(245,181,68,.18);border-color:var(--amber)}
.sc-img{display:block;width:100%;border-radius:var(--radius-md);margin-top:8px;border:1px solid var(--line)}
.sc-progress{margin-top:10px}
.sc-bar{height:9px;border-radius:var(--radius-xs);background:rgba(255,255,255,.08);overflow:hidden;border:1px solid var(--line)}
.sc-fill{height:100%;border-radius:var(--radius-xs);background:linear-gradient(90deg,var(--teal),var(--cyan));
  box-shadow:0 0 12px rgba(45,212,191,.6);transition:width var(--motion-slow) var(--ease-premium)}
.sc-pct{margin-top:8px;font-family: var(--font-mono);font-size:13px;color:var(--teal)}

/* 新 kind：metric / form / selfcheck / awakening / 容器 */
.scene-card[data-kind="metric"]{border-color:rgba(34,211,238,.36)}
.scene-card[data-kind="form"]{border-color:rgba(245,181,68,.32)}
.scene-card[data-kind="selfcheck"]{border-color:rgba(45,212,191,.34)}
.scene-card[data-kind="awakening"]{border-color:rgba(34,211,238,.5);box-shadow:0 0 22px var(--border)}
.scene-card[data-kind="stack"],.scene-card[data-kind="row"],.scene-card[data-kind="col"]{border-color:rgba(255,255,255,.16)}
.sc-metric{margin-top:4px;display:flex;flex-direction:column;gap:2px}
.sc-metric-val{font-family: var(--font-display);font-size:34px;font-weight:700;color:var(--cyan);
  line-height:1.05;text-shadow:0 0 16px rgba(34,211,238,.45);letter-spacing:.5px}
.sc-metric-unit{font-size:16px;margin-left:6px;color:var(--teal);font-family: var(--font-ui)}
.sc-metric-label{font-size:13px;color:var(--dim);font-family: var(--font-ui)}
.sc-metric-delta{font-family: var(--font-mono);font-size:13px;margin-top:1px}
.sc-delta-up{color:#4ade80}.sc-delta-down{color:#f87171}.sc-delta-flat{color:var(--dim)}
.sc-form{display:flex;flex-direction:column;gap:10px;margin-top:6px}
.sc-field{display:flex;flex-direction:column;gap:4px;font-size:13px;color:var(--dim);font-family: var(--font-ui)}
.sc-input{flex:1;background:rgba(5,7,10,.55);border:1px solid var(--input-border);border-radius:var(--radius-sm);padding:8px 12px;
  color:var(--text);font-family: var(--font-ui);font-size:14px;outline:0;transition:var(--motion-fast)}
.sc-input:focus{border-color:var(--input-focus-border);box-shadow:0 0 10px rgba(34,211,238,.25)}
.sc-submit{margin-top:2px;cursor:pointer;padding:10px 16px;border-radius:var(--radius-sm);font-family: var(--font-ui);font-size:14px;font-weight:600;
  color:#03121a;background:linear-gradient(135deg,var(--cyan),var(--teal));border:0;transition:var(--motion-fast)}
.sc-submit:hover{transform:translateY(-1px)}
.sc-check{list-style:none;margin:8px 0 0;padding:0;display:flex;flex-direction:column;gap:7px}
.sc-check li{display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:var(--radius-sm);background:rgba(255,255,255,.04);
  border:1px solid var(--line);font-size:14px;color:var(--txt)}
.sc-check li.ok .sc-tick{color:#4ade80}.sc-check li.bad .sc-tick{color:#f87171}
.sc-tick{font-weight:700}
.sc-summary{margin-top:10px;font-size:13px;color:var(--teal);font-family: var(--font-ui)}
.sc-awaken{margin-top:10px;cursor:pointer;padding:12px 20px;border-radius:var(--radius-md);font-family: var(--font-ui);font-size:15px;font-weight:700;
  color:#03121a;background:linear-gradient(135deg,var(--cyan),var(--teal));border:0;transition:var(--motion-fast);
  box-shadow:0 0 18px rgba(34,211,238,.4);animation:awakenPulse 2.2s ease-in-out infinite}
.sc-awaken:hover{transform:translateY(-1px) scale(1.02)}
@keyframes awakenPulse{0%,100%{box-shadow:0 0 14px color-mix(in srgb, var(--accent) 35%, transparent)}50%{box-shadow:0 0 26px rgba(34,211,238,.7)}}
.sc-children{display:flex;gap:12px;margin-top:8px}
.sc-children-row{flex-direction:row;flex-wrap:wrap}
.sc-children-col{flex-direction:column}
.sc-child{flex:1;min-width:0;padding:12px 14px;border-radius:var(--radius-md);background:rgba(255,255,255,.03);
  border:1px solid var(--line)}

/* ---- 输入坞 ---- */
.dock{display:flex;align-items:flex-end;gap:12px;padding:12px 14px;border-top:1px solid var(--line);background:transparent}
.mic-btn{width:46px;height:46px;flex:0 0 46px;border-radius:var(--radius-md);cursor:pointer;color:var(--txt);
  background:rgba(255,255,255,.06);border:1px solid var(--line);display:grid;place-items:center;transition:var(--motion-fast);pointer-events:auto}
.mic-btn .ic{fill:var(--txt);stroke:none}
#btnImage .ic, #btnMedia .ic, #btnScreen .ic{fill:none;stroke:var(--txt);stroke-width:1.4}
#btnImage:hover .ic, #btnMedia:hover .ic, #btnScreen:hover .ic{stroke:var(--cyan)}
#btnImage:hover, #btnMedia:hover, #btnScreen:hover{color:var(--cyan);border-color:var(--line-strong);background:rgba(34,211,238,.08)}
.mic-btn:hover{color:var(--cyan);border-color:var(--line-strong);background:rgba(34,211,238,.08)}
.mic-btn.recording{color:#fff;border-color:var(--cyan);background:color-mix(in srgb, var(--accent) 16%, transparent);animation:micPulse 1.1s ease-in-out infinite}
@keyframes micPulse{0%,100%{box-shadow:0 0 14px rgba(34,211,238,.4)}50%{box-shadow:0 0 26px rgba(34,211,238,.75)}}
.input-shell{flex:1;display:flex;align-items:center;
  background:transparent;border:0;border-radius:var(--radius-md);padding:4px 14px;transition:var(--motion-fast)}
#input{width:100%;resize:none;border:0;outline:0;background:transparent;color:var(--text);
  font-family: var(--font-ui);font-size:16px;line-height:1.5;max-height:120px;padding:9px 0;
  transition:color var(--motion-fast) var(--ease-soft)}
#input::placeholder{color:var(--input-placeholder)}
.send-btn{width:46px;height:46px;flex:0 0 46px;border-radius:var(--radius-md);cursor:pointer;color:#03121a;
  background:linear-gradient(135deg,var(--cyan),var(--teal));border:0;display:grid;place-items:center;
  box-shadow:var(--shadow-glow);transition:var(--motion-fast)}
.send-btn .ic{fill:#03121a;stroke:none}
.send-btn:hover{transform:translateY(-1px) scale(1.03)}
.send-btn:disabled{opacity:.5;cursor:not-allowed;transform:none}

/* ---------- 右侧遥测 ---------- */
.tele{display:flex;flex-direction:column;gap:16px;overflow:hidden;
  background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-md);
  padding:18px 16px;backdrop-filter: var(--glass-2);transition:var(--motion-base)}
.app.tele-hidden .tele{opacity:0;pointer-events:none;transform:translateX(20px)}
.tele-head{display:flex;align-items:center;justify-content:space-between;
  font-family: var(--font-display);letter-spacing:2px;font-size:13px;color:var(--cyan)}
.tele-close{background:none;border:0;color:var(--dim);cursor:pointer;width:26px;height:26px;display:grid;place-items:center}
.tele-close:hover{color:var(--cyan)}
.meter{background:rgba(5,7,10,.5);border:1px solid var(--line);border-radius:var(--radius-md);padding:13px}
.meter-label{font-family: var(--font-mono);font-size:11px;color:var(--dim2);letter-spacing:1px}
.meter-val{font-family: var(--font-display);font-size:22px;letter-spacing:2px;color:var(--teal);margin:4px 0 10px;
  text-shadow:0 0 12px rgba(45,212,191,.4)}
.meter-bar{height:5px;border-radius:var(--radius-xs);background:rgba(255,255,255,.06);overflow:hidden}
.meter-bar i{display:block;height:100%;background:linear-gradient(90deg,var(--cyan),var(--teal));transition:width var(--motion-slow)}
.tele-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tcell{background:rgba(5,7,10,.5);border:1px solid var(--line);border-radius:var(--radius-sm);padding:11px}
.tk{display:block;font-family: var(--font-mono);font-size:10px;color:var(--dim2);letter-spacing:1px}
.tv{display:block;font-family: var(--font-ui);font-weight:600;font-size:15px;color:var(--txt);margin-top:4px;
  word-break:break-all}
.tele-block{background:rgba(5,7,10,.5);border:1px solid var(--line);border-radius:var(--radius-md);padding:13px}
.tele-title{font-family: var(--font-mono);font-size:11px;color:var(--dim2);letter-spacing:1px;margin-bottom:10px}
.trait-list{list-style:none;display:flex;flex-direction:column;gap:7px}
.trait-list li{font-size:14px;color:var(--dim);padding-left:16px;position:relative}
.trait-list li::before{content:"";position:absolute;left:0;top:8px;width:6px;height:6px;border-radius:50%;
  background:var(--teal);box-shadow:0 0 6px var(--teal)}
.mem-note{font-size:14px;color:var(--dim);line-height:1.5}

.tele-open{position:fixed;right:0;top:50%;z-index: var(--z-popover);width:34px;height:88px;border-radius:14px 0 0 14px;
  display:none;place-items:center;cursor:pointer;color:var(--cyan);
  background:var(--panel-solid);border:1px solid var(--line-strong);border-right:0;box-shadow:var(--shadow-glow);
  transform:translateY(-50%);padding:0 4px 0 6px}
.tele-open .ic{width:22px;height:22px;opacity:.9}
.tele-open:hover{background:rgba(34,211,238,.12);box-shadow:0 0 20px rgba(34,211,238,.25)}
.app.tele-hidden .tele-open{display:grid}

/* ---------- Toast ---------- */
.toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(20px);
  background:rgba(255,77,77,.12);border:1px solid rgba(255,77,77,.45);color:#ffd0d0;
  padding:12px 20px;border-radius:var(--radius-sm);font-size:14px;opacity:0;pointer-events:none;transition:var(--motion-base);z-index: var(--z-overlay)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* Workspace（.app）响应式策略：固定画布 + JS 整体缩放，任何窗口尺寸下布局不变。
 * 故 .app 不参与 Formal UI System 的 Compact(≤1199)/Narrow(≤980) 断点重排 —— 这是
 * 有意设计而非遗漏。原此处两段被注释废弃的 1080/680 断点代码已删除（死代码，
