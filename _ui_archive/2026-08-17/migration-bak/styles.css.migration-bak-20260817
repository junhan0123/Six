.settings-panel.open{transform:translateX(0)}

.settings-head{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;
  border-bottom:1px solid var(--line);background:rgba(5,7,10,.45)}
.settings-head-title{font-family: var(--font-display);font-size:16px;letter-spacing:2px;color:var(--accent)}
.settings-close{width:32px;height:32px;border-radius:var(--radius-sm);display:grid;place-items:center;cursor:pointer;
  background:rgba(255,255,255,.04);border:1px solid var(--line);color:var(--dim);font-size:20px;line-height:1}
.settings-close:hover{color:var(--txt);border-color:var(--line-strong);background:rgba(255,255,255,.08)}

.settings-body{flex:1;display:flex;min-height:0}
.settings-nav{flex:0 0 150px;display:flex;flex-direction:column;gap:4px;padding:16px 12px;
  border-right:1px solid var(--line);overflow-y:auto;background:rgba(5,7,10,.35)}
.settings-nav-item{text-align:left;padding:10px 14px;border-radius:var(--radius-sm);border:1px solid transparent;
  background:transparent;color:var(--dim);font-size:13px;cursor:pointer;transition:var(--motion-fast)}
.settings-nav-item:hover{color:var(--txt);background:rgba(255,255,255,.04)}
.settings-nav-item.active{color:var(--cyan);border-color:color-mix(in srgb, var(--accent) 35%, transparent);background:rgba(34,211,238,.08)}

.settings-content{flex:1;padding:20px 22px;overflow-y:auto;scrollbar-width:thin;scrollbar-color:var(--line-strong) transparent}
.settings-content::-webkit-scrollbar{width:5px}
.settings-content::-webkit-scrollbar-thumb{background:var(--line-strong);border-radius:var(--radius-pill)}

.settings-tab{display:none}
.settings-tab.active{display:block;animation:fadeUp var(--motion-base) var(--ease-soft) both}

.settings-section{margin-bottom:22px;padding-bottom:18px;border-bottom:1px solid var(--line)}
.settings-section:last-child{border-bottom:none;margin-bottom:0}
.settings-section-label{font-family: var(--font-mono);font-size:12px;letter-spacing:1px;color:var(--cyan);margin-bottom:12px}
.settings-row{display:flex;align-items:center;gap:12px;margin-bottom:10px;flex-wrap:wrap}
.settings-label{flex:0 0 110px;font-size:13px;color:var(--txt)}
.settings-input,.settings-select{flex:1;min-width:120px;padding:var(--input-pad-y) var(--input-pad-x);border-radius:var(--input-radius);
  background:var(--input-bg);border:1px solid var(--input-border);color:var(--text);font-size:var(--input-font);outline:none;transition:var(--motion-fast)}
.settings-input::placeholder,.settings-select::placeholder{color:var(--input-placeholder)}
.settings-input:hover,.settings-select:hover{border-color:var(--line-strong)}
.settings-input:focus,.settings-select:focus{border-color:var(--input-focus-border);box-shadow:0 0 0 3px var(--input-focus-glow)}
.settings-input:disabled,.settings-select:disabled{opacity:var(--input-disabled-op);cursor:not-allowed}
.settings-input[data-error="true"],.settings-input.zz-input--error,.settings-select[data-error="true"],.settings-select.zz-input--error{border-color:var(--input-error-border)}
.settings-row-action{display:flex;align-items:center;gap:10px;margin-top:12px;flex-wrap:wrap}
.settings-save-btn{padding:8px 18px;border-radius:var(--radius-sm);border:1px solid var(--line-strong);
  background:linear-gradient(135deg,rgba(34,211,238,.18),rgba(45,212,191,.12));color:var(--txt);
  font-size:13px;cursor:pointer;transition:var(--motion-fast)}
.settings-save-btn:hover{border-color:var(--cyan);box-shadow:0 0 14px rgba(34,211,238,.2)}
.settings-row-btn{padding:8px 14px;font-size:12px;white-space:nowrap}
.settings-feedback{font-size:12px;color:var(--teal);font-family: var(--font-mono)}
.settings-hint{font-size:12px;color:var(--dim);line-height:1.55;margin:8px 0 12px}

/* ---- 开关（设置面板通用，参考参考实现） ---- */
.settings-switch{position:relative;display:inline-block;width:42px;height:24px;flex:0 0 auto}
.settings-switch input{opacity:0;width:0;height:0;margin:0}
.settings-switch-slider{position:absolute;inset:0;cursor:pointer;background:rgba(255,255,255,.12);
  border:1px solid var(--line);border-radius:var(--radius-lg);transition:var(--motion-fast)}
.settings-switch-slider:before{content:"";position:absolute;height:18px;width:18px;left:3px;top:2px;
  background:#e6eef2;border-radius:50%;transition:var(--motion-fast)}
.settings-switch input:checked + .settings-switch-slider{background:linear-gradient(135deg,rgba(34,211,238,.5),rgba(45,212,191,.4));
  border-color:rgba(34,211,238,.5)}
.settings-switch input:checked + .settings-switch-slider:before{transform:translateX(18px);background:#fff}

/* ---- 系统提示词预览（参考参考实现） ---- */
.sysprompt-overlay{position:fixed;inset:0;z-index: var(--z-dialog-mask);background:var(--ws-overlay-scrim);backdrop-filter: var(--glass-1);
  opacity:0;pointer-events:none;transition:opacity var(--motion-base)}
.sysprompt-overlay.show{opacity:1;pointer-events:auto}
.sysprompt-panel{position:fixed;top:50%;left:50%;transform:translate(-50%,-46%) scale(.98);
  width:min(900px,94vw);max-height:86vh;z-index: var(--z-dialog);display:flex;flex-direction:column;
  background:linear-gradient(180deg,rgba(13,18,26,.96),rgba(8,12,17,.96));
  border:1px solid var(--line-strong);border-radius:var(--radius-md);box-shadow:var(--shadow-glow);
  opacity:0;pointer-events:none;transition:opacity var(--motion-base),transform var(--motion-base) var(--ease-premium)}
.sysprompt-panel.open{opacity:1;pointer-events:auto;transform:translate(-50%,-50%) scale(1)}
.sysprompt-body{padding:6px 22px 22px;overflow:auto;display:flex;flex-direction:column;gap:12px;min-height:0}
.sysprompt-meta{font-family: var(--font-mono);font-size:12px;color:var(--dim);padding-top:4px}
.sysprompt-text{margin:0;white-space:pre-wrap;word-break:break-word;
  font-family: var(--font-mono);font-size:13px;line-height:1.75;color:var(--txt);
  background:rgba(0,0,0,.28);border:1px solid var(--line);border-radius:var(--radius-sm);padding:14px 16px;
  max-height:64vh;overflow:auto}

/* ============ 能力清单面板 ============ */
.cap-overlay{position:fixed;inset:0;z-index: var(--z-dialog-mask);background:var(--ws-overlay-scrim);backdrop-filter:blur(var(--ws-overlay-blur));-webkit-backdrop-filter:blur(var(--ws-overlay-blur));
  opacity:0;pointer-events:none;transition:opacity var(--motion-base) var(--ease-soft)}
.cap-overlay.show{opacity:1;pointer-events:auto}
.cap-panel{position:fixed;top:50%;left:50%;transform:translate(-50%,-46%) scale(.98);
  width:min(920px,94vw);max-height:86vh;z-index: var(--z-dialog);display:flex;flex-direction:column;
  background:linear-gradient(180deg, var(--surface-2), var(--bg-2));
  border:1px solid var(--border);border-radius:var(--radius-lg);box-shadow:var(--elev-3);
  backdrop-filter: blur(var(--ws-overlay-blur));-webkit-backdrop-filter: blur(var(--ws-overlay-blur));
  opacity:0;pointer-events:none;transition:opacity var(--motion-base) var(--ease-soft),transform var(--motion-base) var(--ease-premium)}
.cap-panel.open{opacity:1;pointer-events:auto;transform:translate(-50%,-50%) scale(1)}
.cap-panel .settings-head{display:flex;align-items:center;gap:14px}
.cap-meta{font-family: var(--font-mono);font-size:12px;color:var(--dim);margin-left:auto;
  padding-right:10px;letter-spacing:.02em}
.cap-body{padding:18px 22px 24px;overflow:auto;display:flex;flex-direction:column;gap:14px;min-height:0}
.cap-loading{font-family: var(--font-mono);font-size:13px;color:var(--dim);padding:24px;text-align:center}

.cap-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}
.cap-card{position:relative;display:flex;flex-direction:column;gap:10px;
  padding:16px 16px 14px;border-radius:var(--radius-md);cursor:pointer;
  background:rgba(255,255,255,.04);border:1px solid var(--line);
  backdrop-filter: var(--glass-2);-webkit-backdrop-filter: var(--glass-2);
  box-shadow:var(--elev-2);
  transition:transform var(--motion-fast) var(--ease-premium),border-color var(--motion-fast),box-shadow var(--motion-fast),background var(--motion-fast)}
.cap-card:hover{transform:translateY(-3px);border-color:color-mix(in srgb,#A78BFA 55%,var(--line));
  box-shadow:0 16px 40px rgba(0,0,0,.38),0 0 22px rgba(167,139,250,.18);
  background:rgba(167,139,250,.07)}
.cap-card.is-active{border-color:color-mix(in srgb,#A78BFA 45%,var(--line))}
.cap-card.is-active::before{content:"";position:absolute;inset:0;border-radius:var(--radius-md);pointer-events:none;
  box-shadow:inset 0 0 22px rgba(167,139,250,.12)}
.cap-card-top{display:flex;align-items:center;gap:12px}
.cap-icon{width:42px;height:42px;flex:none;display:grid;place-items:center;font-size:22px;border-radius:var(--radius-md);
  background:rgba(167,139,250,.12);border:1px solid rgba(167,139,250,.28);
  box-shadow:0 0 16px rgba(167,139,250,.18);filter:drop-shadow(0 0 6px rgba(167,139,250,.25))}
.cap-card-h{display:flex;flex-direction:column;gap:4px;min-width:0}
.cap-card-title{font-size:15px;font-weight:700;color:var(--txt);letter-spacing:.01em;
  font-family: var(--font-ui)}
.cap-status{font-size:11px;font-family: var(--font-mono);letter-spacing:.02em}
.cap-status.on{color:var(--ok)}
.cap-status.off{color:var(--dim)}
.cap-desc{margin:0;font-size:13px;line-height:1.6;color:var(--text-dim);opacity:.92}
.cap-chips{display:flex;flex-wrap:wrap;gap:6px}
.cap-chip{font-size:11px;font-family: var(--font-mono);color:#cdb6ff;
  padding:2px 10px;border-radius:var(--radius-pill);background:rgba(167,139,250,.1);
  border:1px solid rgba(167,139,250,.22)}
.cap-try{margin-top:2px;align-self:flex-start;
  font-size:13px;font-weight:600;color:#e9e3ff;cursor:pointer;
  padding:8px 14px;border-radius:var(--radius-sm);
  background:linear-gradient(180deg,rgba(167,139,250,.28),rgba(167,139,250,.16));
  border:1px solid rgba(167,139,250,.4);
  transition:background var(--motion-fast),transform var(--motion-fast),box-shadow var(--motion-fast)}
.cap-try:hover{background:linear-gradient(180deg,rgba(167,139,250,.42),rgba(167,139,250,.26));
  transform:translateY(-1px);box-shadow:0 0 18px rgba(167,139,250,.35)}
.cap-try:active{transform:translateY(0) scale(.97)}

/* 能力卡片：可展开看工作原理 + 分组 + 刷新按钮 */
.cap-expand{margin-left:auto;font-size:14px;color:var(--dim);transition:transform var(--motion-base);pointer-events:none}
.cap-card.expanded .cap-expand{transform:rotate(180deg);color:#cdb6ff}
.cap-card.expanded{border-color:color-mix(in srgb,#A78BFA 50%,var(--line));background:rgba(167,139,250,.08)}
.cap-detail{max-height:0;overflow:hidden;opacity:0;transition:max-height var(--motion-base) var(--ease-soft),opacity var(--motion-base) var(--ease-soft);margin:0}
.cap-card.expanded .cap-detail{max-height:220px;opacity:1;margin-top:2px}
.cap-detail-label{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#9f8fd6;
  margin-bottom:6px;font-family: var(--font-mono)}
.cap-how{margin:0;font-size:12px;line-height:1.65;color:var(--text-dim);
  background:rgba(0,0,0,.22);border-left:2px solid rgba(167,139,250,.5);padding:10px 12px;border-radius:var(--radius-sm)}

.cap-group{display:flex;flex-direction:column;gap:12px}
.cap-group-title{font-family: var(--font-ui);font-size:13px;font-weight:700;
  letter-spacing:.06em;color:#cdb6ff;display:flex;align-items:center;gap:10px;margin:2px 0 -2px}
.cap-group-title::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,rgba(167,139,250,.35),transparent)}

.cap-refresh{width:30px;height:30px;flex:none;border-radius:var(--radius-sm);cursor:pointer;
  border:1px solid var(--line);background:rgba(255,255,255,.05);color:var(--text-dim);
  font-size:15px;line-height:1;display:grid;place-items:center;transition:var(--motion-fast)}
.cap-refresh:hover{background:rgba(167,139,250,.22);border-color:rgba(167,139,250,.45);transform:rotate(90deg)}
.cap-refresh:active{transform:scale(.92)}

/* 主题切换 */
.theme-options{display:flex;gap:10px;flex-wrap:wrap}
.theme-opt{width:78px;padding:10px 8px;border-radius:var(--radius-md);border:1px solid var(--line);background:rgba(5,7,10,.5);
  cursor:pointer;text-align:center;transition:var(--motion-fast)}
.theme-opt:hover{border-color:var(--line-strong)}
.theme-opt.active{border-color:var(--cyan);background:rgba(34,211,238,.1);box-shadow:0 0 14px rgba(34,211,238,.15)}
.theme-opt-dot{width:28px;height:28px;border-radius:50%;margin:0 auto 8px;border:1px solid rgba(255,255,255,.1)}
.theme-opt-dot.void{background:radial-gradient(circle at 35% 30%,var(--cyan),#05070A 70%)}
.theme-opt-dot.light{background:radial-gradient(circle at 35% 30%,#7dd3fc,#f1f5f9 70%)}
.theme-opt-dot.system{background:conic-gradient(var(--cyan) 0deg 180deg,#f1f5f9 180deg 360deg)}
.theme-opt-name{font-size:11px;color:var(--dim)}
.theme-opt.active .theme-opt-name{color:var(--txt)}

/* 开关 */
.zz-toggle{display:flex;align-items:center;gap:10px;cursor:pointer}
.zz-toggle input{position:absolute;opacity:0;width:0;height:0}
.zz-toggle-track{width:40px;height:22px;border-radius:var(--radius-pill);background:rgba(255,255,255,.1);border:1px solid var(--line);
  position:relative;transition:var(--motion-fast)}
.zz-toggle-track::after{content:'';position:absolute;left:2px;top:2px;width:16px;height:16px;border-radius:50%;
  background:var(--txt);transition:var(--motion-fast);box-shadow:0 0 6px rgba(0,0,0,.3)}
.zz-toggle input:checked + .zz-toggle-track{background:rgba(34,211,238,.25);border-color:rgba(34,211,238,.5)}
.zz-toggle input:checked + .zz-toggle-track::after{left:20px;background:var(--cyan)}
.zz-toggle input:focus-visible + .zz-toggle-track{outline:2px solid var(--accent);outline-offset:2px}
.zz-toggle input:disabled + .zz-toggle-track{opacity:var(--input-disabled-op);cursor:not-allowed}

/* 滑块 */
.settings-range{flex:1;display:flex;align-items:center;gap:10px}
.settings-range input[type=range]{flex:1;cursor:pointer}
.settings-range-val{min-width:3em;text-align:right;font-family: var(--font-mono);font-size:13px;color:var(--cyan)}

/* 快捷入口卡片 */
.settings-cards{display:grid;grid-template-columns:repeat(2, 1fr);gap:10px}
.settings-card{padding:14px;border-radius:var(--radius-md);border:1px solid var(--line);background:rgba(5,7,10,.45);
  cursor:pointer;transition:var(--motion-fast);display:flex;flex-direction:column;gap:6px}
.settings-card:hover{border-color:var(--line-strong);background:rgba(255,255,255,.04);transform:translateY(-2px)}
.settings-card-title{font-size:14px;font-weight:600;color:var(--txt)}
.settings-card-desc{font-size:11px;color:var(--dim)}

/* 快捷键 */
.kbd-list{display:grid;gap:8px}
.kbd-row{display:flex;justify-content:space-between;align-items:center;font-size:13px;color:var(--dim)}
.kbd-row kbd{padding:4px 8px;border-radius:var(--radius-xs);background:rgba(255,255,255,.06);border:1px solid var(--line);
  font-family: var(--font-mono);font-size:11px;color:var(--txt)}

/* ── LEGACY FALLBACK（Formal UI System v1.0 · Phase A / D-02）──
 * 浅色主题令牌此前在此以 body[data-theme="light"] (特异性 0,1,1) 重定义，
 * 会覆盖 ui2.css [data-theme="light"] (0,1,0) 的权威值，造成主题双源冲突
 * （含 --line/--line-strong/--panel-solid/--void 4 个真实视觉差）。
 * 现所有主题令牌的唯一权威收口到 ui2.css [data-theme]，此处不再重定义令牌；
 * R1 的 WCAG AA 可读变体（--cyan:#0E7490 / --teal:#0F766E）已在 ui2.css light 块逐字保留。
 * 仅保留旧 UI 的 light 组件外观规则（.bg-glow / .bubble，见下）。 */
body[data-theme="light"] .bg-glow{background:radial-gradient(60% 50% at 22% 18%,rgba(34,211,238,.18),transparent 60%),radial-gradient(50% 45% at 82% 78%,rgba(245,181,68,.10),transparent 60%),radial-gradient(40% 40% at 60% 50%,rgba(45,212,191,.12),transparent 60%)}
body[data-theme="light"] .bubble{background:rgba(255,255,255,.55);border-color:color-mix(in srgb, var(--cyan) 25%, transparent)}
body[data-theme="light"] .msg.zhuangzhou .bubble{background:color-mix(in srgb, var(--cyan) 10%, transparent)}
body[data-theme="light"] .msg.user .bubble{background:color-mix(in srgb, var(--amber) 10%, transparent)}

/* ── LEGACY FALLBACK（Formal UI System v1.0 · Phase A / D-02）──
 * 深色强调色主题令牌此前在此以 body[data-theme] (0,1,1) 重定义，其中 --glow 被误用为
 * box-shadow 简写 "0 0 24px ..."（与 ui2.css 的颜色语义冲突 → D-01 双向破坏）。
 * 现令牌唯一权威收口到 ui2.css [data-theme="dark-*"]；此处不再重定义，
 * 消除 --glow 双语义残余与主题双源冲突。各 dark-* 的 cyan/teal/glow 值与 ui2.css
 * 对应块逐字一致（--glow 现统一为颜色令牌），零视觉变化。 */

.theme-opt-dot.green{background:radial-gradient(circle at 35% 30%,#34d399,#05070A 70%)}
.theme-opt-dot.purple{background:radial-gradient(circle at 35% 30%,#c084fc,#05070A 70%)}
.theme-opt-dot.amber{background:radial-gradient(circle at 35% 30%,#fbbf24,#05070A 70%)}
.theme-opt-dot.rose{background:radial-gradient(circle at 35% 30%,#fb7185,#05070A 70%)}
.theme-opt-dot.dark{background:radial-gradient(circle at 35% 30%,#1a1f2b,#05070A 70%)}
.theme-opt-dot.quantum{background:radial-gradient(circle at 35% 30%,#22d3ee,#a78bfa 70%)}
.theme-opt-dot.midnight{background:radial-gradient(circle at 35% 30%,#4f7bff,#05070A 70%)}

/* 密码/Key 输入框的眼睛切换 */
.settings-input-wrap{position:relative;display:flex;align-items:center}
.settings-input-wrap .settings-input{width:100%}
.input-eye{position:absolute;right:8px;top:50%;transform:translateY(-50%);width:28px;height:28px;border-radius:var(--radius-xs);background:transparent;border:1px solid transparent;color:var(--dim);cursor:pointer;font-size:13px;display:grid;place-items:center}
.input-eye:hover{color:var(--cyan);background:rgba(255,255,255,.06);border-color:var(--line)}

/* ============================================================
   科技感右侧任务弹窗 · 2026-07-29
   ============================================================ */
.zz-task-overlay{
  position:fixed;inset:0;z-index: var(--z-task-mask);
  background:rgba(4,8,14,.45);
  backdrop-filter: var(--glass-1);
  opacity:0;visibility:hidden;
  transition:opacity var(--motion-base),visibility var(--motion-base);
}
.zz-task-overlay.show{opacity:1;visibility:visible}

.zz-task-panel{
  position:fixed;top:16px;right:16px;bottom:16px;
  width:0;max-width:calc(100vw - 32px);
  z-index: var(--z-task);
  display:flex;flex-direction:column;
  background:
    linear-gradient(160deg,rgba(10,18,26,.82),rgba(5,8,12,.88)),
    radial-gradient(120% 120% at 0% 0%,rgba(34,211,238,.10),transparent 55%);
  border:1px solid var(--line-strong);
  border-radius:var(--radius-lg);
  box-shadow:var(--elev-3),0 0 40px rgba(34,211,238,.12);
  backdrop-filter: var(--glass-3);
  opacity:0;pointer-events:none;overflow:hidden;
  transition:width var(--motion-slow) var(--ease-soft),opacity var(--motion-base) var(--ease-soft);
}
.zz-task-panel.show{width:520px;opacity:1;pointer-events:auto}

/* 四角括弧 */
.zz-task-hud{position:absolute;inset:0;pointer-events:none;z-index: var(--z-ground)}
.zz-task-corner{position:absolute;width:26px;height:26px;border:2px solid var(--line-strong)}
.zz-task-corner.tl{top:12px;left:12px;border-right:0;border-bottom:0}
.zz-task-corner.tr{top:12px;right:12px;border-left:0;border-bottom:0}
.zz-task-corner.bl{bottom:12px;left:12px;border-right:0;border-top:0}
.zz-task-corner.br{bottom:12px;right:12px;border-left:0;border-top:0}

/* 扫描线 */
.zz-task-scanline{
  position:absolute;inset:0;pointer-events:none;
  background:repeating-linear-gradient(0deg,rgba(255,255,255,.025) 0 1px,transparent 1px 3px);
  mix-blend-mode:overlay;
  animation:zzTaskScan 6s linear infinite;
}
@keyframes zzTaskScan{from{background-position:0 0}to{background-position:0 36px}}

.zz-task-head{
  position:relative;z-index: var(--z-base);
  display:flex;align-items:center;justify-content:space-between;
  padding:18px 22px 14px;
  border-bottom:1px solid var(--line);
}
.zz-task-title-wrap{display:flex;align-items:center;gap:10px}
.zz-task-dot{width:8px;height:8px;border-radius:50%;background:var(--cyan);box-shadow:0 0 10px var(--cyan)}
.zz-task-title{font-family: var(--font-display);font-size:16px;letter-spacing:2px;color:#fff}
.zz-task-sub{font-family: var(--font-mono);font-size:11px;color:var(--dim);letter-spacing:1px}
.zz-task-close{
  width:32px;height:32px;border-radius:var(--radius-sm);border:1px solid var(--line);
  background:transparent;color:var(--dim);cursor:pointer;font-size:16px;
  display:grid;place-items:center;transition:var(--motion-fast);
}
.zz-task-close:hover{color:#fff;border-color:var(--cyan);transform:rotate(90deg)}

.zz-task-body{
  position:relative;z-index: var(--z-base);flex:1;min-height:0;overflow-y:auto;
  padding:18px 22px 22px;
}

/* 启动器内容 */
.zz-task-launch{
  height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;
  text-align:center;
}
.zz-task-launch-icon{font-size:56px;filter:drop-shadow(0 6px 18px rgba(34,211,238,.25))}
.zz-task-launch-title{font-family: var(--font-display);font-size:22px;color:#fff;letter-spacing:2px}
.zz-task-launch-desc{color:var(--dim);font-size:14px}
.zz-task-launch-btn{
  margin-top:8px;padding:10px 28px;border-radius:var(--radius-sm);border:1px solid var(--cyan);
  background:rgba(34,211,238,.10);color:var(--cyan);font-family: var(--font-ui);font-size:15px;font-weight:700;
  cursor:pointer;transition:var(--motion-fast);
}
.zz-task-launch-btn:hover{background:var(--cyan);color:#061018;box-shadow:0 0 20px color-mix(in srgb, var(--accent) 35%, transparent)}

/* boot 入场动画 */
.zz-task-booting .zz-task-head,
.zz-task-booting .zz-task-body{opacity:0;transform:translateX(20px);animation:zzTaskSlideIn var(--motion-slow) var(--ease-glitch) forwards}
.zz-task-booting .zz-task-body{animation-delay:80ms}
@keyframes zzTaskSlideIn{to{opacity:1;transform:none}}

/* 热点面板现已改为左侧弹出 + 右侧聊天框（见 .hs-overlay），此处旧规则作废 */

/* 所在地设置行 */
.settings-row--loc .settings-select{min-width:160px}

/* 舆情告警配置表单 */
.settings-textarea{
  width:100%; min-height:92px; resize:vertical; box-sizing:border-box;
  background:var(--input-bg-soft); border:1px solid var(--input-border); border-radius:var(--input-radius);
  color:var(--text); font-size:var(--input-font); padding:10px 12px; font-family:inherit; line-height:1.5;
}
.settings-textarea:focus{outline:none; border-color:rgba(34,211,238,.45); box-shadow:0 0 0 3px rgba(34,211,238,.12)}
.settings-checks{display:flex; flex-wrap:wrap; gap:14px; align-items:center; padding-top:2px}
.settings-check{display:inline-flex; align-items:center; gap:6px; font-size:13px; color:var(--txt); cursor:pointer; opacity:.92}
.settings-check input{accent-color:var(--accent); width:15px; height:15px}
.settings-check input:disabled{cursor:not-allowed; opacity:.5}
.badge-wip{font-size:10px; padding:1px 6px; border-radius:var(--radius-xs); background:rgba(245,181,68,.16); color:#F5B544; border:1px solid rgba(245,181,68,.3); font-family: var(--font-mono)}


/* ── 右侧遥测面板 · 后台日志（主动推送静默记录）── */
.tele-log-list{
  max-height:180px; overflow:auto; display:flex; flex-direction:column; gap:6px;
  padding-right:4px; scrollbar-width:thin;
}
.tele-log-row{
  display:grid; grid-template-columns:52px 44px 1fr; gap:8px; align-items:center;
  padding:6px 8px; border-radius:var(--radius-sm); background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.06);
  font-size:12px; line-height:1.45; color:var(--txt);
}
.tele-log-time{font-family: var(--font-mono); font-size:11px; color:var(--dim2); white-space:nowrap}
.tele-log-tag{font-size:10px; padding:1px 6px; border-radius:var(--radius-xs); text-align:center; font-family: var(--font-mono); background:rgba(255,255,255,.08); color:var(--dim)}
.log-tag--hotspot{background:rgba(245,181,68,.14); color:#F5B544}
.log-tag--weather{background:rgba(34,211,238,.14); color:#22D3EE}
.log-tag--alert{background:rgba(239,68,68,.16); color:#EF4444}
.log-tag--system{background:rgba(148,163,184,.14); color:#94A3B8}
.log-tag--reminder{background:rgba(45,212,191,.14); color:#2DD4BF}
.log-tag--briefing{background:rgba(34,211,238,.12); color:#22D3EE}
.tele-log-body{white-space:nowrap; overflow:hidden; text-overflow:ellipsis; color:var(--txt); opacity:.92}

/* ============================================================
   通用侧弹面板 · ZZPanel（参考实现人物档案同款容器）
   ============================================================ */
.zz-panel{
  position:fixed; right:18px; top:82px;
  width:min(420px, calc(100vw - 28px));
  max-height:calc(100vh - 96px);
  z-index: var(--z-drawer);
  pointer-events:none;
  opacity:0;
  display:flex;
  transition:opacity var(--motion-fast) var(--ease-soft);
}
.zz-panel[aria-hidden="false"]{
  pointer-events:auto;
  opacity:1;
}
.zz-panel.zz-panel--entering{
  animation:zzPanelFlashIn var(--motion-base) var(--ease-soft) both;
}
.zz-panel.zz-panel--leaving{
  pointer-events:none;
  animation:zzPanelFlashOut var(--motion-fast) var(--ease-soft) both;
}

.zz-panel-card{
  position:relative;
  width:100%;
  display:flex; flex-direction:column;
  overflow:hidden;
  border:1px solid color-mix(in srgb, var(--accent) 32%, transparent);
  border-radius:var(--radius-md);
  background:
    linear-gradient(160deg, var(--surface-2), var(--bg-2));
  box-shadow:var(--elev-3), inset 0 1px 0 rgba(255,255,255,.06);
  backdrop-filter: blur(var(--ws-secondary-blur));
  -webkit-backdrop-filter: blur(var(--ws-secondary-blur));
  color:var(--txt);
}
.zz-panel-card::before{
  content:"";
  position:absolute; inset:0; pointer-events:none;
  background:
    linear-gradient(90deg, color-mix(in srgb, var(--accent) 12%, transparent), transparent 34%),
    repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0, rgba(255,255,255,.035) 1px, transparent 1px, transparent 8px);
  opacity:.55;
}

.zz-panel-close{
  position:absolute; top:10px; right:10px; z-index: var(--z-stage);
  width:28px; height:28px;
  border:1px solid var(--border); border-radius:var(--radius-sm);
  background:var(--surface-2); color:var(--dim);
  cursor:pointer; font-size:18px; line-height:1;
  display:grid; place-items:center;
  opacity:0; pointer-events:none;
  transform:translateY(-3px);
  transition:opacity var(--motion-fast) var(--ease-soft), transform var(--motion-fast) var(--ease-soft), border-color var(--motion-fast) var(--ease-soft), color var(--motion-fast) var(--ease-soft);
}
.zz-panel-card:hover .zz-panel-close,
.zz-panel-close:focus-visible{
  opacity:1; pointer-events:auto; transform:translateY(0);
}
.zz-panel-close:hover{
  color:var(--text); border-color:var(--accent); background:color-mix(in srgb, var(--accent) 12%, transparent);
}

.zz-panel-head,
.zz-panel-body{
  position:relative; z-index: var(--z-base);
}
.zz-panel-head{
  padding:16px 18px 12px;
  border-bottom:1px solid var(--border);
}
.zz-panel-title{
  font-family: var(--font-display); font-size:18px; letter-spacing:1px;
  color:var(--accent); text-shadow:0 0 14px var(--glow);
}
.zz-panel-subtitle{
  margin-top:4px; font-size:12px; color:var(--dim); font-family: var(--font-mono);
}
.zz-panel-body{
  flex:1; min-height:0; overflow-y:auto; overflow-x:hidden;
  padding:16px 18px 18px;
  scrollbar-width:thin; scrollbar-color:var(--border) transparent;
}
.zz-panel-body::-webkit-scrollbar{width:5px}
.zz-panel-body::-webkit-scrollbar-thumb{background:var(--border); border-radius:var(--radius-pill)}

/* 默认卡片内容样式（人物档案/信息卡） */
.zz-panel-hero{
  position:relative; width:100%; aspect-ratio:16/9; border-radius:var(--radius-sm);
  display:grid; place-items:center; overflow:hidden;
  border:1px solid color-mix(in srgb, var(--accent) 32%, transparent);
  background:
    linear-gradient(135deg, color-mix(in srgb, var(--accent) 22%, transparent), color-mix(in srgb, var(--accent-2) 10%, transparent)),
    rgba(255,255,255,.04);
  color:#dff5ff; font-size:44px; font-weight:800;
  margin-bottom:14px;
}
.zz-panel-hero img{
  position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 28%;
}
.zz-panel-hero::after{
  content:""; position:absolute; inset:0; pointer-events:none;
  background:linear-gradient(180deg, transparent 52%, rgba(4,8,12,.45));
}
.zz-panel-name{
  font-family: var(--font-ui); font-size:24px; font-weight:700; color:#fff;
  line-height:1.15; overflow-wrap:anywhere;
}
.zz-panel-tagline{
  margin-top:6px; font-size:13px; color:var(--dim); line-height:1.35;
}
.zz-panel-summary{
  margin-top:14px; font-size:14px; line-height:1.65; color:var(--txt);
}
.zz-panel-section{
  margin-top:14px; padding-top:12px; border-top:1px solid rgba(255,255,255,.08);
}
.zz-panel-section-title{
  color:var(--dim); font-size:12px; margin-bottom:8px; font-family: var(--font-mono);
}
.zz-panel-list{
  margin:0; padding:0; display:grid; gap:8px; list-style:none;
}
.zz-panel-list li{
  display:flex; align-items:flex-start; gap:8px;
  color:var(--txt); font-size:13px; line-height:1.35;
}
.zz-panel-list li::before{
  content:""; flex:0 0 5px; width:5px; height:5px; margin-top:6px;
  border-radius:50%; background:var(--accent); box-shadow:0 0 10px var(--glow);
}
.zz-panel-tags{
  margin-top:14px; display:flex; flex-wrap:wrap; gap:8px;
}
.zz-panel-tag{
  max-width:100%; padding:4px 8px; border-radius:var(--radius-xs);
  border:1px solid color-mix(in srgb, var(--accent) 24%, transparent);
  color:color-mix(in srgb, var(--accent) 80%, #fff);
  background:color-mix(in srgb, var(--accent) 10%, transparent);
  font-size:12px; line-height:1.2; overflow-wrap:anywhere;
}
.zz-panel-footer{
  margin-top:16px; display:flex; align-items:center; justify-content:space-between;
  gap:10px; color:var(--dim); font-size:11px; font-family: var(--font-mono);
}

@media (max-width: 980px){
  .zz-panel{
    top:auto; right:14px; left:14px; bottom:86px;
    width:auto; max-height:calc(100vh - 110px);
  }
}

@keyframes zzPanelFlashIn{
  0%   { opacity:0; filter:brightness(2); }
  15%  { opacity:1; filter:brightness(1.5); }
  35%  { opacity:.55; filter:none; }
  60%  { opacity:1; }
  80%  { opacity:.82; }
  100% { opacity:1; }
}
@keyframes zzPanelFlashOut{
  0%   { opacity:1; }
  25%  { opacity:.6; filter:brightness(1.4); }
  55%  { opacity:.85; filter:none; }
  100% { opacity:0; }
}

@media (prefers-reduced-motion:reduce){
  .zz-panel, .zz-panel.zz-panel--entering, .zz-panel.zz-panel--leaving{
    animation:none !important; transition:none !important;
  }
}

/* ============================================================
   首页输入增强：图片预览 + 语音交互浮层
   ============================================================ */

/* ---- 图片预览条（位于输入坞上方） ---- */
.image-preview-row{
  display:none; gap:10px; padding:0 0 10px 0; max-width:860px; margin:0 auto;
  width:100%; overflow-x:auto; scrollbar-width:thin;
}
.image-preview-row.show{display:flex}
.image-preview-thumb{
  width:56px; height:56px; border-radius:var(--radius-sm); flex:0 0 56px;
  background-size:cover; background-position:center;
  border:1px solid var(--line); position:relative;
  box-shadow:0 0 0 1px rgba(34,211,238,.08);
}
.image-preview-del{
  position:absolute; top:-6px; right:-6px; width:18px; height:18px; border-radius:50%;
  border:1px solid var(--line-strong); background:rgba(255,77,77,.9); color:#fff;
  font-size:12px; line-height:16px; text-align:center; cursor:pointer;
  display:grid; place-items:center; transition:var(--motion-fast);
}
.image-preview-del:hover{transform:scale(1.1); background:#ff5a5a}

/* ---- 麦克风录音/识别全屏浮层 ---- */
.mic-overlay{
  position:fixed; left:50%; bottom:96px; transform:translateX(-50%) translateY(14px);
  z-index: var(--z-dialog-mask); display:flex; justify-content:center; width:min(440px,90vw);
  opacity:0; pointer-events:none;
  transition:opacity var(--motion-base) var(--ease-soft), transform var(--motion-base) var(--ease-premium);
}
.mic-overlay.show{opacity:1; transform:translateX(-50%) translateY(0); pointer-events:none}
.mic-overlay-card{
  pointer-events:auto;
  position:relative;
  display:flex; align-items:center; gap:14px;
  width:100%; padding:12px 16px; border-radius:var(--radius-lg);
  background:linear-gradient(145deg, rgba(8,14,20,.96), rgba(5,9,14,.96));
  border:1px solid color-mix(in srgb, var(--accent) 35%, transparent); box-shadow:0 10px 40px rgba(34,211,238,.18);
}
.mic-overlay-close{
  position:absolute; top:8px; right:10px; width:26px; height:26px; border-radius:50%;
  background:transparent; border:1px solid rgba(120,180,255,.25); color:var(--dim);
  font-size:18px; line-height:1; cursor:pointer; display:grid; place-items:center;
  transition:var(--motion-fast); z-index: var(--z-stage);
}
.mic-overlay-close:hover{
  color:#fff; border-color:var(--red); background:rgba(255,77,77,.12);
}
.mic-overlay-orb{
  position:relative; width:46px; height:46px; flex:0 0 46px; border-radius:50%;
  background:linear-gradient(135deg, rgba(34,211,238,.18), rgba(45,212,191,.10));
  border:1px solid rgba(34,211,238,.45); display:grid; place-items:center;
  box-shadow:0 0 18px rgba(34,211,238,.25);
  animation:micOrbPulse 1.4s ease-in-out infinite;
}
.mic-overlay.recognizing .mic-overlay-orb{animation:micOrbSpin 1.2s linear infinite}
.mic-overlay.speaking .mic-overlay-orb{
  border-color:rgba(45,212,191,.6); box-shadow:0 0 22px rgba(45,212,191,.45);
}
.mic-overlay-orb .ic{width:22px; height:22px; fill:var(--cyan)}
@keyframes micOrbPulse{
  0%,100%{transform:scale(1); box-shadow:0 0 18px rgba(34,211,238,.25)}
  50%{transform:scale(1.06); box-shadow:0 0 30px rgba(34,211,238,.45)}
}
@keyframes micOrbSpin{
  from{transform:rotate(0)}
  to{transform:rotate(360deg)}
}
.mic-overlay-waves{
  position:absolute; inset:-8px -2px; display:flex; align-items:center; justify-content:center; gap:4px;
  pointer-events:none;
}
.mic-overlay-waves i{
  width:3px; height:3px; border-radius:var(--radius-xs); background:var(--cyan);
  opacity:.7; transition:height var(--dur-tick) var(--ease-soft);
}
.mic-overlay-meta{flex:1 1 auto; min-width:0; padding-right:18px}
.mic-overlay-title{
  font-family: var(--font-display); font-size:14px; letter-spacing:2px; color:var(--cyan);
  margin-bottom:4px; text-shadow:0 0 10px color-mix(in srgb, var(--accent) 35%, transparent);
}
.mic-overlay-sub{
  font-size:13px; color:var(--dim); letter-spacing:.3px;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}

/* 输入坞麦克风按钮录音态增强 */
.mic-btn.recording .ic{fill:#fff !important}

/* 减少动效适配 */
@media (prefers-reduced-motion:reduce){
  .mic-overlay-orb{animation:none !important}
  .mic-overlay-waves i{transition:none}
}

/* ── 全屏视频播放面板 ── */
.video-panel{
  position:fixed;inset:0;z-index: var(--z-overlay);
  visibility:hidden;opacity:0;
  transition:opacity var(--motion-base) var(--ease-soft),visibility var(--motion-base);
}
body.video-mode .video-panel{visibility:visible;opacity:1}
.video-backdrop{
  position:absolute;inset:0;
  background:var(--ws-overlay-scrim);
  backdrop-filter: var(--glass-2);
}
.video-stage{
  position:absolute;inset:0;
  display:flex;flex-direction:column;gap:14px;
  padding:26px;
}
.video-bar{
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  width:100%;max-width:1180px;margin:0 auto;
}
.video-title{
  font:600 16px/1.2 'Rajdhani',system-ui,sans-serif;
  letter-spacing:.4px;color:var(--text);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:90%;
}
.video-close{
  flex:none;width:40px;height:40px;border-radius:var(--radius-md);
  border:1px solid var(--line);background:rgba(255,255,255,.06);
  color:#cfeff5;font-size:18px;cursor:pointer;transition:var(--motion-fast);
}
.video-close:hover{
  background:rgba(255,80,80,.18);border-color:rgba(255,80,80,.5);
  color:#fff;transform:rotate(90deg);
}
.video-frame-wrap{
  position:relative;flex:1;width:100%;max-width:1180px;margin:0 auto;
  border-radius:var(--radius-lg);overflow:hidden;background:#000;
  border:1px solid var(--line-strong);
  box-shadow:var(--elev-3),0 0 50px rgba(34,211,238,.12);
}
.video-frame{position:absolute;inset:0;width:100%;height:100%;border:0;background:#000}
@media (max-width: 980px){
  .video-stage{padding:12px;gap:10px}
  .video-frame-wrap{border-radius:var(--radius-md)}
}

/* ───────── 全屏面板通用（地图 / 文档 / 记忆 / 审视）───────── */
.map-panel,.doc-panel,.memory-panel,.review-panel{
  position:fixed;inset:0;z-index: var(--z-overlay);
  visibility:hidden;opacity:0;
  transition:opacity var(--motion-base) var(--ease-soft),visibility var(--motion-base);
}
body.map-mode .map-panel,
body.doc-mode .doc-panel,
body.memory-mode .memory-panel,
body.review-mode .review-panel{visibility:visible;opacity:1}

.map-backdrop,.doc-backdrop,.memory-backdrop,.review-backdrop{
  position:absolute;inset:0;
  background:var(--ws-overlay-scrim);
  backdrop-filter: var(--glass-2);
}
.map-stage,.doc-stage,.memory-stage,.review-stage{
  position:absolute;inset:0;
  display:flex;flex-direction:column;gap:14px;padding:26px;
  background:linear-gradient(160deg, var(--surface-2), var(--bg-2));
  backdrop-filter: blur(var(--ws-secondary-blur));
  -webkit-backdrop-filter: blur(var(--ws-secondary-blur));
}
.map-bar,.doc-bar,.memory-bar,.review-bar{
  display:flex;align-items:center;gap:12px;
  width:100%;max-width:1180px;margin:0 auto;
}
.map-title,.doc-title,.memory-title,.review-title{
  flex:1;min-width:0;
  font:600 16px/1.2 'Rajdhani',system-ui,sans-serif;
  letter-spacing:.4px;color:var(--txt);
  display:flex;align-items:center;gap:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.map-dot,.doc-dot,.memory-dot{width:10px;height:10px;border-radius:50%;background:var(--cyan);box-shadow:0 0 10px var(--cyan)}
.memory-dot{background:var(--teal);box-shadow:0 0 10px var(--teal)}
.review-dot{background:var(--amber);box-shadow:0 0 10px var(--amber)}

.map-close,.doc-close,.memory-close,.review-close,.doc-back,.memory-refresh{
  flex:none;height:40px;min-width:40px;padding:0 12px;border-radius:var(--radius-md);
  border:1px solid var(--line);background:rgba(255,255,255,.06);
  color:var(--txt);font-size:16px;cursor:pointer;transition:var(--motion-fast);
  display:flex;align-items:center;justify-content:center;
}
.map-close:hover,.doc-close:hover,.memory-close:hover,.review-close:hover{background:rgba(255,80,80,.18);border-color:rgba(255,80,80,.5);color:#fff;transform:rotate(90deg)}
.doc-back:hover,.memory-refresh:hover{background:color-mix(in srgb, var(--accent) 16%, transparent);border-color:var(--line-strong);color:#fff;transform:none}

/* 地图服务 */
.map-body{flex:1;width:100%;max-width:1180px;margin:0 auto;overflow:auto;color:var(--dim)}
.map-empty{padding:40px;text-align:center;color:var(--dim);font-size:15px;line-height:1.7}
.map-loc-text{margin-bottom:18px;color:var(--txt)}
.map-hero{text-align:center;padding:18px 0 26px}
.map-hero-route{font:700 26px/1.3 'Rajdhani',system-ui,sans-serif;color:var(--txt);letter-spacing:.5px}
.map-arrow{margin:0 14px;color:var(--cyan)}
.map-hero-km{margin-top:10px;font-size:15px;color:var(--dim)}
.map-hero-km b{color:var(--cyan);font-size:22px}
.map-card-row{display:flex;gap:18px;flex-wrap:wrap}
.map-card{flex:1;min-width:240px;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:var(--radius-md);padding:18px;transition:var(--motion-fast)}
.map-card:hover{border-color:var(--line-strong);background:rgba(255,255,255,.06)}
.map-card-label{font-size:12px;letter-spacing:1px;color:var(--dim2);text-transform:uppercase;margin-bottom:8px}
.map-card-name{font:600 18px/1.3 'Rajdhani',system-ui,sans-serif;color:var(--txt);margin-bottom:10px}
.map-coord{display:flex;align-items:center;gap:8px;font-family: var(--font-mono);font-size:14px;color:var(--cyan)}
