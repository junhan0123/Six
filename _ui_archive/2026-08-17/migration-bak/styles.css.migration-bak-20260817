.execv-confirm { background: rgba(240,179,94,.07); border: 1px solid rgba(240,179,94,.3); border-radius: var(--radius-md, 14px); padding: 14px; display: flex; flex-direction: column; gap: 10px; }
.execv-confirm-title { display: flex; gap: 8px; align-items: center; font: 600 14px/1.3 'Rajdhani', system-ui, sans-serif; color: #f0b35e; }
.execv-confirm-body { display: flex; flex-direction: column; gap: 6px; }
.execv-confirm-row { display: flex; gap: 10px; font-size: 13px; line-height: 1.5; }
.execv-confirm-row .execv-k { flex: 0 0 48px; }
.execv-confirm-note { font-size: 12px; color: var(--dim); font-style: italic; }
.execv-confirm-actions { display: flex; gap: 8px; justify-content: flex-end; }
.execv-confirm-ask { padding: 6px 14px; border-radius: var(--radius-sm, 10px); border: 1px solid rgba(34,211,238,.4); background: rgba(34,211,238,.14); color: #22d3ee; font-size: 13px; cursor: pointer; }
.execv-confirm-ask:hover { background: rgba(34,211,238,.24); }
.execv-confirm-cancel { padding: 6px 14px; border-radius: var(--radius-sm, 10px); border: 1px solid var(--line); background: transparent; color: var(--dim); font-size: 13px; cursor: pointer; }
.execv-confirm-cancel:hover { background: rgba(255,255,255,.08); }

.execv-hist { display: flex; flex-direction: column; gap: 8px; }
.execv-hist-item { background: rgba(255,255,255,.03); border: 1px solid var(--line); border-left: 3px solid rgba(34,211,238,.4); border-radius: var(--radius-sm, 10px); padding: 10px 12px; }
.execv-hist-item.is-done { border-left-color: rgba(86,211,100,.5); }
.execv-hist-item.is-failed { border-left-color: rgba(255,107,107,.5); }
.execv-hist-main { font-size: 13px; line-height: 1.5; color: var(--txt); white-space: pre-wrap; word-break: break-word; }
.execv-hist-meta { font-size: 11px; color: var(--dim2); margin-top: 4px; }

/* 执行状态 toast（独立实例，避免与自我认知冲突） */
.execv-toast { position: fixed; left: 50%; bottom: 40px; transform: translateX(-50%) translateY(20px); background: rgba(13,19,32,.96); border: 1px solid var(--line); color: var(--txt); padding: 10px 18px; border-radius: 12px; font-size: 13px; opacity: 0; pointer-events: none; transition: var(--motion-fast, .2s); z-index: 200; max-width: 80vw; }
.execv-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* Glance 每日智能：允许悬停阅读全文（其余种类保持不可交互） */
.glance-card[data-kind="briefing"] { cursor: help; }
