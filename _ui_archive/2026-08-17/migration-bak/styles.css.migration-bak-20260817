  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px 6px;
  border-bottom: 1px solid var(--line);
  background: color-mix(in srgb, var(--panel-solid) 80%, transparent);
}

.hs-platform-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex: 0 0 auto;
}

.hs-dot-douyin   { background: #FE2C55; box-shadow: 0 0 6px #FE2C5588; }
.hs-dot-xhs      { background: #FF2442; box-shadow: 0 0 6px #FF244288; }

.hs-dot-wechat   { background: #07C160; box-shadow: 0 0 6px #07C16088; }
.hs-dot-weibo { background: #E6162D; box-shadow: 0 0 6px #E6162D88; }

.hs-platform-name {
  font-size: 16px;
  font-weight: 600;
  color: var(--txt);
  flex: 0 0 auto;
}

.hs-card-badge {
  font-size: 10px;
  color: var(--dim);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-xs);
  padding: 0 4px;
  line-height: 1.5;
  flex: 0 0 auto;
}

.hs-card-update {
  margin-left: auto;
  font-size: 10px;
  color: var(--dim);
  white-space: nowrap;
}

.hs-list {
  flex: 1 1 0;
  min-height: 0;
  overflow-y: auto;
  list-style: none;
  margin: 0;
  padding: 2px 0;
  scrollbar-width: none;
}

.hs-list::-webkit-scrollbar { display: none; }


.hs-item {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  cursor: default;
  transition: background var(--dur-micro) var(--ease-soft);
  min-width: 0;
}

.hs-item:hover { background: var(--line); }


.hs-rank {
  font-family: var(--font-mono);
  font-size: 16px;
  font-weight: 700;
  color: var(--dim);
  flex: 0 0 18px;
  text-align: center;
  line-height: 1;
}

.hs-rank-top1 { color: #ff4444; }
.hs-rank-top2 { color: #ff8800; }

.hs-rank-top3 { color: #ffcc00; }


.hs-item-text {
  flex: 1 1 0;
  min-width: 0;
  font-size: 16px;
  color: var(--dim);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

.hs-new-badge {
  display: inline-block;
  font-size: 10px;
  color: #ff4444;
  border: 1px solid #ff444466;
  border-radius: var(--radius-xs);
  padding: 0 2px;
  margin-left: 4px;
  vertical-align: middle;
  line-height: 1.4;
}

.hs-heat {
  font-size: 14px;
  color: var(--dim);
  flex: 0 0 auto;
  white-space: nowrap;
}

.hs-label-badge {
  font-size: 9px;
  color: var(--cyan);
  border: 1px solid color-mix(in srgb, var(--cyan) 30%, transparent);
  border-radius: var(--radius-xs);
  padding: 0 4px;
  flex: 0 0 auto;
  white-space: nowrap;
  line-height: 1.5;
}

.hs-trend {
  font-size: 13px;
  font-family: var(--font-mono);
  flex: 0 0 10px;
  text-align: center;
}

.hs-trend-up   { color: #44dd88; }
.hs-trend-dn   { color: #ee5555; }

.hs-trend-same { color: var(--dim); }


.hs-earth-container {
  flex: 1 1 0;
  min-height: 0;
  position: relative;
  overflow: hidden;
  background: transparent;
}

.hs-earth-container canvas {
  width: 100%;
  height: 100%;
  display: block;
  cursor: grab;
}

.hs-earth-container canvas:active { cursor: grabbing; }


.hs-earth-label {
  position: absolute;
  top: 10px;
  left: 14px;
  font-size: 10px;
  color: var(--cyan);
  font-family: var(--font-mono);
  letter-spacing: 0.12em;
  opacity: 0.7;
  pointer-events: none;
}

.hs-earth-error {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  text-align: center;
  font-size: 12px;
  color: #ff8888;
  background: rgba(6, 11, 20, 0.72);
  backdrop-filter: var(--glass-1);
  z-index: var(--z-rail);
  pointer-events: none;
  line-height: 1.5;
}
.hs-earth-error[hidden] { display: none; }

/* ── 地球初始化/运行状态面板（调试与兜底） ── */
.hs-earth-status {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  text-align: center;
  font-size: 12px;
  color: #a8d0ff;
  background: rgba(6, 11, 20, 0.55);
  backdrop-filter: var(--glass-1);
  z-index: var(--z-rail);
  pointer-events: none;
  line-height: 1.5;
  transition: opacity var(--motion-fast) var(--ease-soft);
}
.hs-earth-status[data-type="error"] { color: #ff8888; }
.hs-earth-status[data-type="warn"]  { color: #f5b544; }
.hs-earth-status[data-type="success"] { color: #2dd4bf; }
.hs-earth-status[hidden] { display: none; }

/* ── 地球 hover 地域提示 ── */
.hs-earth-tooltip {
  position: fixed;
  z-index: var(--z-top);
  pointer-events: none;
  padding: 6px 10px;
  border-radius:var(--radius-sm);
  font-size: 11px;
  font-weight: 600;
  color: var(--text);
  background: rgba(13, 22, 38, 0.78);
  backdrop-filter: var(--glass-2);
  -webkit-backdrop-filter: var(--glass-2);
  border: 1px solid rgba(120, 180, 255, 0.28);
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.35);
  white-space: nowrap;
  transform: translateY(0);
  transition: opacity var(--motion-fast) var(--ease-soft), transform var(--motion-fast) var(--ease-soft);
}
.hs-earth-tooltip[hidden] { display: none; }

/* ── 地球标注点点击弹出的地域内容浮层（参考参考实现：只显示标注点，点击才出内容，可关闭）── */
.hs-region-popup {
  position: absolute;
  top: 16px; right: 16px;
  width: 264px; max-height: 78%;
  display: flex; flex-direction: column;
  background: rgba(10, 16, 28, 0.66);
  backdrop-filter: var(--glass-3);
  -webkit-backdrop-filter: var(--glass-3);
  border: 1px solid rgba(34, 211, 238, 0.28);
  border-radius: var(--radius-md);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(34, 211, 238, 0.06) inset, 0 0 28px rgba(34, 211, 238, 0.10);
  overflow: hidden;
  z-index: var(--z-raised);
  animation: hs-rp-in var(--motion-base) var(--ease-premium);
}
.hs-region-popup[hidden] { display: none; }
@keyframes hs-rp-in { from { opacity: 0; transform: translateY(-10px) scale(0.95); } to { opacity: 1; transform: none; } }
.hs-rp-head {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  padding: 12px 14px;
  border-bottom: 1px solid rgba(120, 180, 255, 0.14);
  background: linear-gradient(180deg, rgba(34, 211, 238, 0.12), transparent);
}
.hs-rp-title { font-size: 16px; font-weight: 700; color: var(--text); letter-spacing: 0.02em; text-shadow: 0 0 12px rgba(34, 211, 238, 0.35); }
.hs-rp-close {
  flex: none;
  width: 26px; height: 26px; border-radius:var(--radius-sm);
  border: 1px solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.05); color: var(--text-dim);
  font-size: 18px; line-height: 1; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background var(--motion-fast) var(--ease-soft), transform var(--motion-fast) var(--ease-soft), border-color var(--motion-fast) var(--ease-soft);
}
.hs-rp-close:hover { background: rgba(229, 90, 90, 0.32); border-color: rgba(229, 90, 90, 0.5); color: #fff; transform: scale(1.1); }
.hs-rp-close:active { transform: scale(0.96); }

/* ── 每日简报面板 ── */
.briefing-overlay {
  position: fixed; inset: 0; z-index: var(--z-overlay);
  display: flex; align-items: center; justify-content: center;
  background: rgba(2,4,7,.55); backdrop-filter: var(--glass-1);
  opacity: 0; visibility: hidden; transition: opacity var(--motion-base) var(--ease-soft), visibility var(--motion-base) var(--ease-soft);
}
.briefing-overlay.show { opacity: 1; visibility: visible; }
.briefing-card {
  width: min(560px, 92vw); max-height: 84vh; overflow: auto;
  background: rgba(10,16,28,.72);
  backdrop-filter: var(--glass-3);
  -webkit-backdrop-filter: var(--glass-3);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: 0 24px 60px rgba(0,0,0,.55), 0 0 0 1px rgba(34,211,238,.06) inset, 0 0 30px rgba(34,211,238,.10);
  padding: 22px 24px 18px;
  transform: translateY(12px) scale(.98); transition: transform var(--motion-base) var(--ease-premium);
}
.briefing-overlay.show .briefing-card { transform: none; }
.briefing-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.briefing-title { font-size: 18px; font-weight: 800; color: var(--text); letter-spacing: .04em; text-shadow: 0 0 14px rgba(34,211,238,.4); }
.briefing-date { font-size: 12px; color: var(--dim, #8B98A9); }
.briefing-close {
  width: 28px; height: 28px; border-radius:var(--radius-sm); border: 1px solid rgba(255,255,255,.14);
  background: rgba(255,255,255,.05); color: var(--text-dim); font-size: 18px; line-height: 1; cursor: pointer;
  display: flex; align-items: center; justify-content: center; transition: background var(--motion-fast) var(--ease-soft), border-color var(--motion-fast) var(--ease-soft);
}
.briefing-close:hover { background: rgba(229,90,90,.32); border-color: rgba(229,90,90,.5); color: #fff; }
.briefing-sec { margin-bottom: 14px; }
.briefing-sec-h {
  display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700;
  color: var(--cyan, #22D3EE); letter-spacing: .05em; margin-bottom: 8px;
}
.briefing-weather { font-size: 15px; color: var(--text); line-height: 1.5; }
.briefing-weather b { color: #fff; }
.briefing-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
.briefing-list li { font-size: 14px; color: var(--text); line-height: 1.45; display: flex; gap: 8px; align-items: flex-start; }
.briefing-rank {
  flex: none; width: 18px; height: 18px; border-radius: var(--radius-xs); background: color-mix(in srgb, var(--accent) 16%, transparent);
  color: var(--accent); font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center;
}
.briefing-heat { color: var(--dim, #8B98A9); font-size: 11px; margin-left: 4px; }
.briefing-task { font-size: 14px; color: var(--text); }
.briefing-empty { font-size: 13px; color: var(--dim, #8B98A9); }
.briefing-foot { display: flex; gap: 10px; margin-top: 6px; }
.briefing-speak, .briefing-refresh {
  flex: 1; padding: 10px; border-radius: var(--radius-sm); border: 1px solid var(--border);
  background: linear-gradient(180deg, rgba(34,211,238,.18), rgba(34,211,238,.06));
  color: var(--text); font-size: 13px; font-weight: 700; cursor: pointer; transition: var(--motion-fast);
}
.briefing-speak:hover, .briefing-refresh:hover { border-color: rgba(34,211,238,.6); background: rgba(34,211,238,.26); transform: translateY(-1px); }
.briefing-refresh { flex: none; width: 110px; }
.hs-rp-body { padding: 8px 12px 12px; overflow-y: auto; }
.hs-rp-item {
  display: grid; grid-template-columns: 18px auto 1fr; align-items: baseline; gap: 8px;
  padding: 8px 8px; border-radius: var(--radius-sm);
  transition: background var(--motion-fast) var(--ease-soft), transform var(--motion-fast) var(--ease-soft);
  text-decoration: none; color: inherit; cursor: pointer;
}
.hs-rp-item:hover { background: rgba(34, 211, 238, 0.10); transform: translateX(2px); }
.hs-rp-item:active { transform: translateX(1px); }
.hs-rp-item-disabled { cursor: default; opacity: 0.65; }
.hs-rp-item-disabled:hover { background: rgba(255, 255, 255, 0.03); transform: none; }
.hs-rp-rank { font-size: 14px; color: #7fa8d8; font-family: var(--font-mono); text-align: center; }
.hs-rp-plat { font-size: 13px; white-space: nowrap; font-weight: 700; }
.hs-rp-text {
  font-size: 15px; color: var(--text); text-decoration: none; line-height: 1.45;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.hs-rp-item:hover .hs-rp-text { color: #22D3EE; }
.hs-rp-empty { font-size: 13px; color: #7e93b3; padding: 6px; text-align: center; }

/* 地域分布浮层内的行（动态生成，未单独设尺寸，显式统一放大） */
.hs-region-row { font-size: 15px; color: var(--text); padding: 10px 14px; display: flex; align-items: center; gap: 8px; transition: background var(--motion-fast) var(--ease-soft); }
.hs-region-row:hover { background: rgba(34, 211, 238, .08); }
.hs-region-empty { color: var(--dim); font-size: 14px; text-align: center; padding: 14px; }
.hs-region-name { flex: 1 1 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
.hs-region-plats { color: var(--dim); font-size: 12px; margin-left: 6px; font-weight: 400; }
.hs-region-pct { flex: 0 0 auto; font-family: var(--font-mono); font-weight: 700; color: var(--cyan); }

.hs-feed-bar {
  flex: 0 0 auto;
  display: flex;
  align-items: stretch;
  gap: 0;
  height: 124px;
  margin-top: 6px;
  border-top: 1px solid var(--line);
  overflow: hidden;
}

.hs-feed-label {
  flex: 0 0 auto;
  width: 78px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 8px 10px;
  border-right: 1px solid var(--line);
  gap: 4px;
  background: color-mix(in srgb, var(--panel-solid) 60%, transparent);
}

.hs-feed-live-dot { color: #ff4444; font-size: 9px; animation: hs-blink 1.2s infinite; }
.hs-feed-label > span:nth-child(2) { font-size: 12px; font-weight: 700; color: var(--cyan); letter-spacing: 0.06em; }

.hs-feed-subtitle { font-size: 14px; color: var(--dim); font-weight: 600; }
.hs-feed-desc     { font-size: 14px; color: var(--dim); line-height: 1.45; margin-top: 2px; }

.hs-feed-viewport {
  flex: 1 1 0;
  min-width: 0;
  overflow-x: auto;
  overflow-y: hidden;
  scroll-behavior: smooth;
  scrollbar-width: none;
  padding: 10px 8px;
  display: flex;
  align-items: stretch;
}

.hs-feed-viewport::-webkit-scrollbar { display: none; }


.hs-feed-track {
  display: flex;
  gap: 12px;
  align-items: stretch;
}

.hs-feed-card {
  flex: 0 0 195px;
  background: var(--panel-solid);
  border: 1px solid var(--line-strong);
  border-radius:var(--radius-sm);
  padding: 8px 10px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  cursor: default;
  transition: border-color var(--motion-fast) var(--ease-soft), background var(--motion-fast) var(--ease-soft);
  min-width: 0;
}

.hs-feed-card:hover { border-color: var(--cyan); background: color-mix(in srgb, var(--panel-solid) 80%, var(--cyan) 5%); }


.hs-feed-card-top { display: flex; align-items: center; gap: 6px; }
.hs-feed-time     { font-size: 13px; color: var(--dim); font-family: var(--font-mono); flex: 0 0 auto; }

.hs-feed-cat      { font-size: 13px; border: 1px solid; border-radius: var(--radius-xs); padding: 0 4px; line-height: 1.5; flex: 0 0 auto; }
.hs-feed-title    { font-size: 16px; font-weight: 600; color: var(--txt); line-height: 1.35; }

.hs-feed-desc     { font-size: 14px; color: var(--dim); line-height: 1.45; flex: 1 1 0; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.hs-feed-loc      { font-size: 10px; color: var(--dim); margin-top: auto; }

.hs-feed-controls {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 10px;
  border-left: 1px solid var(--line);
  background: color-mix(in srgb, var(--panel-solid) 60%, transparent);
}

.hs-feed-auto-label {
  font-size: 9px;
  color: var(--dim);
  writing-mode: vertical-rl;
  letter-spacing: 0.06em;
}

.hs-feed-nav {
  background: none;
  border: 1px solid var(--line-strong);
  color: var(--dim);
  font-size: 11px;
  width: 18px;
  height: 18px;
  border-radius: var(--radius-xs);
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: color var(--dur-micro) var(--ease-soft), background var(--dur-micro) var(--ease-soft);
  padding: 0;
}

.hs-feed-nav:hover { color: var(--txt); background: var(--line); }


.hs-ticker-bar {
  flex: 0 0 auto;
  height: 28px;
  border-top: 1px solid var(--line);
  overflow: hidden;
  display: flex;
  align-items: center;
  background: color-mix(in srgb, var(--void) 80%, #001020 20%);
}

.hs-ticker-inner {
  display: inline-flex;
  white-space: nowrap;
  animation: hs-ticker 60s linear infinite;
  will-change: transform;
}

@keyframes hs-ticker {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.hs-ticker-item {
  font-size: 15px;
  color: var(--dim);
  padding: 0 8px;
}

.hs-ticker-time {
  font-family: var(--font-mono);
  font-size: 13px;
  color: var(--cyan);
  margin-right: 6px;
}

.hs-ticker-sep {
  color: var(--dim);
  font-size: 10px;
  padding: 0 6px;
}

/* ===== 天气面板样式（Task #32） ===== */
/* ============================================================
   天气观测面板样式（Task #32）
   ============================================================ */
.weather-panel {
  position: fixed;
  inset: 0;
  z-index: var(--z-overlay);
  display: flex;
  align-items: stretch;
  justify-content: center;
  background: radial-gradient(120% 120% at 50% 0%, rgba(34,211,238,.06), transparent 60%),
              var(--ws-overlay-scrim);
  backdrop-filter: var(--glass-2);
  opacity: 0;
  visibility: hidden;
  transform: scale(1.015);
  transition: opacity var(--motion-base) var(--ease-soft), transform var(--motion-base) var(--ease-soft), visibility var(--motion-base);
}
body.weather-mode .weather-panel {
  opacity: 1;
  visibility: visible;
  transform: scale(1);
}
.wx-boot {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(90deg, transparent, rgba(34,211,238,.10), transparent);
  opacity: 0;
}
body.weather-mode .weather-panel.wx-booting .wx-boot {
  animation: wxGlitch .9s steps(2, end);
}
@keyframes wxGlitch {
  0%   { opacity: 0; transform: translateX(-12%); }
  20%  { opacity: 1; transform: translateX(8%); }
  40%  { opacity: .2; transform: translateX(-4%); }
  60%  { opacity: .9; transform: translateX(3%); }
  100% { opacity: 0; transform: translateX(0); }
}
.wx-inner {
  width: min(1180px, 94vw);
  margin: auto;
  padding: 28px 30px 22px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: linear-gradient(160deg, var(--bg-2), var(--bg-2));
  box-shadow: var(--elev-3), inset 0 0 0 1px rgba(34,211,238,.05);
  max-height: 92vh;
  overflow: auto;
}
.wx-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.wx-title {
  display: flex;
  align-items: baseline;
  gap: 10px;
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: .06em;
  color: var(--cyan);
}
.wx-title .wx-glyph { font-size: 22px; filter: drop-shadow(0 0 8px rgba(34,211,238,.5)); }
.wx-sub { font-size: 11px; color: var(--dim); letter-spacing: .25em; }
.wx-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.wx-mode { display: flex; border: 1px solid var(--line); border-radius: var(--radius-sm); overflow: hidden; }
.wx-mode-btn {
  background: transparent; color: var(--dim); border: 0; padding: 8px 12px;
  font-size: 12px; cursor: pointer; transition: var(--motion-fast); font-family: var(--font-ui);
}
.wx-mode-btn.active { background: rgba(34,211,238,.14); color: var(--cyan); }
.wx-mode-btn:hover { color: var(--txt); }
.wx-search { display: flex; gap: 6px; }
.wx-city-input {
  width: 190px; background: var(--bg); border: 1px solid var(--input-border); color: var(--text);
  border-radius: var(--radius-sm); padding: 8px 10px; font-size: 13px; outline: none;
}
.wx-city-input:focus { border-color: var(--input-focus-border); }
.wx-city-go {
  background: rgba(34,211,238,.14); border: 1px solid var(--line); color: var(--cyan);
  border-radius: var(--radius-sm); padding: 8px 14px; cursor: pointer; font-size: 13px;
}
.wx-city-go:hover { background: rgba(34,211,238,.24); }
.wx-fetch { font-size: 11px; color: var(--dim); font-family: var(--font-mono); }
.wx-exit-btn {
  background: transparent; border: 1px solid var(--line); color: var(--dim);
