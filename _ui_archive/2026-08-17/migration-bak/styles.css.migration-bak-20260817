}
.modal-close:hover{color:#fff;border-color:var(--cyan);transform:rotate(90deg);box-shadow:0 0 14px rgba(34,211,238,.25)}

/* —— 天气弹窗 —— */
.wx-modal-head{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.wx-city{font-family: var(--font-ui);font-weight:700;font-size:28px;color:var(--text);line-height:1}
.wx-resolved{font-size:12px;color:var(--dim2);font-family: var(--font-mono)}
.wx-now{display:flex;align-items:center;gap:18px;margin:18px 0 6px}
.wx-emoji{font-size:64px;line-height:1;filter:drop-shadow(0 6px 14px rgba(0,0,0,.35))}
.wx-temp{font-family: var(--font-ui);font-weight:700;font-size:64px;color:var(--text);line-height:.9}
.wx-temp sup{font-size:24px;top:-1.4em;color:var(--dim)}
.wx-cond{font-size:18px;color:var(--text);font-weight:600}
.wx-meta{display:flex;flex-wrap:wrap;gap:8px 16px;margin-top:6px;font-size:13px;color:var(--dim)}
.wx-day{display:flex;align-items:center;gap:8px;margin:16px 0 4px;font-size:13px;color:var(--dim);
  background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:var(--radius-md);padding:8px 12px}
.wx-day .hi{color:var(--amber);font-weight:700}
.wx-day .lo{color:var(--dim)}
.wx-hourly{display:flex;gap:10px;overflow-x:auto;padding:12px 2px 6px;margin-top:6px}
.wx-hb{flex:0 0 auto;width:58px;text-align:center;background:rgba(255,255,255,.03);
  border:1px solid var(--line);border-radius:var(--radius-md);padding:10px 4px;transition:var(--motion-fast)}
.wx-hb:hover{border-color:var(--accent);transform:translateY(-2px)}
.wx-hb .t{font-size:10px;color:var(--dim2);font-family: var(--font-mono)}
.wx-hb .e{font-size:22px;margin:4px 0}
.wx-hb .d{font-size:14px;font-weight:700;color:var(--text)}
.wx-foot{display:flex;align-items:center;gap:10px;margin-top:16px;padding-top:14px;border-top:1px solid var(--line)}
.wx-speak{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);
  background:rgba(255,255,255,.04);color:var(--text);border-radius:var(--radius-md);padding:10px 16px;
  font-size:14px;cursor:pointer;transition:var(--motion-fast);font-family: var(--font-ui)}
.wx-speak:hover{border-color:var(--accent);background:rgba(255,255,255,.08)}
.wx-foot .hint{font-size:11px;color:var(--dim2);margin-left:auto;font-family: var(--font-mono)}

/* ===== 热点看板头部按钮（朗读 / 自检） ===== */
.hs-tts-btn, .hs-selfcheck-btn {
  background:none;border:1px solid var(--line);color:var(--dim);
  font-size:11px;width:20px;height:20px;border-radius:var(--radius-xs);cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:color var(--motion-fast) var(--ease-soft),background var(--motion-fast) var(--ease-soft),border-color var(--motion-fast) var(--ease-soft),transform var(--motion-fast) var(--ease-soft);
  flex:0 0 auto;padding:0;
}
.hs-tts-btn:hover{color:var(--txt);background:rgba(34,211,238,.14);border-color:var(--cyan)}
.hs-selfcheck-btn:hover{color:var(--txt);background:rgba(245,181,68,.14);border-color:var(--amber)}

/* ===== 热点弹窗卡片（科技感玻璃拟态） ===== */
.hs-modal-head{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px}
.hs-modal-badge{font-size:12px;font-weight:700;padding:4px 10px;border-radius:var(--radius-pill);border:1px solid}
.hs-modal-rank{font-family: var(--font-mono);font-size:14px;color:var(--cyan);font-weight:700}
.hs-modal-tag{font-size:10px;letter-spacing:1px;text-transform:uppercase;color:var(--dim2);
  border:1px solid var(--line);border-radius:var(--radius-pill);padding:4px 10px;font-family: var(--font-mono)}
.hs-modal-title{font-family: var(--font-ui);font-weight:700;font-size:24px;line-height:1.25;color:var(--text);margin-bottom:14px}
.hs-modal-meta{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:6px}
.hs-mm{flex:1;min-width:84px;background:rgba(255,255,255,.03);border:1px solid var(--line);
  border-radius:var(--radius-md);padding:10px 12px;text-align:center}
.hs-mm span{display:block;font-size:11px;color:var(--dim2);margin-bottom:3px}
.hs-mm b{font-family: var(--font-ui);font-size:18px;color:var(--text)}
.hs-modal-foot{display:flex;align-items:center;gap:10px;margin-top:18px;padding-top:14px;border-top:1px solid var(--line)}
.hs-modal-open,.hs-modal-speak{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);
  background:rgba(255,255,255,.04);color:var(--text);border-radius:var(--radius-md);padding:10px 16px;
  font-size:14px;cursor:pointer;transition:var(--motion-fast);font-family: var(--font-ui)}
.hs-modal-open:hover{border-color:var(--cyan);background:rgba(34,211,238,.1)}
.hs-modal-speak:hover{border-color:var(--amber);background:rgba(245,181,68,.1)}
.hs-modal-foot .hint{font-size:11px;color:var(--dim2);margin-left:auto;font-family: var(--font-mono)}

/* ============================================================
   指挥中心增强层 · 热点追踪 v2（高级科技感，区别于参考实现 L2 风格）
   ============================================================ */
.hotspot-panel {
  background: transparent;
  border: none;
  box-shadow: none;
  overflow: hidden;
}
.hotspot-panel::before { display: none; }
.hotspot-panel > * { position: relative; z-index: var(--z-base); }

/* HUD 扫描线 */
.hs-hud { position: absolute; inset: 0; pointer-events: none; z-index: var(--z-stage); }
.hs-scanline {
  position: absolute; left: 0; right: 0; top: 0; height: 60px; pointer-events: none;
  background: linear-gradient(180deg, var(--border), rgba(34,211,238,.06) 40%, transparent);
  opacity: 0;   /* 默认隐藏，仅在开场（.hs-booting）时上下扫描一次 */
  will-change: top, opacity, transform;
}
/* 上下扫描仅在进入热点模式的开场播放一次，结束后自动淡出并隐藏 */
body.hotspot-mode .hotspot-panel.hs-booting .hs-scanline {
  opacity: .5; animation: hs-scan 2.2s var(--ease-out-soft) 1 forwards;
}
@keyframes hs-scan {
  0%   { top: 0%; transform: translateY(-100%); opacity: 0; }
  8%   { opacity: .5; }
  90%  { opacity: .45; }
  100% { top: 100%; transform: translateY(-100%); opacity: 0; }
}

/* 地球核心化：放大、辉光、浮起 */
.hs-earth-core {
  position: relative;
  border-radius: 0;
  background: transparent;
  border: none;
  box-shadow: none;
  overflow: hidden;
  min-height: 300px;
  flex: 1 1 auto;
}
.hs-earth-core canvas { filter: none; }
.hs-earth-label {
  position: absolute; top: 14px; left: 16px; z-index: var(--z-stage-deco);
  font-family: var(--font-ui); font-weight: 600; letter-spacing: .08em;
  font-size: 15px; color: #bfe9ff; text-shadow: 0 0 12px rgba(34,211,238,.5);
}
.hs-earth-label::before { content: "◉ "; color: var(--cyan); }

/* 左右浮层玻璃卡：更窄、更悬浮 */
.hs-list-card {
  background: rgba(10,16,28,.5);
  border: 1px solid var(--border);
  box-shadow: var(--elev-2);
  backdrop-filter: var(--glass-2); -webkit-backdrop-filter: var(--glass-2);
}
.hs-list-card:hover { border-color: var(--border); }

/* header / stats / feed 玻璃辉光 */
.hs-header { border-bottom: 1px solid var(--border); background: linear-gradient(180deg, rgba(34,211,238,.05), transparent); }
.hs-title-en { font-family: var(--font-display); color: var(--cyan); text-shadow: 0 0 14px rgba(34,211,238,.4); }
.hs-stat { background: rgba(10,16,28,.45); border: 1px solid rgba(120,180,255,.10); backdrop-filter: var(--glass-1); -webkit-backdrop-filter: var(--glass-1); }
.hs-stat--ai .hs-stat-icon { color: #aa88ff; }
.hs-feed-bar { background: rgba(8,12,22,.6); border-top: 1px solid var(--border); backdrop-filter: var(--glass-1); -webkit-backdrop-filter: var(--glass-1); }
/* ============================================================
   主界面遥测面板 · 认知功能（自主行动 / 认知指标 / AI 活动）
   原独立认知模块（cognitive.html）的功能，现常驻于右侧 .tele 面板。
   ============================================================ */
.tele-ai{display:flex; align-items:center; gap:8px; font-size:11px; font-family: var(--font-mono);
  padding:10px 12px; border-radius:var(--radius-sm); border:1px solid var(--line); background:rgba(5,7,10,.5); margin-bottom:2px}
.tele-ai-dot{width:7px; height:7px; border-radius:50%; background:rgba(255,255,255,.2); flex:none}
.tele-ai[data-state="busy"]{color:var(--cyan)}
.tele-ai[data-state="busy"] .tele-ai-dot{background:var(--cyan); box-shadow:0 0 8px rgba(34,211,238,.5); animation:blink 1.2s ease-in-out infinite}
.tele-ai-label{font-weight:600; letter-spacing:.04em}
.tele-ai-detail{flex:1; opacity:.7; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
/* Agent Runtime 编排状态点（Phase 8） */
.tele-ai[data-state="planning"]{color:var(--amber,#f5b544)}
.tele-ai[data-state="planning"] .tele-ai-dot{background:var(--amber,#f5b544); box-shadow:0 0 8px rgba(245,181,68,.5); animation:blink 1.2s ease-in-out infinite}
.tele-ai[data-state="executing"]{color:var(--cyan)}
.tele-ai[data-state="executing"] .tele-ai-dot{background:var(--cyan); box-shadow:0 0 8px rgba(34,211,238,.5); animation:blink 1s ease-in-out infinite}
.tele-ai[data-state="reflecting"]{color:var(--violet)}
.tele-ai[data-state="reflecting"] .tele-ai-dot{background:var(--violet); box-shadow:0 0 8px rgba(167,139,250,.5); animation:blink 1.4s ease-in-out infinite}
.tele-ai[data-state="disabled"]{opacity:.5}
.tele-ai[data-state="disabled"] .tele-ai-dot{background:rgba(255,255,255,.18)}

/* Agent 审批卡（Agent Runtime 后台授权） */
.appr-head{display:flex; align-items:center; gap:10px; margin-bottom:10px}
.appr-badge{font-size:11px; padding:2px 10px; border-radius:var(--radius-lg); background:color-mix(in srgb, var(--warn) 15%, transparent); color:var(--amber,#f5b544); border:1px solid color-mix(in srgb, var(--warn) 35%, transparent); font-family: var(--font-mono); white-space:nowrap}
.appr-tool{font-family: var(--font-mono); font-size:14px; color:var(--txt,#e6edf3); font-weight:600; word-break:break-all}
.appr-summary{font-size:13px; line-height:1.6; color:var(--txt,#e6edf3); opacity:.9; margin-bottom:12px}
.appr-args-label{font-size:11px; color:var(--dim); margin-bottom:6px; letter-spacing:.04em}
.appr-args{background:rgba(0,0,0,.28); border:1px solid var(--line,rgba(255,255,255,.08)); border-radius:var(--radius-sm); padding:10px 12px; font-family: var(--font-mono); font-size:12px; color:var(--cyan); max-height:180px; overflow:auto; white-space:pre-wrap; word-break:break-word; margin:0 0 14px}
.appr-foot{display:flex; gap:10px; margin-bottom:8px}
.appr-btn{flex:1; padding:10px; border-radius:var(--radius-sm); font-size:13px; font-weight:600; cursor:pointer; border:1px solid transparent; transition:all var(--motion-fast) var(--ease-soft); font-family:inherit}
.appr-btn:disabled{opacity:.5; cursor:default}
.appr-approve{background:linear-gradient(135deg, rgba(34,211,238,.9), rgba(45,212,191,.9)); color:#04222a}
.appr-approve:hover:not(:disabled){transform:translateY(-1px); box-shadow:0 6px 20px color-mix(in srgb, var(--accent) 35%, transparent)}
.appr-reject{background:rgba(255,255,255,.06); color:var(--txt,#e6edf3); border-color:var(--line,rgba(255,255,255,.12))}
.appr-reject:hover:not(:disabled){background:rgba(255,90,90,.12); border-color:rgba(255,90,90,.4); color:#ff9a9a}

/* 自主行动 · Tick */
.act-head{display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px; gap:12px}
.act-title{font-size:15px; font-weight:600; color:var(--txt); letter-spacing:.02em}
.act-sub{font-size:10px; color:var(--dim); margin-top:2px; font-family: var(--font-mono); letter-spacing:.04em}
.act-pill{display:inline-flex; align-items:center; gap:6px; font-family: var(--font-mono); font-size:9px;
  letter-spacing:.1em; padding:4px 10px; border-radius:var(--radius-pill); color:var(--amber); border:1px solid color-mix(in srgb, var(--warn) 35%, transparent); background:rgba(245,181,68,.08)}
.act-pill .live-dot{width:6px; height:6px; border-radius:50%; background:var(--amber); box-shadow:0 0 8px var(--amber); animation:blink 1.4s ease-in-out infinite}

.act-stats{display:grid; grid-template-columns:repeat(3, 1fr); gap:8px; margin-bottom:12px;
  padding:10px; border-radius:var(--radius-md); background:rgba(5,7,10,.45); border:1px solid var(--line)}
.act-stat{display:flex; flex-direction:column; gap:3px}
.act-stat-label{font-size:9px; color:var(--dim); letter-spacing:.12em; text-transform:uppercase; font-family: var(--font-mono)}
.act-stat-val{font-size:13px; font-family: var(--font-mono); font-weight:600; color:var(--txt); display:flex; align-items:center; gap:5px}
.act-stat-val.live{color:var(--amber)}

.act-stream{max-height:200px; overflow-y:auto; overflow-x:hidden; overscroll-behavior:contain;
  scrollbar-width:thin; scrollbar-color:var(--line-strong) transparent}
.act-stream::-webkit-scrollbar{width:5px}
.act-stream::-webkit-scrollbar-thumb{background:var(--line-strong); border-radius:var(--radius-pill)}
.stream-line{padding:10px 0; border-bottom:1px solid var(--line); transition:opacity var(--motion-slow) var(--ease-soft); opacity:.95}
.line-header{display:flex; align-items:center; gap:8px; margin-bottom:4px}
.line-dot{width:5px; height:5px; border-radius:50%; flex-shrink:0}
.line-type{font-size:9px; font-family: var(--font-mono); letter-spacing:.14em; text-transform:uppercase; font-weight:600}
.line-time{font-size:9px; color:var(--dim); font-family: var(--font-mono); margin-left:auto}
.line-status{display:inline-block; margin:6px 0 0 14px; font-size:9px; font-family: var(--font-mono); letter-spacing:.04em;
  padding:2px 8px; border-radius:var(--radius-pill); border:1px solid var(--line-strong); color:var(--dim); background:rgba(255,255,255,.03); white-space:nowrap}
.line-status.busy{color:var(--amber); border-color:rgba(245,181,68,.45); background:rgba(245,181,68,.08)}
.line-status.done{color:var(--teal); border-color:rgba(45,212,191,.45); background:rgba(45,212,191,.08)}
.line-text{font-size:12px; line-height:1.55; color:var(--txt); padding-left:14px; word-break:break-word; white-space:pre-wrap}
.line-tool{font-size:11px; padding-left:14px; margin-top:6px; display:flex; align-items:center; gap:8px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.line-tool .tool-spinner{display:inline-block; width:10px; height:10px; border-radius:50%; border:1.4px solid currentColor; border-top-color:transparent; animation:spin 1s linear infinite; flex-shrink:0}
.line-tool.done .tool-spinner{animation:none; border-top-color:currentColor; opacity:.5}

/* 认知指标 */
.tele-cog .cog-stat-grid{display:grid; grid-template-columns:1fr 1fr; gap:9px 14px}
.tele-cog .cog-stat{display:flex; align-items:center; gap:8px; font-size:12px; font-family: var(--font-mono)}
.tele-cog .cog-dot{width:7px; height:7px; border-radius:50%; background:var(--dim); flex:none}
.tele-cog .cog-dot.constraint{background:var(--amber); box-shadow:0 0 8px rgba(245,181,68,.5)}
.tele-cog .cog-dot.memory{background:var(--cyan); box-shadow:0 0 8px rgba(34,211,238,.5)}
.tele-cog .cog-dot.knowledge{background:var(--teal); box-shadow:0 0 8px rgba(45,212,191,.4)}
.tele-cog .cog-dot.decayed{background:var(--dim)}
.tele-cog .cog-sl{color:var(--dim)}
.tele-cog .cog-sv{margin-left:auto; color:var(--txt); font-weight:600}

/* ============================================================
   设置面板（参考参考实现但不照搬，增加更多设置项）
   ============================================================ */
.settings-open-btn{--bc:#22D3EE}
.settings-open-btn.active{color:#061018;background:linear-gradient(135deg,var(--cyan),var(--teal));border-color:transparent;box-shadow:0 0 18px rgba(34,211,238,.4)}

.settings-overlay{position:fixed;inset:0;z-index: var(--z-mask);background:var(--ws-overlay-scrim);backdrop-filter: var(--glass-1);
  opacity:0;visibility:hidden;transition:opacity var(--motion-base),visibility var(--motion-base)}
.settings-overlay.show{opacity:1;visibility:visible}

.settings-panel{position:fixed;top:0;right:0;bottom:0;width:560px;max-width:92vw;z-index: var(--z-panel);
  display:flex;flex-direction:column;
  background:var(--bg-2);border-left:1px solid var(--line);
