    document.getElementById('btnNew')?.click();
    close();
  });

  // 重新启动引导（P7-3）：清除首启标记并重开引导浮层
  document.getElementById('settingsReOnboard')?.addEventListener('click', () => {
    try { localStorage.removeItem('zz_onboarded'); } catch {}
    close();
    if (window.ZZOnboarding) window.ZZOnboarding.show();
  });

  // ── 数据管理（P7-2）：本地配置导出/导入 + 服务端全量数据导出/导入 + 重置缓存 ──
  const dataFeedback = document.getElementById('settingsDataFeedback');
  const importFile = document.getElementById('settingsImportFile');

  function downloadText(filename, text, mime = 'application/json') {
    const blob = new Blob([text], { type: mime + ';charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 2000);
  }

  function readFileAsText(file) {
    return new Promise((resolve, reject) => {
      const fr = new FileReader();
      fr.onload = () => resolve(String(fr.result || ''));
      fr.onerror = () => reject(new Error('读取文件失败'));
      fr.readAsText(file);
    });
  }

  const LOCAL_KEYS = [
    'zhuangzhou_settings_v1', 'zhuangzhou_sid', 'zhuangzhou_history_v1',
    'zz_device_id', 'zzu_show_telemetry', 'zz_briefing_date',
  ];

  // 导出本地配置
  document.getElementById('settingsCardExportLocal')?.addEventListener('click', () => {
    try {
      const dump = {};
      LOCAL_KEYS.forEach((k) => {
        const v = localStorage.getItem(k);
        if (v !== null) dump[k] = v;
      });
      const name = 'zhuangzhou-local-' + new Date().toISOString().slice(0, 19).replace(/[:T]/g, '') + '.json';
      downloadText(name, JSON.stringify({ __zhuangzhou_local__: true, keys: dump }, null, 2));
      showFeedback(dataFeedback, '已导出本地配置 ✓');
    } catch (e) {
      showFeedback(dataFeedback, '导出失败：' + (e.message || e), false);
    }
  });

  // 导入本地配置
  document.getElementById('settingsCardImportLocal')?.addEventListener('click', () => {
    importFile?.click();
    importFile && (importFile.dataset.target = 'local');
  });

  // 导出服务端全部数据
  document.getElementById('settingsCardExportServer')?.addEventListener('click', async () => {
    try {
      const r = await fetch('/api/data/export');
      if (!r.ok) throw new Error('服务端返回 ' + r.status);
      const text = await r.text();
      const cd = r.headers.get('Content-Disposition') || '';
      const m = cd.match(/filename="?([^";]+)"?/);
      const name = m ? m[1] : 'zhuangzhou-data.json';
      downloadText(name, text);
      showFeedback(dataFeedback, '已导出服务端数据 ✓');
    } catch (e) {
      showFeedback(dataFeedback, '导出失败：' + (e.message || e), false);
    }
  });

  // 导入服务端全部数据
  document.getElementById('settingsCardImportServer')?.addEventListener('click', () => {
    importFile?.click();
    importFile && (importFile.dataset.target = 'server');
  });

  importFile?.addEventListener('change', async () => {
    const file = importFile.files && importFile.files[0];
    if (!file) return;
    const target = importFile.dataset.target || 'local';
    importFile.value = '';
    try {
      const text = await readFileAsText(file);
      const parsed = JSON.parse(text);
      if (target === 'local') {
        if (!parsed.__zhuangzhou_local__ || !parsed.keys) throw new Error('不是本地配置备份');
        Object.entries(parsed.keys).forEach(([k, v]) => localStorage.setItem(k, v));
        saveSettings(loadSettings());
        showFeedback(dataFeedback, '本地配置已恢复，刷新后生效 ✓');
      } else {
        const r = await fetch('/api/data/import', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: text,
        });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(d.error || ('服务端返回 ' + r.status));
        const t = d.tables ? Object.keys(d.tables).length : 0;
        const f = d.files ? Object.keys(d.files).length : 0;
        showFeedback(dataFeedback, `已恢复 ${t} 张表、${f} 个文件 ✓`);
      }
    } catch (e) {
      showFeedback(dataFeedback, '导入失败：' + (e.message || e), false);
    }
  });

  // 重置本地缓存
  document.getElementById('settingsResetLocal')?.addEventListener('click', () => {
    if (!confirm('确定清空浏览器本地缓存（设置 / 会话 / 设备 ID 等）？\n此操作不影响服务端记忆，但会重置本机外观与当前会话。')) return;
    LOCAL_KEYS.forEach((k) => localStorage.removeItem(k));
    showFeedback(dataFeedback, '本地缓存已重置，刷新后生效');
  });

  // 版本
  const verEl = document.getElementById('settingsVersion');
  if (verEl) {
    fetch('/api/version').then((r) => r.json()).then((d) => {
      verEl.textContent = 'v' + (d.version || '1.4.0');
    }).catch(() => { verEl.textContent = 'v1.4.0'; });
  }

  function syncUI() {
    document.querySelectorAll('.theme-opt').forEach((o) => o.classList.toggle('active', o.getAttribute('data-theme') === s.theme));
    if (animSel) animSel.value = s.animation;
    if (voiceSel) voiceSel.value = s.ttsVoice;
    if (rateSel) rateSel.value = s.ttsRate;
    if (volRange) { volRange.value = s.ttsVolume; if (volVal) volVal.textContent = Number(s.ttsVolume).toFixed(2); }
    if (autoTtsToggle) autoTtsToggle.checked = s.autoTts;
    if (tempRange) tempRange.value = s.temperature;
    if (tempVal) tempVal.textContent = Number(s.temperature).toFixed(2);
    if (cityInput) cityInput.value = s.defaultCity || '';
    restoreLocation();
    if (proactiveToggle) proactiveToggle.checked = s.proactive;
    if (aiNameInput) aiNameInput.value = s.aiName;
    if (memoryGraphToggle) memoryGraphToggle.checked = s.memoryGraph;
    if (reasoningToggle) reasoningToggle.checked = s.reasoning;
  }

  // 从服务端拉取当前真实配置（不暴露密钥本身，只更新状态/非敏感字段）
  async function loadServerConfig() {
    try {
      const d = await apiGetConfig();
      // ── G-11：Provider 框架状态投影（providers[] / active_provider / provider_probe）──
      providerSpecs = Array.isArray(d.providers) ? d.providers : [];
      providerProbe = d.provider_probe || {};
      const activeId = d.active_provider || 'agnes';
      const activeSpec = findSpec(activeId);
      if (llmStatus) {
        if (activeSpec) {
          llmStatus.textContent = `${activeSpec.label} · ${activeSpec.resolved_model || '-'} · ${activeSpec.configured ? '已配置' : '未配置'}`;
        } else {
          llmStatus.textContent = `${d.llm?.model || '-'} · ${d.llm?.key_present ? '已配置' : '未配置'}`;
        }
      }
      if (providerSpecs.length) {
        renderProviderOptions(activeId);
        renderProbeResult();
      } else {
        // 降级：后端未暴露 providers[] 时退回原单 Provider 行为
        if (llmBaseUrl && d.llm?.base_url) llmBaseUrl.value = d.llm.base_url;
        if (llmModel && d.llm?.model) llmModel.value = d.llm.model;
      }
      if (reasoningToggle && d.llm?.reasoning) {
        reasoningToggle.checked = !!d.llm.reasoning;
        s.reasoning = reasoningToggle.checked;
        saveSettings(s);
      }
      if (mediaStatus) {
        mediaStatus.textContent = d.media?.enabled ? `${d.media.provider} · 已启用` : '未启用';
      }
      if (s.aiName !== (d.ai_name || '庄周')) {
        s.aiName = d.ai_name || '庄周';
        saveSettings(s);
        if (aiNameInput) aiNameInput.value = s.aiName;
      }
      if (d.theme && s.theme !== d.theme) {
        s.theme = normalizeTheme(d.theme);
        saveSettings(s);
        applyTheme(s.theme);
        document.querySelectorAll('.theme-opt').forEach((o) => o.classList.toggle('active', o.getAttribute('data-theme') === s.theme));
      }
      if (typeof d.memory_graph === 'boolean' && s.memoryGraph !== d.memory_graph) {
        s.memoryGraph = d.memory_graph;
        saveSettings(s);
        if (memoryGraphToggle) memoryGraphToggle.checked = s.memoryGraph;
      }
      // 社交媒体状态
      if (socialDiscord) socialDiscord.textContent = d.social?.discord ? '已配置 ✓' : '未配置';
      if (socialFeishu) socialFeishu.textContent = d.social?.feishu ? '已配置 ✓' : '未配置';
      // 上网搜索
      if (searchEngine && d.web_search?.engine) searchEngine.value = d.web_search.engine;
      if (searchSearxng && d.web_search?.searxng_url) searchSearxng.value = d.web_search.searxng_url;
      // 安全沙箱
      if (sandboxFile && typeof d.security?.fileSandbox === 'boolean') sandboxFile.checked = d.security.fileSandbox;
      if (sandboxExec && typeof d.security?.execSandbox === 'boolean') sandboxExec.checked = d.security.execSandbox;
      if (sandboxBlocked && Array.isArray(d.security?.blockedTools)) sandboxBlocked.value = d.security.blockedTools.join(', ');
      // Phase 4 功能开关回填
      const featMap = {
        settingsFeatPremiumUi: d.feature_premium_ui,
        settingsFeatKnowledgeRag: d.feature_knowledge_rag,
        settingsFeatProactiveV2: d.feature_proactive_v2,
        settingsFeatMultiDevice: d.feature_multi_device,
        settingsFeatCalendarSense: d.feature_calendar_sense,
        settingsFeatAppFocus: d.feature_app_focus,
        settingsFeatClipboardSense: d.feature_clipboard_sense,
        settingsFeatAlwaysOn: d.feature_always_on,
        settingsFeatCrossDevice: d.feature_cross_device,
        settingsFeatMobileCompanion: d.feature_mobile_companion,
        settingsFeatPersona: d.feature_persona,
        settingsFeatMemoryDistill: d.feature_memory_distill,
      };
      Object.entries(featMap).forEach(([id, val]) => {
        if (typeof val !== 'boolean') return;
        const cb = document.getElementById(id);
        if (cb) cb.checked = val;
      });
    } catch (e) {
      if (llmStatus) llmStatus.textContent = '检测失败';
      if (mediaStatus) mediaStatus.textContent = '检测失败';
    }
  }

  // 舆情告警配置：关键词存 SQLite，渠道可多选（QQ/邮件待接入）
  const alertKeywords = document.getElementById('settingsAlertKeywords');
  const alertChannels = document.getElementById('settingsAlertChannels');
  const saveAlertBtn = document.getElementById('settingsSaveAlert');
  const alertFeedback = document.getElementById('settingsAlertFeedback');

  async function loadAlertConfig() {
    if (!alertKeywords) return;
    try {
      const r = await fetch('/api/alert-config');
      if (!r.ok) return;
      const d = await r.json();
      alertKeywords.value = (d.keywords || []).join('\n');
      if (alertChannels) {
        alertChannels.querySelectorAll('input[type=checkbox]').forEach((cb) => {
          cb.checked = (d.channels || ['ui']).includes(cb.value);
        });
      }
    } catch (_) {}
  }

  saveAlertBtn?.addEventListener('click', async () => {
    if (!alertKeywords) return;
    const keywords = alertKeywords.value.split('\n').map((k) => k.trim()).filter(Boolean);
    const channels = alertChannels
      ? Array.from(alertChannels.querySelectorAll('input[type=checkbox]:checked')).map((cb) => cb.value)
      : ['ui'];
    try {
      const r = await fetch('/api/alert-config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ keywords, channels }),
      });
      if (!r.ok) throw new Error('save failed');
      showFeedback(alertFeedback, '已保存告警配置 ✓');
    } catch (e) {
      showFeedback(alertFeedback, '保存失败：' + (e.message || e), false);
    }
  });

  // 语音后端适配：服务端启用 GPT-SoVITS 自定义音色时，放开音色/语速显示并说明
  function syncTtsBackend() {
    const sovitsHint = document.getElementById('sovitsHint');
    if (!voiceSel || !rateSel) return;
    fetch('/api/health').then((r) => r.json()).then((d) => {
      if (!d || d.tts_backend !== 'sovits') {
        if (sovitsHint) sovitsHint.hidden = true;
        return;
      }
      voiceSel.innerHTML = '<option value="__sovits__">自定义音色（GPT-SoVITS · 克隆男声）</option>';
      voiceSel.value = '__sovits__';
      rateSel.disabled = true;
      if (sovitsHint) sovitsHint.hidden = false;
      s.ttsVoice = '__sovits__';
    }).catch(() => {});
  }
  syncTtsBackend();

  // ── 社交媒体（参考参考实现「社交媒体」设置）──
  const socialDiscord = document.getElementById('settingsSocialDiscord');
  const socialFeishu = document.getElementById('settingsSocialFeishu');
  const discordToken = document.getElementById('settingsDiscordToken');
  const feishuId = document.getElementById('settingsFeishuId');
  const feishuSecret = document.getElementById('settingsFeishuSecret');
  const saveSocialBtn = document.getElementById('settingsSaveSocial');
  const socialFeedback = document.getElementById('settingsSocialFeedback');
  toggleEye('settingsDiscordToken', 'settingsDiscordTokenToggle');
  toggleEye('settingsFeishuSecret', 'settingsFeishuSecretToggle');

  saveSocialBtn?.addEventListener('click', async () => {
    const updates = {};
    const dt = discordToken.value.trim();
    if (dt) updates.DISCORD_BOT_TOKEN = dt;
    const fid = feishuId.value.trim();
    if (fid) updates.FEISHU_APP_ID = fid;
    const fsec = feishuSecret.value.trim();
    if (fsec) updates.FEISHU_APP_SECRET = fsec;
    try {
      await apiSaveConfig(updates);
      showFeedback(socialFeedback, '已保存，社交推送配置立即生效');
      loadServerConfig();
    } catch (e) {
      showFeedback(socialFeedback, '保存失败', false);
    }
  });

  // ── 上网搜索（参考参考实现「上网搜索」设置）──
  const searchEngine = document.getElementById('settingsSearchEngine');
  const searchKey = document.getElementById('settingsSearchKey');
  const searchSerper = document.getElementById('settingsSearchSerper');
  const searchJina = document.getElementById('settingsSearchJina');
  const searchBrave = document.getElementById('settingsSearchBrave');
  const searchSearxng = document.getElementById('settingsSearchSearxng');
  const saveSearchBtn = document.getElementById('settingsSaveSearch');
  const searchFeedback = document.getElementById('settingsSearchFeedback');
  toggleEye('settingsSearchKey', 'settingsSearchKeyToggle');
  toggleEye('settingsSearchSerper', 'settingsSearchSerperToggle');
  toggleEye('settingsSearchJina', 'settingsSearchJinaToggle');
  toggleEye('settingsSearchBrave', 'settingsSearchBraveToggle');

  saveSearchBtn?.addEventListener('click', async () => {
    const updates = {
      ZHUANGZHOU_WEB_SEARCH_ENGINE: searchEngine.value,
    };
    const k = searchKey.value.trim();
    if (k) updates.ZHUANGZHOU_WEB_SEARCH_KEY = k;
    const sp = searchSerper.value.trim();
    if (sp) updates.ZHUANGZHOU_WEB_SEARCH_SERPER_KEY = sp;
    const jn = searchJina.value.trim();
    if (jn) updates.ZHUANGZHOU_WEB_SEARCH_JINA_KEY = jn;
    const bv = searchBrave.value.trim();
    if (bv) updates.ZHUANGZHOU_WEB_SEARCH_BRAVE_KEY = bv;
    const sx = searchSearxng.value.trim();
    if (sx) updates.ZHUANGZHOU_WEB_SEARCH_SEARXNG_URL = sx;
    try {
      await apiSaveConfig(updates);
      showFeedback(searchFeedback, '已保存，搜索配置立即生效');
      loadServerConfig();
    } catch (e) {
      showFeedback(searchFeedback, '保存失败', false);
    }
  });

  // ── 安全沙箱（参考参考实现「安全沙箱」设置）──
  const sandboxFile = document.getElementById('settingsSandboxFile');
  const sandboxExec = document.getElementById('settingsSandboxExec');
  const sandboxBlocked = document.getElementById('settingsSandboxBlocked');
  const saveSandboxBtn = document.getElementById('settingsSaveSandbox');
  const sandboxFeedback = document.getElementById('settingsSandboxFeedback');

  saveSandboxBtn?.addEventListener('click', async () => {
    const updates = {
      ZHUANGZHOU_SANDBOX_FILE: sandboxFile.checked ? 'true' : 'false',
      ZHUANGZHOU_SANDBOX_EXEC: sandboxExec.checked ? 'true' : 'false',
      ZHUANGZHOU_BLOCKED_TOOLS: sandboxBlocked.value.trim(),
    };
    try {
      await apiSaveConfig(updates);
      showFeedback(sandboxFeedback, '已保存，工具门控立即生效');
      loadServerConfig();
    } catch (e) {
      showFeedback(sandboxFeedback, '保存失败', false);
    }
  });

  // ── 更新（参考参考实现「更新」设置）──
  const updateName = document.getElementById('settingsUpdateName');
  const updateVersion = document.getElementById('settingsUpdateVersion');
  const checkUpdateBtn = document.getElementById('settingsCheckUpdate');
  const updateFeedback = document.getElementById('settingsUpdateFeedback');

  async function refreshVersion() {
    try {
      const r = await fetch('/api/version');
      const d = await r.json();
      if (updateName) updateName.textContent = d.app_name || '庄周';
      if (updateVersion) updateVersion.textContent = 'v' + (d.version || '1.4.0');
    } catch (_) {}
  }
  refreshVersion();

  checkUpdateBtn?.addEventListener('click', () => {
    window.open('https://github.com/AGI-ZhuangZhou/ZhuangZhou/releases/latest', '_blank');
    showFeedback(updateFeedback, '已打开发布页，请核对最新版本号');
  });

  // 暴露全局接口
  window.ZZSettings = {
    get: () => ({ ...s }),
    set: (patch) => { Object.assign(s, patch); saveSettings(s); applyTheme(s.theme); },
    open, close,
    refresh: loadServerConfig,
  };
}

