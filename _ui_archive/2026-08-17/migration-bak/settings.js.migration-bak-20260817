  if (proactiveToggle) {
    proactiveToggle.checked = s.proactive;
    proactiveToggle.addEventListener('change', () => { s.proactive = proactiveToggle.checked; saveSettings(s); });
  }

  // 快捷入口
  document.getElementById('settingsCardMemory')?.addEventListener('click', () => {
    close();
    document.getElementById('btnMem')?.click();
  });
  document.getElementById('settingsCardSelfcheck')?.addEventListener('click', () => {
