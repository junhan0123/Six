// 庄周 · 设置面板
// 参考参考实现设置功能：外观/AI名字/LLM模型/媒体能力/语音/天气/系统。

const SETTINGS_KEY = 'zhuangzhou_settings_v1';

const DEFAULTS = {
  theme: 'dark-cyan',     // dark-cyan | dark-green | dark-purple | dark-amber | dark-rose | light | dark | quantum | midnight
  animation: 'full',      // full | reduced
  autoTts: false,
  kws: false,
  ttsVoice: 'zh-CN-YunxiNeural',
  ttsRate: '+0%',
  ttsVolume: 1.0,        // 0.5–2.0，>1 为放大
  defaultCity: '',
  proactive: true,
  temperature: 0.7,
  aiName: '庄周',
  memoryGraph: true,
  reasoning: false,
};

const TTS_VOICES = [
  { value: 'zh-CN-YunxiNeural', label: '云希（男声）' },
  { value: 'zh-CN-YunjianNeural', label: '云间（男声）' },
  { value: 'zh-CN-XiaoyiNeural', label: '晓伊（女声）' },
  { value: 'zh-CN-XiaoxiaoNeural', label: '晓晓（女声）' },
  { value: '__sovits__', label: '自定义音色（GPT-SoVITS）' },
];

function loadSettings() {
  try {
    const raw = localStorage.getItem(SETTINGS_KEY);
    return Object.assign({}, DEFAULTS, raw ? JSON.parse(raw) : {});
  } catch {
    return { ...DEFAULTS };
  }
}

function saveSettings(s) {
  try {
    localStorage.setItem(SETTINGS_KEY, JSON.stringify(s));
  } catch {}
}

function escapeHtml(str) {
  return String(str).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function setLoading(btn, loading) {
  if (!btn) return;
  btn.disabled = loading;
  btn.dataset.originalText = btn.dataset.originalText || btn.textContent;
  btn.textContent = loading ? '…' : btn.dataset.originalText;
}

function normalizeTheme(theme) {
  if (!theme || theme === 'system') return 'dark-cyan'; // 不再支持 system，回退默认；dark 为独立有效主题（ui2.css 已定义）
  return theme;
}

function applyTheme(theme) {
  theme = normalizeTheme(theme);
  document.body.setAttribute('data-theme', theme);
}

async function apiGetConfig() {
  const r = await fetch('/api/config');
  if (!r.ok) throw new Error('config fetch failed');
  return r.json();
}

async function apiSaveConfig(updates) {
  const r = await fetch('/api/config', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(updates),
  });
  if (!r.ok) throw new Error('config save failed');
  return r.json();
}

function showFeedback(el, msg, ok = true) {
  if (!el) return;
  el.textContent = msg;
  el.style.color = ok ? 'var(--teal)' : 'var(--red)';
  setTimeout(() => { el.textContent = ''; }, 2600);
}

function toggleEye(inputId, btnId) {
  const input = document.getElementById(inputId);
  const btn = document.getElementById(btnId);
  if (!input || !btn) return;
  btn.addEventListener('click', () => {
    input.type = input.type === 'password' ? 'text' : 'password';
  });
}

function init() {
  const s = loadSettings();
  s.theme = normalizeTheme(s.theme);
  applyTheme(s.theme);

  const overlay = document.getElementById('settingsOverlay');
  const panel = document.getElementById('settingsPanel');
  const openBtn = document.getElementById('settingsOpenBtn');
  const closeBtn = document.getElementById('settingsClose');
  const navItems = document.querySelectorAll('.settings-nav-item');
  const tabs = document.querySelectorAll('.settings-tab');

  function open() {
    overlay.classList.add('show');
    panel.classList.add('open');
    openBtn.classList.add('active');
    syncUI();
    loadServerConfig();
    loadAlertConfig();
    // Sprint 1/2：登记到 OverlayManager（统一 ESC / 焦点 / 栈）
    if (window.OverlayManager) window.OverlayManager.track('settings', { el: overlay, onClose: closeImpl, type: window.OverlayManager.OverlayType.PANEL, trap: false });
  }
  function closeImpl() {
    overlay.classList.remove('show');
    panel.classList.remove('open');
    openBtn.classList.remove('active');
  }
  function close() {
    if (window.OverlayManager && window.OverlayManager.isOpen('settings')) window.OverlayManager.close('settings');
    else closeImpl();
  }

  openBtn?.addEventListener('click', open);
  closeBtn?.addEventListener('click', close);
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) close(); });
  // ESC 由 OverlayManager 中央处理（关闭栈顶）

  navItems.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab');
      navItems.forEach((n) => n.classList.toggle('active', n === btn));
      tabs.forEach((t) => t.classList.toggle('active', t.getAttribute('data-tab') === tab));
    });
  });

  // 外观：AI 名字
  const aiNameInput = document.getElementById('settingsAiName');
  const saveAiNameBtn = document.getElementById('settingsSaveAiName');
  const aiNameFeedback = document.getElementById('settingsAiNameFeedback');
  if (aiNameInput) {
    aiNameInput.value = s.aiName;
    aiNameInput.addEventListener('change', () => {
      s.aiName = aiNameInput.value.trim() || '庄周';
      saveSettings(s);
    });
  }
  saveAiNameBtn?.addEventListener('click', async () => {
    const name = aiNameInput.value.trim() || '庄周';
    s.aiName = name;
    saveSettings(s);
    try {
      await apiSaveConfig({ AI_DISPLAY_NAME: name });
      showFeedback(aiNameFeedback, '已保存，刷新后生效');
    } catch (e) {
      showFeedback(aiNameFeedback, '保存失败', false);
    }
  });

  // 外观：主题
  document.querySelectorAll('.theme-opt').forEach((opt) => {
    opt.addEventListener('click', () => {
      const t = opt.getAttribute('data-theme');
      s.theme = t;
      applyTheme(t);
      saveSettings(s);
      document.querySelectorAll('.theme-opt').forEach((o) => o.classList.toggle('active', o === opt));
      apiSaveConfig({ ZHUANGZHOU_THEME: t }).catch(() => {});
    });
  });

  // 外观：记忆节点图
  const memoryGraphToggle = document.getElementById('settingsMemoryGraph');
  if (memoryGraphToggle) {
    memoryGraphToggle.checked = s.memoryGraph;
    memoryGraphToggle.addEventListener('change', () => {
      s.memoryGraph = memoryGraphToggle.checked;
      saveSettings(s);
      apiSaveConfig({ ZHUANGZHOU_MEMORY_GRAPH: s.memoryGraph ? 'true' : 'false' }).catch(() => {});
    });
  }

  // 外观：遥测面板显隐（独立于 zhuangzhou_settings_v1，专用 localStorage key）
  const teleToggle = document.getElementById('settingsShowTelemetry');
  if (teleToggle) {
    teleToggle.checked = localStorage.getItem('zzu_show_telemetry') === 'true';
    teleToggle.addEventListener('change', () => {
      const on = teleToggle.checked;
      localStorage.setItem('zzu_show_telemetry', on ? 'true' : 'false');
      const appEl = document.getElementById('app');
      if (appEl) appEl.classList.toggle('tele-hidden', !on);
    });
  }

  // 外观：动画级别
  const animSel = document.getElementById('settingsAnimation');
  if (animSel) {
    animSel.value = s.animation;
    animSel.addEventListener('change', () => {
      s.animation = animSel.value;
      document.body.classList.toggle('reduced-motion', s.animation === 'reduced');
      saveSettings(s);
    });
    document.body.classList.toggle('reduced-motion', s.animation === 'reduced');
  }

  // 语音：音色 / 语速 / 自动朗读
  const voiceSel = document.getElementById('settingsTtsVoice');
  if (voiceSel) {
    voiceSel.innerHTML = TTS_VOICES.map((v) => `<option value="${v.value}">${v.label}</option>`).join('');
    voiceSel.value = s.ttsVoice;
    voiceSel.addEventListener('change', () => { s.ttsVoice = voiceSel.value; saveSettings(s); });
  }
  const rateSel = document.getElementById('settingsTtsRate');
  if (rateSel) {
    rateSel.value = s.ttsRate;
    rateSel.addEventListener('change', () => { s.ttsRate = rateSel.value; saveSettings(s); });
  }
  // 语音：音量（0.5–2.0，可放大）
  const volRange = document.getElementById('settingsTtsVolume');
  const volVal = document.getElementById('settingsTtsVolumeVal');
  if (volRange) {
    volRange.value = s.ttsVolume;
    if (volVal) volVal.textContent = Number(s.ttsVolume).toFixed(2);
    volRange.addEventListener('input', () => {
      s.ttsVolume = parseFloat(volRange.value) || 1.0;
      if (volVal) volVal.textContent = s.ttsVolume.toFixed(2);
      saveSettings(s);
    });
  }
  const autoTtsToggle = document.getElementById('settingsAutoTts');
  if (autoTtsToggle) {
    autoTtsToggle.checked = s.autoTts;
    autoTtsToggle.addEventListener('change', () => {
      s.autoTts = autoTtsToggle.checked;
      saveSettings(s);
      const btnTts = document.getElementById('btnTts');
      if (btnTts) btnTts.classList.toggle('on', s.autoTts);
      if (window.__zzState) window.__zzState.autoTts = s.autoTts;
    });
  }

  // 语音唤醒（KWS）：开启后由 kws.js 启动常驻麦克风监听；同时把意图写入后端配置（若后端支持则持久化）
  const kwsToggle = document.getElementById('settingsKws');
  if (kwsToggle) {
    kwsToggle.checked = !!s.kws;
    kwsToggle.addEventListener('change', () => {
      s.kws = kwsToggle.checked;
      saveSettings(s);
      // 后端即便未开放该配置键也不会报错，仅作为意图记录；实际行为由前端 kws.js 驱动
      apiSaveConfig({ ZHUANGZHOU_KWS_ENABLED: s.kws }).catch(() => {});
      if (window.ZZKws) window.ZZKws.setEnabled(s.kws);
    });
  }

  // Phase 4 功能开关：实时读写后端 /api/config（持久化到 .env，reload 后后端即时生效；沉浸视觉需刷新页面）
  const featFeedback = document.getElementById('settingsFeatFeedback');
  const featToggles = [
    { el: 'settingsFeatPremiumUi', key: 'FEATURE_PREMIUM_UI', refresh: true },
    { el: 'settingsFeatKnowledgeRag', key: 'FEATURE_KNOWLEDGE_PLATFORM', refresh: false },
    { el: 'settingsFeatProactiveV2', key: 'FEATURE_PROACTIVE_V2', refresh: false },
    { el: 'settingsFeatMultiDevice', key: 'FEATURE_MULTI_DEVICE', refresh: false },
    { el: 'settingsFeatCalendarSense', key: 'FEATURE_CALENDAR_SENSE', refresh: false },
    { el: 'settingsFeatAppFocus', key: 'FEATURE_APP_FOCUS', refresh: false },
    { el: 'settingsFeatClipboardSense', key: 'FEATURE_CLIPBOARD_SENSE', refresh: false },
    { el: 'settingsFeatAlwaysOn', key: 'FEATURE_ALWAYS_ON', refresh: false },
    { el: 'settingsFeatCrossDevice', key: 'FEATURE_CROSS_DEVICE', refresh: false },
    { el: 'settingsFeatMobileCompanion', key: 'FEATURE_MOBILE_COMPANION', refresh: false },
    { el: 'settingsFeatPersona', key: 'FEATURE_PERSONA', refresh: false },
    { el: 'settingsFeatMemoryDistill', key: 'FEATURE_MEMORY_DISTILL', refresh: false },
  ];
  featToggles.forEach(({ el, key, refresh }) => {
    const input = document.getElementById(el);
    if (!input) return;
    input.addEventListener('change', () => {
      apiSaveConfig({ [key]: input.checked })
        .then(() => showFeedback(featFeedback, refresh ? '已保存 ✓，刷新页面后视觉生效' : '已保存 ✓'))
        .catch(() => showFeedback(featFeedback, '保存失败', false));
    });
  });

  // 模型：当前状态 / 提供商 / 端点 / 模型 / API Key / 思考模式
  const llmStatus = document.getElementById('settingsLlmStatus');
  const llmProvider = document.getElementById('settingsLlmProvider');
  const llmBaseUrl = document.getElementById('settingsLlmBaseUrl');
  const llmModel = document.getElementById('settingsLlmModel');
  const llmModelList = document.getElementById('settingsLlmModelList');
  const llmKey = document.getElementById('settingsLlmKey');
  const saveLlmBtn = document.getElementById('settingsSaveLlm');
  const fetchModelsBtn = document.getElementById('settingsFetchModels');
  const testLlmBtn = document.getElementById('settingsTestLlm');
  const llmFeedback = document.getElementById('settingsLlmFeedback');
  const reasoningToggle = document.getElementById('settingsReasoning');

  toggleEye('settingsLlmKey', 'settingsLlmKeyToggle');

  // ── Phase 10-C / G-11：Provider 感知的模型设置 ──
  // 唯一选择权威 = ACTIVE_LLM（后端 llm.resolve_provider 只认它）；前端只做「投影 + 写入」，
  // 不在本地另建一套选择状态（禁第二 Selection authority）。
  const llmKeyRow = document.getElementById('settingsLlmKeyRow');
  const providerMeta = document.getElementById('settingsProviderMeta');
  const probeLocalBtn = document.getElementById('settingsProbeLocal');
  const probeResult = document.getElementById('settingsProbeResult');

  // provider id -> .env 键名（与 provider_registry.PROVIDER_SPECS[*].env_keys 对齐）
  const PROVIDER_ENV = {
    agnes: { base: 'AGNES_BASE_URL', model: 'AGNES_MODEL', key: 'AGNES_API_KEY' },
    llm2: { base: 'LLM2_BASE_URL', model: 'LLM2_MODEL', key: 'LLM2_API_KEY' },
    ollama: { base: 'OLLAMA_BASE_URL', model: 'OLLAMA_MODEL', key: null },
    lmstudio: { base: 'LMSTUDIO_BASE_URL', model: 'LMSTUDIO_MODEL', key: null },
    mlx: { base: 'MLX_BASE_URL', model: 'MLX_MODEL', key: null },
  };
  let providerSpecs = [];  // /api/config 的 providers[]（只读投影，不含任何 API Key）
  let providerProbe = {};  // 最近一次本地探测结果

  const findSpec = (id) => providerSpecs.find((p) => p.id === id) || null;

  function renderProviderMeta(id) {
    if (!providerMeta) return;
    const sp = findSpec(id);
    if (!sp) { providerMeta.textContent = ''; return; }
    const isLocal = sp.privacy_class === 'local';
    const privacy = isLocal ? '本地 · 数据不出本机' : '云端 · 请求会发送到外部服务';
    const caps = sp.capabilities || {};
    const capText = [
      caps.chat ? '对话 ✓' : '对话 ✗',
      caps.streaming ? '流式 ✓' : '流式 ✗（当前全链路非流式）',
      caps.tool_calling ? '工具调用 ✓（取决于具体模型）' : '工具调用 ✗',
    ].join(' · ');
    const state = sp.configured ? '已配置 ✓' : '未配置';
    const probe = providerProbe[id];
    const probeText = (isLocal && probe) ? (probe.reachable ? ' · 本地服务在线 ✓' : ' · 本地服务未响应') : '';
    providerMeta.textContent = `${sp.label} · ${privacy} · ${state}${probeText}　|　${capText}`;
  }

  // 切换 provider 时把该 provider 已保存的连接参数投影到输入框
  function applyProviderView(id) {
    const sp = findSpec(id);
    if (sp) {
      const needKey = sp.auth_required !== false;
      if (llmKeyRow) llmKeyRow.hidden = !needKey;
      if (llmBaseUrl) {
        llmBaseUrl.value = sp.resolved_base_url || '';
        llmBaseUrl.placeholder = sp.default_base_url || '';
      }
      if (llmModel) llmModel.value = sp.resolved_model || '';
    }
    if (llmKey) llmKey.value = '';  // Key 永不下发，输入框始终留空
    renderProviderMeta(id);
  }

  function renderProviderOptions(activeId) {
    if (!llmProvider || !providerSpecs.length) return;
    const list = providerSpecs.filter((p) => p.user_selectable !== false);
    if (!list.length) return;
    llmProvider.innerHTML = list
      .map((p) => `<option value="${escapeHtml(p.id)}">${escapeHtml(p.label)}${p.privacy_class === 'local' ? '（本地）' : ''}</option>`)
      .join('');
    llmProvider.value = list.some((p) => p.id === activeId) ? activeId : list[0].id;
    applyProviderView(llmProvider.value);
  }

  llmProvider?.addEventListener('change', () => applyProviderView(llmProvider.value));

  function renderProbeResult() {
    if (!probeResult) return;
    const locals = providerSpecs.filter((p) => p.privacy_class === 'local');
    if (!locals.length) { probeResult.textContent = '无本地 Provider'; return; }
    probeResult.textContent = locals.map((sp) => {
      const r = providerProbe[sp.id];
      if (!r) return `${sp.label}: 未检测`;
      if (r.reachable) return `${sp.label}: 在线 ✓`;
      if (r.reason === 'host-not-in-whitelist') return `${sp.label}: 端点不在白名单`;
      return `${sp.label}: 离线`;
    }).join('　');
  }

  probeLocalBtn?.addEventListener('click', async () => {
    setLoading(probeLocalBtn, true);
    if (probeResult) probeResult.textContent = '检测中…';
    try {
      const r = await fetch('/api/providers/probe', { method: 'POST' });
      const d = await r.json().catch(() => ({}));
      if (!r.ok || !d.ok) throw new Error(d.error || `HTTP ${r.status}`);
      providerProbe = d.probe || {};
      renderProbeResult();
      if (llmProvider) renderProviderMeta(llmProvider.value);
    } catch (e) {
      if (probeResult) probeResult.textContent = '检测失败：' + (e.message || e);
    } finally {
      setLoading(probeLocalBtn, false);
    }
  });

  // 模型：temperature
  const tempRange = document.getElementById('settingsTemperature');
  const tempVal = document.getElementById('settingsTemperatureVal');
  if (tempRange) {
    tempRange.value = s.temperature;
    if (tempVal) tempVal.textContent = Number(s.temperature).toFixed(2);
    tempRange.addEventListener('input', () => {
      s.temperature = parseFloat(tempRange.value);
      if (tempVal) tempVal.textContent = s.temperature.toFixed(2);
      if (window.__zzState) window.__zzState.temperature = s.temperature;
    });
    tempRange.addEventListener('change', () => saveSettings(s));
  }

  if (reasoningToggle) {
    reasoningToggle.checked = s.reasoning;
    reasoningToggle.addEventListener('change', () => {
      s.reasoning = reasoningToggle.checked;
      saveSettings(s);
      const val = s.reasoning ? 'medium' : '';
      apiSaveConfig({ AGNES_REASONING: val }).catch(() => {});
    });
  }

  saveLlmBtn?.addEventListener('click', async () => {
    // G-11：按所选 Provider 写入对应键；ACTIVE_LLM 是唯一选择权威（不再写死控件 AGNES_PROVIDER）
    const pid = llmProvider?.value || 'agnes';
    const envMap = PROVIDER_ENV[pid] || PROVIDER_ENV.agnes;
    const updates = { ACTIVE_LLM: pid };
    updates[envMap.base] = llmBaseUrl.value.trim();
    updates[envMap.model] = llmModel.value.trim();
    // 本地 Provider 无需鉴权（envMap.key === null），不发送任何 Key
    const key = envMap.key ? llmKey.value.trim() : '';
    if (key) updates[envMap.key] = key;  // 留空 = 不修改既有 Key
    try {
      await apiSaveConfig(updates);
      showFeedback(llmFeedback, '已保存，部分配置需重启后生效');
      loadServerConfig();
    } catch (e) {
      showFeedback(llmFeedback, '保存失败', false);
    }
  });

  async function fetchModels() {
    const baseUrl = llmBaseUrl?.value.trim();
    const key = llmKey?.value.trim();
    if (!baseUrl) {
      showFeedback(llmFeedback, '请先填写端点', false);
      return;
    }
    setLoading(fetchModelsBtn, true);
    try {
      const r = await fetch('/api/models', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ base_url: baseUrl, api_key: key }),
      });
      const d = await r.json().catch(() => ({}));
      if (!r.ok || !d.ok) {
        throw new Error(d.error || `HTTP ${r.status}`);
      }
      const models = d.models || [];
      if (llmModelList) {
        llmModelList.innerHTML = models.map((m) => `<option value="${escapeHtml(m.id)}">${escapeHtml(m.id)}${m.owned_by ? ` · ${escapeHtml(m.owned_by)}` : ''}</option>`).join('');
      }
      showFeedback(llmFeedback, `已获取 ${models.length} 个模型`, true);
    } catch (e) {
      showFeedback(llmFeedback, '获取模型失败：' + e.message, false);
    } finally {
      setLoading(fetchModelsBtn, false);
    }
  }

  async function testLlm() {
    const baseUrl = llmBaseUrl?.value.trim();
    const key = llmKey?.value.trim();
    const model = llmModel?.value.trim();
    if (!model) {
      showFeedback(llmFeedback, '请先填写或选择模型', false);
      return;
    }
    setLoading(testLlmBtn, true);
    try {
      const r = await fetch('/api/test-llm', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ base_url: baseUrl, api_key: key, model }),
      });
      const d = await r.json().catch(() => ({}));
      if (!r.ok || !d.ok) {
        throw new Error(d.error || `HTTP ${r.status}`);
      }
      showFeedback(llmFeedback, `连接成功 · ${d.latency_ms}ms · ${d.model}`, true);
    } catch (e) {
      showFeedback(llmFeedback, '测试失败：' + e.message, false);
    } finally {
      setLoading(testLlmBtn, false);
    }
  }

  fetchModelsBtn?.addEventListener('click', fetchModels);
  testLlmBtn?.addEventListener('click', testLlm);

  // 媒体能力
  const mediaStatus = document.getElementById('settingsMediaStatus');
  const minimaxKey = document.getElementById('settingsMinimaxKey');
  const minimaxGroup = document.getElementById('settingsMinimaxGroup');
  const saveMediaBtn = document.getElementById('settingsSaveMedia');
  const mediaFeedback = document.getElementById('settingsMediaFeedback');
  toggleEye('settingsMinimaxKey', 'settingsMinimaxKeyToggle');

  saveMediaBtn?.addEventListener('click', async () => {
    const updates = {};
    const key = minimaxKey.value.trim();
    if (key) updates.MINIMAX_API_KEY = key;
    const group = minimaxGroup.value.trim();
    updates.MINIMAX_GROUP_ID = group;
    updates.ZHUANGZHOU_MEDIA_PROVIDER = key ? 'minimax' : '';
    try {
      await apiSaveConfig(updates);
      showFeedback(mediaFeedback, '已保存');
      loadServerConfig();
    } catch (e) {
      showFeedback(mediaFeedback, '保存失败', false);
    }
  });

  // 天气：所在地三级联动
  const provinceSel = document.getElementById('settingsProvince');
  const citySel = document.getElementById('settingsCity');
  const districtSel = document.getElementById('settingsDistrict');
  const cityInput = document.getElementById('settingsDefaultCity');
  const locateMeBtn = document.getElementById('settingsLocateMe');
  const weatherFeedback = document.getElementById('settingsWeatherFeedback');
  const regions = (typeof CHINA_REGIONS !== 'undefined') ? CHINA_REGIONS : {};

  function findCityPath(target) {
    if (!target) return null;
    const t = String(target).replace(/[市县区]/g, '').trim();
    for (const prov of Object.keys(regions)) {
      const provShort = prov.replace(/[省市自治区壮族维吾尔回族蒙古藏族自治州特别行政区]/g, '').trim();
      for (const city of Object.keys(regions[prov])) {
        const cityShort = city.replace(/[市]/g, '').trim();
        if (city === target || cityShort === t) return { province: prov, city, district: '' };
        for (const district of regions[prov][city]) {
          const distShort = district.replace(/[县区旗]/g, '').trim();
          if (district === target || distShort === t) return { province: prov, city, district };
        }
      }
      if (prov === target || provShort === t) {
        const firstCity = Object.keys(regions[prov])[0];
        return { province: prov, city: firstCity || '', district: '' };
      }
    }
    return null;
  }

  function populateProvince() {
    if (!provinceSel) return;
    provinceSel.innerHTML = '<option value="">请选择</option>';
    Object.keys(regions).forEach((p) => {
      const opt = document.createElement('option');
      opt.value = p; opt.textContent = p;
      provinceSel.appendChild(opt);
    });
  }

  function populateCity(prov) {
    if (!citySel) return;
    citySel.innerHTML = '<option value="">请选择</option>';
    districtSel && (districtSel.innerHTML = '<option value="">请选择</option>');
    if (!prov || !regions[prov]) return;
    Object.keys(regions[prov]).forEach((c) => {
      const opt = document.createElement('option');
      opt.value = c; opt.textContent = c;
      citySel.appendChild(opt);
    });
  }

  function populateDistrict(prov, city) {
    if (!districtSel) return;
    districtSel.innerHTML = '<option value="">请选择</option>';
    if (!prov || !city || !regions[prov] || !regions[prov][city]) return;
    regions[prov][city].forEach((d) => {
      const opt = document.createElement('option');
      opt.value = d; opt.textContent = d;
      districtSel.appendChild(opt);
    });
  }

  function saveLocation() {
    const prov = provinceSel?.value || '';
    const city = citySel?.value || '';
    const district = districtSel?.value || '';
    const customCity = cityInput?.value.trim() || '';
    s.province = prov;
    s.city = city;
    s.district = district;
    // 天气查询优先使用自定义城市名；未填写则使用县/市
    s.defaultCity = customCity || district || city || prov;
    s.locationDisplay = district ? `${prov} · ${city} · ${district}` : (city ? `${prov} · ${city}` : prov);
    saveSettings(s);
    // 同步通知后端（可选）
    apiSaveConfig({ ZHUANGZHOU_LOCATION: s.locationDisplay, ZHUANGZHOU_DEFAULT_CITY: s.defaultCity }).catch(() => {});
  }

  function applyLocationPath(path) {
    if (!path) return;
    populateProvince();
    if (provinceSel) provinceSel.value = path.province || '';
    populateCity(path.province);
    if (citySel) citySel.value = path.city || '';
    populateDistrict(path.province, path.city);
    if (districtSel) districtSel.value = path.district || '';
    if (cityInput) cityInput.value = path.district || path.city || '';
    saveLocation();
  }

  function restoreLocation() {
    populateProvince();
    const path = { province: s.province || '', city: s.city || '', district: s.district || '' };
    if (path.province && regions[path.province]) {
      provinceSel.value = path.province;
      populateCity(path.province);
      if (path.city && regions[path.province][path.city]) {
        citySel.value = path.city;
        populateDistrict(path.province, path.city);
        districtSel.value = path.district || '';
      }
    }
    if (cityInput) cityInput.value = s.defaultCity || '';
  }

  provinceSel?.addEventListener('change', () => {
    populateCity(provinceSel.value);
    populateDistrict('', '');
    saveLocation();
  });
  citySel?.addEventListener('change', () => {
    populateDistrict(provinceSel.value, citySel.value);
    if (cityInput && !cityInput.value.trim()) cityInput.value = citySel.value;
    saveLocation();
  });
  districtSel?.addEventListener('change', () => {
    if (cityInput) cityInput.value = districtSel.value;
    saveLocation();
  });
  cityInput?.addEventListener('change', saveLocation);

  locateMeBtn?.addEventListener('click', async () => {
    setLoading(locateMeBtn, true);
    try {
      // 优先 IP 定位（后端有缓存）
      const r = await fetch('/api/geo?refresh=1', { cache: 'no-store' });
      const d = await r.json();
      const loc = d.location || {};
      const candidate = loc.city_zh || loc.city || loc.region || '';
      const path = findCityPath(candidate);
      if (path) {
        applyLocationPath(path);
        showFeedback(weatherFeedback, `已定位到：${path.district || path.city || path.province}（IP 定位，可手动微调）`, true);
      } else {
        showFeedback(weatherFeedback, `IP 定位返回「${candidate}」，未匹配到行政区划，请手动选择`, false);
      }
    } catch (e) {
      showFeedback(weatherFeedback, '定位失败：' + e.message, false);
    } finally {
      setLoading(locateMeBtn, false);
    }
  });

  restoreLocation();

  // 系统：主动推送
