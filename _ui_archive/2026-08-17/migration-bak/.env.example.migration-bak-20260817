# ============================================================
# 庄周 (ZhuangZhou) · 运行时配置模板
# ------------------------------------------------------------
# 复制为 .env 并填入你自己的值；本文件不会被打包进分发版。
# 首次启动时若 .env 不存在，程序会自动从此模板生成 .env。
# 所有键值也可在「设置」面板中修改（持久化回此文件）。
# ============================================================

# ---- 发布通道（决定界面是否露出开发者入口）----
# development：显示自检页、预览页等内部入口，便于开发与排障
# release    ：只留最终用户该看见的东西
# 只影响界面，不启用/禁用任何能力，也不改变任何后端行为。
BUILD_CHANNEL=development

# ---- 核心：Agnes LLM 供应商（对话必需）----
# 申请地址随供应商而定；留空则核心对话不可用（首启会提示填写）。
AGNES_API_KEY=
AGNES_PROVIDER=agnes
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash
# 推理增强：空=关闭 / low / medium / high
AGNES_REASONING=

# ---- 显示名称与主题 ----
AI_DISPLAY_NAME=庄周
ZHUANGZHOU_THEME=dark-cyan

# ---- 网络代理（可选；留空则自动探测本机 Clash 等）----
# 服务器在探测到 127.0.0.1:7890 可达且未显式设置环境代理时，会临时启用它。
ZHUANGZHOU_PROXY_URL=

# ---- 语音合成 TTS（可选增强；缺失则跳过语音输出）----
ZHUANGZHOU_TTS_BACKEND=edge
ZhuangZhou_TTS_VOICE=zh-CN-YunxiNeural
ZhuangZhou_TTS_RATE=+0%

# ---- 本地语音识别 ASR（可选增强；首次启动安装增强依赖后可用）----
# 设为空或 vosk / aliyun / xfyun / volcengine 等；默认不启用 ASR 重依赖。
ZHUANGZHOU_ASR_PROVIDER=

# ---- 上网搜索（可选增强）----
ZHUANGZHOU_WEB_SEARCH_ENGINE=tavily
ZHUANGZHOU_WEB_SEARCH_KEY=

# ---- 记忆图谱 / 功能开关（多数有合理默认值，一般无需改动）----
ZHUANGZHOU_MEMORY_GRAPH=true
ZHUANGZHOU_KWS_ENABLED=true
ZHUANGZHOU_VOSK_KWS_ENABLED=true
ZHUANGZHOU_WAKE_PHRASE=庄周,小周

# ---- 沙箱（文件 / 命令工具的安全边界，默认开启）----
ZHUANGZHOU_SANDBOX_FILE=true
ZHUANGZHOU_SANDBOX_EXEC=true
