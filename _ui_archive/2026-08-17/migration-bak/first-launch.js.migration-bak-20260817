/*
 * first-launch.js — Six 首次启动向导（Phase B · 开箱即用）
 *
 * 流程：环境检测 → 依赖检查 → 能力检测 → Provider 选择 → 模型选择 → 验证 → 创建用户档案 → 就绪
 * 性质：纯前端编排；复用 ZZDependencyManager（检测/报告）+ 既有 API（/api/config /providers/probe /models /test-llm）+ onboarding 个性化。
 * 纪律：
 *   - 绝不自动跑 shell / pip / npm；缺失项只引导，Core 缺失则阻塞 Ready（可显式跳过并警告）。
 *   - API Key 永不明文回显 / 不进日志（沿用 settings.js 约定：输入框始终留空，仅回写后端）。
 *   - 不修改 Phase 37 核心（Memory V2 / Planner / Executor / Agent Runtime / EventBus）。
 */
(function (global) {
  'use strict';

  var DM = global.ZZDependencyManager;
  var ONB_KEY = 'zz_onboarded';
  var BOOT_KEY = 'zz_boot_done';

  function loadSettings() {
    try { return JSON.parse(localStorage.getItem('zhuangzhou_settings_v1') || '{}'); }
    catch (e) { return {}; }
  }
  function saveSettings(patch) {
    var s = loadSettings(); Object.assign(s, patch);
    try { localStorage.setItem('zhuangzhou_settings_v1', JSON.stringify(s)); } catch (e) {}
  }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function getJSON(url, opts) {
    var ctrl = new AbortController();
    var t = setTimeout(function () { ctrl.abort(); }, (opts && opts.timeout) || 15000);
    return fetch(url, Object.assign({ signal: ctrl.signal }, opts || {}))
      .then(function (r) { return r.json().catch(function () { return {}; }); })
      .catch(function () { return { _network_error: true }; })
      .then(function (d) { clearTimeout(t); return d; });
  }
  function postJSON(url, body) {
    return getJSON(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}), timeout: 30000 });
  }

  var STEPS = ['meet', 'env', 'deps', 'capability', 'provider', 'model', 'verify', 'profile', 'ready'];
  var state = { step: 0, dep: null, cfg: null, probe: null, models: [], selectedProvider: null, selectedModel: null, testResult: null };

  function shouldRun() {
    try { return localStorage.getItem(BOOT_KEY) !== '1'; } catch (e) { return true; }
  }

  async function start() {
    var overlay = document.getElementById('flOverlay');
    if (!overlay) return;
    overlay.hidden = false;
    requestAnimationFrame(function () { overlay.classList.add('show'); });
    // Phase 38I · P0-1 后端身份校验：先探 /api/health，确认 8000 端口上确为小6后端。
    // 不可达或非小6实例时，进入阻塞屏（不进入配置向导、不误报就绪、不擅自拉起后端）。
    var health = await getJSON('/api/health').catch(function () { return {}; });
    state.cfg = await getJSON('/api/config').catch(function () { return {}; });
    state.probe = await postJSON('/api/providers/probe', {}).catch(function () { return { probe: {} }; });
    var reachable = !health._network_error && health.status === 'alive';
    var identityOk = reachable && health.ai_name === '小6' && health.features && Array.isArray(health.tools);
    state.backendIssue = reachable && !identityOk ? 'identity' : (health._network_error ? 'unreachable' : null);
    if (state.backendIssue) {
      renderBackendIssue(document.getElementById('flBody'));
    } else {
      go(0);
    }
  }

  /* Phase 38I · P0-2 后端未连接 / 非小6 阻塞屏
     只给 [重新检测] 与 [查看诊断]；严格不提供「启动小6」（前端不得拉起后端，红线）。 */
  function renderBackendIssue(body) {
    if (!body) body = document.getElementById('flBody');
    if (!body) return;
    var kind = state.backendIssue;
    var title = kind === 'identity' ? '这不是小6服务' : '暂时无法连接小6服务';
    var desc = kind === 'identity'
      ? '当前 8000 端口上运行的不是小6后端（可能是其它程序占用了该端口）。请关闭占用端口的程序，再点「重新检测」。'
      : '小6的后端服务没有响应。请确认桌面客户端已启动并常驻托盘，再点「重新检测」。';
    body.innerHTML = '<h2 class="fl__h fl__h--warn">' + esc(title) + '</h2>' +
      '<p class="fl__sub">' + esc(desc) + '</p>' +
      '<div id="flDiag" class="fl__msg"></div>';
    var foot = document.querySelector('#flOverlay .fl__footer');
    if (foot) foot.innerHTML =
      '<button class="fl__btn fl__btn--primary" id="flRetry">重新检测</button>' +
      '<button class="fl__btn fl__btn--ghost" id="flDiagBtn" type="button">查看诊断</button>';
    var retry = document.getElementById('flRetry');
    if (retry) retry.addEventListener('click', function () { start(); });
    var diagBtn = document.getElementById('flDiagBtn');
    if (diagBtn) diagBtn.addEventListener('click', function () {
      var box = document.getElementById('flDiag');
      if (box) box.textContent = '正在拉取诊断…';
      getJSON('/api/startup_diagnosis').then(function (d) {
        if (!box) return;
        if (d && d._network_error) { box.textContent = '无法连接诊断接口。'; return; }
        var mods = (d && d.modules) || [];
        if (!mods.length) { box.textContent = '诊断接口未返回模块信息。'; return; }
        box.innerHTML = '<ul class="fl__caps">' + mods.map(function (m) {
          return '<li>' + esc(m.name || m.key || '?') + '：' + esc(m.status || '?') +
            (m.detail ? ' — ' + esc(m.detail) : '') + '</li>';
        }).join('') + '</ul>';
      });
    });
  }

  function go(i) {
    state.step = i;
    var step = STEPS[i];
    var body = document.getElementById('flBody');
    if (!body) return;
    if (step === 'meet') return renderMeet(body);
    if (step === 'env') return renderEnv(body);
    if (step === 'deps') return renderDeps(body);
    if (step === 'capability') return renderCapability(body);
    if (step === 'provider') return renderProvider(body);
    if (step === 'model') return renderModel(body);
    if (step === 'verify') return renderVerify(body);
    if (step === 'profile') return renderProfile(body);
    if (step === 'ready') return renderReady(body);
  }

  /* 认识小6 · 首次见面屏（产品化包装，不替代技术校验，技术步在之后可跳过） */
  function renderMeet(body) {
    body.innerHTML = '<div class="fl__meet">' +
      '<div class="fl__meet-orb"></div>' +
      '<h2 class="fl__h">你好，我是小6</h2>' +
      '<p class="fl__sub">你的个人 AI 副驾。</p>' +
      '<p class="fl__sub fl__meet-sub">以后，我会在这里陪你。</p>' +
      '</div>';
    footer(body, '认识一下', function () { go(1); }, false);
  }

  function renderEnv(body) {
    body.innerHTML = '<h2 class="fl__h">你好，我是小6</h2>' +
      '<p class="fl__sub">我正在检查你的环境，几秒钟就好。</p>' +
      '<div id="flEnvHost" class="fl__env"><div class="zz-dep__loading">环境检测中…</div></div>';
    DM.probe().then(function (res) {
      state.dep = res;
      DM.render(document.getElementById('flEnvHost'), res);
    });
    footer(body, '下一步：依赖检查', function () { go(2); }, false);
  }

  function renderDeps(body) {
    var coreBlock = state.dep ? state.dep.summary.coreBlock : 0;
    var items = (state.dep && state.dep.items) || [];
    var coreMissing = items.filter(function (x) { return x.tier === 'CORE' && x.status !== 'READY'; });
    var canNext = coreBlock === 0;
    body.innerHTML = '<h2 class="fl__h">依赖检查</h2>' +
      '<p class="fl__sub">按"核心 / 可选 / 增强"三级评估。核心缺失时 AI 对话暂时不可用，但你可以现在修复，或先进入主界面稍后设置。</p>' +
      '<div id="flDepHost"></div>';
    DM.render(document.getElementById('flDepHost'), state.dep);
    if (!canNext && coreMissing.length) {
      var names = coreMissing.map(function (x) { return x.label; }).join('、');
      body.innerHTML += '<div class="fl__msg fl__msg--warn" style="color:var(--c-waiting);background:rgba(240,179,94,0.08);padding:10px 12px;border-radius:8px;border:1px solid rgba(240,179,94,0.25);margin-top:12px;">' +
        '<strong>' + esc(names) + '</strong> 未就绪，AI 对话暂时不可用。<br>' +
        '建议点「配置 AI 模型」修复；也可以「跳过，进入主界面」以后再设置。</div>';
      footer(body, '配置 AI 模型', function () { go(4); }, false, false, '跳过，进入主界面', finish);
    } else {
      footer(body, '下一步：能力检测', function () { go(3); }, false, false);
    }
  }

  function renderCapability(body) {
    var aiOk = state.dep && state.dep.summary.coreBlock === 0 && state.testResult && state.testResult.ok;
    var asr = getOverride('asr_provider') || (state.cfg && state.cfg.ZHUANGZHOU_ASR_PROVIDER) || '';
    var tts = getOverride('tts_backend') || (state.cfg && state.cfg.ZHUANGZHOU_TTS_BACKEND) || '';
    var local = Object.keys((state.probe && state.probe.probe) || {});
    var localUrls = getOverride('local_urls') || {};

    body.innerHTML = '<h2 class="fl__h">能力检测</h2>' +
      '<p class="fl__sub">点击任意能力卡片进行配置。配置完成后会实时刷新这里的状态。</p>' +
      '<div class="fl__cap-grid">' +
        capCard('ai', '🧠', '对话核心（AI 模型）',
          aiOk ? ('可用 · ' + (state.selectedModel || '已配置')) : '需先配置',
          aiOk ? 'is-ok' : 'is-warn') +
        capCard('asr', '🎙', '语音输入（ASR）',
          asr ? ('已启用 · ' + asr) : '未启用',
          asr ? 'is-ok' : 'is-off') +
        capCard('tts', '🔊', '语音输出（TTS）',
          tts ? ('已启用 · ' + tts) : '未启用',
          tts ? 'is-ok' : 'is-off') +
        capCard('local', '💻', '本地模型服务',
          local.length ? ('已检测到 · ' + local.join(', ')) : '未配置',
          local.length ? 'is-ok' : 'is-off') +
      '</div>';

    body.querySelectorAll('.fl__cap-card').forEach(function (c) {
      c.addEventListener('click', function () { renderCapabilityConfig(c.dataset.type, body); });
    });

    var nextLabel = aiOk ? '下一步：验证' : '下一步：选择模型来源';
    var nextStep = aiOk ? 6 : 4;
    footer(body, nextLabel, function () { go(nextStep); }, false);
  }

  function capCard(type, icon, title, status, statusClass) {
    return '<button class="fl__cap-card ' + esc(statusClass) + '" type="button" data-type="' + esc(type) + '">' +
      '<span class="fl__cap-icon">' + icon + '</span>' +
      '<span class="fl__cap-info">' +
        '<div class="fl__cap-title">' + esc(title) + '</div>' +
        '<div class="fl__cap-status ' + esc(statusClass) + '">' + esc(status) + '</div>' +
      '</span>' +
      '<span class="fl__cap-action">配置</span>' +
    '</button>';
  }

  function renderCapabilityConfig(type, body) {
    if (type === 'ai') return renderAIConfig(body);
    if (type === 'asr') return renderASRConfig(body);
    if (type === 'tts') return renderTTSConfig(body);
    if (type === 'local') return renderLocalConfig(body);
    renderCapability(body);
  }

  function configHeader(body, icon, title) {
    body.innerHTML = '<div class="fl__config-head">' +
      '<button class="fl__config-back" id="flConfigBack" type="button">← 返回</button>' +
      '<span class="fl__config-title">' + icon + ' ' + esc(title) + '</span>' +
    '</div>';
    var back = document.getElementById('flConfigBack');
    if (back) back.addEventListener('click', function () { renderCapability(body); });
  }

  function getOverride(key) {
    try { var o = JSON.parse(localStorage.getItem('zz_config_overrides') || '{}'); return o[key]; }
    catch (e) { return undefined; }
  }
  function setOverride(key, value) {
    try {
      var o = JSON.parse(localStorage.getItem('zz_config_overrides') || '{}');
      o[key] = value;
      localStorage.setItem('zz_config_overrides', JSON.stringify(o));
    } catch (e) {}
  }

  function renderAIConfig(body) {
    configHeader(body, '🧠', '配置 AI 模型');
    var providers = (state.cfg && state.cfg.providers) || [];
    var opts = providers
      .filter(function (p) { return p.user_selectable !== false; })
      .map(function (p) { return '<option value="' + esc(p.id) + '">' + esc(p.label) + (p.privacy_class === 'local' ? '（本地）' : '') + '</option>'; })
      .join('') || '<option value="agnes">Agnes / OpenAI 兼容（云端）</option><option value="ollama">Ollama（本地）</option><option value="lmstudio">LM Studio（本地）</option>';
    var base = getOverride('ai_base_url') || '';
    var savedProvider = state.selectedProvider || getOverride('ai_provider') || (providers[0] && providers[0].id) || 'agnes';
    body.innerHTML += '<div class="fl__config-form">' +
      '<div class="fl__config-row"><label>Provider</label><select id="flCfgProvider">' + opts + '</select></div>' +
      '<div class="fl__config-row"><label>Base URL</label><input id="flCfgBaseUrl" placeholder="https://… 或 http://localhost:11434" value="' + esc(base) + '"></div>' +
      '<div class="fl__config-row"><label>API Key</label><input id="flCfgKey" type="password" placeholder="留空则使用已保存密钥 / 本地无需"></div>' +
      '<div class="fl__config-btns">' +
        '<button class="fl__btn" id="flCfgFetch">拉取模型列表</button>' +
        '<button class="fl__btn fl__btn--ghost" id="flCfgTest" disabled>测试连通性</button>' +
      '</div>' +
      '<div id="flCfgModelWrap"></div>' +
      '<div id="flCfgMsg" class="fl__msg"></div>' +
    '</div>';

    var providerSel = document.getElementById('flCfgProvider');
    providerSel.value = savedProvider;
    providerSel.addEventListener('change', function () { state.selectedProvider = providerSel.value; });
    state.selectedProvider = savedProvider;

    var fetchBtn = document.getElementById('flCfgFetch');
    var testBtn = document.getElementById('flCfgTest');
    var msg = document.getElementById('flCfgMsg');
    fetchBtn.addEventListener('click', function () {
      var baseUrl = document.getElementById('flCfgBaseUrl').value.trim();
      var key = document.getElementById('flCfgKey').value;
      setOverride('ai_provider', providerSel.value);
      setOverride('ai_base_url', baseUrl);
      fetchBtn.disabled = true; fetchBtn.textContent = '拉取中…';
      postJSON('/api/models', { base_url: baseUrl, api_key: key }).then(function (r) {
        fetchBtn.disabled = false; fetchBtn.textContent = '拉取模型列表';
        if (!r.ok) { msg.textContent = '拉取失败：' + (r.error || '未知'); testBtn.disabled = true; return; }
        state.models = r.models || [];
        var sel = '<div class="fl__config-row"><label>模型</label><select id="flCfgModel">' +
          state.models.map(function (m) { return '<option value="' + esc(m.id) + '">' + esc(m.id) + '</option>'; }).join('') +
          '</select></div>';
        document.getElementById('flCfgModelWrap').innerHTML = sel;
        testBtn.disabled = false;
        msg.textContent = '找到 ' + state.models.length + ' 个模型';
      });
    });
    testBtn.addEventListener('click', function () {
      var baseUrl = document.getElementById('flCfgBaseUrl').value.trim();
      var key = document.getElementById('flCfgKey').value;
      var model = document.getElementById('flCfgModel');
      model = model ? model.value : (state.models[0] && state.models[0].id);
      if (!model) { msg.textContent = '请先拉取模型列表'; return; }
      testBtn.disabled = true; testBtn.textContent = '测试中…';
      postJSON('/api/test-llm', { base_url: baseUrl, api_key: key, model: model }).then(function (t) {
        testBtn.disabled = false; testBtn.textContent = '测试连通性';
        state.selectedModel = model; state.testResult = t;
        setOverride('ai_model', model);
        msg.textContent = t.ok
          ? ('✓ 连通成功 · 延迟 ' + (t.latency_ms || '?') + 'ms · ' + model)
          : ('✗ ' + (t.error || '测试失败'));
      });
    });
    footer(body, '保存并返回', function () { renderCapability(body); }, false);
  }

  function renderASRConfig(body) {
    configHeader(body, '🎙', '配置语音输入（ASR）');
    var current = getOverride('asr_provider') || (state.cfg && state.cfg.ZHUANGZHOU_ASR_PROVIDER) || '';
    var model = getOverride('asr_model') || (state.cfg && state.cfg.ZHUANGZHOU_ASR_MODEL) || '';
    body.innerHTML += '<div class="fl__config-form">' +
      '<div class="fl__config-row"><label>Provider</label><select id="flCfgAsrProvider"><option value="">不使用</option><option value="whisper">OpenAI Whisper</option><option value="local">本地 ASR</option><option value="azure">Azure Speech</option></select></div>' +
      '<div class="fl__config-row"><label>模型 / 识别器</label><input id="flCfgAsrModel" placeholder="例如 whisper-1 / zh-CN" value="' + esc(model) + '"></div>' +
      '<div id="flCfgAsrMsg" class="fl__msg"></div>' +
    '</div>';
    var sel = document.getElementById('flCfgAsrProvider');
    sel.value = current;
    footer(body, '保存并返回', function () {
      setOverride('asr_provider', sel.value);
      setOverride('asr_model', document.getElementById('flCfgAsrModel').value.trim());
      renderCapability(body);
    }, false);
  }

  function renderTTSConfig(body) {
    configHeader(body, '🔊', '配置语音输出（TTS）');
    var current = getOverride('tts_backend') || (state.cfg && state.cfg.ZHUANGZHOU_TTS_BACKEND) || '';
    var voice = getOverride('tts_voice') || (state.cfg && state.cfg.ZHUANGZHOU_TTS_VOICE) || '';
    body.innerHTML += '<div class="fl__config-form">' +
      '<div class="fl__config-row"><label>Provider</label><select id="flCfgTtsProvider"><option value="">不使用</option><option value="edge">Edge TTS</option><option value="openai">OpenAI TTS</option><option value="local">本地 TTS</option></select></div>' +
      '<div class="fl__config-row"><label>音色 / Voice</label><input id="flCfgTtsVoice" placeholder="例如 zh-CN-XiaoxiaoNeural / alloy" value="' + esc(voice) + '"></div>' +
      '<div id="flCfgTtsMsg" class="fl__msg"></div>' +
    '</div>';
    var sel = document.getElementById('flCfgTtsProvider');
    sel.value = current;
    footer(body, '保存并返回', function () {
      setOverride('tts_backend', sel.value);
      setOverride('tts_voice', document.getElementById('flCfgTtsVoice').value.trim());
      renderCapability(body);
    }, false);
  }

  function renderLocalConfig(body) {
    configHeader(body, '💻', '配置本地模型服务');
    var urls = getOverride('local_urls') || {};
    body.innerHTML += '<div class="fl__config-form">' +
      '<p class="fl__sub">填写本地服务地址，点「探测」检查是否可达。小6会在需要时优先使用它们。</p>' +
      '<div class="fl__config-row"><label>Ollama</label><input id="flCfgOllama" placeholder="http://localhost:11434" value="' + esc(urls.ollama || '') + '"></div>' +
      '<div class="fl__config-row"><label>LM Studio</label><input id="flCfgLmstudio" placeholder="http://localhost:1234" value="' + esc(urls.lmstudio || '') + '"></div>' +
      '<div class="fl__config-row"><label>MLX</label><input id="flCfgMlx" placeholder="http://localhost:8080" value="' + esc(urls.mlx || '') + '"></div>' +
      '<div class="fl__config-btns">' +
        '<button class="fl__btn" id="flCfgProbe">探测本地服务</button>' +
      '</div>' +
      '<div id="flCfgLocalMsg" class="fl__msg"></div>' +
    '</div>';
    document.getElementById('flCfgProbe').addEventListener('click', function () {
      var u = {
        ollama: document.getElementById('flCfgOllama').value.trim(),
        lmstudio: document.getElementById('flCfgLmstudio').value.trim(),
        mlx: document.getElementById('flCfgMlx').value.trim()
      };
      setOverride('local_urls', u);
      var btn = document.getElementById('flCfgProbe');
      btn.disabled = true; btn.textContent = '探测中…';
      postJSON('/api/providers/probe', u).then(function (r) {
        btn.disabled = false; btn.textContent = '探测本地服务';
        state.probe = r || { probe: {} };
        var found = Object.keys(state.probe.probe || {});
        document.getElementById('flCfgLocalMsg').textContent = found.length
          ? '检测到：' + found.join('、')
          : '未检测到可连通的本地服务，请确认服务已启动。';
      });
    });
    footer(body, '保存并返回', function () {
      setOverride('local_urls', {
        ollama: document.getElementById('flCfgOllama').value.trim(),
        lmstudio: document.getElementById('flCfgLmstudio').value.trim(),
        mlx: document.getElementById('flCfgMlx').value.trim()
      });
      renderCapability(body);
    }, false);
  }

  function renderProvider(body) {
    var providers = (state.cfg && state.cfg.providers) || [];
    var opts = providers
      .filter(function (p) { return p.user_selectable !== false; })
      .map(function (p) { return '<option value="' + esc(p.id) + '">' + esc(p.label) + (p.privacy_class === 'local' ? '（本地）' : '') + '</option>'; })
      .join('') || '<option value="agnes">Agnes / OpenAI 兼容（云端）</option>';
    body.innerHTML = '<h2 class="fl__h">选择模型来源</h2>' +
      '<p class="fl__sub">云端模型需要 API Key；本地模型（Ollama / LM Studio / MLX）数据不出本机。</p>' +
      '<label class="fl__field">Provider<select id="flProvider">' + opts + '</select></label>' +
      '<label class="fl__field">Base URL<input id="flBaseUrl" class="fl__input" placeholder="https://… 或 http://localhost:11434"></label>' +
      '<label class="fl__field">API Key<input id="flKey" class="fl__input" type="password" placeholder="留空则使用已保存密钥 / 本地无需"></label>' +
      '<div id="flProviderMsg" class="fl__msg"></div>';
    var sel = document.getElementById('flProvider');
    sel.addEventListener('change', function () { state.selectedProvider = sel.value; });
    state.selectedProvider = sel.value;
    footer(body, '下一步：选择模型', function () { go(5); }, false);
  }

  function renderModel(body) {
    body.innerHTML = '<h2 class="fl__h">选择模型</h2>' +
      '<p class="fl__sub">从所选来源拉取可用模型，并测试连通性。</p>' +
      '<button id="flFetch" class="fl__btn">拉取模型列表</button>' +
      '<div id="flModelWrap" class="fl__model-wrap"></div>' +
      '<div id="flTestMsg" class="fl__msg"></div>';
    var fetchBtn = document.getElementById('flFetch');
    fetchBtn.addEventListener('click', function () {
      var base = document.getElementById('flBaseUrl').value.trim();
      var key = document.getElementById('flKey').value;
      fetchBtn.disabled = true; fetchBtn.textContent = '拉取中…';
      postJSON('/api/models', { base_url: base, api_key: key })
        .then(function (r) {
          fetchBtn.disabled = false; fetchBtn.textContent = '拉取模型列表';
          if (!r.ok) { document.getElementById('flTestMsg').textContent = '拉取失败：' + (r.error || '未知'); return; }
          state.models = r.models || [];
          var sel = '<select id="flModel" class="fl__input">' +
            state.models.map(function (m) { return '<option value="' + esc(m.id) + '">' + esc(m.id) + '</option>'; }).join('') +
            '</select>';
          document.getElementById('flModelWrap').innerHTML = '<label class="fl__field">模型' + sel + '</label>' +
            '<button id="flTest" class="fl__btn fl__btn--ghost">测试连通性</button>';
          document.getElementById('flTest').addEventListener('click', function () {
            var model = document.getElementById('flModel').value;
            postJSON('/api/test-llm', { base_url: base, api_key: key, model: model }).then(function (t) {
              state.selectedModel = model; state.testResult = t;
              document.getElementById('flTestMsg').textContent = t.ok
                ? ('✓ 连通成功 · 延迟 ' + t.latency_ms + 'ms · ' + model) : ('✗ ' + (t.error || '测试失败'));
            });
          });
        });
    });
    footer(body, '下一步：验证', function () { go(6); }, false);
  }

  function renderVerify(body) {
    var ok = state.dep && state.dep.summary.coreBlock === 0 && state.testResult && state.testResult.ok;
    body.innerHTML = '<h2 class="fl__h">验证</h2>' +
      '<p class="fl__sub">最后确认一切就绪。</p>' +
      '<ul class="fl__caps">' +
      '<li>服务 / 模型：' + (state.dep && state.dep.summary.coreBlock === 0 ? '✓' : '✗ 核心缺失') + '</li>' +
      '<li>Provider：' + esc(state.selectedProvider || '—') + '</li>' +
      '<li>模型连通：' + (state.testResult && state.testResult.ok ? ('✓ ' + state.selectedModel) : '未测试 / 失败') + '</li>' +
      '</ul>';
    footer(body, '下一步：创建你的档案', function () { go(7); }, !ok, !ok);
  }

  function renderProfile(body) {
    var s = loadSettings();
    var savedName = '';
    try { savedName = localStorage.getItem('zz_user_name') || ''; } catch (e) {}
    body.innerHTML = '<h2 class="fl__h">认识你</h2>' +
      '<p class="fl__sub">最后一步。告诉我该怎么称呼你，以及你希望我怎么陪你。</p>' +
      '<label class="fl__field">我该怎么称呼你<input id="flName" class="fl__input" value="' + esc(savedName) + '" placeholder="例如：老板、朋友、你随意"></label>' +
      '<label class="fl__check"><input id="flTts" type="checkbox" ' + (s.autoTts ? 'checked' : '') + '> 开启语音输出（我说话时念出来）</label>' +
      '<label class="fl__check"><input id="flPro" type="checkbox" ' + (s.proactive !== false ? 'checked' : '') + '> 开启主动智能（主动给你建议和提醒）</label>';
    footer(body, '完成，进入小6', function () {
      var nm = (document.getElementById('flName').value || '').trim();
      var patch = {
        autoTts: document.getElementById('flTts').checked,
        proactive: document.getElementById('flPro').checked,
      };
      saveSettings(patch);
      // 称呼仅存于本地偏好（zz_user_name），不谎称后端；AI 名/主题仍由 Control Center 管理
      try { localStorage.setItem('zz_user_name', nm); } catch (e) {}
      go(8);
    }, false);
  }

  function renderReady(body) {
    try { localStorage.setItem(BOOT_KEY, '1'); localStorage.setItem(ONB_KEY, '1'); } catch (e) {}
    body.innerHTML = '<h2 class="fl__h fl__h--ok">全部准备完成 🌿</h2>' +
      '<p class="fl__sub">小6已经了解你的环境。你可以随时在「设置 → 依赖 / AI / 语音」里调整。</p>' +
      '<p class="fl__sub">你的数据默认保存在本机。</p>';
    var foot = document.querySelector('#flOverlay .fl__footer');
    if (foot) foot.innerHTML = '<button class="fl__btn fl__btn--primary" id="flDone">进入小6</button>';
    var done = document.getElementById('flDone');
    if (done) done.addEventListener('click', finish);
  }

  function footer(body, label, onClick, danger, disabled, secondaryLabel, secondaryAction) {
    var foot = document.querySelector('#flOverlay .fl__footer');
    if (!foot) return;
    var html = '<button class="fl__btn ' + (danger ? 'fl__btn--warn' : 'fl__btn--primary') + '" id="flNext"' + (disabled ? ' disabled' : '') + '>' + esc(label) + '</button>';
    if (secondaryLabel) {
      html += '<button class="fl__btn fl__btn--ghost" id="flSecondary" type="button">' + esc(secondaryLabel) + '</button>';
    }
    html += '<button class="fl__btn fl__btn--ghost" id="flSkip" type="button">跳过引导，直接进入</button>';
    foot.innerHTML = html;
    var next = document.getElementById('flNext');
    if (next) next.addEventListener('click', onClick);
    var secondary = document.getElementById('flSecondary');
    if (secondary && secondaryAction) secondary.addEventListener('click', secondaryAction);
    var skip = document.getElementById('flSkip');
    if (skip) skip.addEventListener('click', finish);   // 全局可跳过：不阻塞进入小6
  }

  function finish() {
    var overlay = document.getElementById('flOverlay');
    if (!overlay) return;
    overlay.classList.remove('show');
    setTimeout(function () { overlay.hidden = true; }, 300);
  }

  var ZZFirstLaunch = {
    shouldRun: shouldRun,
    start: start,
    maybeStart: function () { if (shouldRun()) start(); },
    _state: state,
  };
  global.ZZFirstLaunch = ZZFirstLaunch;

  // 自动触发：首次访问且未完成引导
  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { ZZFirstLaunch.maybeStart(); });
    } else {
      ZZFirstLaunch.maybeStart();
    }
  }
})(typeof window !== 'undefined' ? window : globalThis);
